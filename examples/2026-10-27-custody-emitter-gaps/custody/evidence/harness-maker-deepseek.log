tion_at_source\"] = \"logged live (inputs/custody-events.jsonl)\"\n```\nThere's also `if live and at and (...)` refusal earlier, and `if live and not at: at = live.get(\"at\")`. So if `live` exists, `at` is set from live. Good.\n\n**Hunk H**: time_sources map before `check_order`.\n\n```python\n    xp[\"time_tolerance_s\"] = H.TOLERANCE_S\n    xp[\"times\"] = {...}\n```\nAdd after:\n\n```python\n    time_sources = {\"startedAt\": mk.get(\"startedAt_source\"), \"producedAt\": mk.get(\"producedAt_source\"),\n                    \"bar.frozenAt\": fz_src, \"disposition.at\": dsp_src}\n    for i, a in enumerate(approvals):\n        time_sources[f\"bar.approvals[{i}].at\"] = (a.get(\"x-plumbline\") or {}).get(\"at_source\")\n    for c in checks:\n        x = c.get(\"x-plumbline\") or {}\n        if x.get(\"pass_id\"):\n            time_sources[f\"checks[{x['pass_id']}/{c.get('dimension')}].at\"] = x.get(\"at_source\")\n    for k in controls:\n        time_sources[f\"controls[{k.get('id')}].at\"] = (k.get(\"x-plumbline\") or {}).get(\"at_source\")\n    xp[\"time_sources\"] = time_sources\n```\n\nWhere `mk.get(...)` returns None when mk is {} — need `mk` defined; it is (`mk = maker_history(...) if ... else {}`).\n\nNote: `checks` entries from `ci[\"checks\"]` won't have `pass_id` → skipped.\n\n**Hunk I**: `maker_history`.\n\n```python\n    first = min(calls, key=lambda c: c.started)\n    last = max(calls, key=lambda c: c.at)\n    started, produced = first.started, last.at\n    H.cross_check(ref, \"startedAt\", ci.get(\"startedAt\"), started, f\"harness log {first.label}\")\n    H.cross_check(ref, \"producedAt\", ci.get(\"producedAt\"), produced, f\"harness log {last.label}\")\n    out = {\"startedAt\": H.iso(started), \"producedAt\": H.iso(produced), \"endpoint\": last.endpoint,\n           \"x\": {**route_x(log, calls), \"startedAt_basis\": f\"{first.label} response \"\n                 + (\"created\" if first.created else \"Date header\"), \"producedAt_basis\": f\"{last.label} {last.at_basis}\"}}\n```\n\nNew:\n\n```python\n    first = min(calls, key=lambda c: c.sent_at or c.started)\n    last = max(calls, key=lambda c: c.received_at or c.at)\n    has_sent = any(c.sent_at for c in calls)\n    has_recv = any(c.received_at for c in calls)\n    if has_sent and first.sent_at is None:\n        ref.add(\"time\", f\"maker: the first call {first.label} carries no `sent_at` (the harness's request-send \"\n                        f\"time), so startedAt cannot be read from the log\")\n    if has_recv and last.received_at is None:\n        ref.add(\"time\", f\"maker: the last call {last.label} carries no `received_at` (the harness's reply-receive \"\n                        f\"time), so producedAt cannot be read from the log\")\n    started, produced = first.sent_at or first.started, last.received_at or last.at\n    if first.sent_at is None and gaps is not None:\n        gaps.add(\"maker.startedAt\", f\"{first.label} logs no sent_at; startedAt falls back to its \"\n                                    f\"{first.at_basis or 'logged time'} ({H.iso(started)})\", False)\n    if last.received_at is None and gaps is not None:\n        gaps.add(\"maker.producedAt\", f\"{last.label} logs no received_at; producedAt falls back to its \"\n                                     f\"{last.at_basis or 'logged time'} ({H.iso(produced)})\", False)\n    H.cross_check(ref, \"startedAt\", ci.get(\"startedAt\"), started, f\"harness log {first.label}\")\n    H.cross_check(ref, \"producedAt\", ci.get(\"producedAt\"), produced, f\"harness log {last.label}\")\n    out = {\"startedAt\": H.iso(started), \"producedAt\": H.iso(produced), \"endpoint\": last.endpoint,\n           \"startedAt_source\": source(job, log, first.sent_line if first.sent_at else first.date_line,\n                                      H.iso(started), \"harness log \" + (\"sent_at\" if first.sent_at else \"reply time\")),\n           \"producedAt_source\": source(job, log, last.recv_line if last.received