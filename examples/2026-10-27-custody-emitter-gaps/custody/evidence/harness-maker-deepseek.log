}`\n326: `        elif from_file:`\n327: `            instrument[key] = from_file`\n328: `        else:`\n329: `            gaps.add(f\"instrument.{key}\", \"neither the §5 record nor the custody inputs pin it\")`\n330: `            instrument[key] = None`\n331: (blank)\n332: `    # ---- evaluators ----`\n333: `    evs, ev_calls, ev_ep = [], {}, {}`\n334: `    for i, e in enumerate(ci.get(\"evaluators\") or []):`\n335: `        e_model = e.get(\"model\")`\n336: `        if e.get(\"kind\") == \"model\":`\n337: `            eh = evaluator_history(job, ev_dir, ci, e, ref, pin_for(ci, ev_log, str(e.get(\"id\")), ref), gaps)`\n338: `            ev_calls[e.get(\"id\")], ev_ep[e.get(\"id\")] = eh.get(\"calls\", {}), eh.get(\"endpoint\")`\n339: `            if eh.get(\"endpoint\"):`\n340: `                e_model = dict(e_model or {}, endpoint=eh[\"endpoint\"])`\n341: `        ev = {\"id\": e.get(\"id\"), \"name\": e.get(\"name\"), \"kind\": e.get(\"kind\"),`\n342: `              \"model\": model_block(e_model, f\"evaluators[{i}].model\", gaps) if e.get(\"kind\") == \"model\" else None}`\n343: `        if e.get(\"kind\") == \"model\" and eh.get(\"x\"):`\n344: `            ev[\"x-plumbline\"] = eh[\"x\"]`\n345: `        if e.get(\"kind\") == \"script\":`\n346: `            s = e.get(\"script\") or {}`\n347: `            ev[\"script\"] = {\"name\": s.get(\"name\"), \"author\": s.get(\"author\"),`\n348: `                            \"digest\": digest_of(job, s.get(\"file\"), f\"evaluators[{i}].script.digest\", gaps)}`\n349: `        else:`\n350: `            ev[\"script\"] = None`\n351: `        if e.get(\"kind\") == \"model\" and maker.get(\"model\") and ev[\"model\"]:`\n352: `            same = ev[\"model\"].get(\"identifier\") == maker[\"model\"].get(\"identifier\")`\n353: `            if \"sameModelAsMaker\" in e and bool(e[\"sameModelAsMaker\"]) != same:`\n354: `                gaps.add(f\"evaluators[{i}].sameModelAsMaker\", \"the inputs' value contradicts the identifiers; \"`\n355: `                                                               \"the identifiers decide (CL1-6)\", False)`\n356: `            if same:`\n357: `                ev[\"sameModelAsMaker\"] = True`\n358: `        evs.append(ev)`\n359: `    if not evs:`\n360: `        gaps.add(\"evaluators\", \"no evaluator recorded\")`\n361: `    ev_ids = {e[\"id\"] for e in evs}`\n362: (blank)\n363: `    # ---- separation gaps: the inputs' own, plus the same-family fact the model blocks show ----`\n364: `    sep = list(ci.get(\"separationGaps\") or [])`\n365: `    mf = (maker.get(\"model\") or {}).get(\"family\")`\n366: `    for e in evs:`\n367: `        ef = (e.get(\"model\") or {}).get(\"family\")`\n368: `        if mf and ef and ef == mf:`\n369: `            line = f\"evaluator {e['id']} ({e['name']}) shares model family '{ef}' with the maker\"`\n370: `            if not any(line in s for s in sep):`\n371: `                sep.append(line)`\n372: (blank)\n373: `    # ---- checks: one per (filed pass, bar dimension), from the final iteration's passes ----`\n374: `    pfacts = ci.get(\"passes\") or {}`\n375: `    quotes = {}`\n376: `    for p in (run or {}).get(\"passes\") or []:`\n377: `        for q in p.get(\"evidence\") or []:`\n378: `            quotes.setdefault((p.get(\"pass_id\"), q.get(\"dimension\")), []).append(q.get(\"quote\"))`\n379: `    scales = {d[\"id\"]: d.get(\"scale\") for d in dims}`\n380: `    checks = []`\n381: `    for p in passes_src:`\n382: `        pid = p.get(\"pass_id\")`\n383: `        f = pfacts.get(pid)`\n384: `        if p.get(\"_missing\"):`\n385: `            gaps.add(f\"checks[{pid}]\", f\"the §5 record lists pass {pid} but {p['_missing']} is absent\")`\n386: `            continue`\n387: `        if f is None:`\n388: `            gaps.add(f\"checks[{pid}]\", f\"no custody facts for pass {pid} (evaluator, time, batch, evidence)\")`\n389: `            continue`\n390: `        scores = {pl_name.get(s.get(\"dimension\"), s.get(\"dimension\"))