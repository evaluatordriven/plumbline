ater:\n```\n    out = {\"startedAt\": H.iso(started), \"producedAt\": H.iso(produced), \"endpoint\": last.endpoint,\n           \"x\": {**route_x(log, calls), \"startedAt_basis\": f\"{first.label} response \"\n                 + (\"created\" if first.created else \"Date header\"), \"producedAt_basis\": f\"{last.label} {last.at_basis}\"}}\n```\n(3 lines)\n\nNew:\n```\n    if any(c.sent or c.received for c in calls):\n        for c in calls:\n            if not (c.sent and c.received):\n                ref.add(\"time\", f\"maker: {c.label} carries no sent_at/received_at; a Maker harness log \"\n                                f\"must record both the request-send and the reply-receive time\")\n        timed = [c for c in calls if c.sent and c.received]\n        if not timed:\n            return {}\n        first = min(timed, key=lambda c: c.sent)\n        last = max(timed, key=lambda c: c.received)\n        started, produced = first.sent, last.received\n        start_basis = f\"{first.label} sent_at\"\n        prod_basis = f\"{last.label} received_at\"\n        start_src = src(job, log, first.sent_line)\n        prod_src = src(job, log, last.received_line)\n    else:\n        calls = [c for c in calls if c.at]\n        if not calls:\n            return {}\n        first = min(calls, key=lambda c: c.started)\n        last = max(calls, key=lambda c: c.at)\n        started, produced = first.started, last.at\n        start_basis = f\"{first.label} response \" + (\"created\" if first.created else \"Date header\")\n        prod_basis = f\"{last.label} {last.at_basis}\"\n        start_src = src(job, log, first.created_line or first.date_line)\n        prod_src = src(job, log, last.date_line or last.created_line)\n    annotate(calls, \"maker\", (m.get(\"model\") or {}).get(\"identifier\"), ref, pin)\n    check_pin_order(pin, [c for c in calls if c.started], \"maker\", ref)\n```\nCount new: \n1 `if any(...):`\n2 `for c in calls:`\n3 `if not (c.sent and c.received):`\n4 `ref.add