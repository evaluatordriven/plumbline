valuator evidence file and harness log (checks, controls, external)\n11     context/...                the job files the record digests besides those: maker method, instrument files,\n12                                control cases, the final §5 record and the packet (for a reader who wants them)\n13     MANIFEST.sha256            `sha256  path` for every file above (sha256sum -c compatible)\n14     README.txt                 the one command that re-reads it\n15 \n16 The zip is deterministic (sorted entries, fixed timestamps and modes), so packing the same job twice gives the\n17 same sha256. Nothing is fetched and nothing outside the job folder and the record is read.\n18 \n19     pack_stranger_bundle.py --job-dir <job> [--record FILE] --out bundle.zip\n20 \n21 Prints the submission's stranger_bundle fields as JSON: zip path, zip sha256, and the in-zip paths of the\n22 record, files, evidence and bar. Exit 0 packed · 1 a file the record names is missing (nothing written).\n23 \"\"\"\n24 from __future__ import annotations\n25 import argparse, json, sys, zipfile\n26 from hashlib import sha256\n27 from pathlib import Path\n28 \n29 FIXED = (1980, 1, 1, 0, 0, 0)\n30 \n31 \n32 def h(b: bytes) -> str:\n33     return sha256(b).hexdigest()\n34 \n35 \n36 def main() -> int:\n37     ap = argparse.ArgumentParser(description=\"Pack a custody record and its files for a stranger.\")\n38     ap.add_argument(\"--job-dir\", required=True)\n39     ap.add_argument(\"--record\", help=\"the custody record (default: <job>/custody/record.custody.json)\")\n40     ap.add_argument(\"--inputs\", help=\"custody inputs (default: <job>/inputs/custody.json)\")\n41     ap.add_argument(\"--out\", required=True)\n42     a = ap.parse_args()\n43     job = Path(a.job_dir).expanduser().resolve()\n44     rec_path = Path(a.record).expanduser() if a.record else job / \"custody\" / \"record.custody.json\"\n45     ci_path = Path(a.inputs).expanduser() if a.inputs else job / \"inputs\" / \"custody.json\"\n46  