: `            if not c[\"batch\"]:`\n415: `                gaps.add(f\"checks[{pid}/{dim}].batch\", \"not recorded\")`\n416: `            if not c[\"failureCondition\"]:`\n417: `                gaps.add(f\"checks[{pid}/{dim}].failureCondition\", \"not declared on the bar dimension or the pass\")`\n418: `            sc = scores.get(dim)`\n419: `            explicit = (f.get(\"outcomes\") or {}).get(dim)`\n420: `            void = p.get(\"status\") not in (None, \"filed\") or (sc is None and explicit is None)`\n421: `            if void:`\n422: `                c[\"outcome\"] = \"unobserved\"`\n423: `                c[\"unobserved\"] = {\"channel\": p.get(\"channel\") or p.get(\"provider\") or \"unrecorded\",`\n424: `                                   \"reason\": p.get(\"void_cause\") or (f.get(\"unobserved_reason\") or {}).get(dim)`\n425: `                                   or f\"pass {pid} filed no score for {dim} (status {p.get('status')!r})\"}`\n426: `            else:`\n427: `                scale = scales.get(dim)`\n428: `                if isinstance(scale, dict) and isinstance(sc, (int, float)) and \"threshold\" in scale:`\n429: `                    c[\"score\"] = sc`\n430: `                    c[\"outcome\"] = \"conforms\" if sc >= scale[\"threshold\"] else \"does_not_conform\"   # CL1-17`\n431: `                    if explicit and explicit != c[\"outcome\"]:`\n432: `                        gaps.add(f\"checks[{pid}/{dim}].outcome\", f\"the inputs say {explicit!r} but score {sc} \"`\n433: `                                 f\"against threshold {scale['threshold']} reads {c['outcome']!r}; CL1-17 decides\", False)`\n434: `                elif explicit in (\"conforms\", \"does_not_conform\"):`\n435: `                    c[\"outcome\"] = explicit`\n436: `                    if sc is not None:`\n437: `                        x[\"score\"] = sc`\n438: `                        x[\"score_note\"] = \"Plumbline score; the bar declares no custody scale for this dimension\