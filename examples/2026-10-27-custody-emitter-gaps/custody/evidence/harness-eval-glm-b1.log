  425|     scales = {d[\"id\"]: d.get(\"scale\") for d in dims}\n  426|     checks = []\n  427|     for p in passes_src:\n  428|         pid = p.get(\"pass_id\")\n  429|         f = pfacts.get(pid)\n  430|         if p.get(\"_missing\"):\n  431|             gaps.add(f\"checks[{pid}]\", f\"the §5 record lists pass {pid} but {p['_missing']} is absent\")\n  432|             continue\n  433|         if f is None:\n  434|             gaps.add(f\"checks[{pid}]\", f\"no custody facts for pass {pid} (evaluator, time, batch, evidence)\")\n  435|             continue\n  436|         scores = {pl_name.get(s.get(\"dimension\"), s.get(\"dimension\")): s.get(\"score\") for s in p.get(\"scores\") or []}\n  437|         dims_read = f.get(\"dimensions\") or list(scores) or [d[\"id\"] for d in dims]\n  438|         n_passes = sum(1 for q in pfacts.values() if q.get(\"evaluator\") == f.get(\"evaluator\"))\n  439|         call = link_call(ev_calls, f.get(\"evaluator\"), f.get(\"call\"),\n  440|                          \"eval_artifact\" if n_passes == 1 else None, f\"passes.{pid}\", ref)\n  441|         at_v, ep_v, xc = f.get(\"at\"), f.get(\"endpoint\"), {}\n  442|         if call is not None:\n  443|             H.cross_check(ref, f\"passes.{pid}.at\", f.get(\"at\"), call.at, f\"harness log {call.label}\")\n  444|             at_v, xc = H.iso(call.at), {\"call\": call.label, \"at_basis\": call.at_basis}\n  445|             if call.source_at():\n  446|                 xc[\"at_source\"] = call.source_at()\n  447|             if f.get(\"endpoint\") and call.endpoint and f[\"endpoint\"] != call.endpoint:\n  448|                 ref.add(\"endpoint\", f\"passes.{pid}.endpoint: hand-entered {f['endpoint']!r} but {call.label} was \"\n  449|                                     f\"answered by {call.endpoint}\")\n  450|             ep_v = call.endpoint if call.endpoint and call.endpoint != ev_ep.get(f.get(\"evaluator\")) else None\n  451|         elif f.get(\"at\"):\n  452|             n = line