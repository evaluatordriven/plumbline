         gaps.add(field, f"named file {rel!r} does not exist in the job", hard); return None
     return p
+
+
+def src(job: Path, p: Path | None, line: int | None) -> dict | None:
+    """The file (relative to the job) and line a time in this record was read from."""
+    if p is None or not line:
+        return None
+    try:
+        rel = p.resolve().relative_to(job.resolve()).as_posix()
+    except ValueError:
+        rel = p.name
+    return {"file": rel, "line": int(line)}
+
+
+def json_src(job: Path, p: Path, key: str, value) -> dict | None:
+    """The line a value sits on in a JSON file (the ledger times the inputs hold)."""
+    if not p.is_file() or value in (None, ""):
+        return None
+    text = p.read_text(encoding="utf-8")
+    i = text.find(f'"{key}": {json.dumps(value)}')
+    if i < 0:
+        i = text.find(f'"{key}":{json.dumps(value)}')
+    if i < 0:
+        return None
+    try:
+        rel = p.resolve().relative_to(job.resolve()).as_posix()
+    except ValueError:
+        rel = p.name
+    return {"file": rel, "line": text.count("\n", 0, i) + 1}
+
