+def _annotate_lines(text: str, calls: list) -> None:
+    """The line each time value sits on, so the record can name it."""
+    cur: dict = {}
+    for c in calls:
+        raw = c.raw
+        for key, attr in (("sent_at", "sent_line"), ("received_at", "received_line")):
+            val = raw.get(key)
+            if isinstance(val, str):
+                line, pos = _line_of(text, f'"{key}": {json.dumps(val)}', cur.get(key, 0))
+                if line:
