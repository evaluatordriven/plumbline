+def json_src(job: Path, p: Path, key: str, value) -> dict | None:
+    if not p.is_file() or value in (None, ""):
+        return None
+    text = p.read_text(encoding="utf-8")
+    needle = f'"{key}": {json.dumps(value)}'
+    i = text.find(needle)
+    if i < 0:
+        needle = f'"{key}":{json.dumps(value)}'
+        i = text.find(needle)
+    if i < 0:
+        return None
+    try:
+        rel = p.resolve().relative_to(job.resolve()).as_posix()
+    except ValueError:
+        rel = p.name
+    return {"file": rel, "line": text.count("\n", 0, i) + 1}
+
