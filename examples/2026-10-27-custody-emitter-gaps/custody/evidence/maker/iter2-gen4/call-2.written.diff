+def _clock(created, date) -> tuple[str | None, str | None]:
+    """(send, receive) as whole-second ISO from a call's own response `created` and `Date` header."""
+    c = datetime.fromtimestamp(created, timezone.utc) if isinstance(created, (int, float)) else None
+    d = None
+    if date:
+        try:
+            d = parsedate_to_datetime(date).astimezone(timezone.utc)
+        except (TypeError, ValueError):
+            d = None
+    send, recv = (c or d), (d or c)
+    if send and recv and recv < send:
+        recv = send
+    f = lambda x: x.strftime("%Y-%m-%dT%H:%M:%SZ") if x else None     # noqa: E731
+    return f(send), f(recv)
+
+
+def fill_logger_times(path: Path) -> bool:
+    """Bring a pre-logger harness log forward, once: a call with no `sent_at`/`received_at` gets them from its
+    own response `created` (else its `Date` header) at whole seconds UTC, so the record can name the line that
+    carries the time it used. Values already present are never changed. True when the file was rewritten."""
+    try:
+        text = path.read_text(encoding="utf-8")
+    except OSError:
+        return False
+    try:
+        doc = json.loads(text)
+        items = doc if isinstance(doc, list) else [doc]
+    except ValueError:
+        items = []
+        for ln in text.splitlines():
+            if ln.strip():
+                try:
+                    items.append(json.loads(ln))
+                except ValueError:
+                    return False
+    changed = False
+    for it in items:
+        if not isinstance(it, dict) or "request" not in it:
+            continue
+        resp = it.get("response") if isinstance(it.get("response"), dict) else {}
+        send, recv = _clock(resp.get("created"),
+                            _hdr(it.get("response_headers") or it.get("headers") or {}, "Date"))
+        if not it.get("sent_at") and send:
+            it["sent_at"] = send
+            changed = True
+        if not it.get("received_at") and recv:
+            it["received_at"] = recv
+            changed = True
+    if changed:
+        try:
+            path.write_text(json.dumps(items, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
+        except OSError:
+            return False
+    return changed
+
