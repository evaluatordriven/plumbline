                      else f\"evidence file {ev_name!r} not under {ev_dir.relative_to(job)}\")\n  505|             c[\"x-plumbline\"] = x\n  506|             checks.append(c)\n  507|     for i, c in enumerate(ci.get(\"checks\") or []):     # a readings job: checks recorded directly\n  508|         c = dict(c)\n  509|         en = c.pop(\"evidence_file\", None)\n  510|         if en:\n  511|             c[\"evidence\"] = {\"name\": en, \"sha256\": file_digest(ev_dir / en)} if (ev_dir / en).is_file() else None\n  512|             if c[\"evidence\"] is None:\n  513|                 gaps.add(f\"checks[+{i}].evidence\", f\"evidence file {en!r} missing\")\n  514|         if c.get(\"at\"):\n  515|             n = line_in(inputs_path, c.get(\"at\"), \"at\")\n  516|             if n:\n  517|                 xc = c.get(\"x-plumbline\")\n  518|                 if not isinstance(xc, dict):\n  519|                     xc = {}\n  520|                 xc[\"at_source\"] = f\"{rel_inputs}:{n}\"\n  521|                 c[\"x-plumbline\"] = xc\n  522|                 xp[\"sources\"][f\"checks[+{i}].at\"] = f\"{rel_inputs}:{n}\"\n  523|         checks.append(c)\n  524|     if not checks:\n  525|         gaps.add(\"checks\", \"no filed pass and no recorded check\")\n  526|     for d in dims:\n  527|         if d[\"id\"] and not any(c.get(\"dimension\") == d[\"id\"] for c in checks):\n  528|             gaps.add(\"checks\", f\"bar dimension {d['id']} has no check (custody CL1-7: every dimension is checked)\")\n  529| \n  530|     # ---- controls: a clean and a planted case per evaluator per batch, by case digest ----\n  531|     controls = []\n  532|     for i, k in enumerate(ci.get(\"controls\") or []):\n  533|         ctl = {\"id\": k.get(\"id\"), \"batch\": k.get(\"batch\"), \"evaluator\": k.get(\"evaluator\"),\n  534|                \"case\": digest_of(job, k.get(\"case_file\"), f\"controls[{i}].case\", gaps),\n  535|                \"expected\": k.get(\"expected\"), \"outcome\": k.get(\"outcome\")}\n  536|         if \"dimension\" in k:\n  537|             ctl[\"dimension\"] = k[\"dimension\"]\n  538|         xk = {}\n  539|         if k.get(\"evidence_file\"):\n  540|             p = job / k[\"evidence_file\"]\n  541|             xk[\"evidence\"] = {\"name\": k[\"evidence_file\"], \"sha256\": file_digest(p)} if p.is_file() else None\n  542|         call = link_call(ev_calls, k.get(\"evaluator\"), k.get(\"call\"), f\"eval_{str(k.get('id') or '').lower()}\",\n  543|                          f\"controls[{k.get('id')}]\", ref)\n  544|         if call is not None:\n  545|             H.cross_check(ref, f\"controls[{k.get('id')}].at\", k.get(\"at\"), call.at, f\"harness log {call.label}\")\n  546|             xk.update({\"call\": call.label, \"at\": H.iso(call.at), \"at_basis\": call.at_basis})\n  547|             if call.source_at():\n  548|                 xk[\"at_source\"] = call.source_at()\n  549|             if call.endpoint and call.endpoint != ev_ep.get(k.get(\"evaluator\")):\n  550|                 xk[\"endpoint\"] = call.endpoint\n  551|         elif k.get(\"at\"):\n  552|             xk[\"at\"] = k[\"at\"]\n  553|             n = line_in(inputs_path, k[\"at\"], \"at\")\n  554|             if n:\n  555|                 xk[\"at_source\"] = f\"{rel_inputs}:{n}\"\n  556|         if xk:\n  557|             ctl[\"x-plumbline\"] = xk\n  558|             if xk.get(\"at_source\"):\n  559|                 xp[\"sources\"][f\"controls[{k.get('id')}].at\"] = xk[\"at_source\"]\n  560|         controls.append(ctl)\n  561|     have = {(k[\"evaluator\"], k[\"batch\"], k[\"expected\"]) for k in controls}\n  562|     for c in checks:\n  563|         if c.get(\"outcome\") in (\"conforms\", \"does_not_conform\"):\n  564|             for exp in (\"conforms\", \"does_not_conform\"):\n  565|                 if (c[\"evaluator\"], c[\"batch\"], exp) not in have:\n  566|                     gaps.add(\"controls\", f\"evaluator {c['evaluator']} batch {c['batch']} ha