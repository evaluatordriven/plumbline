rate code. It may use\n   23 + kit/custody_history.py to parse harness logs.\n   24 + \"\"\"\n   25 + from __future__ import annotations\n   26 + \n   27 + import argparse\n   28 + import json\n   29 + import re\n   30 + import subprocess\n   31 + import sys\n   32 + from hashlib import sha256\n   33 + from pathlib import Path\n   34 + \n   35 + HERE = Path(__file__).resolve().parent\n   36 + REPO = HERE.parent\n   37 + sys.path.insert(0, str(HERE))\n   38 + import custody_history as H  # noqa: E402\n   39 + \n   40 + SCHEMA_VERSION = \"plumbline/x-plumbline/v1\"\n   41 + SCHEMA_PATH = REPO / \"schemas\" / \"x-plumbline\" / \"x-plumbline-v1.schema.json\"\n   42 + SPEND_TOL = 0.0001\n   43 + LEDGER_REL = \"inputs/custody-events.jsonl\"\n   44 + # The record path given by --record: a finding about the record names it, never an empty file field.\n   45 + RECORD_PATH: Path | None = None\n   46 + OWNED = (\"verdict\", \"gaps\", \"times\", \"time_tolerance_s\", \"hand_times\", \"allowances\",\n   47 +          \"generations\", \"evaluations\", \"relays\", \"amendments\", \"spend\", \"schema\")\n   48 + # A tool's writer stamp: a .py path under kit/ and 12 lowercase hex (V3). Checked by form only.\n   49 + WRITER_FORM = re.compile(r\"^kit/[A-Za-z0-9_./-]+\\.py@[0-9a-f]{12}$\")\n   50 + \n   51 + \n   52 + def file_sha(p: Path) -> str:\n   53 +     return sha256(Path(p).read_bytes()).hexdigest()\n   54 + \n   55 + \n   56 + def load(p: Path):\n   57 +     return json.loads(Path(p).read_text(encoding=\"utf-8\"))\n   58 + \n   59 + \n   60 + def relpath(job: Path, p: Path) -> str:\n   61 +     try:\n   62 +         return Path(p).resolve().relative_to(Path(job).resolve()).as_posix()\n   63 +     except ValueError:\n   64 +         return str(Path(p).resolve())\n   65 + \n   66 + \n   67 + def ledger_lines(p: Path) -> list[tuple[int, dict]]:\n   68 +     out: list[tuple[int, dict]] = []\n   69 +     if not Path(p).is_file():\n   70 +         return out\n   71 +     for n, ln in enumerate(Path(p).read_text(encoding=\"utf-8\").splitlines(), 1):\n   72 +         if not ln.strip():\n   73 +             continue\n   74 +         try:\n   75 +             e = json.loads(ln)\n   76 +         except ValueError:\n   77 +             continue\n   78 +         if isinstance(e, dict):\n   79 +             e[\"_line\"] = n\n   80 +             out.append((n, e))\n   81 +     return out\n   82 + \n   83 + \n   84 + def writer_source(e: dict):\n   85 +     w = e.get(\"writer\")\n   86 +     if w == \"hand\":\n   87 +         return \"ledger-hand\"\n   88 +     if w in (None, \"\"):\n   89 +         return \"ledger-no-writer\"\n   90 +     return None\n   91 + \n   92 + \n   93 + def allowance_writer_ok(w) -> bool:\n   94 +     \"\"\"A tool's writer stamp by form: `<relative .py path under kit/>@<12 lowercase hex>`, never `hand`.\"\"\"\n   95 +     return isinstance(w, str) and WRITER_FORM.match(w) is not None and \"..\" not in w\n   96 + \n   97 + \n   98 + def line_of(path: Path, value, key: str | None = None):\n   99 +     if value in (None, \"\") or not Path(path).is_file():\n  100 +         return None\n  101 +     try:\n  102 +         lines = Path(path).read_text(encoding=\"utf-8\").splitlines()\n  103 +     except OSError:\n  104 +         return None\n  105 +     vs = str(value)\n  106 +     hits = [n for n, ln in enumerate(lines, 1) if vs in ln and (key is None or f'\"{key}\"' in ln)]\n  107 +     if not hits:\n  108 +         hits = [n for n, ln in enumerate(lines, 1) if vs in ln]\n  109 +     return hits[0] if hits else None\n  110 + \n  111 + \n  112 + def bar_path(job: Path, custody_json: Path) -> Path:\n  113 +     \"\"\"The job's bar file: `bar.file` in inputs/custody.json, relative to the job, default `custody/bar.md`.\"\"\"\n  114 +     try:\n  115 +         ci = load(custody_json) if Path(custody_json).is_file() else {}\n  116 +     except Exception:\n  117 +         ci = {}\n  118 +     rel = ((ci.get(\"bar\") or {}).get(\"file\")) or \"custody/bar.md\"\n  119 +     p = Path(rel)\n  120 +     return p if p.is_absolute() else Path(job) / p\n  121 + \n  122 + \n  123 + def used_seats(ci: dict) -> set[str]:\n  124 +     seats: set[str] = set()\n  125 +     m = ci.get(\"maker\") or {}\n  126 +     if m.get(\"kind\") == \"model\":\n  127 +         seats.add(\"maker\")\n  128 +     for e in ci.get(\"evaluators\") or []:\n  129 +         if e.get(\"kind\") == \"model\":\n  130 +             seats.add(str(e.get(\"id\")))\n  131 +     return seats\n  132 + \n  133 + \n  134 + def evidence_dirs(job: Path, ev: Path, ci: dict) -> list[Path]:\n  135 +     \"\"\"Where harness logs can be: the verifier's --evidence, the inputs' evidence_dir, and the job itself.\"\"\"\n  136 +     out = [Path(ev)]\n  137 +     rel = (ci.get(\"evidence_dir\") if isinstance(ci, dict) else None) or \"custody/evidence\"\n  138 +     out.append(Path(job) / rel)\n  139 +     out.append(Path(job))\n  140 +     seen: set[str] = set()\n  141 +     uniq: list[Path] = []\n  142 +     for d in out:\n  143 +         r = str(Path(d).resolve())\n  144 +         if r not in seen:\n  145 +             seen.add(r)\n  146 +             uniq.append(Path(d))\n  147 +     return uniq\n  148 + \n  149 + \n  150 + def find_log(job: Path, dirs: list[Path], rel: str | None, pattern: str | None):\n  151 +     if rel:\n  152 +         for base in dirs:\n  153 +             p = Path(base) / rel\n  154 +             if p.is_file():\n  155 +                 return p\n  156 +         return None\n  157 +     hits: list[Path] = []\n  158 +     seen: set[str] = set()\n  159 +     for base in dirs:\n  160 +         if not Path(base).is_dir() or not pattern:\n  161 +             continue\n  162 +         for p in sorted(Path(base).glob(pattern)):\n  163 +             k = str(p.resolve())\n  164 +             if k not in seen:\n  165 +                 seen.add(k)\n  166 +                 hits.append(p)\n  167 +     return hits[0] if len(hits) == 1 else None\n  168 + \n  169 + \n  170 + def read_calls(job: Path, ev_dir: Path, ci: dict):\n  171 +     by: dict[str, dict] = {}\n  172 +     allc: list = []\n  173 +     dirs = evidence_dirs(job, ev_dir, ci)\n  174 + \n  175 +     def add(seat: str, log):\n  176 +         if not log:\n  177 +             return\n  178 +         try:\n  179 +             calls = H.read_log(Path(log), H.Refusals(), str(seat))\n  180 +         except Exception:\n  181 +             return\n  182 +         d = by.setdefault(str(seat), {})\n  183 +         for c in calls:\n  184 +             name = getattr(c, \"name\", None) or str(getattr(c, \"i\", \"\"))\n  185 +             d[name] = c\n  186 +             allc.append(c)\n  187 + \n  188 +     if isinstance(ci, dict):\n  189 +         m = ci.get(\"maker\") or {}\n  190 +         if m.get(\"kind\") == \"model\":\n  191 +             add(\"maker\", find_log(job, dirs, m.get(\"harness_log\"), \"harness-maker*.log\"))\n  192 +         for e in ci.get(\"evaluators\") or []:\n  193 +             if e.get(\"kind\") == \"model\":\n  194 +                 rel = e.get(\"harness_log\") or next(\n  195 +                     (x.get(\"evidence_file\") for x in ci.get(\"external\") or []\n  196 +                      if x.get(\"subject\") == e.get(\"id\")), None)\n  197 +                 add(str(e.get(\"id\")), find_log(job, dirs, rel, None))\n  198 +     if not allc:\n  199 +         for base in dirs:\n  200 +             if Path(base).is_dir():\n  201 +                 for log in sorted(Path(base).glob(\"*.log\")):\n  202 +                     add(log.stem, log)\n  203 +     return by, allc\n  204 + \n  205 + \n  206 + def call_cost(c) -> float:\n  207 +     \"\"\"A harness call's billed cost, in the order the job's harness uses for its own settle lines: the\n  208 +     generation reply's `data.total_cost` when present, else the chat reply's `usage.cost` (V5).\"\"\"\n  209 +     raw = getattr(c, \"raw\", None)\n  210 +     if not isinstance(raw, dict):\n  211 +         return 0.0\n  212 +     gen = raw.get(\"generation\") if isinstance(raw.get(\"generation\"), dict) else None\n  213 +     if gen is not None:\n  214 +         data = gen.get(\"data\") if isinstance(gen.get(\"data\"), dict) else gen\n  215 +         v = data.get(\"total_cost\") if isinstance(data, dict) else None\n  216 +         if isinstance(v, (int, float)) and not isinstance(v, bool):\n  217 +             return float(v)\n  218 +     resp = raw.get(\"response\") if isinstance(raw.get(\"response\"), dict) else {}\n  219 +     usage = resp.get(\"usage\") if isinstance(resp.get(\"usage\"), dict) else {}\n  220 +     v = usage.get(\"cost\") if isinstance(usage, dict) else None\n  221 +     if isinstance(v, (int, float)) and not isinstance(v, bool):\n  222 +         return float(v)\n  223 +     return 0.0\n  224 + \n  225 + \n  226 + def call_time(c):\n  227 +     return getattr(c, \"started\", None) or getattr(c, \"at\", None)\n  228 + \n  229 + \n  230 + def ledger_array(lines: list[tuple[int, dict]], event: str, ledger_rel: str) -> list[dict]:\n  231 +     return [{**{k: v for k, v in e.items() if k != \"_line\"},\n  232 +              \"source\": f\"{ledger_rel}:{e['_line']}\"}\n  233 +             for _, e in lines if e.get(\"event\") == event]\n  234 + \n  235 + \n  236 + def last_spend_line(lines: list[tuple[int, dict]]):\n  237 +     sp = None\n  238 +     for _, e in lines:\n  239 +         if e.get(\"event\") == \"spend\":\n  240 +             sp = e\n  241 +     return sp\n  242 + \n  243 + \n  244 + def compute_spend_block(lines: list[tuple[int, dict]], all_calls, ledger_rel: str) -> dict:\n  245 +     sp = last_spend_line(lines)\n  246 +     calls_sum = round(sum(call_cost(c) for c in all_calls if getattr(c, \"at\", None)), 6)\n  247 +     key_delta = float(sp.get(\"key_delta_usd\") or 0) if sp else 0.0\n  248 +     return {\"calls_sum_usd\": calls_sum,\n  249 +             \"key_delta_usd\": key_delta,\n  250 +             \"total_usd\": max(calls_sum, key_delta),\n  251 +             \"tolerance_usd\": SPEND_TOL,\n  252 +             \"source\": f\"{ledger_rel}:{sp['_line']}\" if sp else None}\n  253 + \n  254 + \n  255 + def hand_key(e: dict):\n  256 +     try:\n  257 +         line = int(e.get(\"line\")) if e.get(\"line\") is not None else None\n  258 +     except (TypeError, ValueError):\n  259 +         line = None\n  260 +     return (e.get(\"field\"), e.get(\"file\"), line, e.get(\"source\"))\n  261 + \n  262 + \n  263 + def hand_sort(k) -> tuple:\n  264 +     \"\"\"A total order over hand-time keys: a missing line sorts first, and nothing compares None with an int.\"\"\"\n  265 +     line = k[2] if isinstance(k[2], int) and not isinstance(k[2], bool) else -1\n  266 +     return (str(k[0]), str(k[1]), line, str(k[3]))\n  267 + \n  268 + \n  269 + def hand_time_set(job: Path, ledger_path: Path, custody_path: Path, record: dict, evidence: Path) -> list[dict]:\n  270 +     ci = load(custody_path) if Path(custody_path).is_file() else {}\n  271 +     lines = ledger_lines(ledger_path)\n  272 +     ledger_rel = relpath(job, ledger_path)\n  273 +     try:\n  274 +         inputs_rel = relpath(job, custody_path)\n  275 +     except Exception:\n  276 +         inputs_rel = str(custody_path)\n  277 +     seats = used_seats(ci)\n  278 +     calls_by_seat, all_calls = read_calls(job, evidence, ci)\n  279 +     hand: dict[str, dict] = {}\n  280 +     seen: set = set()\n  281 + \n  282 +     def mark(field: str, file: str, line, source: str) -> None:\n  283 +         hand[field] = {\"field\": field, \"file\": file, \"line\": line, \"source\": source}\n  284 + \n  285 +     for n, e in lines:\n  286 +         src = writer_source(e)\n  287 +         ev = e.get(\"event\")\n  288 +         field = None\n  289 +         if ev == \"freeze\":\n  290 +             seen.add(\"freeze\")\n  291 +             field = \"bar.frozenAt\"\n  292 +         elif ev == \"approve\":\n  293 +             role = e.get(\"role\")\n  294 +             seen.add((\"approve\", role))\n  295 +             for i, a in enumerate((ci.get(\"bar\") or {}).get(\"approvals\") or []):\n  296 +                 if a.get(\"role\") == role:\n  297 +                     f = f\"bar.approvals[{i}].at\"\n  298 +                     if src:\n  299 +                         mark(f, ledger_rel, n, src)\n  300 +                     else:\n  301 +                         hand.pop(f, None)\n  302 +             continue\n  303 +         elif ev == \"dispose\":\n  304 +             seen.add(\"dispose\")\n  305 +             field = \"disposition.at\"\n  306 +         elif ev == \"pin\":\n  307 +             seat = e.get(\"seat\")\n  308 +             seen.add((\"pin\", seat))\n  309 +             if seat in seats:\n  310 +                 field = f\"routing.{seat}.declaredAt\"\n  311 +         else:\n  312 +             continue\n  313 +         if field:\n  314 +             if src:\n  315 +                 mark(field, ledger_rel, n, src)\n  316 +             else:\n  317 +                 hand.pop(field, None)\n  318 + \n  319 +     bar = ci.get(\"bar\") or {}\n  320 +     if \"freeze\" not in seen and bar.get(\"frozenAt\"):\n  321 +         mark(\"bar.frozenAt\", inputs_rel, line_of(custody_path, bar.get(\"frozenAt\"), \"frozenAt\"),\n  322 +              \"inputs-no-ledger\")\n  323 +     for i, a in enumerate(bar.get(\"approvals\") or []):\n  324 +         if (\"approve\", a.get(\"role\")) not in seen and a.get(\"at\"):\n  325 +             mark(f\"bar.approvals[{i}].at\", inputs_rel, line_of(custody_path, a.get(\"at\"), \"at\"),\n  326 +                  \"inputs-no-ledger\")\n  327 +     for seat in seats:\n  328 +         if (\"pin\", seat) not in seen:\n  329 +             pin = (ci.get(\"routing\") or {}).get(seat) or {}\n  330 +             if pin.get(\"declaredAt\"):\n  331 +                 mark(f\"routing.{seat}.declaredAt\", inputs_rel,\n  332 +                      line_of(custody_path, pin.get(\"declaredAt\"), \"declaredAt\"), \"inputs-no-ledger\")\n  333 +     if \"dispose\" not in seen:\n  334 +         d = ci.get(\"disposition\") or {}\n  335 +         if d.get(\"at\"):\n  336 +             mark(\"disposition.at\", inputs_rel, line_of(custody_path, d.get(\"at\"), \"at\"), \"inputs-no-ledger\")\n  337 + \n  338 +     # A typed startedAt/producedAt is a hand time whether or not the maker has a logged call (V3): the tool's\n  339 +     # time is the log's, and a time typed into custody.json has no tool behind it (as for pass and control times).\n  340 +     if ci.get(\"startedAt\"):\n  341 +         mark(\"startedAt\", inputs_rel, line_of(custody_path, ci.get(\"startedAt\"), \"startedAt\"),\n  342 +              \"inputs-no-ledger\")\n  343 +     if ci.get(\"producedAt\"):\n  344 +         mark(\"producedAt\", inputs_rel, line_of(custody_path, ci.get(\"producedAt\"), \"producedAt\"),\n  345 +              \"inputs-no-ledger\")\n  346 + \n  347 +     # A typed pass or control time is a hand time whether or not a harness call is linked: the tool's time is\n  348 +     # the log's, and a time typed into custody.json has no tool behind it (the emitter's rule, V3).\n  349 +     for pid, f in (ci.get(\"passes\") or {}).items():\n  350 +         if not isinstance(f, dict) or not f.get(\"at\"):\n  351 +             continue\n  352 +         mark(f\"passes.{pid}.at\", inputs_rel, line_of(custody_path, f.get(\"at\"), \"at\"),\n  353 +              \"inputs-no-ledger\")\n  354 + \n  355 +     for k in ci.get(\"controls\") or []:\n  356 +         if not k.get(\"at\"):\n  357 +             continue\n  358 +         mark(f\"controls[{k.get('id')}].at\", inputs_rel, line_of(custody_path, k.get(\"at\"), \"at\"),\n  359 +              \"inputs-no-ledger\")\n  360 + \n  361 +     # A call the logger did not stamp `sent_at`/`received_at` carries a server time: a hand time (T7b, V3).\n  362 +     logs: list[Path] = []\n  363 +     for base in evidence_dirs(job, evidence, ci):\n  364 +         if Path(base).is_dir():\n  365 +             logs += sorted(Path(base).glob(\"*.log\"))\n  366 +     for log in dict.fromkeys(logs):\n  367 +         try:\n  368 +             calls = H.read_log(Path(log), H.Refusals(), \"verify\")\n  369 +         except Exception:\n  370 +             continue\n  371 +         for c in calls:\n  372 +             try:\n  373 +                 entries = c.hand_time_entries()\n  374 +             except Exception:\n  375 +                 entries = []\n  376 +             for e in entries:\n  377 +                 if isinstance(e, dict) and e.get(\"field\"):\n  378 +                     hand[str(e[\"field\"])] = e\n  379 +     return [hand[k] for k in sorted(hand)]\n  380 + \n  381 + \n  382 + def check_hand_times(hand: list[dict], record: dict, record_path: Path | None = None) -> list[dict]:\n  383 +     fails: list[dict] = []\n  384 +     rp = str(record_path) if record_path is not None else \"<record>\"\n  385 +     xp = (record.get(\"predicate\") or {}).get(\"x-plumbline\") if isinstance(record, dict) else None\n  386 +     if not isinstance(xp, dict):\n  387 +         return fails\n  388 +     flags = xp.get(\"hand_times\")\n  389 +     if not isinstance(flags, list):\n  390 +         return fails\n  391 +     recomp = {hand_key(e) for e in hand if isinstance(e, dict)}\n  392 +     got = {hand_key(e) for e in flags if isinstance(e, dict)}\n  393 +     for k in sorted(recomp - got, key=hand_sort):\n  394 +         fails.append({\"kind\": \"hand-time-unflagged\", \"field\": k[0], \"file\": k[1] or rp,\n  395 +                       \"line\": k[2] if isinstance(k[2], int) and not isinstance(k[2], bool) else 0})\n  396 +     for k in sorted(got - recomp, key=hand_sort):\n  397 +         fails.append({\"kind\": \"flag-without-source\", \"field\": k[0], \"file\": k[1] or rp,\n  398 +                       \"line\": k[2] if isinstance(k[2], int) and not isinstance(k[2], bool) else 0})\n  399 +     if recomp:\n  400 +         allowances = xp.get(\"allowances\")\n  401 +         allowance = allowances.get(\"hand_times\") if isinstance(allowances, dict) else None\n  402 +         if not isinstance(allowance, dict):\n  403 +             fails.append({\"kind\": \"allowance\", \"field\": \"x-plumbline.allowances.hand_times\",\n  404 +                           \"file\": rp, \"line\": 0})\n  405 +         else:\n  406 +             if allowance.get(\"switch\") != \"--allow-hand-times\":\n  407 +                 fails.append({\"kind\": \"allowance\", \"field\": \"x-plumbline.allowances.hand_times.switch\",\n  408 +                               \"file\": rp, \"line\": 0})\n  409 +             if not allowance_writer_ok(allowance.get(\"writer\")):\n  410 +                 fails.append({\"kind\": \"allowance\", \"field\": \"x-plumbline.allowances.hand_times.writer\",\n  411 +                               \"file\": rp, \"line\": 0})\n  412 +             if not H.parse_ts(allowance.get(\"at\")):\n  413 +                 fails.append({\"kind\": \"allowance\", \"field\": \"x-plumbline.allowances.hand_times.at\",\n  414 +                               \"file\": rp, \"line\": 0})\n  415 +     return fails\n  416 + \n  417 + \n  418 + def check_events(job: Path, ledger_path: Path, record: dict, calls_by_seat: dict) -> list[dict]:\n  419 +     fails: list[dict] = []\n  420 +     xp = (record.get(\"predicate\") or {}).get(\"x-plumbline\") if isinstance(record, dict) else None\n  421 +     if not isinstance(xp, dict):\n  422 +         return fails\n  423 +     lines = ledger_lines(ledger_path)\n  424 +     ledger_rel = relpath(job, ledger_path)\n  425 +     for ev, key in ((\"generation\", \"generations\"), (\"evaluation\", \"evaluations\"),\n  426 +                     (\"relay\", \"relays\"), (\"amendment\", \"amendments\")):\n  427 +         expected = ledger_array(lines, ev, ledger_rel)\n  428 +         got = xp.get(key)\n  429 +         if got != expected:\n  430 +             fails.append({\"kind\": \"events\", \"field\": f\"x-plumbline.{key}\", \"file\": str(ledger_path), \"line\": 0})\n  431 + \n  432 +     for _, e in lines:\n  433 +         if e.get(\"event\") != \"evaluation\":\n  434 +             continue\n  435 +         vf = e.get(\"verdict_file\")\n  436 +         want = e.get(\"verdict_sha256\")\n  437 +         if not vf:\n  438 +             continue\n  439 +         p = Path(vf) if Path(vf).is_absolute() else Path(job) / vf\n  440 +         if not p.is_file() or file_sha(p) != want:\n  441 +             fails.append({\"kind\": \"events\", \"field\": f\"evaluations[{e.get('batch')}].verdict_sha256\",\n  442 +                           \"file\": vf, \"line\": e.get(\"_line\", 0)})\n  443 + \n  444 +     opens: dict = {}\n  445 +     closes: dict = {}\n  446 +     for _, e in lines:\n  447 +         if e.get(\"event\") != \"generation\":\n  448 +             continue\n  449 +         k = (e.get(\"seat\"), e.get(\"n\"))\n  450 +         if e.get(\"action\") == \"open\":\n  451 +             opens[k] = e\n  452 +         elif e.get(\"action\") == \"close\":\n  453 +             closes[k] = e\n  454 +     maker_calls = list((calls_by_seat.get(\"maker\") or {}).values())\n  455 +     for k, o in opens.items():\n  456 +         c = closes.get(k)\n  457 +         if not c:\n  458 +             fails.append({\"kind\": \"events\", \"field\": f\"generations[{k[0]}#{k[1]}].close\",\n  459 +                           \"file\": str(ledger_path), \"line\": o.get(\"_line\", 0)})\n  460 +             continue\n  461 +         t0, t1 = H.parse_ts(o.get(\"at\")), H.parse_ts(c.get(\"at\"))\n  462 +         if t0 and t1:\n  463 +             found = any(call_time(x) and t0 <= call_time(x) <= t1 for x in maker_calls)\n  464 +             if not found:\n  465 +                 fails.append({\"kind\": \"events\", \"field\": f\"generations[{k[0]}#{k[1]}].calls\",\n  466 +                               \"file\": str(ledger_path), \"line\": o.get(\"_line\", 0)})\n  467 + \n  468 +     relays = [e for _, e in lines if e.get(\"event\") == \"relay\"]\n  469 +     approvals = ((record.get(\"predicate\") or {}).get(\"bar\") or {}).get(\"approvals\") or []\n  470 +     for r in relays:\n  471 +         for a in approvals:\n  472 +             if (a.get(\"kind\") == \"relay\" or a.get(\"relay\") or a.get(\"role\") == \"relay\"\n  473 +                     or a.get(\"by\") == r.get(\"from\") or a.get(\"quote\") == r.get(\"quote\")):\n  474 +                 fails.append({\"kind\": \"relay-as-approval\", \"field\": \"predicate.bar.approvals\",\n  475 +                               \"file\": str(ledger_path), \"line\": r.get(\"_line\", 0)})\n  476 +                 break\n  477 +     return fails\n  478 + \n  479 + \n  480 + def check_spend(job: Path, ledger_path: Path, record: dict, all_calls) -> list[dict]:\n  481 +     fails: list[dict] = []\n  482 +     xp = (record.get(\"predicate\") or {}).get(\"x-plumbline\") if isinstance(record, dict) else None\n  483 +     if not isinstance(xp, dict):\n  484 +         return fails\n  485 +     lines = ledger_lines(ledger_path)\n  486 +     ledger_rel = relpath(job, ledger_path)\n  487 +     expected = compute_spend_block(lines, all_calls, ledger_rel)\n  488 +     sp = xp.get(\"spend\")\n  489 +     if not isinstance(sp, dict):\n  490 +         return [{\"kind\": \"spend\", \"field\": \"x-plumbline.spend\", \"file\": str(ledger_path), \"line\": 0}]\n  491 +     for k in (\"calls_sum_usd\", \"key_delta_usd\", \"total_usd\", \"tolerance_usd\"):\n  492 +         if k not in sp:\n  493 +             fails.append({\"kind\": \"spend\", \"field\": f\"x-plumbline.spend.{k}\", \"file\": str(ledger_path), \"line\": 0})\n  494 +     calls_sum = float(sp.get(\"calls_sum_usd\") or 0)\n  495 +     key_delta = float(sp.get(\"key_delta_usd\") or 0)\n  496 +     total = float(sp.get(\"total_usd\") or 0)\n  497 +     tol = float(sp.get(\"tolerance_usd\") or 0)\n  498 +     if abs(calls_sum - expected[\"calls_sum_usd\"]) > SPEND_TOL:\n  499 +         fails.append({\"kind\": \"spend\", \"field\": \"x-plumbline.spend.calls_sum_usd\",\n  500 +                       \"file\": str(ledger_path), \"line\": 0})\n  501 +     if abs(key_delta - expected[\"key_delta_usd\"]) > 1e-9:\n  502 +         fails.append({\"kind\": \"spend\", \"field\": \"x-plumbline.spend.key_delta_usd\",\n  503 +                       \"file\": str(ledger_path), \"line\": 0})\n  504 +     if abs(total - max(calls_sum, key_delta)) > 1e-9:\n  505 +         fails.append({\"kind\": \"spend\", \"field\": \"x-plumbline.spend.total_usd\",\n  506 +                       \"file\": str(ledger_path), \"line\": 0})\n  507 +     if abs(tol - SPEND_TOL) > 1e-12:\n  508 +         fails.append({\"kind\": \"spend\", \"field\": \"x-plumbline.spend.tolerance_usd\",\n  509 +                       \"file\": str(ledger_path), \"line\": 0})\n  510 + \n  511 +     # V5 does not require a spend-ledger line: with none, the block above is the expected one (key_delta 0,\n  512 +     # total = the calls sum, source null). The settle and key-reading checks apply to the spend line when there\n  513 +     # is one.\n  514 +     sp_line = last_spend_line(lines)\n  515 +     if sp_line:\n  516 +         lp = Path(sp_line.get(\"spend_ledger\") or \"\")\n  517 +         if not lp.is_absolute():\n  518 +             lp = Path(job) / lp\n  519 +         if not lp.is_file():\n  520 +             fails.append({\"kind\": \"spend\", \"field\": \"spend_ledger\", \"file\": str(lp), \"line\": sp_line.get(\"_line\", 0)})\n  521 +         else:\n  522 +             labels = {getattr(c, \"name\", None) or str(getattr(c, \"i\", \"\")) for c in all_calls}\n  523 +             for n, ln in enumerate(lp.read_text(encoding=\"utf-8\").splitlines(), 1):\n  524 +                 if not ln.strip():\n  525 +                     continue\n  526 +                 try:\n  527 +                     x = json.loads(ln)\n  528 +                 except ValueError:\n  529 +                     continue\n  530 +                 if x.get(\"event\") == \"settle\":\n  531 +                     call = x.get(\"call\") or x.get(\"id\")\n  532 +                     if call and call not in labels:\n  533 +                         fails.append({\"kind\": \"spend\", \"field\": f\"settle[{call}]\",\n  534 +                                       \"file\": str(lp), \"line\": n})\n  535 +         rp = Path(sp_line.get(\"key_reading\") or \"\")\n  536 +         if not rp.is_absolute():\n  537 +             rp = Path(job) / rp\n  538 +         if not rp.is_file():\n  539 +             fails.append({\"kind\": \"spend\", \"field\": \"key_reading\", \"file\": str(rp), \"line\": sp_line.get(\"_line\", 0)})\n  540 +         else:\n  541 +             try:\n  542 +                 r = load(rp)\n  543 +             except Exception:\n  544 +                 r = {}\n  545 +             if not r.get(\"read_at\") or not r.get(\"writer\"):\n  546 +                 fails.append({\"kind\": \"spend\", \"field\": \"key_reading.read_at\",\n  547 +                               \"file\": str(rp), \"line\": 0})\n  548 +             else:\n  549 +                 read_at = H.parse_ts(r.get(\"read_at\"))\n  550 +                 last = H.parse_ts(sp_line.get(\"last_settle_at\"))\n  551 +                 if read_at and last and (read_at - last).total_seconds() < 180:\n  552 +                     fails.append({\"kind\": \"spend\", \"field\": \"key_reading.read_at\",\n  553 +                                   \"file\": str(rp), \"line\": 0})\n  554 +                 if abs(float(r.get(\"key_delta_usd\") or 0) - key_delta) > 1e-6:\n  555 +                     fails.append({\"kind\": \"spend\", \"field\": \"key_reading.key_delta_usd\",\n  556 +                                   \"file\": str(rp), \"line\": 0})\n  557 +     return fails\n  558 + \n  559 + \n  560 + def check_shadow(job: Path, ledger_path: Path, record: dict, all_calls, hand: list[dict],\n  561 +                  calls_by_seat: dict) -> list[dict]:\n  562 +     fails: list[dict] = []\n  563 +     xp = (record.get(\"predicate\") or {}).get(\"x-plumbline\") if isinstance(record, dict) else None\n  564 +     if not isinstance(xp, dict):\n  565 +         return fails\n  566 +     inputs = xp.get(\"inputs\")\n  567 +     if not isinstance(inputs, dict):\n  568 +         inputs = {}\n  569 +     lines = ledger_lines(ledger_path)\n  570 +     ledger_rel = relpath(job, ledger_path)\n  571 +     derived: dict = {\n  572 +         \"schema\": SCHEMA_VERSION,\n  573 +         \"time_tolerance_s\": H.TOLERANCE_S,\n  574 +         \"hand_times\": hand,\n  575 +         \"generations\": ledger_array(lines, \"generation\", ledger_rel),\n  576 +         \"evaluations\": ledger_array(lines, \"evaluation\", ledger_rel),\n  577 +         \"relays\": ledger_array(lines, \"relay\", ledger_rel),\n  578 +         \"amendments\": ledger_array(lines, \"amendment\", ledger_rel),\n  579 +         \"spend\": compute_spend_block(lines, all_calls, ledger_rel),\n  580 +     }\n  581 +     s5 = xp.get(\"s5_record\") or {}\n  582 +     if s5.get(\"name\"):\n  583 +         p = Path(s5[\"name\"]) if Path(s5[\"name\"]).is_absolute() else Path(job) / s5[\"name\"]\n  584 +         if p.is_file():\n  585 +             try:\n  586 +                 rec = load(p)\n  587 +                 if \"verdict\" in rec:\n  588 +                     derived[\"verdict\"] = rec.get(\"verdict\")\n  589 +             except Exception:\n  590 +                 pass\n  591 +     mcalls = calls_by_seat.get(\"maker\") or {}\n  592 +     derived[\"times\"] = {\"startedAt\": \"harness log\" if mcalls else \"hand-entered\",\n  593 +                         \"producedAt\": \"harness log\" if mcalls else \"hand-entered\"}\n  594 + \n  595 +     for key in OWNED:\n  596 +         if key not in derived or key not in xp:\n  597 +             continue\n  598 +         if key == \"hand_times\":\n  599 +             if {hand_key(e) for e in xp.get(key) or [] if isinstance(e, dict)} != \\\n  600 +                     {hand_key(e) for e in derived[key] or [] if isinstance(e, dict)}:\n  601 +                 fails.append({\"kind\": \"shadow\", \"field\": f\"x-plumbline.{key}\",\n  602 +                               \"file\": str(ledger_path), \"line\": 0})\n  603 +         elif xp.get(key) != derived[key]:\n  604 +             fails.append({\"kind\": \"shadow\", \"field\": f\"x-plumbline.{key}\",\n  605 +                           \"file\": str(ledger_path), \"line\": 0})\n  606 +     for key in OWNED:\n  607 +         if key in inputs and key in xp and key in derived:\n  608 +             if xp.get(key) == inputs.get(key) and xp.get(key) != derived[key]:\n  609 +                 fails.append({\"kind\": \"shadow\", \"field\": f\"x-plumbline.inputs.{key}\",\n  610 +                               \"file\": str(ledger_path), \"line\": 0})\n  611 +     return fails\n  612 + \n  613 + \n  614 + def _type_ok(v, t: str) -> bool:\n  615 +     if t == \"object\":\n  616 +         return isinstance(v, dict)\n  617 +     if t == \"array\":\n  618 +         return isinstance(v, list)\n  619 +     if t == \"string\":\n  620 +         return isinstance(v, str)\n  621 +     if t == \"integer\":\n  622 +         return isinstance(v, int) and not isinstance(v, bool)\n  623 +     if t == \"number\":\n  624 +         return isinstance(v, (int, float)) and not isinstance(v, bool)\n  625 +     if t == \"boolean\":\n  626 +         return isinstance(v, bool)\n  627 +     if t == \"null\":\n  628 +         return v is None\n  629 +     return True\n  630 + \n  631 + \n  632 + def _validate(inst, sch, root, path: str) -> list[tuple[str, str]]:\n  633 +     errs: list[tuple[str, str]] = []\n  634 +     if sch is True or sch == {}:\n  635 +         return errs\n  636 +     if sch is False:\n  637 +         return [(path, \"false schema\")]\n  638 +     if \"$ref\" in sch:\n  639 +         ref = sch[\"$ref\"]\n  640 +         if isinstance(ref, str) and ref.startswith(\"#/$defs/\"):\n  641 +             name = ref.split(\"/\")[-1]\n  642 +             return _validate(inst, root[\"$defs\"][name], root, path)\n  643 +         return errs\n  644 +     if \"const\" in sch and inst != sch[\"const\"]:\n  645 +         errs.append((path, \"const\"))\n  646 +     if \"enum\" in sch and inst not in sch[\"enum\"]:\n  647 +         errs.append((path, \"enum\"))\n  648 +     if \"type\" in sch:\n  649 +         ts = sch[\"type\"] if isinstance(sch[\"type\"], list) else [sch[\"type\"]]\n  650 +         if not any(_type_ok(inst, t) for t in ts):\n  651 +             errs.append((path, \"type\"))\n  652 +     for sub in sch.get(\"allOf\") or []:\n  653 +         errs += _validate(inst, sub, root, path)\n  654 +     if \"anyOf\" in sch:\n  655 +         if not any(not _validate(inst, sub, root, path) for sub in sch[\"anyOf\"]):\n  656 +             errs.append((path, \"anyOf\"))\n  657 +     if \"oneOf\" in sch:\n  658 +         ok = sum(1 for sub in sch[\"oneOf\"] if not _validate(inst, sub, root, path))\n  659 +         if ok != 1:\n  660 +             errs.append((path, \"oneOf\"))\n  661 +     if isinstance(inst, dict):\n  662 +         for r in sch.get(\"required\") or []:\n  663 +             if r not in inst:\n  664 +                 errs.append((path + \".\" + r, \"required\"))\n  665 +         props = sch.get(\"properties\") or {}\n  666 +         for k, v in inst.items():\n  667 +             if k in props:\n  668 +                 errs += _validate(v, props[k], root, path + \".\" + k)\n  669 +             else:\n  670 +                 ap = sch.get(\"additionalProperties\", True)\n  671 +                 if ap is False:\n  672 +                     errs.append((path + \".\" + k, \"additionalProperties\"))\n  673 +                 elif isinstance(ap, dict):\n  674 +                     errs += _validate(v, ap, root, path + \".\" + k)\n  675 +     if isinstance(inst, list) and \"items\" in sch:\n  676 +         for i, v in enumerate(inst):\n  677 +             errs += _validate(v, sch[\"items\"], root, f\"{path}[{i}]\")\n  678 +     if isinstance(inst, str):\n  679 +         if \"minLength\" in sch and len(inst) < sch[\"minLength\"]:\n  680 +             errs.append((path, \"minLength\"))\n  681 +         if \"pattern\" in sch and not re.search(sch[\"pattern\"], inst):\n  682 +             errs.append((path, \"pattern\"))\n  683 +     if isinstance(inst, (int, float)) and not isinstance(inst, bool):\n  684 +         if \"minimum\" in sch and inst < sch[\"minimum\"]:\n  685 +             errs.append((path, \"minimum\"))\n  686 +         if \"maximum\" in sch and inst > sch[\"maximum\"]:\n  687 +             errs.append((path, \"maximum\"))\n  688 +     return errs\n  689 + \n  690 + \n  691 + def iter_xplumbline(obj, path: str = \"\"):\n  692 +     if isinstance(obj, dict):\n  693 +         for k, v in obj.items():\n  694 +             p = f\"{path}.{k}\" if path else k\n  695 +             if k == \"x-plumbline\":\n  696 +                 yield p, v\n  697 +             else:\n  698 +                 yield from iter_xplumbline(v, p)\n  699 +     elif isinstance(obj, list):\n  700 +         for i, v in enumerate(obj):\n  701 +             yield from iter_xplumbline(v, f\"{path}[{i}]\")\n  702 + \n  703 + \n  704 + def check_schema(record: dict, schema_path: Path, record_path: Path | None = None) -> list[dict]:\n  705 +     fails: list[dict] = []\n  706 +     rp = str(record_path) if record_path is not None else \"<record>\"\n  707 +     if not Path(schema_path).is_file():\n  708 +         return [{\"kind\": \"schema\", \"field\": \"schema file\", \"file\": str(schema_path), \"line\": 0}]\n  709 +     try:\n  710 +         schema = load(schema_path)\n  711 +     except Exception:\n  712 +         return [{\"kind\": \"schema\", \"field\": \"schema file\", \"file\": str(schema_path), \"line\": 0}]\n  713 +     for p, _ in _validate(record, schema, schema, \"$\"):\n  714 +   