refused once the seat's harness log records a call. The emitter refuses the record if any call was served\n   37   by, or also tried at, another provider, if the log does not say who served a call, or if the pin was declared\n      - after the first call. Stdlib only.\n   38 + after the first call.\n   39 + \n   40 + `generation`, `evaluation`, `amendment`, `relay` and `spend` record the batch's own events as they happen, so the\n   41 + emitter can carry them into `x-plumbline.generations[]`, `evaluations[]`, `amendments[]`, `relays[]` and `spend`\n   42 + (F1a-F1h). `dispose --decided-at` bounds the Owner's decision between the last logged check and the tool's clock\n   43 + (F1b). Stdlib only.\n   44   \"\"\"\n   45   from __future__ import annotations\n   46   import argparse, json, sys\n   47   from datetime import datetime, timezone\n   48   from hashlib import sha256\n   49   from pathlib import Path\n   50   \n   51   sys.path.insert(0, str(Path(__file__).resolve().parent))\n   52   import custody_history as H          # noqa: E402\n   53   \n   54   \n   55   def now() -> str:\n   56       return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n   57   \n   58   \n   59 + def writer_stamp() -> str:\n   60 +     \"\"\"`kit/custody_ledger.py@<sha12>` for the file that is running (T1).\"\"\"\n   61 +     try:\n   62 +         d = sha256(Path(__file__).resolve().read_bytes()).hexdigest()[:12]\n   63 +     except OSError:\n   64 +         d = \"0\" * 12\n   65 +     return f\"kit/custody_ledger.py@{d}\"\n   66 + \n   67 + \n   68 + def relpath(job: Path, p: Path) -> str:\n   69 +     \"\"\"A path relative to the job dir when inside it, else absolute (INTERFACE section 1).\"\"\"\n   70 +     try:\n   71 +         return p.resolve().relative_to(job.resolve()).as_posix()\n   72 +     except ValueError:\n   73 +         return str(p.resolve())\n   74 + \n   75 + \n   76 + def read_events(job: Path) -> list[dict]:\n   77 +     p = job / \"inputs\" / \"custody-events.jsonl\"\n   78 +     if not p.is_file():\n   79 +         return []\n   80 +     out = []\n   81 +     for line in p.read_text(encoding=\"utf-8\").splitlines():\n   82 +         if line.strip():\n   83 +             try:\n   84 +                 ev = json.loads(line)\n   85 +             except ValueError:\n   86 +                 continue\n   87 +             if isinstance(ev, dict):\n   88 +                 out.append(ev)\n   89 +     return out\n   90 + \n   91 + \n   92   def seat_logs(job: Path, ci: dict, seat: str) -> list[Path]:\n   93       \"\"\"Harness logs that may already hold this seat's calls (named in the inputs, or by the usual file names).\"\"\"\n   94       ev = job / ci.get(\"evidence_dir\", \"custody/evidence\")\n   95       if seat == \"maker\":\n   96           named, pat = (ci.get(\"maker\") or {}).get(\"harness_log\"), \"harness-maker*.log\"\n   97       else:\n   98           e = next((x for x in ci.get(\"evaluators\") or [] if str(x.get(\"id\")) == seat), {})\n   99           named = e.get(\"harness_log\") or next((x.get(\"evidence_file\") for x in ci.get(\"external\") or []\n  100                                                 if x.get(\"subject\") == seat), None)\n  101           pat = f\"harness-{seat}*.log\"\n  102       out = [b / named for b in (ev, job) if named and (b / named).is_file()]\n  103       out += sorted(ev.glob(pat)) if ev.is_dir() else []\n  104       return list(dict.fromkeys(out))\n  105   \n  106   \n  107 + def last_check_time(job: Path, ci: dict) -> datetime | None:\n  108 +     \"\"\"The latest logged check: evaluator `received_at`, `evaluation` line times, instrument `finished_at` (F1b).\"\"\"\n  109 +     times = []\n  110 +     for ev in read_events(job):\n  111 +         if ev.get(\"event\") == \"evaluation\":\n  112 +             for k in (\"started_at\", \"finished_at\", \"at\"):\n  113 +                 d = H.parse_ts(ev.get(k))\n  114 +                 if d:\n  115 +                     times.a