\", encoding=\"utf-8\")\n      -     except OSError:\n      -         return False\n      -     return True\n  250 +     \"\"\"Deprecated: the emitter never writes its inputs (T7).\n  251 + \n  252 +     Kept as a no-op so a caller that still imports it cannot dirty a harness log. The emitter reads a call\n  253 +     with no logger `sent_at`/`received_at` as a hand time and either refuses it or lists it under\n  254 +     `--allow-hand-times`; see `Call.hand_time_entries()`.\"\"\"\n  255 +     return False\n  256   \n  257   \n  258   def norm(v) -> str:\n  259       return re.sub(r\"[^a-z0-9]\", \"\", str(v or \"\").lower())\n  260   \n  261   \n  262   def generation_names(raw: dict) -> tuple[dict, list]:\n  263       \"\"\"({source: provider that served}, [providers tried]) as the /api/v1/generation reply alone states them.\"\"\"\n=== FILE kit/custody_ledger.py (line numbers are the revision's) ===\n...\n    2   \"\"\"Log a job's custody events WHEN THEY HAPPEN, so no time in the custody record is typed from memory.\n    3   \n    4   The emitter (kit/emit_custody.py) reads model-call times from harness logs. Three events have no harness log:\n    5   the bar's freeze, each approval of the bar, and the Owner's disposition. This tool stamps each with the clock at\n    6   the moment it is run, writes it into inputs/custody.json, and appends it to inputs/custody-events.jsonl. The\n    7   emitter then refuses a ledger value that differs from the logged one, and refuses the bar if it changed after the\n    8   freeze. Run it at the moment the thing happens, not afterwards: a late stamp is a wrong time.\n    9   \n   10 + Every line this tool appends carries `writer: \"kit/custody_ledger.py@<sha12>\"` (the sha256 of the file that ran)\n   11 + and `at` (the tool's clock), so a reader can tell a tool stamp from a hand-typed one (T1).\n   12 + \n   13       custody_ledger.py freeze  --job-dir J [--bar custody/bar.md] [--orchestrator \"Agent name\" [--orchestrator-alia