\")\n  336       k.add_argument(\"--expect-revision\", help=\"the emitter revision (commit or tree) the record must be written by\")\n  337 +     k.add_argument(\"--allow-hand-times\", action=\"store_true\",\n  338 +                    help=\"pass the hand-time allowance to the emitter; the verifier still enforces the flags\")\n  339 +     k.add_argument(\"--custody\", help=\"the custody checker checkout (default: $PLUMBLINE_CUSTODY)\")\n  340       a = ap.parse_args()\n  341       return {\"open\": do_open, \"close\": do_close, \"custody\": do_custody}[a.cmd](a)\n  342   \n  343   \n  344   if __name__ == \"__main__\":\n  345       sys.exit(main())\n=== FILE kit/plumbline_verify.py (line numbers are the revision's) ===\n...\n    1 + #!/usr/bin/env python3\n    2 + \"\"\"Verify a custody/v1 record at two layers: the standard checker, then x-plumbline.\n    3 + \n    4 + The standard layer is `checker/check.py` from the pinned custody checkout. It knows nothing about `x-` keys\n    5 + (SPEC.md line 141): it reads the custody/v1 predicate and ignores every extension. The Plumbline layer is this\n    6 + file: it runs the standard checker FIRST, then enforces the `x-plumbline` block the emitter writes.\n    7 + \n    8 +     plumbline_verify.py --record R --files F --evidence E --ledger L --custody <checkout> [--json OUT]\n    9 + \n   10 + There is no switch that relaxes a check. The hand-time allowance is read from the record, never from the command\n   11 + line. Exit codes:\n   12 +   0  OK at both layers\n   13 +   3  the standard layer failed (kind `standard`; nothing else is checked)\n   14 +   4  the standard layer passed and a Plumbline check failed\n   15 +   2  cannot run (usage, a missing input, or a checker whose sha256 is not the pin)\n   16 + \n   17 + Every failure prints one line: `FAIL <kind> <field> <file>:<line>`. Kinds: standard, schema, allowance,\n   18 + hand-time-unflagged, flag-without-source, events, relay-as-approval, spend, shadow.\n   19 + \n   20 + This file must not import kit/emit_custody.py: the emitter's logic is checked by separate code (V7). It may use\n   21 + kit/custody_history.py to parse harness logs.\n   22 + \"\"\"\n   23 + from __future__ import annotations\n   24 + \n   25 + import argparse\n   26 + import json\n   27 + import math\n   28 + import re\n   29 + import subprocess\n   30 + import sys\n   31 + from hashlib import sha256\n   32 + from pathlib import Path\n   33 + \n   34 + HERE = Path(__file__).resolve().parent\n   35 + REPO = HERE.parent\n   36 + sys.path.insert(0, str(HERE))\n   37 + import custody_history as H  # noqa: E402\n   38 + \n   39 + SCHEMA_VERSION = \"plumbline/x-plumbline/v1\"\n   40 + SCHEMA_PATH = REPO / \"schemas\" / \"x-plumbline\" / \"x-plumbline-v1.schema.json\"\n   41 + SPEND_TOL = 0.0001\n   42 + LEDGER_REL = \"inputs/custody-events.jsonl\"\n   43 + OWNED = (\"verdict\", \"gaps\", \"times\", \"time_tolerance_s\", \"hand_times\", \"allowances\",\n   44 +          \"generations\", \"evaluations\", \"relays\", \"amendments\", \"spend\", \"schema\")\n   45 + \n   46 + \n   47 + def file_sha(p: Path) -> str:\n   48 +     return sha256(Path(p).read_bytes()).hexdigest()\n   49 + \n   50 + \n   51 + def load(p: Path):\n   52 +     return json.loads(Path(p).read_text(encoding=\"utf-8\"))\n   53 + \n   54 + \n   55 + def relpath(job: Path, p: Path) -> str:\n   56 +     try:\n   57 +         return Path(p).resolve().relative_to(Path(job).resolve()).as_posix()\n   58 +     except ValueError:\n   59 +         return str(Path(p).resolve())\n   60 + \n   61 + \n   62 + def ledger_lines(p: Path) -> list[tuple[int, dict]]:\n   63 +     out: list[tuple[int, dict]] = []\n   64 +     if not Path(p).is_file():\n   65 +         return out\n   66 +     for n, ln in enumerate(Path(p).read_text(encoding=\"utf-8\").splitlines(), 1):\n   67 +         if not ln.strip():\n   68 +             continue\n   69 +         try:\n   70 +             e = json.loads(ln)\n   71 +         except ValueError:\n   72 +             continue\n   73 +         if isinstance(e, dict):\n   74 +             e[\"_line\"] = n\n   75 +             out.append((n, e))\n   76 +     return out\n   77 + \n   78 + \n   79 + def writer_source(e: dict):\n   80 +     w = e.get(\"writer\")\n   81 +     if w == \"hand\":\n   82 +         return \"ledger-hand\"\n   83 +     if w in (None, \"\"):\n   84 +         return \"ledger-no-writer\"\n   85 +     return None\n   86 + \n   87 + \n   88 + def line_of(path: Path, value, key: str | None = None):\n   89 +     if value in (None, \"\") or not Path(path).is_file():\n   90 +         return None\n   91 +     try:\n   92 +         lines = Path(path).read_text(encoding=\"utf-8\").splitlines()\n   93 +     except OSError:\n   94 +         return None\n   95 +     vs = str(value)\n   96 +     hits = [n for n, ln in enumerate(lines, 1) if vs in ln and (key is None or f'\"{key}\"' in ln)]\n   97 +     if not hits:\n   98 +         hits = [n for n, ln in enumerate(lines, 1) if vs in ln]\n   99 +     return hits[0] if hits else None\n  100 + \n  101 + \n  102 + def used_seats(ci: dict) -> set[str]:\n  103 +     seats: set[str] = set()\n  104 +     m = ci.get(\"maker\") or {}\n  105 +     if m.get(\"kind\") == \"model\":\n  106 +         seats.add(\"maker\")\n  107 +     for e in ci.get(\"evaluators\") or []:\n  108 +         if e.get(\"kind\") == \"model\":\n  109 +             seats.add(str(e.get(\"id\")))\n  110 +     return seats\n  111 + \n  112 + \n  113 + def find_log(job: Path, ev_dir: Path, rel: str | None, pattern: str | None):\n  114 +     if rel:\n  115 +         for base in (ev_dir, job):\n  116 +             p = Path(base) / rel\n  117 +             if p.is_file():\n  118 +                 return p\n  119 +         return None\n  120 +     hits = sorted(Path(ev_dir).glob(pattern)) if pattern and Path(ev_dir).is_dir() else []\n  121 +     return hits[0] if len(hits) == 1 else None\n  122 + \n  123 + \n  124 + def read_calls(job: Path, ev_dir: Path, ci: dict):\n  125 +     by: dict[str, dict] = {}\n  126 +     allc: list = []\n  127 + \n  128 +     def add(seat: str, log):\n  129 +         if not log:\n  130 +             return\n  131 +         try:\n  132 +             calls = H.read_log(Path(log), H.Refusals(), str(seat))\n  133 +         except Exception:\n  134 +             return\n  135 +         d = by.setdefault(str(seat), {})\n  136 +         for c in calls:\n  137 +             name = getattr(c, \"name\", None) or str(getattr(c, \"i\", \"\"))\n  138 +             d[name] = c\n  139 +             allc.append(c)\n  140 + \n  141 +     if isinstance(ci, dict):\n  142 +         m = ci.get(\"maker\") or {}\n  143 +         if m.get(\"kind\") == \"model\":\n  144 +             add(\"maker\", find_log(job, ev_dir, m.get(\"harness_log\"), \"harness-maker*.log\"))\n  145 +         for e in ci.get(\"evaluators\") or []:\n  146 +             if e.get(\"kind\") == \"model\":\n  147 +                 rel = e.get(\"harness_log\") or next(\n  148 +                     (x.get(\"evidence_file\") for x in ci.get(\"external\") or []\n  149 +                      if x.get(\"subject\") == e.get(\"id\")), None)\n  150 +                 add(str(e.get(\"id\")), find_log(job, ev_dir, rel, None))\n  151 +     if not allc and Path(ev_dir).is_dir():\n  152 +         for log in sorted(Path(ev_dir).glob(\"*.log\")):\n  153 +             add(log.stem, log)\n  154 +     return by, allc\n  155 + \n  156 + \n  157 + def call_cost(c) -> float:\n  158 +     raw = getattr(c, \"raw\", None)\n  159 +     if not isinstance(raw, dict):\n  160 +         return 0.0\n  161 +     resp = raw.get(\"response\") if isinstance(raw.get(\"response\"), dict) else {}\n  162 +     usage = resp.get(\"usage\") if isinstance(resp.get(\"usage\"), dict) else {}\n  163 +     for v in (raw.get(\"total_cost\"), resp.get(\"total_cost\"), usage.get(\"total_cost\"), usage.get(\"cost\")):\n  164 +         if isinstance(v, (int, float)) and not isinstance(v, bool):\n  165 +             return float(v)\n  166 +     return 0.0\n  167 + \n  168 + \n  169 + def call_time(c):\n  170 +     return getattr(c, \"started\", None) or getattr(c, \"at\", None)\n  171 + \n  172 + \n  173 + def ledger_array(lines: list[tuple[int, dict]], event: str, ledger_rel: str) -> list[dict]:\n  174 +     return [{**{k: v for k, v in e.items() if k != \"_line\"},\n  175 +              \"source\": f\"{ledger_rel}:{e['_line']}\"}\n  176 +             for _, e in lines if e.get(\"event\") == event]\n  177 + \n  178 + \n  179 + def last_spend_line(lines: list[tuple[int, dict]]):\n  180 +     sp = None\n  181 +     for _, e in lines:\n  182 +         if e.get(\"event\") == \"spend\":\n  183 +             sp = e\n  184 +     return sp\n  185 + \n  186 + \n  187 + def compute_spend_block(lines: list[tuple[int, dict]], all_calls, ledger_rel: str) -> dict:\n  188 +     sp = last_spend_line(lines)\n  189 +     calls_sum = round(sum(call_cost(c) for c in all_calls if getattr(c, \"at\", None)), 6)\n  190 +     key_delta = float(sp.get(\"key_delta_usd\") or 0) if sp else 0.0\n  191 +     return {\"calls_sum_usd\": calls_sum,\n  192 +             \"key_delta_usd\": key_delta,\n  193 +             \"total_usd\": max(calls_sum, key_delta),\n  194 +             \"tolerance_usd\": SPEND_TOL,\n  195 +             \"source\": f\"{ledger_rel}:{sp['_line']}\" if sp else None}\n  196 + \n  197 + \n  198 + def hand_key(e: dict):\n  199 +     try:\n  200 +         line = int(e.get(\"line\")) if e.get(\"line\") is not None else None\n  201 +     except (TypeError, ValueError):\n  202 +         line = None\n  203 +     return (e.get(\"field\"), e.get(\"file\"), line, e.get(\"source\"))\n  204 + \n  205 + \n  206 + def hand_time_set(job: Path, ledger_path: Path, custody_path: Path, record: dict, evidence: Path) -> list[dict]:\n  207 +     ci = load(custody_path) if Path(custody_path).is_file() else {}\n  208 +     lines = ledger_lines(ledger_path)\n  209 +     ledger_rel = relpath(job, ledger_path)\n  210 +     try:\n  211 +         inputs_rel = relpath(job, custody_path)\n  212 +     except Exception:\n  213 +         inputs_rel = str(custody_path)\n  214 +     seats = used_seats(ci)\n  215 +     calls_by_seat, _ = read_calls(job, evidence, ci)\n  216 +     hand: dict[str, dict] = {}\n  217 +     seen: set = set()\n  218 + \n  219 +     def mark(field: str, file: str, line, source: str) -> None:\n  220 +         hand[field] = {\"field\": field, \"file\": file, \"line\": line, \"source\": source}\n  221 + \n  222 +     for n, e in lines:\n  223 +         src = writer_source(e)\n  224 +         ev = e.get(\"event\")\n  225 +         field = None\n  226 +         if ev == \"freeze\":\n  227 +             seen.add(\"freeze\")\n  228 +             field = \"bar.frozenAt\"\n  229 +         elif ev == \"approve\":\n  230 +             role = e.get(\"role\")\n  231 +             seen.add((\"approve\", role))\n  232 +             for i, a in enumerate((ci.get(\"bar\") or {}).get(\"approvals\") or []):\n  233 +                 if a.get(\"role\") == role:\n  234 +                     f = f\"bar.approvals[{i}].at\"\n  235 +                     if src:\n  236 +                         mark(f, ledger_rel, n, src)\n  237 +                     else:\n  238 +                         hand.pop(f, None)\n  239 +             continue\n  240 +         elif ev == \"dispose\":\n  241 +             seen.add(\"dispose\")\n  242 +             field = \"disposition.at\"\n  243 +         elif ev == \"pin\":\n  244 +             seat = e.get(\"seat\")\n  245 +             seen.add((\"pin\", seat))\n  246 +             if seat in seats:\n  247 +                 field = f\"routing.{seat}.declaredAt\"\n  248 +         else:\n  249 +             continue\n  250 +         if field:\n  251 +             if src:\n  252 +                 mark(field, ledger_rel, n, src)\n  253 +             else:\n  254 +                 hand.pop(field, None)\n  255 + \n  256 +     bar = ci.get(\"bar\") or {}\n  257 +     if \"freeze\" not in seen and bar.get(\"frozenAt\"):\n  258 +         mark(\"bar.frozenAt\", inputs_rel, line_of(custody_path, bar.get(\"frozenAt\"), \"frozenAt\"),\n  259 +              \"inputs-no-ledger\")\n  260 +     for i, a in enumerate(bar.get(\"approvals\") or []):\n  261 +         if (\"approve\", a.get(\"role\")) not in seen and a.get(\"at\"):\n  262 +             mark(f\"bar.approvals[{i}].at\", inputs_rel, line_of(custody_path, a.get(\"at\"), \"at\"),\n  263 +                  \"inputs-no-ledger\")\n  264 +     for seat in seats:\n  265 +         if (\"pin\", seat) not in seen:\n  266 +             pin = (ci.get(\"routing\") or {}).get(seat) or {}\n  267 +             if pin.get(\"declaredAt\"):\n  268 +                 mark(f\"routing.{seat}.declaredAt\", inputs_rel,\n  269 +                      line_of(custody_path, pin.get(\"declaredAt\"), \"declaredAt\"), \"inputs-no-ledger\")\n  270 +     if \"dispose\" not in seen:\n  271 +         d = ci.get(\"disposition\") or {}\n  272 +         if d.get(\"at\"):\n  273 +             mark(\"disposition.at\", inputs_rel, line_of(custody_path, d.get(\"at\"), \"at\"), \"inputs-no-ledger\")\n  274 + \n  275 +     mcalls = calls_by_seat.get(\"maker\") or {}\n  276 +     if not mcalls:\n  277 +         if ci.get(\"startedAt\"):\n  278 +             mark(\"startedAt\", inputs_rel, line_of(custody_path, ci.get(\"startedAt\"), \"startedAt\"),\n  279 +                  \"inputs-no-ledger\")\n  280 +         if ci.get(\"producedAt\"):\n  281 +             mark(\"producedAt\", inputs_rel, line_of(custody_path, ci.get(\"producedAt\"), \"producedAt\"),\n  282 +                  \"inputs-no-ledger\")\n  283 + \n  284 +     for pid, f in (ci.get(\"passes\") or {}).items():\n  285 +         if not isinstance(f, dict) or not f.get(\"at\"):\n  286 +             continue\n  287 +         calls = calls_by_seat.get(str(f.get(\"evaluator\"))) or {}\n  288 +         linked = (f.get(\"call\") in calls) if f.get(\"call\") else len(calls) == 1\n  289 +         if not linked:\n  290 +             mark(f\"passes.{pid}.at\", inputs_rel, line_of(custody_path, f.get(\"at\"), \"at\"),\n  291 +                  \"inputs-no-ledger\")\n  292 + \n  293 +     for k in ci.get(\"controls\") or []:\n  294 +         if not k.get(\"at\"):\n  295 +             continue\n  296 +         calls = calls_by_seat.get(str(k.get(\"evaluator\"))) or {}\n  297 +         linked = (k.get(\"call\") in calls) if k.get(\"call\") else len(calls) == 1\n  298 +         if not linked:\n  299 +             mark(f\"controls[{k.get('id')}].at\", inputs_rel, line_of(custody_path, k.get(\"at\"), \"at\"),\n  300 +                  \"inputs-no-ledger\")\n  301 + \n  302 +     logs = []\n  303 +     if Path(evidence).is_dir():\n  304 +         logs += sorted(Path(evidence).glob(\"*.log\"))\n  305 +     if Path(job).is_dir():\n  306 +         logs += sorted(Path(job).glob(\"*.log\"))\n  307 +     for log in dict.fromkeys(logs):\n  308 +         try:\n  309 +             calls = H.read_log(Path(log), H.Refusals(), \"verify\")\n  310 +         except Exception:\n  311 +             continue\n  312 +         for c in calls:\n  313 +             try:\n  314 +                 entries = c.hand_time_entries()\n  315 +             except Exception:\n  316 +                 entries = []\n  317 +             for e in entries:\n  318 +                 if isinstance(e, dict) and e.get(\"field\"):\n  319 +                     hand[str(e[\"field\"])] = e\n  320 +     return [hand[k] for k in sorted(hand)]\n  321 + \n  322 + \n  323 + def check_hand_times(hand: list[dict], record: dict) -> list[dict]:\n  324 +     fails: list[dict] = []\n  325 +     xp = (record.get(\"predicate\") or {}).get(\"x-plumbline\") if isinstance(record, dict) else None\n  326 +     if not isinstance(xp, dict):\n  327 +         return fails\n  328 +     flags = xp.get(\"hand_times\")\n  329 +     if not isinstance(flags, list):\n  330 +         return fails\n  331 +     recomp = {hand_key(e) for e in hand if isinstance(e, dict)}\n  332 +     got = {hand_key(e) for e in flags if isinstance(e, dict)}\n  333 +     for k in sorted(recomp - got):\n  334 +         fails.append({\"kind\": \"hand-time-unflagged\", \"field\": k[0], \"file\": k[1], \"line\": k[2]})\n  335 +     for k in sorted(got - recomp):\n  336 +         fails.append({\"kind\": \"flag-without-source\", \"field\": k[0], \"file\": k[1], \"line\": k[2]})\n  337 +     if recomp:\n  338 +         allowance = (xp.get(\"allowances\") or {}).get(\"hand_times\")\n  339 +         if not isinstance(allowance, dict):\n  340 +             fails.append({\"kind\": \"allowance\", \"field\": \"x-plumbline.allowances.hand_times\",\n  341 +                           \"file\": \"\", \"line\": 0})\n  342 +         else:\n  343 +             if allowance.get(\"switch\") != \"--allow-hand-times\":\n  344 +                 fails.append({\"kind\": \"allowance\", \"field\": \"x-plumbline.allowances.hand_times.switch\",\n  345 +                               \"file\": \"\", \"line\": 0})\n  346 +             if not str(allowance.get(\"writer\", \"\")).startswith(\"kit/emit_custody.py@\"):\n  347 +                 fails.append({\"kind\": \"allowance\", \"field\": \"x-plumbline.allowances.hand_times.writer\",\n  348 +                               \"file\": \"\", \"line\": 0})\n  349 +             if not H.parse_ts(allowance.get(\"at\")):\n  350 +                 fails.append({\"kind\": \"allowance\", \"field\": \"x-plumbline.allowances.hand_times.at\",\n  351 +                               \"file\": \"\", \"line\": 0})\n  352 +     return fails\n  353 + \n  354 + \n  355 + def check_events(job: Path, ledger_path: Path, record: dict, calls_by_seat: dict) -> list[dict]:\n  356 +     fails: list[dict] = []\n  357 +     xp = (record.get(\"predicate\") or {}).get(\"x-plumbline\") if isinstance(record, dict) else None\n  358 +     if not isinstance(xp, dict):\n  359 +         return fails\n  360 +     lines = ledger_lines(ledger_path)\n  361 +     ledger_rel = relpath(job, ledger_path)\n  362 +     for ev, key in ((\"generation\", \"generations\"), (\"evaluation\", \"evaluations\"),\n  363 +                     (\"relay\", \"relays\"), (\"amendment\", \"amendments\")):\n  364 +         expected = ledger_array(lines, ev, ledger_rel)\n  365 +         got = xp.get(key)\n  366 +         if got != expected:\n  367 +             fails.append({\"kind\": \"events\", \"field\": f\"x-plumbline.{key}\", \"file\": str(ledger_path), \"line\": 0})\n  368 + \n  369 +     for _, e in lines:\n  370 +         if e.get(\"event\") != \"evaluation\":\n  371 +             continue\n  372 +         vf = e.get(\"verdict_file\")\n  373 +         want = e.get(\"verdict_sha256\")\n  374 +         if not vf:\n  375 +             continue\n  376 +         p = Path(vf) if Path(vf).is_absolute() else Path(job) / vf\n  377 +         if not p.is_file() or file_sha(p) != want:\n  378 +             fails.append({\"kind\": \"events\", \"field\": f\"evaluations[{e.get('batch')}].verdict_sha256\",\n  379 +                           \"file\": vf, \"line\": e.get(\"_line\", 0)})\n  380 + \n  381 +     opens: dict = {}\n  382 +     closes: dict = {}\n  383 +     for _, e in lines:\n  384 +         if e.get(\"event\") != \"generation\":\n  385 +             continue\n  386 +         k = (e.get(\"seat\"), e.get(\"n\"))\n  387 +         if e.get(\"action\") == \"open\":\n  388 +             opens[k] = e\n  389 +         elif e.get(\"action\") == \"close\":\n  390 +             closes[k] = e\n  391 +     maker_calls = list((calls_by_seat.get(\"maker\") or {}).values())\n  392 +     for k, o in opens.items():\n  393 +         c = closes.get(k)\n  394 +         if not c:\n  395 +             fails.append({\"kind\": \"events\", \"field\": f\"generations[{k[0]}#{k[1]}].close\",\n  396 +                           \"file\": str(ledger_path), \"line\": o.get(\"_line\", 0)})\n  397 +             continue\n  398 +         t0, t1 = H.parse_ts(o.get(\"at\")), H.parse_ts(c.get(\"at\"))\n  399 +         if t0 and t1:\n  400 +             found = any(call_time(x) and t0 <= call_time(x) <= t1 for x in maker_calls)\n  401 +             if not found:\n  402 +                 fails.append({\"kind\": \"events\", \"field\": f\"generations[{k[0]}#{k[1]}].calls\",\n  403 +                               \"file\": str(ledger_path), \"line\": o.get(\"_line\", 0)})\n  404 + \n  405 +     relays = [e for _, e in lines if e.get(\"event\") == \"relay\"]\n  406 +     approvals = ((record.get(\"predicate\") or {}).get(\"bar\") or {}).get(\"approvals\") or []\n  407 +     for r in relays:\n  408 +         for a in approvals:\n  409 +             if (a.get(\"kind\") == \"relay\" or a.get(\"relay\") or a.get(\"role\") == \"relay\"\n  410 +                     or a.get(\"by\") == r.get(\"from\") or a.get(\"quote\") == r.get(\"quote\")):\n  411 +                 fails.append({\"kind\": \"relay-as-approval\", \"field\": \"predicate.bar.approvals\",\n  412 +                               \"file\": str(ledger_path), \"line\": r.get(\"_line\", 0)})\n  413 +                 break\n  414 +     return fails\n  415 + \n  416 + \n  417 + def check_spend(job: Path, ledger_path: Path, record: dict, all_calls) -> list[dict]:\n  418 +     fails: list[dict] = []\n  419 +     xp = (record.get(\"predicate\") or {}).get(\"x-plumbline\") if isinstance(record, dict) else None\n  420 +     if not isinstance(xp, dict):\n  421 +         return fails\n  422 +     lines = ledger_lines(ledger_path)\n  423 +     ledger_rel = relpath(job, ledger_path)\n  424 +     expected = compute_spend_block(lines, all_calls, ledger_rel)\n  425 +     sp = xp.get(\"spend\")\n  426 +     if not isinstance(sp, dict):\n  427 +         return [{\"kind\": \"spend\", \"field\": \"x-plumbline.spend\", \"file\": str(ledger_path), \"line\": 0}]\n  428 +     for k in (\"calls_sum_usd\", \"key_delta_usd\", \"total_usd\", \"tolerance_usd\"):\n  429 +         if k not in sp:\n  430 +             fails.append({\"kind\": \"spend\", \"field\": f\"x-plumbline.spend.{k}\", \"file\": str(ledger_path), \"line\": 0})\n  431 +     calls_sum = float(sp.get(\"calls_sum_usd\") or 0)\n  432 +     key_delta = float(sp.get(\"key_delta_usd\") or 0)\n  433 +     total = float(sp.get(\"total_usd\") or 0)\n  434 +     tol = float(sp.get(\"tolerance_usd\") or 0)\n  435 +     if abs(calls_sum - expected[\"calls_sum_usd\"]) > SPEND_TOL:\n  436 +         fails.append({\"kind\": \"spend\", \"field\": \"x-plumbline.spend.calls_sum_usd\",\n  437 +                       \"file\": str(ledger_path), \"line\": 0})\n  438 +     if abs(key_delta - expected[\"key_delta_usd\"]) > 1e-9:\n  439 +         fails.append({\"kind\": \"spend\", \"field\": \"x-plumbline.spend.key_delta_usd\",\n  440 +                       \"file\": str(ledger_path), \"line\": 0})\n  441 +     if abs(total - max(calls_sum, key_delta)) > 1e-9:\n  442 +         fails.append({\"kind\": \"spend\", \"field\": \"x-plumbline.spend.total_usd\",\n  443 +                       \"file\": str(ledger_path), \"line\": 0})\n  444 +     if abs(tol - SPEND_TOL) > 1e-12:\n  445 +         fails.append({\"kind\": \"spend\", \"field\": \"x-plumbline.spend.tolerance_usd\",\n  446 +                       \"file\": str(ledger_path), \"line\": 0})\n  447 + \n  448 +     sp_line = last_spend_line(lines)\n  449 +     if sp_line:\n  450 +         lp = Path(sp_line.get(\"spend_ledger\") or \"\")\n  451 +         if not lp.is_absolute():\n  452 +             lp = Path(job) / lp\n  453 +         if not lp.is_file():\n  454 +             fails.append({\"kind\": \"spend\", \"field\": \"spend_ledger\", \"file\": str(lp), \"line\": sp_line.get(\"_line\", 0)})\n  455 +         else:\n  456 +             labels = {getattr(c, \"name\", None) or str(getattr(c, \"i\", \"\")) for c in all_calls}\n  457 +             for n, ln in enumerate(lp.read_text(encoding=\"utf-8\").splitlines(), 1):\n  458 +                 if not ln.strip():\n  459 +                     continue\n  460 +                 try:\n  461 +                     x = json.loads(ln)\n  462 +                 except ValueError:\n  463 +                     continue\n  464 +                 if x.get(\"event\") == \"settle\":\n  465 +                     call = x.get(\"call\") or x.get(\"id\")\n  466 +                     if call and call not in labels:\n  467 +                         fails.append({\"kind\": \"spend\", \"field\": f\"settle[{call}]\",\n  468 +                                       \"file\": str(lp), \"line\": n})\n  469 +         rp = Path(sp_line.get(\"key_reading\") or \"\")\n  470 +         if not rp.is_absolute():\n  471 +             rp = Path(job) / rp\n  472 +         if not rp.is_file():\n  473 +             fails.append({\"kind\": \"spend\", \"field\": \"key_reading\", \"file\": str(rp), \"line\": sp_line.get(\"_line\", 0)})\n  474 +         else:\n  475 +             try:\n  476 +                 r = load(rp)\n  477 +             except Exception:\n  478 +                 r = {}\n  479 +             if not r.get(\"read_at\") or not r.get(\"writer\"):\n  480 +                 fails.append({\"kind\": \"spend\", \"field\": \"key_reading.read_at\",\n  481 +                               \"file\": str(rp), \"line\": 0})\n  482 +             else:\n  483 +                 read_at = H.parse_ts(r.get(\"read_at\"))\n  484 +                 last = H.parse_ts(sp_line.get(\"last_settle_at\"))\n  485 +                 if read_at and last and (read_at - last).total_seconds() < 180:\n  486 +                     fails.append({\"kind\": \"spend\", \"field\": \"key_reading.read_at\",\n  487 +                                   \"file\": str(rp), \"line\": 0})\n  488 +                 if abs(float(r.get(\"key_delta_usd\") or 0) - key_delta) > 1e-6:\n  489 +                     fails.append({\"kind\": \"spend\", \"field\": \"key_reading.key_delta_usd\",\n  490 +                                   \"file\": str(rp), \"line\": 0})\n  491 +     elif expected[\"calls_sum_usd\"] > 0:\n  492 +         fails.append({\"kind\": \"spend\", \"field\": \"x-plumbline.spend.source\",\n  493 +                       \"file\": str(ledger_path), \"line\": 0})\n  494 +     return fails\n  495 + \n  496 + \n  497 + def check_shadow(job: Path, ledger_path: Path, record: dict, all_calls, hand: list[dict],\n  498 +                  calls_by_seat: dict) -> list[dict]:\n  499 +     fails: list[dict] = []\n  500 +     xp = (record.get(\"predicate\") or {}).get(\"x-plumbline\") if isinstance(record, dict) else None\n  501 +     if not isinstance(xp, dict):\n  502 +         return fails\n  503 +     inputs = xp.get(\"inputs\")\n  504 +     if not isinstance(inputs, dict):\n  505 +         inputs = {}\n  506 +     lines = ledger_lines(ledger_path)\n  507 +     ledger_rel = relpath(job, ledger_path)\n  508 +     derived: dict = {\n  509 +         \"schema\": SCHEMA_VERSION,\n  510 +         \"time_tolerance_s\": H.TOLERANCE_S,\n  511 +         \"hand_times\": hand,\n  512 +         \"generations\": ledger_array(lines, \"generation\", ledger_rel),\n  513 +         \"evaluations\": ledger_array(lines, \"evaluation\", ledger_rel),\n  514 +         \"relays\": ledger_array(lines, \"relay\", ledger_rel),\n  515 +         \"amendments\": ledger_array(lines, \"amendment\", ledger_rel),\n  516 +         \"spend\": compute_spend_block(lines, all_calls, ledger_rel),\n  517 +     }\n  518 +     s5 = xp.get(\"s5_record\") or {}\n  519 +     if s5.get(\"name\"):\n  520 +         p = Path(s5[\"name\"]) if Path(s5[\"name\"]).is_absolute() else Path(job) / s5[\"name\"]\n  521 +         if p.is_file():\n  522 +             try:\n  523 +                 rec = load(p)\n  524 +                 if \"verdict\" in rec:\n  525 +                     derived[\"verdict\"] = rec.get(\"verdict\")\n  526 +             except Exception:\n  527 +                 pass\n  528 +     mcalls = calls_by_seat.get(\"maker\") or {}\n  529 +     derived[\"times\"] = {\"startedAt\": \"harness log\" if mcalls else \"hand-entered\",\n  530 +                         \"producedAt\": \"harness log\" if mcalls else \"hand-entered\"}\n  531 + \n  532 +     for key in OWNED:\n  533 +         if key not in derived or key not in xp:\n  534 +             continue\n  535 +         if key == \"hand_times\":\n  536 +             if {hand_key(e) for e in xp.get(key) or [] if isinstance(e, dict)} != \\\n  537 +                     {hand_key(e) for e in derived[key] or [] if isinstance(e, dict)}:\n  538 +                 fails.append({\"kind\": \"shadow\", \"field\": f\"x-plumbline.{key}\",\n  539 +                               \"file\": str(ledger_path), \"line\": 0})\n  540 +         elif xp.get(key) != derived[key]:\n  541 +             fails.append({\"kind\": \"shadow\", \"field\": f\"x-plumbline.{key}\",\n  542 +                           \"file\": str(ledger_path), \"line\": 0})\n  543 +     for key in OWNED:\n  544 +         if key in inputs and key in xp and key in derived:\n  545 +             if xp.get(key) == inputs.get(key) and xp.get(key) != derived[key]:\n  546 +                 fails.append({\"kind\": \"shadow\", \"field\": f\"x-plumbline.inputs.{key}\",\n  547 +                               \"file\": str(ledger_path), \"line\": 0})\n  548 +     return fails\n  549 + \n  550 + \n  551 + def _type_ok(v, t: str) -> bool:\n  552 +     if t == \"object\":\n  553 +         return isinstance(v, dict)\n  554 +     if t == \"array\":\n  555 +         return isinstance(v, list)\n  556 +     if t == \"string\":\n  557 +         return isinstance(v, str)\n  558 +     if t == \"integer\":\n  559 +         return isinstance(v, int) and not isinstance(v, bool)\n  560 +     if t == \"number\":\n  561 +         return isinstance(v, (int, float)) and not isinstance(v, bool)\n  562 +     if t == \"boolean\":\n  563 +         return isinstance(v, bool)\n  564 +     if t == \"null\":\n  565 +         return v is None\n  566 +     return True\n  567 + \n  568 + \n  569 + def _validate(inst, sch, root, path: str) -> list[tuple[str, str]]:\n  570 +     errs: list[tuple[str, str]] = []\n  571 +     if sch is True or sch == {}:\n  572 +         return errs\n  573 +     if sch is False:\n  574 +         return [(path, \"false schema\")]\n  575 +     if \"$ref\" in sch:\n  576 +         ref = sch[\"$ref\"]\n  577 +         if isinstance(ref, str) and ref.startswith(\"#/$defs/\"):\n  578 +             name = ref.split(\"/\")[-1]\n  579 +             return _validate(inst, root[\"$defs\"][name], root, path)\n  580 +         return errs\n  581 +     if \"const\" in sch and inst != sch[\"const\"]:\n  582 +         errs.append((path, \"const\"))\n  583 +     if \"enum\" in sch and inst not in sch[\"enum\"]:\n  584 +         errs.append((path, \"enum\"))\n  585 +     if \"type\" in sch:\n  586 +         ts = sch[\"type\"] if isinstance(sch[\"type\"], list) else [sch[\"type\"]]\n  587 +         if not any(_type_ok(inst, t) for t in ts):\n  588 +             errs.append((path, \"type\"))\n  589 +     for sub in sch.get(\"allOf\") or []:\n  590 +         errs += _validate(inst, sub, root, path)\n  591 +     if \"anyOf\" in sch:\n  592 +         if not any(not _validate(inst, sub, root, path) for sub in sch[\"anyOf\"]):\n  593 +             errs.append((path, \"anyOf\"))\n  594 +     if \"oneOf\" in sch:\n  595 +         ok = sum(1 for sub in sch[\"oneOf\"] if not _validate(inst, sub, root, path))\n  596 +         if ok != 1:\n  597 +             errs.append((path, \"oneOf\"))\n  598 +     if isinstance(inst, dict):\n  599 +         for r in sch.get(\"required\") or []:\n  600 +             if r not in inst:\n  601 +                 errs.append((path + \".\" + r, \"required\"))\n  602 +         props = sch.get(\"properties\") or {}\n  603 +         for k, v in inst.items():\n  604 +             if k in props:\n  605 +                 errs += _validate(v, props[k], root, path + \".\" + k)\n  606 +             else:\n  607 +                 ap = sch.get(\"additionalProperties\", True)\n  608 +                 if ap is False:\n  609 +                     errs.append((path + \".\" + k, \"additionalProperties\"))\n  610 +                 elif isinstance(ap, dict):\n  611 +                     errs += _validate(v, ap, root, path + \".\" + k)\n  612 +     if isinstance(inst, list) and \"items\" in sch:\n  613 +         for i, v in enumerate(inst):\n  614 +             errs += _validate(v, sch[\"items\"], root, f\"{path}[{i}]\")\n  615 +     if isinstance(inst, str):\n  616 +         if \"minLength\" in sch and len(inst) < sch[\"minLength\"]:\n  617 +             errs.append((path, \"minLength\"))\n  618 +         if \"pattern\" in sch and not re.search(sch[\"pattern\"], inst):\n  619 +             errs.append((path, \"pattern\"))\n  620 +     if isinstance(inst, (int, float)) and not isinstance(inst, bool):\n  621 +         if \"minimum\" in sch and inst < sch[\"minimum\"]:\n  622 +             errs.append((path, \"minimum\"))\n  623 +         if \"maximum\" in sch and inst > sch[\"maximum\"]:\n  624 +             errs.append((path, \"maximum\"))\n  625 +     return errs\n  626 + \n  627 + \n  628 + def iter_xplumbline(obj, path: str = \"\"):\n  629 +     if isinstance(obj, dict):\n  630 +         for k, v in obj.items():\n  631 +             p = f\"{path}.{k}\" if path else k\n  632 +             if k == \"x-plumbline\":\n  633 +                 yield p, v\n  634 +             else:\n  635 +                 yield from iter_xplumbline(v, p)\n  636 +     elif isinstance(obj, list):\n  637 +         for i, v in enumerate(obj):\n  638 +             yield from iter_xplumbline(v, f\"{path}[{i}]\")\n  639 + \n  640 + \n  641 + def check_schema(record: dict, schema_path: Path) -> list[dict]:\n  642 +     fails: list[dict] = []\n  643 +     if not Path(schema_path).is_file():\n  644 +         return [{\"kind\": \"schema\", \"field\": \"schema file\", \"file\": str(schema_path), \"line\": 0}]\n  645 +     try:\n  646 +         schema = load(schema_path)\n  647 +     except Exception:\n  648 +         return [{\"kind\": \"schema\", \"field\": \"schema file\", \"file\": str(schema_path), \"line\": 0}]\n  649 +     for p, _ in _validate(record, schema, schema, \"$\"):\n  650 +         fails.append({\"kind\": \"schema\", \"field\": p, \"file\": str(schema_path), \"line\": 0})\n  651 +     xp = (record.get(\"predicate\") or {}).get(\"x-plumbline\") if isinstance(record, dict) else None\n  652 +     if not isinstance(xp, dict):\n  653 +         fails.append({\"kind\": \"schema\", \"field\": \"predicate.x-plumbline\", \"file\": \"\", \"line\": 0})\n  654 +         return fails\n  655 +     for p, _ in _validate(xp, schema[\"$defs\"][\"xPlumbline\"], schema, \"x-plumbline\"):\n  656 +         fails.append({\"kind\": \"schema\", \"field\": p, \"file\": str(schema_path), \"line\": 0})\n  657 +     if xp.get(\"schema\") != SCHEMA_VERSION:\n  658 +         fails.append({\"kind\": \"schema\", \"field\": \"x-plumbline.schema\", \"file\": \"\", \"line\": 0})\n  659 +     for p, val in iter_xplumbline(record):\n  660 +         if p == \"predicate.x-plumbline\":\n  661 +             continue\n  662 +         for q, _ in _validate(val, schema[\"$defs\"][\"xNested\"], schema, p):\n  663 +             fails.append({\"kind\": \"schema\", \"field\": q, \"file\": str(schema_path), \"line\": 0})\n  664 +     return fails\n  665 + \n  666 + \n  667 + def _strip_sha(v):\n  668 +     if isinstance(v, str):\n  669 +         v = v.strip()\n  670 +         if v.startswith(\"sha256:\"):\n  671 +             v = v[7:]\n  672 +         return v\n  673 +     return v\n  674 + \n  675 + \n  676 + def _is_pin(v) -> bool:\n  677 +     v = _strip_sha(v)\n  678 +     return isinstance(v, str) and re.fullmatch(r\"[0-9a-f]{64}\", v) is not None\n  679 + \n  680 + \n  681 + def _find_pin_in(obj, sha: str):\n  682 +     if isinstance(obj, dict):\n  683 +         for k, v in obj.items():\n  684 +             if isinstance(v, str):\n  685 +                 vv = _strip_sha(v)\n  686 +                 if vv == sha:\n  687 +                     return vv\n  688 +                 if vv.startswith(\"aaeb7e05\") and vv.endswith(\"bcd18\"):\n  689 +                     return vv\n  690 +                 if \"checker/check.py\" in str(k) and _is_pin(v):\n  691 +                     return vv\n  692 +             if isinstance(v, dict):\n  693 +                 path = str(v.get(\"path\") or v.get(\"file\") or \"\")\n  694 +                 if \"checker/check.py\" in path:\n  695 +                     for kk in (\"sha256\", \"digest\", \"hash\"):\n  696 +                         if _is_pin(v.get(kk)):\n  697 +                             return _strip_sha(v.get(kk))\n  698 +                 r = _find_pin_in(v, sha)\n  699 +                 if r:\n  700 +                     return r\n  701 +             if isinstance(v, list):\n  702 +                 r = _find_pin_in(v, sha)\n  703 +                 if r:\n  704 +                     return r\n  705 +     elif isinstance(obj, list):\n  706 +         for v in obj:\n  707 +             r = _find_pin_in(v, sha)\n  708 +             if r:\n  709 +                 return r\n  710 +     return None\n  711 + \n  712 + \n  713 + def find_pin(custody: Path, check: Path):\n  714 +     sha = file_sha(check)\n  715 +     for p in (Path(custody) / \"tools\" / \"pin.json\", REPO / \"tools\" / \"pin.json\"):\n  716 +         if not p.is_file():\n  717 +             continue\n  718 +         try:\n  719 +             doc = load(p)\n  720 +         except Exception:\n  721 +             continue\n  722 +         found = _find_pin_in(doc, sha)\n  723 +         if found:\n  724 +             return found\n  725 +     return None\n  726 + \n  727 + \n  728 + def standard_check(record: Path, custody: Path):\n  729 +     check = None\n  730 +     for rel in (\"checker/check.py\", \"check