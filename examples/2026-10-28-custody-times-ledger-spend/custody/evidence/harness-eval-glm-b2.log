job dir)\")\n  332       k = sub.add_parser(\"custody\", help=\"write the custody/v1 record of an ended job (no corpus needed)\")\n  333       k.add_argument(\"--job-dir\", required=True)\n  334       k.add_argument(\"--out-dir\", help=\"write <out-dir>/<job_id>.custody.json instead of <job>/custody/\")\n  335       k.add_argument(\"--inputs\", help=\"custody inputs (default: <job>/inputs/custody.json)\")\n  336       k.add_argument(\"--expect-revision\", help=\"the emitter revision (commit or tree) the record must be written by\")\n  337 +     k.add_argument(\"--allow-hand-times\", action=\"store_true\",\n  338 +                    help=\"pass the hand-time allowance to the emitter; the verifier still enforces the flags\")\n  339 +     k.add_argument(\"--custody\", help=\"the custody checker checkout (default: $PLUMBLINE_CUSTODY)\")\n  340       a = ap.parse_args()\n  341       return {\"open\": do_open, \"close\": do_close, \"custody\": do_custody}[a.cmd](a)\n  342   \n  343   \n  344   if __name__ == \"__main__\":\n  345       sys.exit(main())\n=== FILE kit/plumbline_verify.py (line numbers are the revision's) ===\n...\n    1 + #!/usr/bin/env python3\n    2 + \"\"\"Verify a custody/v1 record at two layers: the standard checker, then x-plumbline.\n    3 + \n    4 + The standard layer is `checker/check.py` from the pinned custody checkout. It knows nothing about `x-` keys\n    5 + (SPEC.md line 141): it reads the custody/v1 predicate and ignores every extension. The Plumbline layer is this\n    6 + file: it runs the standard checker FIRST, then enforces the `x-plumbline` block the record carries.\n    7 + \n    8 +     plumbline_verify.py --record R --files F --evidence E --ledger L --custody <checkout> [--json OUT]\n    9 + \n   10 + There is no switch that relaxes a check. The hand-time allowance is read from the record, never from the command\n   11 + line. Exit codes:\n   12 +   0  OK at both layers\n   13 +   3  the standard layer failed (kind `standard`; nothing else is checked)\n   14 +   4  the standard layer passed and a Plumbline check failed\n   15 +   2  cannot run (usage, a missing input, or a checker whose sha256 is not the pin)\n   16 + \n   17 + Every failure prints one line: `FAIL <kind> <field> <file>:<line>`. Kinds: standard, schema, allowance,\n   18 + hand-time-unflagged, flag-without-source, events, relay-as-approval, spend, shadow.\n   19 + \n   20 + This file must not import the record emitter (V7): the emitter's logic is checked by separate code. It may use\n   21 + kit/custody_history.py to parse harness logs.\n   22 + \"\"\"\n   23 + from __future__ import annotations\n   24 + \n   25 + import argparse\n   26 + import json\n   27 + import re\n   28 + import subprocess\n   29 + import sys\n   30 + from hashlib import sha256\n   31 + from pathlib import Path\n   32 + \n   33 + HERE = Path(__file__).resolve().parent\n   34 + REPO = HERE.parent\n   35 + sys.path.insert(0, str(HERE))\n   36 + import custody_history as H  # noqa: E402\n   37 + \n   38 + SCHEMA_VERSION = \"plumbline/x-plumbline/v1\"\n   39 + SCHEMA_PATH = REPO / \"schemas\" / \"x-plumbline\" / \"x-plumbline-v1.schema.json\"\n   40 + SPEND_TOL = 0.0001\n   41 + LEDGER_REL = \"inputs/custody-events.jsonl\"\n   42 + OWNED = (\"verdict\", \"gaps\", \"times\", \"time_tolerance_s\", \"hand_times\", \"allowances\",\n   43 +          \"generations\", \"evaluations\", \"relays\", \"amendments\", \"spend\", \"schema\")\n   44 + # A tool's writer stamp: a .py path under kit/ and 12 lowercase hex (V3). Checked by form only.\n   45 + WRITER_FORM = re.compile(r\"^kit/[A-Za-z0-9_./-]+\\.py@[0-9a-f]{12}$\")\n   46 + \n   47 + \n   48 + def file_sha(p: Path) -> str:\n   49 +     return sha256(Path(p).read_bytes()).hexdigest()\n   50 + \n   51 + \n   52 + def load(p: Path):\n   53 +     return json.loads(Path(p).read_text(encoding=\"utf-8\"))\n   54 + \n   55 + \n   56 + def relpath(job: Path, p: Path) -> str:\n   57 +     try:\n   58 +         return Path(p).resolve().relative_to(Path(job).resolve()).as_posix()\n   59 +     except ValueError:\n   60 +         return str(Path(p).resolve())\n   61 + \n   62 + \n   63 + def ledger_lines(p: Path) -> list[tuple[int, dict]]:\n   64 +     out: list[tuple[int, dict]] = []\n   65 +     if not Path(p).is_file():\n   66 +         return out\n   67 +     for n, ln in enumerate(Path(p).read_text(encoding=\"utf-8\").splitlines(), 1):\n   68 +         if not ln.strip():\n   69 +             continue\n   70 +         try:\n   71 +             e = json.loads(ln)\n   72 +         except ValueError:\n   73 +             continue\n   74 +         if isinstance(e, dict):\n   75 +             e[\"_line\"] = n\n   76 +             out.append((n, e))\n   77 +     return out\n   78 + \n   79 + \n   80 + def writer_source(e: dict):\n   81 +     w = e.get(\"writer\")\n   82 +     if w == \"hand\":\n   83 +         return \"ledger-hand\"\n   84 +     if w in (None, \"\"):\n   85 +         return \"ledger-no-writer\"\n   86 +     return None\n   87 + \n   88 + \n   89 + def allowance_writer_ok(w) -> bool:\n   90 +     \"\"\"A tool's writer stamp by form: `<relative .py path under kit/>@<12 lowercase hex>`, never `hand`.\"\"\"\n   91 +     return isinstance(w, str) and WRITER_FORM.match(w) is not None and \"..\" not in w\n   92 + \n   93 + \n   94 + def line_of(path: Path, value, key: str | None = None):\n   95 +     if value in (None, \"\") or not Path(path).is_file():\n   96 +         return None\n   97 +     try:\n   98 +         lines = Path(path).read_text(encoding=\"utf-8\").splitlines()\n   99 +     except OSError:\n  100 +         return None\n  101 +     vs = str(value)\n  102 +     hits = [n for n, ln in enumerate(lines, 1) if vs in ln and (key is None or f'\"{key}\"' in ln)]\n  103 +     if not hits:\n  104 +         hits = [n for n, ln in enumerate(lines, 1) if vs in ln]\n  105 +     return hits[0] if hits else None\n  106 + \n  107 + \n  108 + def used_seats(ci: dict) -> set[str]:\n  109 +     seats: set[str] = set()\n  110 +     m = ci.get(\"maker\") or {}\n  111 +     if m.get(\"kind\") == \"model\":\n  112 +         seats.add(\"maker\")\n  113 +     for e in ci.get(\"evaluators\") or []:\n  114 +         if e.get(\"kind\") == \"model\":\n  115 +             seats.add(str(e.get(\"id\")))\n  116 +     return seats\n  117 + \n  118 + \n  119 + def evidence_dirs(job: Path, ev: Path, ci: dict) -> list[Path]:\n  120 +     \"\"\"Where harness logs can be: the verifier's --evidence, the inputs' evidence_dir, and the job itself.\"\"\"\n  121 +     out = [Path(ev)]\n  122 +     rel = (ci.get(\"evidence_dir\") if isinstance(ci, dict) else None) or \"custody/evidence\"\n  123 +     out.append(Path(job) / rel)\n  124 +     out.append(Path(job))\n  125 +     seen: set[str] = set()\n  126 +     uniq: list[Path] = []\n  127 +     for d in out:\n  128 +         r = str(Path(d).resolve())\n  129 +         if r not in seen:\n  130 +             seen.add(r)\n  131 +             uniq.append(Path(d))\n  132 +     return uniq\n  133 + \n  134 + \n  135 + def find_log(job: Path, dirs: list[Path], rel: str | None, pattern: str | None):\n  136 +     if rel:\n  137 +         for base in dirs:\n  138 +             p = Path(base) / rel\n  139 +             if p.is_file():\n  140 +                 return p\n  141 +         return None\n  142 +     hits: list[Path] = []\n  143 +     seen: set[str] = set()\n  144 +     for base in dirs:\n  145 +         if not Path(base).is_dir() or not pattern:\n  146 +             continue\n  147 +         for p in sorted(Path(base).glob(pattern)):\n  148 +             k = str(p.resolve())\n  149 +             if k not in seen:\n  150 +                 seen.add(k)\n  151 +                 hits.append(p)\n  152 +     return hits[0] if len(hits) == 1 else None\n  153 + \n  154 + \n  155 + def read_calls(job: Path, ev_dir: Path, ci: dict):\n  156 +     by: dict[str, dict] = {}\n  157 +     allc: list = []\n  158 +     dirs = evidence_dirs(job, ev_dir, ci)\n  159 + \n  160 +     def add(seat: str, log):\n  161 +         if not log:\n  162 +             return\n  163 +         try:\n  164 +             calls = H.read_log(Path(log), H.Refusals(), str(seat))\n  165 +         except Exception:\n  166 +             return\n  167 +         d = by.setdefault(str(seat), {})\n  168 +         for c in calls:\n  169 +             name = getattr(c, \"name\", None) or str(getattr(c, \"i\", \"\"))\n  170 +             d[name] = c\n  171 +             allc.append(c)\n  172 + \n  173 +     if isinstance(ci, dict):\n  174 +         m = ci.get(\"maker\") or {}\n  175 +         if m.get(\"kind\") == \"model\":\n  176 +             add(\"maker\", find_log(job, dirs, m.get(\"harness_log\"), \"harness-maker*.log\"))\n  177 +         for e in ci.get(\"evaluators\") or []:\n  178 +             if e.get(\"kind\") == \"model\":\n  179 +                 rel = e.get(\"harness_log\") or next(\n  180 +                     (x.get(\"evidence_file\") for x in ci.get(\"external\") or []\n  181 +                      if x.get(\"subject\") == e.get(\"id\")), None)\n  182 +                 add(str(e.get(\"id\")), find_log(job, dirs, rel, None))\n  183 +     if not allc:\n  184 +         for base in dirs:\n  185 +             if Path(base).is_dir():\n  186 +                 for log in sorted(Path(base).glob(\"*.log\")):\n  187 +                     add(log.stem, log)\n  188 +     return by, allc\n  189 + \n  190 + \n  191 + def call_cost(c) -> float:\n  192 +     raw = getattr(c, \"raw\", None)\n  193 +     if not isinstance(raw, dict):\n  194 +         return 0.0\n  195 +     resp = raw.get(\"response\") if isinstance(raw.get(\"response\"), dict) else {}\n  196 +     usage = resp.get(\"usage\") if isinstance(resp.get(\"usage\"), dict) else {}\n  197 +     for v in (raw.get(\"total_cost\"), resp.get(\"total_cost\"), usage.get(\"total_cost\"), usage.get(\"cost\")):\n  198 +         if isinstance(v, (int, float)) and not isinstance(v, bool):\n  199 +             return float(v)\n  200 +     return 0.0\n  201 + \n  202 + \n  203 + def call_time(c):\n  204 +     return getattr(c, \"started\", None) or getattr(c, \"at\", None)\n  205 + \n  206 + \n  207 + def ledger_array(lines: list[tuple[int, dict]], event: str, ledger_rel: str) -> list[dict]:\n  208 +     return [{**{k: v for k, v in e.items() if k != \"_line\"},\n  209 +              \"source\": f\"{ledger_rel}:{e['_line']}\"}\n  210 +             for _, e in lines if e.get(\"event\") == event]\n  211 + \n  212 + \n  213 + def last_spend_line(lines: list[tuple[int, dict]]):\n  214 +     sp = None\n  215 +     for _, e in lines:\n  216 +         if e.get(\"event\") == \"spend\":\n  217 +             sp = e\n  218 +     return sp\n  219 + \n  220 + \n  221 + def compute_spend_block(lines: list[tuple[int, dict]], all_calls, ledger_rel: str) -> dict:\n  222 +     sp = last_spend_line(lines)\n  223 +     calls_sum = round(sum(call_cost(c) for c in all_calls if getattr(c, \"at\", None)), 6)\n  224 +     key_delta = float(sp.get(\"key_delta_usd\") or 0) if sp else 0.0\n  225 +     return {\"calls_sum_usd\": calls_sum,\n  226 +             \"key_delta_usd\": key_delta,\n  227 +             \"total_usd\": max(calls_sum, key_delta),\n  228 +             \"tolerance_usd\": SPEND_TOL,\n  229 +             \"source\": f\"{ledger_rel}:{sp['_line']}\" if sp else None}\n  230 + \n  231 + \n  232 + def hand_key(e: dict):\n  233 +     try:\n  234 +         line = int(e.get(\"line\")) if e.get(\"line\") is not None else None\n  235 +     except (TypeError, ValueError):\n  236 +         line = None\n  237 +     return (e.get(\"field\"), e.get(\"file\"), line, e.get(\"source\"))\n  238 + \n  239 + \n  240 + def hand_time_set(job: Path, ledger_path: Path, custody_path: Path, record: dict, evidence: Path) -> list[dict]:\n  241 +     ci = load(custody_path) if Path(custody_path).is_file() else {}\n  242 +     lines = ledger_lines(ledger_path)\n  243 +     ledger_rel = relpath(job, ledger_path)\n  244 +     try:\n  245 +         inputs_rel = relpath(job, custody_path)\n  246 +     except Exception:\n  247 +         inputs_rel = str(custody_path)\n  248 +     seats = used_seats(ci)\n  249 +     calls_by_seat, _ = read_calls(job, evidence, ci)\n  250 +     hand: dict[str, dict] = {}\n  251 +     seen: set = set()\n  252 + \n  253 +     def mark(field: str, file: str, line, source: str) -> None:\n  254 +         hand[field] = {\"field\": field, \"file\": file, \"line\": line, \"source\": source}\n  255 + \n  256 +     for n, e in lines:\n  257 +         src = writer_source(e)\n  258 +         ev = e.get(\"event\")\n  259 +         field = None\n  260 +         if ev == \"freeze\":\n  261 +             seen.add(\"freeze\")\n  262 +             field = \"bar.frozenAt\"\n  263 +         elif ev == \"approve\":\n  264 +             role = e.get(\"role\")\n  265 +             seen.add((\"approve\", role))\n  266 +             for i, a in enumerate((ci.get(\"bar\") or {}).get(\"approvals\") or []):\n  267 +                 if a.get(\"role\") == role:\n  268 +                     f = f\"bar.approvals[{i}].at\"\n  269 +                     if src:\n  270 +                         mark(f, ledger_rel, n, src)\n  271 +                     else:\n  272 +                         hand.pop(f, None)\n  273 +             continue\n  274 +         elif ev == \"dispose\":\n  275 +             seen.add(\"dispose\")\n  276 +             field = \"disposition.at\"\n  277 +         elif ev == \"pin\":\n  278 +             seat = e.get(\"seat\")\n  279 +             seen.add((\"pin\", seat))\n  280 +             if seat in seats:\n  281 +                 field = f\"routing.{seat}.declaredAt\"\n  282 +         else:\n  283 +             continue\n  284 +         if field:\n  285 +             if src:\n  286 +                 mark(field, ledger_rel, n, src)\n  287 +             else:\n  288 +                 hand.pop(field, None)\n  289 + \n  290 +     bar = ci.get(\"bar\") or {}\n  291 +     if \"freeze\" not in seen and bar.get(\"frozenAt\"):\n  292 +         mark(\"bar.frozenAt\", inputs_rel, line_of(custody_path, bar.get(\"frozenAt\"), \"frozenAt\"),\n  293 +              \"inputs-no-ledger\")\n  294 +     for i, a in enumerate(bar.get(\"approvals\") or []):\n  295 +         if (\"approve\", a.get(\"role\")) not in seen and a.get(\"at\"):\n  296 +             mark(f\"bar.approvals[{i}].at\", inputs_rel, line_of(custody_path, a.get(\"at\"), \"at\"),\n  297 +                  \"inputs-no-ledger\")\n  298 +     for seat in seats:\n  299 +         if (\"pin\", seat) not in seen:\n  300 +             pin = (ci.get(\"routing\") or {}).get(seat) or {}\n  301 +             if pin.get(\"declaredAt\"):\n  302 +                 mark(f\"routing.{seat}.declaredAt\", inputs_rel,\n  303 +                      line_of(custody_path, pin.get(\"declaredAt\"), \"declaredAt\"), \"inputs-no-ledger\")\n  304 +     if \"dispose\" not in seen:\n  305 +         d = ci.get(\"disposition\") or {}\n  306 +         if d.get(\"at\"):\n  307 +             mark(\"disposition.at\", inputs_rel, line_of(custody_path, d.get(\"at\"), \"at\"), \"inputs-no-ledger\")\n  308 + \n  309 +     mcalls = calls_by_seat.get(\"maker\") or {}\n  310 +     if not mcalls:\n  311 +         if ci.get(\"startedAt\"):\n  312 +             mark(\"startedAt\", inputs_rel, line_of(custody_path, ci.get(\"startedAt\"), \"startedAt\"),\n  313 +                  \"inputs-no-ledger\")\n  314 +         if ci.get(\"producedAt\"):\n  315 +             mark(\"producedAt\", inputs_rel, line_of(custody_path, ci.get(\"producedAt\"), \"producedAt\"),\n  316 +                  \"inputs-no-ledger\")\n  317 + \n  318 +     for pid, f in (ci.get(\"passes\") or {}).items():\n  319 +         if not isinstance(f, dict) or not f.get(\"at\"):\n  320 +             continue\n  321 +         calls = calls_by_seat.get(str(f.get(\"evaluator\"))) or {}\n  322 +         linked = (f.get(\"call\") in calls) if f.get(\"call\") else len(calls) == 1\n  323 +         if not linked:\n  324 +             mark(f\"passes.{pid}.at\", inputs_rel, line_of(custody_path, f.get(\"at\"), \"at\"),\n  325 +                  \"inputs-no-ledger\")\n  326 + \n  327 +     for k in ci.get(\"controls\") or []:\n  328 +         if not k.get(\"at\"):\n  329 +             continue\n  330 +         calls = calls_by_seat.get(str(k.get(\"evaluator\"))) or {}\n  331 +         linked = (k.get(\"call\") in calls) if k.get(\"call\") else len(calls) == 1\n  332 +         if not linked:\n  333 +             mark(f\"controls[{k.get('id')}].at\", inputs_rel, line_of(custody_path, k.get(\"at\"), \"at\"),\n  334 +                  \"inputs-no-ledger\")\n  335 + \n  336 +     logs: list[Path] = []\n  337 +     for base in evidence_dirs(job, evidence, ci):\n  338 +         if Path(base).is_dir():\n  339 +             logs += sorted(Path(base).glob(\"*.log\"))\n  340 +     for log in dict.fromkeys(logs):\n  341 +         try:\n  342 +             calls = H.read_log(Path(log), H.Refusals(), \"verify\")\n  343 +         except Exception:\n  344 +             continue\n  345 +         for c in calls:\n  346 +             try:\n  347 +                 entries = c.hand_time_entries()\n  348 +             except Exception:\n  349 +                 entries = []\n  350 +             for e in entries:\n  351 +                 if isinstance(e, dict) and e.get(\"field\"):\n  352 +                     hand[str(e[\"field\"])] = e\n  353 +     return [hand[k] for k in sorted(hand)]\n  354 + \n  355 + \n  356 + def check_hand_times(hand: list[dict], record: dict) -> list[dict]:\n  357 +     fails: list[dict] = []\n  358 +     xp = (record.get(\"predicate\") or {}).get(\"x-plumbline\") if isinstance(record, dict) else None\n  359 +     if not isinstance(xp, dict):\n  360 +         return fails\n  361 +     flags = xp.get(\"hand_times\")\n  362 +     if not isinstance(flags, list):\n  363 +         return fails\n  364 +     recomp = {hand_key(e) for e in hand if isinstance(e, dict)}\n  365 +     got = {hand_key(e) for e in flags if isinstance(e, dict)}\n  366 +     for k in sorted(recomp - got):\n  367 +         fails.append({\"kind\": \"hand-time-unflagged\", \"field\": k[0], \"file\": k[1], \"line\": k[2]})\n  368 +     for k in sorted(got - recomp):\n  369 +         fails.append({\"kind\": \"flag-without-source\", \"field\": k[0], \"file\": k[1], \"line\": k[2]})\n  370 +     if recomp:\n  371 +         allowances = xp.get(\"allowances\")\n  372 +         allowance = allowances.get(\"hand_times\") if isinstance(allowances, dict) else None\n  373 +         if not isinstance(allowance, dict):\n  374 +             fails.append({\"kind\": \"allowance\", \"field\": \"x-plumbline.allowances.hand_times\",\n  375 +                           \"file\": \"\", \"line\": 0})\n  376 +         else:\n  377 +             if allowance.get(\"switch\") != \"--allow-hand-times\":\n  378 +                 fails.append({\"kind\": \"allowance\", \"field\": \"x-plumbline.allowances.hand_times.switch\",\n  379 +                               \"file\": \"\", \"line\": 0})\n  380 +             if not allowance_writer_ok(allowance.get(\"writer\")):\n  381 +                 fails.append({\"kind\": \"allowance\", \"field\": \"x-plumbline.allowances.hand_times.writer\",\n  382 +                               \"file\": \"\", \"line\": 0})\n  383 +             if not H.parse_ts(allowance.get(\"at\")):\n  384 +                 fails.append({\"kind\": \"allowance\", \"field\": \"x-plumbline.allowances.hand_times.at\",\n  385 +                               \"file\": \"\", \"line\": 0})\n  386 +     return fails\n  387 + \n  388 + \n  389 + def check_events(job: Path, ledger_path: Path, record: dict, calls_by_seat: dict) -> list[dict]:\n  390 +     fails: list[dict] = []\n  391 +     xp = (record.get(\"predicate\") or {}).get(\"x-plumbline\") if isinstance(record, dict) else None\n  392 +     if not isinstance(xp, dict):\n  393 +         return fails\n  394 +     lines = ledger_lines(ledger_path)\n  395 +     ledger_rel = relpath(job, ledger_path)\n  396 +     for ev, key in ((\"generation\", \"generations\"), (\"evaluation\", \"evaluations\"),\n  397 +                     (\"relay\", \"relays\"), (\"amendment\", \"amendments\")):\n  398 +         expected = ledger_array(lines, ev, ledger_rel)\n  399 +         got = xp.get(key)\n  400 +         if got != expected:\n  401 +             fails.append({\"kind\": \"events\", \"field\": f\"x-plumbline.{key}\", \"file\": str(ledger_path), \"line\": 0})\n  402 + \n  403 +     for _, e in lines:\n  404 +         if e.get(\"event\") != \"evaluation\":\n  405 +             continue\n  406 +         vf = e.get(\"verdict_file\")\n  407 +         want = e.get(\"verdict_sha256\")\n  408 +         if not vf:\n  409 +             continue\n  410 +         p = Path(vf) if Path(vf).is_absolute() else Path(job) / vf\n  411 +         if not p.is_file() or file_sha(p) != want:\n  412 +             fails.append({\"kind\": \"events\", \"field\": f\"evaluations[{e.get('batch')}].verdict_sha256\",\n  413 +                           \"file\": vf, \"line\": e.get(\"_line\", 0)})\n  414 + \n  415 +     opens: dict = {}\n  416 +     closes: dict = {}\n  417 +     for _, e in lines:\n  418 +         if e.get(\"event\") != \"generation\":\n  419 +             continue\n  420 +         k = (e.get(\"seat\"), e.get(\"n\"))\n  421 +         if e.get(\"action\") == \"open\":\n  422 +             opens[k] = e\n  423 +         elif e.get(\"action\") == \"close\":\n  424 +             closes[k] = e\n  425 +     maker_calls = list((calls_by_seat.get(\"maker\") or {}).values())\n  426 +     for k, o in opens.items():\n  427 +         c = closes.get(k)\n  428 +         if not c:\n  429 +             fails.append({\"kind\": \"events\", \"field\": f\"generations[{k[0]}#{k[1]}].close\",\n  430 +                           \"file\": str(ledger_path), \"line\": o.get(\"_line\", 0)})\n  431 +             continue\n  432 +         t0, t1 = H.parse_ts(o.get(\"at\")), H.parse_ts(c.get(\"at\"))\n  433 +         if t0 and t1:\n  434 +             found = any(call_time(x) and t0 <= call_time(x) <= t1 for x in maker_calls)\n  435 +             if not found:\n  436 +                 fails.append({\"kind\": \"events\", \"field\": f\"generations[{k[0]}#{k[1]}].calls\",\n  437 +                               \"file\": str(ledger_path), \"line\": o.get(\"_line\", 0)})\n  438 + \n  439 +     relays = [e for _, e in lines if e.get(\"event\") == \"relay\"]\n  440 +     approvals = ((record.get(\"predicate\") or {}).get(\"bar\") or {}).get(\"approvals\") or []\n  441 +     for r in relays:\n  442 +         for a in approvals:\n  443 +             if (a.get(\"kind\") == \"relay\" or a.get(\"relay\") or a.get(\"role\") == \"relay\"\n  444 +                     or a.get(\"by\") == r.get(\"from\") or a.get(\"quote\") == r.get(\"quote\")):\n  445 +                 fails.append({\"kind\": \"relay-as-approval\", \"field\": \"predicate.bar.approvals\",\n  446 +                               \"file\": str(ledger_path), \"line\": r.get(\"_line\", 0)})\n  447 +                 break\n  448 +     return fails\n  449 + \n  450 + \n  451 + def check_spend(job: Path, ledger_path: Path, record: dict, all_calls) -> list[dict]:\n  452 +     fails: list[dict] = []\n  453 +     xp = (record.get(\"predicate\") or {}).get(\"x-plumbline\") if isinstance(record, dict) else None\n  454 +     if not isinstance(xp, dict):\n  455 +         return fails\n  456 +     lines = ledger_lines(ledger_path)\n  457 +     ledger_rel = relpath(job, ledger_path)\n  458 +     expected = compute_spend_block(lines, all_calls, ledger_rel)\n  459 +     sp = xp.get(\"spend\")\n  460 +     if not isinstance(sp, dict):\n  461 +         return [{\"kind\": \"spend\", \"field\": \"x-plumbline.spend\", \"file\": str(ledger_path), \"line\": 0}]\n  462 +     for k in (\"calls_sum_usd\", \"key_delta_usd\", \"total_usd\", \"tolerance_usd\"):\n  463 +         if k not in sp:\n  464 +             fails.append({\"kind\": \"spend\", \"field\": f\"x-plumbline.spend.{k}\", \"file\": str(ledger_path), \"line\": 0})\n  465 +     calls_sum = float(sp.get(\"calls_sum_usd\") or 0)\n  466 +     key_delta = float(sp.get(\"key_delta_usd\") or 0)\n  467 +     total = float(sp.get(\"total_usd\") or 0)\n  468 +     tol = float(sp.get(\"tolerance_usd\") or 0)\n  469 +     if abs(calls_sum - expected[\"calls_sum_usd\"]) > SPEND_TOL:\n  470 +         fails.append({\"kind\": \"spend\", \"field\": \"x-plumbline.spend.calls_sum_usd\",\n  471 +                       \"file\": str(ledger_path), \"line\": 0})\n  472 +     if abs(key_delta - expected[\"key_delta_usd\"]) > 1e-9:\n  473 +         fails.append({\"kind\": \"spend\", \"field\": \"x-plumbline.spend.key_delta_usd\",\n  474 +                       \"file\": str(ledger_path), \"line\": 0})\n  475 +     if abs(total - max(calls_sum, key_delta)) > 1e-9:\n  476 +         fails.append({\"kind\": \"spend\", \"field\": \"x-plumbline.spend.total_usd\",\n  477 +                       \"file\": str(ledger_path), \"line\": 0})\n  478 +     if abs(tol - SPEND_TOL) > 1e-12:\n  479 +         fails.append({\"kind\": \"spend\", \"field\": \"x-plumbline.spend.tolerance_usd\",\n  480 +                       \"file\": str(ledger_path), \"line\": 0})\n  481 + \n  482 +     sp_line = last_spend_line(lines)\n  483 +     if sp_line:\n  484 +         lp = Path(sp_line.get(\"spend_ledger\") or \"\")\n  485 +         if not lp.is_absolute():\n  486 +             lp = Path(job) / lp\n  487 +         if not lp.is_file():\n  488 +             fails.append({\"kind\": \"spend\", \"field\": \"spend_ledger\", \"file\": str(lp), \"line\": sp_line.get(\"_line\", 0)})\n  489 +         else:\n  490 +             labels = {getattr(c, \"name\", None) or str(getattr(c, \"i\", \"\")) for c in all_calls}\n  491 +             for n, ln in enumerate(lp.read_text(encoding=\"utf-8\").splitlines(), 1):\n  492 +                 if not ln.strip():\n  493 +                     continue\n  494 +                 try:\n  495 +                     x = json.loads(ln)\n  496 +                 except ValueError:\n  497 +                     continue\n  498 +                 if x.get(\"event\") == \"settle\":\n  499 +                     call = x.get(\"call\") or x.get(\"id\")\n  500 +                     if call and call not in labels:\n  501 +                         fails.append({\"kind\": \"spend\", \"field\": f\"settle[{call}]\",\n  502 +                                       \"file\": str(lp), \"line\": n})\n  503 +         rp = Path(sp_line.get(\"key_reading\") or \"\")\n  504 +         if not rp.is_absolute():\n  505 +             rp = Path(job) / rp\n  506 +         if not rp.is_file():\n  507 +             fails.append({\"kind\": \"spend\", \"field\": \"key_reading\", \"file\": str(rp), \"line\": sp_line.get(\"_line\", 0)})\n  508 +         else:\n  509 +             try:\n  510 +                 r = load(rp)\n  511 +             except Exception:\n  512 +                 r = {}\n  513 +             if not r.get(\"read_at\") or not r.get(\"writer\"):\n  514 +                 fails.append({\"kind\": \"spend\", \"field\": \"key_reading.read_at\",\n  515 +                               \"file\": str(rp), \"line\": 0})\n  516 +             else:\n  517 +                 read_at = H.parse_ts(r.get(\"read_at\"))\n  518 +                 last = H.parse_ts(sp_line.get(\"last_settle_at\"))\n  519 +                 if read_at and last and (read_at - last).total_seconds() < 180:\n  520 +                     fails.append({\"kind\": \"spend\", \"field\": \"key_reading.read_at\",\n  521 +                                   \"file\": str(rp), \"line\": 0})\n  522 +                 if abs(float(r.get(\"key_delta_usd\") or 0) - key_delta) > 1e-6:\n  523 +                     fails.append({\"kind\": \"spend\", \"field\": \"key_reading.key_delta_usd\",\n  524 +                                   \"file\": str(rp), \"line\": 0})\n  525 +     elif expected[\"calls_sum_usd\"] > 0:\n  526 +         fails.append({\"kind\": \"spend\", \"field\": \"x-plumbline.spend.source\",\n  527 +                       \"file\": str(ledger_path), \"line\": 0})\n  528 +     return fails\n  529 + \n  530 + \n  531 + def check_shadow(job: Path, ledger_path: Path, record: dict, all_calls, hand: list[dict],\n  532 +                  calls_by_seat: dict) -> list[dict]:\n  533 +     fails: list[dict] = []\n  534 +     xp = (record.get(\"predicate\") or {}).get(\"x-plumbline\") if isinstance(record, dict) else None\n  535 +     if not isinstance(xp, dict):\n  536 +         return fails\n  537 +     inputs = xp.get(\"inputs\")\n  538 +     if not isinstance(inputs, dict):\n  539 +         inputs = {}\n  540 +     lines = ledger_lines(ledger_path)\n  541 +     ledger_rel = relpath(job, ledger_path)\n  542 +     derived: dict = {\n  543 +         \"schema\": SCHEMA_VERSION,\n  544 +         \"time_tolerance_s\": H.TOLERANCE_S,\n  545 +         \"hand_times\": hand,\n  546 +         \"generations\": ledger_array(lines, \"generation\", ledger_rel),\n  547 +         \"evaluations\": ledger_array(lines, \"evaluation\", ledger_rel),\n  548 +         \"relays\": ledger_array(lines, \"relay\", ledger_rel),\n  549 +         \"amendments\": ledger_array(lines, \"amendment\", ledger_rel),\n  550 +         \"spend\": compute_spend_block(lines, all_calls, ledger_rel),\n  551 +     }\n  552 +     s5 = xp.get(\"s5_record\") or {}\n  553 +     if s5.get(\"name\"):\n  554 +         p = Path(s5[\"name\"]) if Path(s5[\"name\"]).is_absolute() else Path(job) / s5[\"name\"]\n  555 +         if p.is_file():\n  556 +             try:\n  557 +                 rec = load(p)\n  558 +                 if \"verdict\" in rec:\n  559 +                     derived[\"verdict\"] = rec.get(\"verdict\")\n  560 +             except Exception:\n  561 +                 pass\n  562 +     mcalls = calls_by_seat.get(\"maker\") or {}\n  563 +     derived[\"times\"] = {\"startedAt\": \"harness log\" if mcalls else \"hand-entered\",\n  564 +                         \"producedAt\": \"harness log\" if mcalls else \"hand-entered\"}\n  565 + \n  566 +     for key in OWNED:\n  567 +         if key not in derived or key not in xp:\n  568 +             continue\n  569 +         if key == \"hand_times\":\n  570 +             if {hand_key(e) for e in xp.get(key) or [] if isinstance(e, dict)} != \\\n  571 +                     {hand_key(e) for e in derived[key] or [] if isinstance(e, dict)}:\n  572 +                 fails.append({\"kind\": \"shadow\", \"field\": f\"x-plumbline.{key}\",\n  573 +                               \"file\": str(ledger_path), \"line\": 0})\n  574 +         elif xp.get(key) != derived[key]:\n  575 +             fails.append({\"kind\": \"shadow\", \"field\": f\"x-plumbline.{key}\",\n  576 +                           \"file\": str(ledger_path), \"line\": 0})\n  577 +     for key in OWNED:\n  578 +         if key in inputs and key in xp and key in derived:\n  579 +             if xp.get(key) == inputs.get(key) and xp.get(key) != derived[key]:\n  580 +                 fails.append({\"kind\": \"shadow\", \"field\": f\"x-plumbline.inputs.{key}\",\n  581 +                               \"file\": str(ledger_path), \"line\": 0})\n  582 +     return fails\n  583 + \n  584 + \n  585 + def _type_ok(v, t: str) -> bool:\n  586 +     if t == \"object\":\n  587 +         return isinstance(v, dict)\n  588 +     if t == \"array\":\n  589 +         return isinstance(v, list)\n  590 +     if t == \"string\":\n  591 +         return isinstance(v, str)\n  592 +     if t == \"integer\":\n  593 +         return isinstance(v, int) and not isinstance(v, bool)\n  594 +     if t == \"number\":\n  595 +         return isinstance(v, (int, float)) and not isinstance(v, bool)\n  596 +     if t == \"boolean\":\n  597 +         return isinstance(v, bool)\n  598 +     if t == \"null\":\n  599 +         return v is None\n  600 +     return True\n  601 + \n  602 + \n  603 + def _validate(inst, sch, root, path: str) -> list[tuple[str, str]]:\n  604 +     errs: list[tuple[str, str]] = []\n  605 +     if sch is True or sch == {}:\n  606 +         return errs\n  607 +     if sch is False:\n  608 +         return [(path, \"false schema\")]\n  609 +     if \"$ref\" in sch:\n  610 +         ref = sch[\"$ref\"]\n  611 +         if isinstance(ref, str) and ref.startswith(\"#/$defs/\"):\n  612 +             name = ref.split(\"/\")[-1]\n  613 +             return _validate(inst, root[\"$defs\"][name], root, path)\n  614 +         return errs\n  615 +     if \"const\" in sch and inst != sch[\"const\"]:\n  616 +         errs.append((path, \"const\"))\n  617 +     if \"enum\" in sch and inst not in sch[\"enum\"]:\n  618 +         errs.append((path, \"enum\"))\n  619 +     if \"type\" in sch:\n  620 +         ts = sch[\"type\"] if isinstance(sch[\"type\"], list) else [sch[\"type\"]]\n  621 +         if not any(_type_ok(inst, t) for t in ts):\n  622 +             errs.append((path, \"type\"))\n  623 +     for sub in sch.get(\"allOf\") or []:\n  624 +         errs += _validate(inst, sub, root, path)\n  625 +     if \"anyOf\" in sch:\n  626 +         if not any(not _validate(inst, sub, root, path) for sub in sch[\"anyOf\"]):\n  627 +             errs.append((path, \"anyOf\"))\n  628 +     if \"oneOf\" in sch:\n  629 +         ok = sum(1 for sub in sch[\"oneOf\"] if not _validate(inst, sub, root, path))\n  630 +         if ok != 1:\n  631 +             errs.append((path, \"oneOf\"))\n  632 +     if isinstance(inst, dict):\n  633 +         for r in sch.get(\"required\") or []:\n  634 +             if r not in inst:\n  635 +                 errs.append((path + \".\" + r, \"required\"))\n  636 +         props = sch.get(\"properties\") or {}\n  637 +         for k, v in inst.items():\n  638 +             if k in props:\n  639 +                 errs += _validate(v, props[k]