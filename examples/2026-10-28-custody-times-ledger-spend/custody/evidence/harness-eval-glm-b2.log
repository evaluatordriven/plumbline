e `created` epoch\n  192 +         (`response-created`), exactly as `Call.started` / `Call.at` read them. The emitter must not write\n  193 +         these back to the log (T7).\"\"\"\n  194 +         out = []\n  195 +         resp = self.raw.get(\"response\") if isinstance(self.raw.get(\"response\"), dict) else {}\n  196 +         hdrs = self.raw.get(\"response_headers\") or self.raw.get(\"headers\") or {}\n  197 +         base = f\"{self.log}#{self.name or self.i}\"\n  198 +         if self.sent is None:\n  199 +             if self.created:\n  200 +                 n = self._line_of(resp.get(\"created\"), \"created\")\n  201 +                 out.append({\"field\": f\"{base}.sent_at\", \"file\": self.log, \"line\": n,\n  202 +                             \"source\": \"response-created\"})\n  203 +             elif self.date:\n  204 +                 n = self._line_of(_hdr(hdrs, \"Date\"), \"Date\")\n  205 +                 out.append({\"field\": f\"{base}.sent_at\", \"file\": self.log, \"line\": n,\n  206 +                             \"source\": \"server-header\"})\n  207 +         if self.received is None:\n  208 +             if self.date:\n  209 +                 n = self._line_of(_hdr(hdrs, \"Date\"), \"Date\")\n  210 +                 out.append({\"field\": f\"{base}.received_at\", \"file\": self.log, \"line\": n,\n  211 +                             \"source\": \"server-header\"})\n  212 +             elif self.created:\n  213 +                 n = self._line_of(resp.get(\"created\"), \"created\")\n  214 +                 out.append({\"field\": f\"{base}.received_at\", \"file\": self.log, \"line\": n,\n  215 +                             \"source\": \"response-created\"})\n  216 +         return out\n  217 + \n  218 + \n  219 + def read_log(path: Path, ref: Refusals | None = None, who: str = \"log\") -> list[Call]:\n  220 +     \"\"\"A harness log: one JSON object per call, a JSON list of them, or JSON Lines.\n  221 + \n  222 +     `ref` and `who` are opti