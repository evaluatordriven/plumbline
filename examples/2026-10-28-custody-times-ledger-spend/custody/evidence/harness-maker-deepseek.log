f x.strip()] if (j / \"inputs\" / \"custody-events.jsonl\").is_file() else []\nlines = [e for e in lines if not (e.get(\"event\") == \"approve\" and e.get(\"role\") == \"buyer\")]\nlines.append({\"event\": \"relay\", \"kind\": \"relay\", \"quote\": \"the buyer is happy\", \"from\": \"relay-bot\",\n              \"source_chat\": \"chat-1\", \"source_at\": \"2026-10-20T10:31:00Z\", \"at\": \"2026-10-20T10:32:00Z\",\n              \"writer\": \"kit/custody_ledger.py@abc123def456\"})\n(j / \"inputs\" / \"custody-events.jsonl\").write_text(\"\".join(json.dumps(e) + \"\\n\" for e in lines), encoding=\"utf-8\")\no = TMP / \"relay-only.json\"\nrc, out = emit(j, o, allow_hand=True)\nres((f\"{S} · F1f a buyer approval that exists only as a relay is refused (approval, buyer, nothing written)\",\n     rc == 3 and \"[approval]\" in out and \"buyer\" in out and not o.exists(), f\"exit {rc}: {out.strip()[-140:]}\"))\n# adding a direct buyer approve line removes the refusal\nlines.append({\"event\": \"approve\", \"role\": \"buyer\", \"by\": \"Fixture Buyer\", \"at\": \"2026-10-20T10:10:00Z\",\n              \"writer\": \"kit/custody_ledger.py@abc123def456\"})\n(j / \"inputs\" / \"custody-events.jsonl\").write_text(\"\".join(json.dumps(e) + \"\\n\" for e in lines), encoding=\"utf-8\")\no2 = TMP / \"relay-only-ok.json\"\nrc2, out2 = emit(j, o2, allow_hand=True)\nres((f\"{S} · F1f a direct buyer approve line removes the relay-only refusal\",\n     rc2 != 3 or \"[approval]\" not in out2, f\"exit {rc2}: {out2.strip()[-140:]}\"))\n```\n\nWait, but the `bar.approvals` still lacks buyer. The emitter's `approvals` list only has specialist. The record might have a gap? No, `if not approvals` only gaps if the list is empty. There's a specialist, so no gap. And the record emits. But `check_order` might complain? The relay line has `at` = 10:32, which might be after the close. Hmm. `job-rejected`'s packet close date? If the close is before 10:32, `check_order` refuses (after the job's close). L