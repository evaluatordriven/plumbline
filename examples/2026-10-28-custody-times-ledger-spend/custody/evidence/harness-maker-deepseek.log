            "content": "<<<PLUMBLINE-FILE path=tools/edi/or_call.py>>>\n#!/usr/bin/env python3\n\"\"\"tools/edi/or_call.py: one logged OpenRouter chat call for a job seat.\n\nThis is the product-harness version of the frozen job-1 harness.  It keeps the\njob-1 log shape (so kit/custody_history.read_log can read it) and adds the job\nspend file, per-call GET /api/v1/key checks, --max-cost and a mocked transport.\n\n    or_call.py --seat maker --log custody/evidence/harness-maker.log \\\n               --model MODEL --tag TAG --pin-provider PROVIDER \\\n               --messages msgs.json --out reply.txt \\\n               --job-spend job-spend.json [--call NAME] [--max-cost USD]\n    (or take tag + provider from the ledger: --ledger inputs/custody-events.jsonl)\n\nThe job spend file is required for calls, --init-spend and --spend-status:\n    {job_id, bound_usd, reserve_usd, spend_ledger,\n     prices: [{model, tag, prompt_usd_per_token,\n               completion_usd_per_token, max_completion_tokens}]}\n\nExit codes: 0 logged and served by the pin · 2 usage/key/job-spend error,\nnothing sent · 3 HTTP/transport error (logged when a request was sent) ·\n4 REFUSED: served by another provider, a fallback was tried, or the response\ndoes not say who served it (logged, no --out) · 5 served by the pin but no\n/api/v1/generation reply (logged, --out written) · 6 refused by the job spend\nbound (nothing sent, no log entry) · 8 refused by --max-cost before sending\n(nothing sent, no log entry) · 9 over the cap after settle (logged, settle line\nover_cap, no --out).\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport fcntl\nimport hashlib\nimport json\nimport os\nimport re\nimport stat\nimport sys\nimport time\nimport uuid\nimport urllib.error\nimport urllib.request\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nBASE = \"https://openrouter.ai/api/v1\"\nKEY_FILE = \"/workspace/.openrouter-key\"\nMETA_HEADER = (\"X-OpenRouter-Metadata\", \"enabled\")\nREDACTED = \"Bearer [REDACTED]\"\nHARNESS_NAME = \"tools/edi/or_call.py\"\n\n\ndef now() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n\n\ndef file_sha256() -> str:\n    return hashlib.sha256(Path(__file__).read_bytes()).hexdigest()\n\n\ndef writer() -> str:\n    return f\"{HARNESS_NAME}@{file_sha256()[:12]}\"\n\n\ndef die(msg: str, code: int = 2) -> None:\n    print(msg, file=sys.stderr)\n    raise SystemExit(code)\n\n\ndef norm(v) -> str:\n    return re.sub(r\"[^a-z0-9]\", \"\", str(v or \"\").lower())\n\n\nclass Transport:\n    \"\"\"urllib transport; tests swap it for a fake. Returns (status, headers, body).\"\"\"\n\n    def request(self, method: str, url: str, headers: dict, body: bytes | None, timeout: float = 300):\n        req = urllib.request.Request(url, data=body, method=method, headers=headers)\n        try:\n            with urllib.request.urlopen(req, timeout=timeout) as r:\n                return r.status, dict(r.headers.items()), r.read()\n        except urllib.error.HTTPError as e:\n            return e.code, dict(e.headers.items()) if e.headers else {}, e.read()\n\n\nclass MockTransport:\n    \"\"\"No network.  Replies come from DIR/key.json, DIR/chat.json, DIR/generation.json.\n\n    Each reply file is {\"status\": N, \"headers\": {...}, \"body\": <JSON>}.  Every\n    request is appended to DIR/requests.jsonl as {\"method\", \"url\", \"at\"} with a\n    real OpenRouter URL and no headers or key material.\n    \"\"\"\n\n    def __init__(self, directory: str):\n        self.dir = Path(directory)\n        self.dir.mkdir(parents=True, exist_ok=True)\n        self.requests = self.dir / \"requests.jsonl\"\n\n    def _record(self, method: str, url: str) -> None:\n        with open(self.requests, \"a\", encoding=\"utf-8\") as f:\n            f.write(json.dumps({\"method\": method, \"url\": url, \"at\": now()}, sort_keys=True) + \"\\n\")\n\n    def _reply(self, name: str):\n        p = self.dir / name\n        if not p.is_file():\n            raise FileNotFoundError(str(p))\n        data = json.loads(p.read_text(encoding=\"utf-8\"))\n        status = int(data.get(\"status\", 200))\n        headers = dict(data.get(\"headers\") or {})\n        body = data.get(\"body\", {})\n        raw = body if isinstance(body, bytes) else json.dumps(body, ensure_ascii=False).encode(\"utf-8\")\n        return status, headers, raw\n\n    def request(self, method: str, url: str, headers: dict, body: bytes | None, timeout: float = 300):\n        self._record(method, url)\n        if method == \"GET\" and url.endswith(\"/key\"):\n            return self._reply(\"key.json\")\n        if method == \"POST\" and url.endswith(\"/chat/completions\"):\n            return self._reply(\"chat.json\")\n        if method == \"GET\" and \"/generation\" in url:\n            return self._reply(\"generation.json\")\n        raise FileNotFoundError(f\"no mock reply for {method} {url}\")\n\n\ndef read_key(path: str, allow_missing: bool = False) -> str:\n    p = Path(path)\n    if not p.is_file():\n        if allow_missing:\n            return \"mock-key\"\n        die(f\"or_call: no key file at {path}\", 2)\n    mode = stat.S_IMODE(p.stat().st_mode)\n    if mode & 0o077:\n        die(f\"or_call: key file {path} is readable by group/other (mode {oct(mode)}); chmod 600 it\", 2)\n    key = p.read_text(encoding=\"utf-8\").strip()\n    if not key:\n        die(f\"or_call: key file {path} is empty\", 2)\n    return key\n\n\ndef load_job_spend(path: str) -> dict:\n    p = Path(path)\n    if not p.is_file():\n        die(f\"or_call: no job spend file at {path}\", 2)\n    try:\n        data = json.loads(p.read_text(encoding=\"utf-8\"))\n    except Exception as exc:\n        die(f\"or_call: job spend file {path} is not JSON: {exc}\", 2)\n    if not isinstance(data, dict):\n        die(f\"or_call: job spend file {path} must be a JSON object\", 2)\n    for k in (\"job_id\", \"bound_usd\", \"reserve_usd\", \"spend_ledger\", \"prices\"):\n        if k not in data:\n            die(f\"or_call: job spend file {path} is missing {k!r}\", 2)\n    try:\n        float(data[\"bound_usd\"])\n        float(data[\"reserve_usd\"])\n    except (TypeError, ValueError):\n        die(f\"or_call: job spend file {path} has a non-numeric bound_usd or reserve_usd\", 2)\n    if not isinstance(data[\"spend_ledger\"], str) or not data[\"spend_ledger\"]:\n        die(f\"or_call: job spend file {path} has no spend_ledger path\", 2)\n    if not isinstance(data[\"prices\"], list) or not data[\"prices\"]:\n        die(f\"or_call: job spend file {path} has no prices snapshot\", 2)\n    for entry in data[\"prices\"]:\n        if not isinstance(entry, dict):\n            die(f\"or_call: job spend file {path} has a non-object price entry\", 2)\n        for k in (\"model\", \"tag\", \"prompt_usd_per_token\", \"completion_usd_per_token\", \"max_completion_tokens\"):\n            if k not in entry:\n                die(f\"or_call: job spend price entry is missing {k!r}\", 2)\n        try:\n            float(entry[\"prompt_usd_per_token\"])\n            float(entry[\"completion_usd_per_token\"])\n            int(entry[\"max_completion_tokens\"])\n        except (TypeError, ValueError):\n            die(f\"or_call: job spend price entry has a non-numeric value\", 2)\n    return data\n\n\ndef pin_from_ledger(ledger: str, seat: str) -> tuple[str, str]:\n    p = Path(ledger)\n    if not p.is_file():\n        die(f\"or_call: no ledger at {ledger}\", 2)\n    try:\n        rows = [json.loads(ln) for ln in p.read_text(encoding=\"utf-8\").splitlines() if ln.strip()]\n    except Exception as exc:\n        die(f\"or_call: ledger {ledger} is not JSON lines: {exc}\", 2)\n    pins = [e for e in rows if isinstance(e, dict) and e.get(\"event\") == \"pin\" and e.get(\"seat\") == seat]\n    if not pins:\n        die(f\"or_call: ledger {ledger} has no pin for seat {seat!r} (custody_ledger.py pin first)\", 2)\n    last = pins[-1]\n    if not last.get(\"slug\") or not last.get(\"provider\"):\n        die(f\"or_call: ledger {ledger} has an incomplete pin for seat {seat!r}\", 2)\n    return str(last[\"slug\"]), str(last[\"provider\"])\n\n\ndef served_by(resp: dict, gen: dict | None) -> tuple[dict, list]:\n    \"\"\"({source: provider}, [providers tried]) as the response and generation reply state them.\"\"\"\n    served, tried = {}, []\n    if isinstance(resp, dict):\n        if resp.get(\"provider\"):\n            served[\"response.provider\"] = str(resp[\"provider\"])\n        om = resp.get(\"openrouter_metadata\") if isinstance(resp.get(\"openrouter_metadata\"), dict) else {}\n        sel = [e.get(\"provider\") for e in ((om.get(\"endpoints\") or {}).get(\"available\") or [])\n               if isinstance(e, dict) and e.get(\"selected\") and e.get(\"provider\")]\n        if sel:\n            served[\"openrouter_metadata.endpoints.selected\"] = str(sel[-1])\n        tried += [str(a.get(\"provider\")) for a in (om.get(\"attempts\") or [])\n                  if isinstance(a, dict) and a.get(\"provider\")]\n    if isinstance(gen, dict):\n        g = gen.get(\"data\") if isinstance(gen.get(\"data\"), dict) else gen\n        if g.get(\"provider_name\"):\n            served[\"generation.provider_name\"] = str(g[\"provider_name\"])\n        tried += [str(x.get(\"provider_name\") or x.get(\"provider\")) for x in (g.get(\"provider_responses\") or [])\n                  if isinstance(x, dict) and (x.get(\"provider_name\") or x.get(\"provider\"))]\n    return served, tried\n\n\ndef pin_ok(name, provider: str, tag: str) -> bool:\n    n = norm(name)\n    return bool(n) and n in {norm(provider), norm(tag.split(\"/\")[0])}\n\n\ndef append_entry(log: Path, entry: dict, key: str) -> None:\n    text = json.dumps(entry, ensure_ascii=False)\n    if key and key in text:\n        die(\"or_call: the log entry would contain the key; nothing written\", 2)\n    items = []\n    if log.exists() and log.stat().st_size:\n        try:\n            items = json.loads(log.read_text(encoding=\"utf-8\"))\n        except Exception as exc:\n            die(f\"or_call: {log} is not JSON: {exc}\", 2)\n        if not isinstance(items, list):\n            die(f\"or_call: {log} is not a JSON list harness log; refusing to append\", 2)\n    items.append(entry)\n    log.parent.mkdir(parents=True, exist_ok=True)\n    tmp = log.with_suffix(log.suffix + \".tmp\")\n    tmp.write_text(json.dumps(items, indent=2, ensure_ascii=False) + \"\\n\", encoding=\"utf-8\")\n    os.replace(tmp, log)\n\n\ndef _ledger_rows(ledger: Path) -> list:\n    if not ledger.exists():\n        return []\n    rows = []\n    for ln in ledger.read_text(encoding=\"utf-8\").splitlines():\n        if ln.strip():\n            rows.append(json.loads(ln))\n    return rows\n\n\ndef ledger_spent(ledger: Path) -> float:\n    rows = _ledger_rows(ledger)\n    settled = {}\n    reserved = {}\n    for r in rows:\n        if r.get(\"event\") == \"settle\":\n            settled[str(r.get(\"id\"))] = float(r.get(\"cost_usd\", 0.0))\n        elif r.get(\"event\") == \"reserve\":\n            reserved[str(r.get(\"id\"))] = float(r.get(\"worst_usd\", 0.0))\n    total = sum(settled.values())\n    total += sum(worst for rid, worst in reserved.items() if rid not in settled)\n    return total\n\n\ndef last_settle_at(ledger: Path):\n    vals = [r.get(\"at\") for r in _ledger_rows(ledger)\n            if r.get(\"event\") == \"settle\" and r.get(\"at\")]\n    return max(vals) if vals else None\n\n\ndef _append_ledger(ledger: Path, row: dict) -> None:\n    ledger.parent.mkdir(parents=True, exist_ok=True)\n    with open(ledger, \"a\", encoding=\"utf-8\") as f:\n        f.write(json.dumps(row, sort_keys=True) + \"\\n\")\n        f.flush()\n        os.fsync(f.fileno())\n\n\nclass SpendLock:\n    def __init__(self, ledger: Path):\n        self.path = ledger.parent / \".spend.lock\"\n\n    def __enter__(self):\n        self.path.parent.mkdir(parents=True, exist_ok=True)\n        self.f = open(self.path, \"a\")\n        fcntl.flock(self.f, fcntl.LOCK_EX)\n        return self\n\n    def __exit__(self, *exc):\n        fcntl.flock(self.f, fcntl.LOCK_UN)\n        self.f.close()\n\n\ndef key_usage(a, key: str, t) -> float | None:\n    try:\n        status, _, raw = t.request(\"GET\", f\"{a.base_url}/key\",\n                                   {\"Authorization\": f\"Bearer {key}\"}, None, timeout=60)\n        if status != 200:\n            return None\n        u = json.loads(raw.decode(\"utf-8\")).get(\"data\", {}).get(\"usage\")\n        return float(u) if u is not None else None\n    except Exception:\n        return None\n\n\ndef guard_state(a, job: dict, key: str, t, ledger: Path, allow_zero_baseline: bool = False) -> dict:\n    base_f = ledger.parent / \"key-usage-baseline.json\"\n    st = {\n        \"ledger\": str(ledger),\n        \"ledger_spent_usd\": round(ledger_spent(ledger), 6),\n        \"bound_usd\": float(job[\"bound_usd\"]),\n        \"reserve_usd\": float(job[\"reserve_usd\"]),\n        \"key_usage_baseline\": None,\n        \"key_usage_now\": None,\n        \"key_usage_delta_usd\": None,\n    }\n    now_u = key_usage(a, key, t)\n    if now_u is None:\n        st[\"error\"] = \"could not read key usage (GET /api/v1/key)\"\n        return st\n    st[\"key_usage_now\"] = now_u\n    if base_f.exists():\n        try:\n            baseline = float(json.loads(base_f.read_text(encoding=\"utf-8\"))[\"usage\"])\n        except Exception as exc:\n            st[\"error\"] = f\"cannot read key-usage baseline {base_f}: {exc}\"\n            return st\n    elif allow_zero_baseline and now_u == 0:\n        baseline = 0.0\n    else:\n        st[\"error\"] = (f\"no key-usage baseline at {base_f} \"\n                       \"(run --init-spend once, before the job's first call)\")\n        return st\n    st[\"key_usage_baseline\"] = baseline\n    st[\"key_usage_delta_usd\"] = round(now_u - baseline, 6)\n    st[\"spent_usd\"] = round(max(st[\"ledger_spent_usd\"], st[\"key_usage_delta_usd\"]), 6)\n    st[\"headroom_usd\"] = round(st[\"bound_usd\"] - st[\"reserve_usd\"] - st[\"spent_usd\"], 6)\n    return st\n\n\ndef init_spend(a, job: dict, transport=None) -> int:\n    t = transport or (MockTransport(a.mock_transport) if a.mock_transport else Transport())\n    ledger = Path(job[\"spend_ledger\"])\n    base_f = ledger.parent / \"key-usage-baseline.json\"\n    if ledger.exists() or base_f.exists():\n        print(f\"or_call: {ledger} or {base_f} already exists; --init-spend runs once per job\",\n              file=sys.stderr)\n        return 2\n    key = read_key(a.key_file, allow_missing=bool(a.mock_transport))\n    u = key_usage(a, key, t)\n    if u is None:\n        print(\"or_call: could not read key usage\", file=sys.stderr)\n        return 3\n    ledger.parent.mkdir(parents=True, exist_ok=True)\n    base_f.write_text(json.dumps({\"job\": job[\"job_id\"], \"usage\": u, \"at\": now(), \"writer\": writer()}) + \"\\n\",\n                      encoding=\"utf-8\")\n    print(json.dumps({\"baseline\": str(base_f), \"usage\": u}))\n    return 0\n\n\ndef spend_status(a, job: dict, transport=None) -> int:\n    t = transport or (MockTransport(a.mock_transport) if a.mock_transport else Transport())\n    ledger = Path(job[\"spend_ledger\"])\n    base_f = ledger.parent / \"key-usage-baseline.json\"\n    key = read_key(a.key_file, allow_missing=bool(a.mock_transport))\n    u = key_usage(a, key, t)\n    baseline = None\n    if base_f.exists():\n        try:\n            baseline = float(json.loads(base_f.read_text(encoding=\"utf-8\"))[\"usage\"])\n        except Exception:\n            baseline = None\n    delta = round(u - baseline, 6) if u is not None and baseline is not None else None\n    ledger_sum = round(ledger_spent(ledger), 6)\n    total = round(max(ledger_sum, delta), 6) if delta is not None else ledger_sum\n    data = {\n        \"read_at\": now(),\n        \"writer\": writer(),\n        \"job_id\": job[\"job_id\"],\n        \"key_usage_usd\": u,\n        \"baseline_usd\": baseline,\n        \"key_delta_usd\": delta,\n        \"ledger_sum_usd\": ledger_sum,\n        \"total_usd\": total,\n        \"last_settle_at\": last_settle_at(ledger),\n    }\n    if a.out:\n        out = Path(a.out)\n        out.parent.mkdir(parents=True, exist_ok=True)\n        out.write_text(json.dumps(data, indent=2) + \"\\n\", encoding=\"utf-8\")\n    else:\n        print(json.dumps(data))\n    return 0 if u is not None else 3\n\n\ndef call(a, job: dict, transport=None, sleep=time.sleep) -> int:\n    t = transport or (MockTransport(a.mock_transport) if a.mock_transport else Transport())\n    name = Path(a.log).name\n    if not re.fullmatch(r\"harness-[A-Za-z0-9._-]+\\.log\", name):\n        print(f\"or_call: log name {name!r} must be harness-<seat>[-...].log\", file=sys.stderr)\n        return 2\n    if not name.startswith(f\"harness-{a.seat}\"):\n        print(f\"or_call: log {name!r} is not this seat's (harness-{a.seat}*.log)\", file=sys.stderr)\n        return 2\n    if a.ledger:\n        tag, provider = pin_from_ledger(a.ledger, a.seat)\n        if a.tag and a.tag != tag:\n            print(f\"or_call: --tag {a.tag} differs from the ledger pin {tag}\", file=sys.stderr)\n            return 2\n    else:\n        tag, provider = a.tag, a.pin_provider\n    if not tag or not provider:\n        print(\"or_call: need --tag and --pin-provider, or --ledger\", file=sys.stderr)\n        return 2\n    price = None\n    for entry in job[\"prices\"]:\n        if entry.get(\"model\") == a.model and entry.get(\"tag\") == tag:\n            price = entry\n            break\n    if price is None:\n        print(f\"or_call: ({a.model}, {tag}) is not in the job spend price snapshot; refusing\",\n              file=sys.stderr)\n        return 2\n    p_in = float(price[\"prompt_usd_per_token\"])\n    p_out = float(price[\"completion_usd_per_token\"])\n    max_out = int(price[\"max_completion_tokens\"])\n    if a.max_tokens is None:\n        a.max_tokens = max_out\n    elif a.max_tokens != max_out:\n        print(f\"or_call: --max-tokens {a.max_tokens} != endpoint max {max_out}; \"\n              \"throttling is not allowed\", file=sys.stderr)\n        return 2\n    try:\n        messages = json.loads(Path(a.messages).read_text(encoding=\"utf-8\"))\n    except Exception as exc:\n        print(f\"or_call: cannot read --messages {a.messages}: {exc}\", file=sys.stderr)\n        return 2\n    if not isinstance(messages, list):\n        print(\"or_call: --messages must hold a JSON list of chat messages\", file=sys.stderr)\n        return 2\n    key = read_key(a.key_file, allow_missing=bool(a.mock_transport))\n    ledger = Path(job[\"spend_ledger\"])\n    worst = len(json.dumps(messages, ensure_ascii=False).encode(\"utf-8\")) * p_in + a.max_tokens * p_out\n    if a.max_cost is not None and worst > a.max_cost:\n        print(f\"or_call: REFUSED by --max-cost before sending \"\n              f\"(worst case {worst:.8f} > {a.max_cost})\", file=sys.stderr)\n        return 8\n    call_name = a.call or f\"{a.seat}_call\"\n    with SpendLock(ledger):\n        st = guard_state(a, job, key, t, ledger, allow_zero_baseline=bool(a.mock_transport))\n        st.update({\"call\": call_name, \"seat\": a.seat, \"model\": a.model, \"tag\": tag,\n                   \"worst_usd\": round(worst, 6)})\n        if \"error\" in st or st[\"spent_usd\"] + worst + float(job[\"reserve_usd\"]) >= float(job[\"bound_usd\"]):\n            st[\"decision\"] = \"REFUSED\"\n            print(json.dumps(st), file=sys.stderr)\n            print(f\"or_call: REFUSED by the job spend guard \"\n                  f\"({st.get('error') or 'spent + worst case + reserve >= bound'}); \"\n                  \"nothing sent, nothing logged\", file=sys.stderr)\n            return 6\n        st[\"decision\"] = \"ALLOWED\"\n        rid = uuid.uuid4().hex\n        _append_ledger(ledger, {\n            \"event\": \"reserve\", \"id\": rid, \"at\": now(), \"job\": job[\"job_id\"],\n            \"seat\": a.seat, \"call\": call_name, \"model\": a.model, \"tag\": tag,\n            \"max_tokens\": a.max_tokens, \"worst_usd\": round(worst, 8),\n            \"spent_before_usd\": st[\"spent_usd\"],\n        })\n    holder = {}\n    rc = 3\n    try:\n        rc = _send(a, t, sleep, key, tag, provider, messages, call_name, holder)\n    except SystemExit:\n        raise\n    except Exception as exc:\n        print(f\"or_call: internal error: {type(exc).__name__}: {exc}\", file=sys.stderr)\n        rc = 3\n    finally:\n        resp, gen = holder.get(\"resp\"), holder.get(\"gen\")\n        cost, src = worst, \"worst case (no cost stated)\"\n        g = (gen.get(\"data\") if isinstance(gen, dict) and isinstance(gen.get(\"data\"), dict) else gen) or {}\n        u = (resp.get(\"usage\") if isinstance(resp, dict) else None) or {}\n        if isinstance(g, dict) and g.get(\"total_cost\") is not None:\n            cost, src = float(g[\"total_cost\"]), \"generation.total_cost\"\n        elif isinstance(u, dict) and u.get(\"cost\") is not None:\n            cost, src = float(u[\"cost\"]), \"response.usage.cost\"\n        elif holder.get(\"status\") not in (None, 200) and not (isinstance(resp, dict) and resp.get(\"id\")):\n            cost, src = 0.0, (f\"HTTP {holder.get('status')} without a generation id \"\n                              \"(not billed; key usage reconciles)\")\n        over_cap = bool(a.max_cost is not None and cost > a.max_cost\n                        and src in (\"generation.total_cost\", \"response.usage.cost\"))\n        holder[\"over_cap\"] = over_cap\n        holder[\"cost_usd\"] = cost\n        with SpendLock(ledger):\n            settle = {\"event\": \"settle\", \"id\": rid, \"at\": now(), \"job\": job[\"job_id\"],\n                      \"call\": call_name, \"cost_usd\": cost, \"source\": src}\n            if over_cap:\n                settle[\"over_cap\"] = True\n            _append_ledger(ledger, settle)\n    if holder.get(\"over_cap\"):\n        print(f\"or_call: OVER CAP after settle (cost {holder.get('cost_usd')} > {a.max_cost}); \"\n              \"logged, no reply written\", file=sys.stderr)\n        return 9\n    if rc in (0, 5) and a.out and \"content\" in holder:\n        out = Path(a.out)\n        out.parent.mkdir(parents=True, exist_ok=True)\n        out.write_text(holder[\"content\"], encoding=\"utf-8\")\n    return rc\n\n\ndef _send(a, t, sleep, key, tag, provider, messages, call_name, holder) -> int:\n    body = {\"model\": a.model, \"messages\": messages,\n            \"provider\": {\"order\": [tag], \"allow_fallbacks\": False, \"zdr\": True},\n            \"max_tokens\": a.max_tokens}\n    if a.temperature is not None:\n        body[\"temperature\"] = a.temperature\n    url = f\"{a.base_url}/chat/completions\"\n    send_headers = {\"Authorization\": f\"Bearer {key}\", \"Content-Type\": \"application/json\",\n                    META_HEADER[0]: META_HEADER[1]}\n    log_headers = {**send_headers, \"Authorization\": REDACTED}\n    entry = {\n        \"call\": call_name,\n        \"seat\": a.seat,\n        \"request\": {\"method\": \"POST\", \"url\": url, \"headers\": log_headers, \"body\": body},\n        \"harness\": {\"name\": HARNESS_NAME, \"sha256\": file_sha256()},\n    }\n    entry[\"sent_at\"] = now()\n    try:\n        status, hdrs, raw = t.request(\"POST\", url, send_headers, json.dumps(body).encode())\n    except Exception as exc:\n        entry.update({\n            \"received_at\": now(),\n            \"response_status\": None,\n            \"response_headers\": {},\n            \"response\": None,\n            \"transport_error\": f\"{type(exc).__name__}: {exc}\",\n            \"generation\": None,\n            \"generation_status\": None,\n            \"generation_fetched_at\": None,\n            \"verdict\": {\"ok\": False, \"refusal\": \"transport error\"},\n        })\n        append_entry(Path(a.log), entry, key)\n        print(f\"or_call: transport error, logged: {type(exc).__name__}\", file=sys.stderr)\n        return 3\n    entry[\"received_at\"] = now()\n    entry[\"response_status\"], entry[\"response_headers\"] = status, hdrs\n    holder[\"status\"] = status\n    try:\n        resp = json.loads(raw.decode(\"utf-8\"))\n    except ValueError:\n        resp = {\"_raw_text\": raw.decode(\"utf-8\", \"replace\")}\n    entry[\"response\"] = resp\n    holder[\"resp\"] = resp\n    if status != 200 or not isinstance(resp, dict) or not resp.get(\"id\"):\n        entry.update({\n            \"generation\": None,\n            \"generation_status\": None,\n            \"generation_fetched_at\": None,\n            \"verdict\": {\"ok\": False, \"refusal\": f\"HTTP {status}\"},\n        })\n        append_entry(Path(a.log), entry, key)\n        print(f\"or_call: HTTP {status}, logged\", file=sys.stderr)\n        return 3\n    gen, gstatus = None, None\n    for attempt in range(a.gen_tries):\n        gurl = f\"{a.base_url}/generation?id={resp['id']}\"\n        try:\n            gstatus, _, graw = t.request(\"GET\", gurl, {\"Authorization\": f\"Bearer {key}\"},\n                                         None, timeout=60)\n            if gstatus == 200:\n                gen = json.loads(graw.decode(\"utf-8\"))\n                break\n        except Exception as exc:\n            gstatus = f\"{type(exc).__name__}\"\n        if attempt + 1 < a.gen_tries:\n            sleep(a.gen_wait)\n    entry[\"generation\"], entry[\"generation_status\"], entry[\"generation_fetched_at\"] = gen, gstatus, now()\n    holder[\"gen\"] = gen\n    served, tried = served_by(resp, gen)\n    bad = {s: n for s, n in served.items() if not pin_ok(n, provider, tag)}\n    fallback = sorted({n for n in tried if not pin_ok(n, provider, tag)})\n    refusal = None\n    if not served:\n        refusal = \"the response and generation reply do not say which provider served the call\"\n    elif bad:\n        refusal = \"served by \" + \", \".join(f\"{n!r} ({s})\" for s, n in bad.items()) + \\\n                  f\", not the pin {provider!r} ({tag})\"\n    elif fallback:\n        refusal = f\"a fallback was tried: {fallback}\"\n    entry[\"verdict\"] = {\n        \"pin\": {\"tag\": tag, \"provider\": provider},\n        \"served_by\": served,\n        \"tried\": tried,\n        \"ok\": refusal is None,\n        \"refusal\": refusal,\n        \"generation_reply\": gen is not None,\n    }\n    append_entry(Path(a.log), entry, key)\n    content = ((resp.get(\"choices\") or [{}])[0].get(\"message\") or {}).get(\"content\") or \"\"\n    holder[\"content\"] = content\n    if refusal:\n        print(f\"or_call: REFUSED ({refusal}); logged to {a.log}; no reply written\", file=sys.stderr)\n        return 4\n    if gen is None:\n        print(f\"or_call: served by the pin, but no /api/v1/generation reply after \"\n              f\"{a.gen_tries} tries (last status {gstatus}); logged with generation null\",\n              file=sys.stderr)\n        return 5\n    print(json.dumps({\n        \"logged\": a.log,\n        \"call\": entry[\"call\"],\n        \"id\": resp[\"id\"],\n        \"served_by\": served,\n        \"date\": next((v for k, v in hdrs.items() if k.lower() == \"date\"), None),\n    }))\n    return 0\n\n\ndef check_key(a, transport=None) -> int:\n    \"\"\"Read-only GET /api/v1/key: proves the key works; prints only status, limit and usage.\"\"\"\n    t = transport or (MockTransport(a.mock_transport) if a.mock_transport else Transport())\n    key = read_key(a.key_file, allow_missing=bool(a.mock_transport))\n    status, _, raw = t.request(\"GET\", f\"{a.base_url}/key\", {\"Authorization\": f\"Bearer {key}\"},\n                               None, timeout=60)\n    d = json.loads(raw.decode(\"utf-8\")).get(\"data\", {}) if status == 200 else {}\n    print(json.dumps({\"status\": status, \"limit\": d.get(\"limit\"), \"usage\": d.get(\"usage\")}))\n    return 0 if status == 200 else 3\n\n\ndef parser() -> argparse.ArgumentParser:\n    ap = argparse.ArgumentParser(description=\"One logged OpenRouter call for a job seat.\")\n    ap.add_argument(\"--key-file\", default=KEY_FILE)\n    ap.add_argument(\"--base-url\", default=BASE)\n    ap.add_argument(\"--check-key\", action=\"store_true\", help=\"read-only GET /api/v1/key, then exit\")\n    ap.add_argument(\"--seat\")\n    ap.add_argument(\"--log\")\n    ap.add_argument(\"--model\")\n    ap.add_argument(\"--tag\")\n    ap.add_argument(\"--pin-provider\")\n    ap.add_argument(\"--ledger\")\n    ap.add_argument(\"--messages\")\n    ap.add_argument(\"--out\")\n    ap.add_argument(\"--call\")\n    ap.add_argument(\"--max-tokens\", type=int)\n    ap.add_argument(\"--temperature\", type=float)\n    ap.add_argument(\"--gen-tries\", type=int, default=6)\n    ap.add_argument(\"--gen-wait\", type=float, default=5.0)\n    ap.add_argument(\"--job-spend\")\n    ap.add_argument(\"--mock-transport\")\n    ap.add_argument(\"--init-spend\", action=\"store_true\",\n                    help=\"record the key-usage baseline once, then exit\")\n    ap.add_argument(\"--spend-status\", action=\"store_true\",\n                    help=\"write or print guard state, then exit\")\n    ap.add_argument(\"--max-cost\", type=float)\n    ap.add_argument(\"--spend-ledger\", help=argparse.SUPPRESS)\n    return ap\n\n\ndef main(argv=None) -> int:\n    a = parser().parse_args(argv)\n    if a.check_key:\n        return check_key(a)\n    if a.init_spend:\n        if not a.job_spend:\n            print(\"or_call: --job-spend is required\", file=sys.stderr)\n            return 2\n        return init_spend(a, load_job_spend(a.job_spend))\n    if a.spend_status:\n        if not a.job_spend:\n            print(\"or_call: --job-spend is required\", file=sys.stderr)\n            return 2\n        return spend_status(a, load_job_spend(a.job_spend))\n    if not a.job_spend:\n        print(\"or_call: --job-spend is required\", file=sys.stderr)\n        return 2\n    job = load_job_spend(a.job_spend)\n    for k in (\"seat\", \"log\", \"model\", \"messages\"):\n        if not getattr(a, k):\n            print(f\"or_call: --{k.replace('_', '-')} is required\", file=sys.stderr)\n            return 2\n    return call(a, job)\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n<<<PLUMBLINE-END path=tools/edi/or_call.py>>>\n<<<PLUMBLINE-FILE path=tools/edi/judge_batch.py>>>\n#!/usr/bin/env python3\n\"\"\"tools/edi/judge_batch.py: a model-judge batch with rotating order.\n\n    judge_batch.py --items ITEMS.json --batch N --rubric FILE --out DIR \\\n                   --job-spend F --log L --model M \\\n                   (--tag T --pin-provider P | --ledger LED) [--mock-transport D]\n\nITEMS.json is a list of {id, text}.  The order for batch N is the list rotated\nleft by (N-1) mod len.  One tools/edi/or_call.py call is made per item.  The\nsummary is DIR/summary.json with started_at, finished_at, writer, batch,\norder (ids) and results ({id, call, exit, reply_file}).\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport re\nimport subprocess\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nHARNESS_NAME = \"tools/edi/judge_batch.py\"\n\n\ndef now() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n\n\ndef writer() -> str:\n    sha = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()[:12]\n    return f\"{HARNESS_NAME}@{sha}\"\n\n\ndef seat_from_log(log: str) -> str:\n    m = re.match(r\"harness-([A-Za-z0-9]+)\", Path(log).name)\n    return m.group(1) if m else \"judge\"\n\n\ndef safe_name(value: str) -> str:\n    s = re.sub(r\"[^A-Za-z0-9._-]+\", \"_\", value).strip(\"._-\")\n    return s or \"item\"\n\n\ndef main(argv=None) -> int:\n    ap = argparse.ArgumentParser(description=\"Run a rotating model-judge batch.\")\n    ap.add_argument(\"--items\", required=True)\n    ap.add_argument(\"--batch\", type=int, required=True)\n    ap.add_argument(\"--rubric\", required=True)\n    ap.add_argument(\"--out\", required=True)\n    ap.add_argument(\"--job-spend\", required=True)\n    ap.add_argument(\"--log\", required=True)\n    ap.add_argument(\"--model\", required=True)\n    g = ap.add_mutually_exclusive_group(required=True)\n    g.add_argument(\"--tag\")\n    g.add_argument(\"--ledger\")\n    ap.add_argument(\"--pin-provider\")\n    ap.add_argument(\"--mock-transport\")\n    ap.add_argument(\"--key-file\")\n    ap.add_argument(\"--base-url\")\n    ap.add_argument(\"--seat\")\n    a = ap.parse_args(argv)\n\n    if a.tag and not a.pin_provider:\n        print(\"judge_batch: --pin-provider is required with --tag\", file=sys.stderr)\n        return 2\n    try:\n        items = json.loads(Path(a.items).read_text(encoding=\"utf-8\"))\n    except Exception as exc:\n        print(f\"judge_batch: cannot read --items {a.items}: {exc}\", file=sys.stderr)\n        return 2\n    if not isinstance(items, list):\n        print(\"judge_batch: --items must hold a JSON list\", file=sys.stderr)\n        return 2\n    for item in items:\n        if not isinstance(item, dict) or \"id\" not in item or \"text\" not in item:\n            print(\"judge_batch: every item must be an object with id and text\", file=sys.stderr)\n            return 2\n    try:\n        rubric = Path(a.rubric).read_text(encoding=\"utf-8\")\n    except OSError as exc:\n        print(f\"judge_batch: cannot read --rubric {a.rubric}: {exc}\", file=sys.stderr)\n        return 2\n\n    out = Path(a.out)\n    out.mkdir(parents=True, exist_ok=True)\n    or_call = Path(__file__).with_name(\"or_call.py\")\n    if not or_call.is_file():\n        print(f\"judge_batch: missing sibling {or_call}\", file=sys.stderr)\n        return 2\n\n    started = now()\n    n = len(items)\n    k = ((a.batch - 1) % n) if n else 0\n    ordered = items[k:] + items[:k]\n    seat = a.seat or seat_from_log(a.log)\n    results = []\n\n    for idx, item in enumerate(ordered):\n        item_id = str(item[\"id\"])\n        safe = safe_name(item_id)\n        call_name = f\"batch{a.batch}_{idx:03d}_{safe}\"\n        msg_path = out / f\"messages-{idx:03d}-{safe}.json\"\n        msg_path.write_text(json.dumps([\n            {\"role\": \"system\", \"content\": rubric},\n            {\"role\": \"user\", \"content\": str(item[\"text\"])},\n        ], indent=2) + \"\\n\", encoding=\"utf-8\")\n        reply_path = out / f\"reply-{idx:03d}-{safe}.txt\"\n        cmd = [\n            sys.executable, str(or_call),\n            \"--seat\", seat,\n            \"--log\", a.log,\n            \"--model\", a.model,\n            \"--messages\", str(msg_path),\n            \"--out\", str(reply_path),\n            \"--call\", call_name,\n            \"--job-spend\", a.job_spend,\n        ]\n        if a.ledger:\n            cmd += [\"--ledger\", a.ledger]\n        else:\n            cmd += [\"--tag\", a.tag, \"--pin-provider\", a.pin_provider]\n        if a.mock_transport:\n            cmd += [\"--mock-transport\", a.mock_transport]\n        if a.key_file:\n            cmd += [\"--key-file\", a.key_file]\n        if a.base_url:\n            cmd += [\"--base-url\", a.base_url]\n        proc = subprocess.run(cmd)\n        results.append({\n            \"id\": item_id,\n            \"call\": call_name,\n            \"exit\": proc.returncode,\n            \"reply_file\": str(reply_path),\n        })\n\n    summary = {\n        \"started_at\": started,\n        \"finished_at\": now(),\n        \"writer\": writer(),\n        \"batch\": a.batch,\n        \"order\": [str(i[\"id\"]) for i in ordered],\n        \"results\": results,\n    }\n    (out / \"summary.json\").write_text(json.dumps(summary, indent=2) + \"\\n\", encoding=\"utf-8\")\n    return 0 if all(r[\"exit\"] == 0 for r in results) else 1\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n<<<PLUMBLINE-END path=tools/edi/judge_batch.py>>>\n<<<PLUMBLINE-FILE path=tools/edi/fixture_run.py>>>\n#!/usr/bin/env python3\n\"\"\"tools/edi/fixture_run.py: run a fixture tree from a writable copy.\n\n    fixture_run.py --src DIR --work DIR --summary FILE\n\nCopies src into work, making every copied file owner-writable and every copied\ndirectory owner-writable and searchable, whatever the source modes were.  The\nsummary is {started_at, finished_at, writer, files: [{path, sha256, mode}]}\nwith paths relative to work and mode as an octal string.  Two runs from the same\ncontents differ only in started_at and finished_at.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport os\nimport shutil\nimport stat\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nHARNESS_NAME = \"tools/edi/fixture_run.py\"\n\n\ndef now() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n\n\ndef writer() -> str:\n    sha = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()[:12]\n    return f\"{HARNESS_NAME}@{sha}\"\n\n\ndef _force_rmtree(path: Path) -> None:\n    if path.is_symlink() or path.is_file():\n        path.unlink()\n        return\n    if not path.exists():\n        return\n    for root, dirs, files in os.walk(path):\n        for d in dirs:\n            os.chmod(Path(root) / d, 0o700)\n        for f in files:\n            os.chmod(Path(root) / f, 0o600)\n    os.chmod(path, 0o700)\n    shutil.rmtree(path)\n\n\ndef copy_writable(src: Path, work: Path) -> None:\n    _force_rmtree(work)\n    work.mkdir(parents=True, exist_ok=True)\n    for root, dirs, files in os.walk(src):\n        rel = Path(root).relative_to(src)\n        wroot = work / rel\n        wroot.mkdir(parents=True, exist_ok=True)\n        os.chmod(wroot, (stat.S_IMODE(os.stat(wroot).st_mode) & 0o777) | 0o700)\n        for name in files:\n            s = Path(root) / name\n            d = wroot / name\n            shutil.copyfile(s, d)\n            os.chmod(d, (stat.S_IMODE(os.stat(d).st_mode) & 0o777) | 0o600)\n    for root, dirs, files in os.walk(work):\n        os.chmod(root, (stat.S_IMODE(os.stat(root).st_mode) & 0o777) | 0o700)\n        for name in files:\n            p = Path(root) / name\n            os.chmod(p, (stat.S_IMODE(os.stat(p).st_mode) & 0o777) | 0o600)\n\n\ndef main(argv=None) -> int:\n    ap = argparse.ArgumentParser(description=\"Copy a fixture tree into a writable work tree.\")\n    ap.add_argument(\"--src\", required=True)\n    ap.add_argument(\"--work\", required=True)\n    ap.add_argument(\"--summary\", required=True)\n    a = ap.parse_args(argv)\n    src, work, summary = Path(a.src), Path(a.work), Path(a.summary)\n    if not src.is_dir():\n        print(f\"fixture_run: --src {src} is not a directory\", file=sys.stderr)\n        return 2\n    started = now()\n    try:\n        copy_writable(src, work)\n        files = []\n        for root, dirs, names in os.walk(work):\n            for name in names:\n                p = Path(root) / name\n                rel = p.relative_to(work).as_posix()\n                files.append({\n                    \"path\": rel,\n                    \"sha256\": hashlib.sha256(p.read_bytes()).hexdigest(),\n                    \"mode\": oct(stat.S_IMODE(p.stat().st_mode) & 0o777),\n                })\n        files.sort(key=lambda x: x[\"path\"])\n        finished = now()\n        summary.parent.mkdir(parents=True, exist_ok=True)\n        summary.write_text(json.dumps({\n            \"started_at\": started,\n            \"finished_at\": finished,\n            \"writer\": writer(),\n            \"files\": files,\n        }, indent=2) + \"\\n\", encoding=\"utf-8\")\n    except Exception as exc:\n        print(f\"fixture_run: {type(exc).__name__}: {exc}\", file=sys.stderr)\n        return 1\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n<<<PLUMBLINE-END path=tools/edi/fixture_run.py>>>\n<<<PLUMBLINE-FILE path=tools/edi/extract_files.py>>>\n#!/usr/bin/env python3\n\"\"\"tools/edi/extract_files.py: write a whole-file reply into a checkout.\n\n    extract_files.py REPLY.txt TARGET_DIR [--list OUT.txt] [--check]\n\nThe reply format is the Maker output contract: one FILE marker line, the\ncomplete new contents, one matching END line, repeated, then one DONE line with\nthe block count, then optional NOTES lines.  The bytes between the FILE and END\nlines are written exactly as they appear; the extractor adds and strips nothing.\n\nAll checks run before anything is written.  A malformed marker, a missing END,\na wrong DONE count, stray text, a bad or duplicate path, or an unsafe target\nmakes the command exit 1 with a one-line reason and writes nothing.  --check\nvalidates only.  Exit 2 is a usage error.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport re\nimport sys\nfrom pathlib import Path\n\nPFX = b\"<<<PLUMBLINE-\"\nRE_FILE = re.compile(rb\"<<<PLUMBLINE-FILE path=([^\\s>]+)>>>\\n\\Z\")\nRE_END = re.compile(rb\"<<<PLUMBLINE-END path=([^\\s>]+)>>>\\n\\Z\")\nRE_DONE = re.compile(rb\"<<<PLUMBLINE-DONE files=(0|[1-9][0-9]*)>>>\\n?\\Z\")\nRE_PATH = re.compile(r\"[!-~]+\\Z\")\n\n\nclass Refuse(Exception):\n    pass\n\n\ndef check_path(p: str) -> None:\n    if not RE_PATH.match(p) or \"\\\\\" in p or p.startswith(\"/\"):\n        raise Refuse(f\"bad path {p!r}\")\n    if any(s in (\"\", \".\", \"..\") for s in p.split(\"/\")):\n        raise Refuse(f\"bad path {p!r}\")\n\n\ndef parse(data: bytes) -> list[tuple[str, bytes]]:\n    lines = [ln for ln in re.split(rb\"(?<=\\n)\", data) if ln]\n    files: list[tuple[str, bytes]] = []\n    seen: set[str] = set()\n    i, n, done = 0, len(lines), None\n    while i < n:\n        ln = lines[i]\n        if ln.startswith(PFX):\n            m = RE_FILE.match(ln)\n            if m:\n                path = m.group(1).decode(\"ascii\")\n                check_path(path)\n                if path in seen:\n                    raise Refuse(f\"path returned twice: {path}\")\n                seen.add(path)\n                start = i + 1\n                j = start\n                endtxt = f\"<<<PLUMBLINE-END path={path}>>>\".encode()\n                while j < n and not lines[j].startswith(PFX):\n                    if endtxt in lines[j]:\n                        raise Refuse(\n                            f\"line {j + 1}: END marker for {path} is not at the start of a line \"\n                            \"(the file's last line must end with a newline before the END line)\"\n                        )\n                    j += 1\n                if j >= n:\n                    raise Refuse(f\"block for {path} (FILE at line {i + 1}) has no END line: reply truncated\")\n                e = RE_END.match(lines[j])\n                if not e:\n                    raise Refuse(\n                        f\"line {j + 1}: expected END for {path}, got a malformed or other marker line \"\n                        \"(a content line may not start with the marker prefix)\"\n                    )\n                if e.group(1).decode(\"ascii\", \"replace\") != path:\n                    raise Refuse(\n                        f\"line {j + 1}: END path {e.group(1).decode('ascii', 'replace')!r} \"\n                        f\"does not match FILE path {path!r}\"\n                    )\n                files.append((path, b\"\".join(lines[start:j])))\n                i = j + 1\n                continue\n            d = RE_DONE.match(ln)\n            if d:\n                done = (i, int(d.group(1)))\n                break\n            raise Refuse(f\"line {i + 1}: malformed or unexpected marker line {ln[:80]!r}\")\n        if ln.strip(b\" \\t\\r\\n\"):\n            raise Refuse(f\"line {i + 1}: text outside a file block before DONE: {ln[:80]!r}\")\n        i += 1\n    if done is None:\n        raise Refuse(\"no DONE line: reply truncated or malformed\")\n    at, count = done\n    if count != len(files):\n        raise Refuse(f\"DONE says files={count} but the reply has {len(files)} file block(s)\")\n    if not files:\n        raise Refuse(\"the reply returns no files\")\n    notes = 0\n    for k in range(at + 1, n):\n        ln = lines[k]\n        if not ln.strip(b\" \\t\\r\\n\"):\n            continue\n        if ln.startswith(b\"NOTES:\"):\n            notes += 1\n            if notes > 20:\n                raise Refuse(\"more than 20 NOTES: lines after DONE\")\n            continue\n        raise Refuse(f\"line {k + 1}: text after DONE that is not a NOTES: line: {ln[:80]!r}\")\n    if not lines[at].endswith(b\"\\n\") and at != n - 1:\n        raise Refuse(\"malformed DONE line\")\n    return files\n\n\ndef main(argv: list[str]) -> int:\n    ap = argparse.ArgumentParser(description=\"Write whole-file reply blocks into a checkout.\")\n    ap.add_argument(\"reply\")\n    ap.add_argument(\"target\")\n    ap.add_argument(\"--list\", dest=\"list_out\")\n    ap.add_argument(\"--check\", action=\"store_true\")\n    a = ap.parse_args(argv)\n    reply, root = Path(a.reply), Path(a.target)\n    try:\n        files = parse(reply.read_bytes())\n        if not root.is_dir():\n            raise Refuse(f\"target dir {root} does not exist\")\n        rr = root.resolve()\n        for path, _ in files:\n            t = root / path\n            cur = root\n            for seg in path.split(\"/\"):\n                cur = cur / seg\n                if cur.is_symlink():\n                    raise Refuse(f\"{path}: {cur} is a symlink\")\n            if t.exists() and not t.is_file():\n                raise Refuse(f\"{path}: target exists and is not a regular file\")\n            if rr not in t.resolve().parents:\n                raise Refuse(f\"{path}: resolves outside the target dir\")\n    except (Refuse, OSError) as e:\n        print(f\"extract_files: {e}; nothing written\", file=sys.stderr)\n        return 1\n    if a.check:\n        for path, body in files:\n            print(f\"extract_files: ok {path} ({len(body)} bytes, \"\n                  f\"sha256 {hashlib.sha256(body).hexdigest()})\")\n        return 0\n    for path, body in files:\n        t = root / path\n        t.parent.mkdir(parents=True, exist_ok=True)\n        t.write_bytes(body)\n        print(f\"extract_files: wrote {path} ({len(body)} bytes, \"\n              f\"sha256 {hashlib.sha256(body).hexdigest()})\")\n    if a.list_out:\n        Path(a.list_out).write_text(\"\".join(p + \"\\n\" for p, _ in files), encoding=\"utf-8\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv[1:]))\n<<<PLUMBLINE-END path=tools/edi/extract_files.py>>>\n<<<PLUMBLINE-FILE path=tools/edi/README.md>>>\n# tools/edi\n\nProduct-harness helpers for E-DI jobs.  They are ordinary command-line tools:\nstandard library only, no network except `or_call.py`, and every instrument that\nwrites a summary stamps `started_at`, `finished_at` (UTC Z, its own clock) and\n`writer: \"tools/edi/<file>@<sha12>\"`.\n\n## `or_call.py`\n\nOne logged OpenRouter chat call for a seat.  It keeps the job-1 harness log shape\n(`call`, `seat`, `request`, `sent_at`, `response_status`, `response_headers`,\n`response`, `received_at`, `generation`, `generation_status`,\n`generation_fetched_at`, `harness`, `verdict`), so `kit/custody_history.read_log`\ncan read it.\n\nRequired job spend file for calls, `--init-spend` and `--spend-status`:\n\n```json\n{\n  \"job_id\": \"job-id\",\n  \"bound_usd\": 2.0,\n  \"reserve_usd\": 0.05,\n  \"spend_ledger\": \"/path/to/spend-ledger.jsonl\",\n  \"prices\": [\n    {\"model\": \"model\", \"tag\": \"provider/fp8\",\n     \"prompt_usd_per_token\": 0.0000001,\n     \"completion_usd_per_token\": 0.0000003,\n     \"max_completion_tokens\": 131072}\n  ]\n}\n```\n\nThe job total is `max(spend-ledger sum, key-usage delta)`.  It is read with a\nfree `GET /api/v1/key` before every call, and the call is refused when\n`total + worst case + reserve >= bound`.  `max_tokens` is always the endpoint\nmaximum; a different `--max-tokens` is refused.  There is no throttling and no\nreasoning-limit parameter.\n\nUseful flags:\n\n- `--init-spend`: write `key-usage-baseline.json` beside the spend ledger once.\n- `--spend-status --out R`: write the stamped key/ledger reading.\n- `--max-cost X`: refuse before sending when the worst case is greater than X;\n  if the settled cost is greater than X, exit 9, mark the settle line\n  `over_cap`, and write no reply.\n- `--mock-transport DIR`: no network.  Replies come from `DIR/key.json`,\n  `DIR/chat.json` and `DIR/generation.json`; requests are recorded in\n  `DIR/requests.jsonl` with no headers or key material.\n\nExit codes: 0 logged and served by the pin; 2 usage/key/job-spend error;\n3 HTTP or transport error; 4 provider-pin refusal; 5 no generation reply;\n6 job-spend bound refusal; 8 `--max-cost` refusal before sending; 9 over the cap\nafter settle.\n\n## `judge_batch.py`\n\nRuns one `or_call.py` per item in a rotated order.  The order for batch N is the\nitem list rotated left by `(N-1) mod len`.  It writes `DIR/summary.json` with\n`started_at`, `finished_at`, `writer`, `batch`, `order` (ids) and `results`\n(`{id, call, exit, reply_file}`).\n\n## `fixture_run.py`\n\nCopies a fixture tree into a working directory and makes every copied file\nowner-writable and every copied directory owner-writable and searchable, even\nwhen the source is read-only.  It writes a summary with `started_at`,\n`finished_at`, `writer` and `files` (`{path, sha256, mode}`).  Two runs from the\nsame contents differ only in the two timestamps.\n\n## `extract_files.py`\n\nThe whole-file reply extractor.  `extract_files.py REPLY.txt TARGET_DIR` writes\nthe blocks; `--check` validates only; `--list OUT.txt` records the written paths.\nIt validates every block before writing anything and never normalizes file\nbytes.\n<<<PLUMBLINE-END path=tools/edi/README.md>>>\n<<<PLUMBLINE-FILE path=tests/test_edi_fixture_run.py>>>\nimport hashlib\nimport json\nimport os\nimport stat\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[1]\nFIXTURE_RUN = ROOT / \"tools\" / \"edi\" / \"fixture_run.py\"\n\n\ndef chmod_tree(root: Path, file_mode: int = 0o644, dir_mode: int = 0o755) -> None:\n    for base, dirs, files in os.walk(root):\n        for d in dirs:\n            os.chmod(Path(base) / d, dir_mode)\n        for f in files:\n            os.chmod(Path(base) / f, file_mode)\n    os.chmod(root, dir_mode)\n\n\nclass TestFixtureRun(unittest.TestCase):\n    def test_read_only_source_copies_writable_and_reproducible(self):\n        with tempfile.TemporaryDirectory() as td:\n            td = Path(td)\n            src = td / \"src\"\n            (src / \"sub\").mkdir(parents=True)\n            (src / \"a.txt\").write_text(\"alpha\\n\", encoding=\"utf-8\")\n            (src / \"sub\" / \"b.bin\").write_bytes(b\"\\x00\\x01\")\n            os.chmod(src / \"a.txt\", 0o444)\n            os.chmod(src / \"sub\" / \"b.bin\", 0o400)\n            os.chmod(src / \"sub\", 0o555)\n            os.chmod(src, 0o555)\n            try:\n                work1 = td / \"work1\"\n                sum1 = td / \"sum1.json\"\n                r = subprocess.run([\n                    sys.executable, str(FIXTURE_RUN),\n                    \"--src\", str(src), \"--work\", str(work1), \"--summary\", str(sum1),\n                ], capture_output=True, text=True)\n                self.assertEqual(r.returncode, 0, r.stderr)\n                for p in work1.rglob(\"*\"):\n                    if p.is_file():\n                        self.assertTrue(os.access(p, os.W_OK), f\"{p} is not writable\")\n                self.assertEqual((work1 / \"a.txt\").read_bytes(), b\"alpha\\n\")\n                s1 = json.loads(sum1.read_text(encoding=\"utf-8\"))\n                self.assertIn(\"started_at\", s1)\n                self.assertIn(\"finished_at\", s1)\n                self.assertTrue(s1[\"writer\"].startswith(\"tools/edi/fixture_run.py@\"))\n                self.assertEqual({f[\"path\"] for f in s1[\"files\"]}, {\"a.txt\", \"sub/b.bin\"})\n                for f in s1[\"files\"]:\n                    self.assertIsInstance(f[\"mode\"], str)\n                    self.assertTrue(int(f[\"mode\"].replace(\"0o\", \"\"), 8) & 0o200)\n\n                work2 = td / \"work2\"\n                sum2 = td / \"sum2.json\"\n                r = subprocess.run([\n                    sys.executable, str(FIXTURE_RUN),\n                    \"--src\", str(src), \"--work\", str(work2), \"--summary\", str(sum2),\n                ], capture_output=True, text=True)\n                self.assertEqual(r.returncode, 0, r.stderr)\n                s2 = json.loads(sum2.read_text(encoding=\"utf-8\"))\n                self.assertEqual(s1[\"files\"], s2[\"files\"])\n            finally:\n                chmod_tree(src)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n<<<PLUMBLINE-END path=tests/test_edi_fixture_run.py>>>\n<<<PLUMBLINE-FILE path=tests/test_edi_or_call.py>>>\nimport json\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[1]\nOR_CALL = ROOT / \"tools\" / \"edi\" / \"or_call.py\"\n\n\ndef write_json(path: Path, obj) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    path.write_text(json.dumps(obj, indent=2) + \"\\n\", encoding=\"utf-8\")\n\n\ndef make_job(td: Path, bound: float = 1.0, reserve: float = 0.0):\n    spend = td / \"spend\" / \"ledger.jsonl\"\n    job = {\n        \"job_id\": \"test-job\",\n        \"bound_usd\": bound,\n        \"reserve_usd\": reserve,\n        \"spend_ledger\": str(spend),\n        \"prices\": [{\n            \"model\": \"test/model\",\n            \"tag\": \"test/fp8\",\n            \"prompt_usd_per_token\": 0.001,\n            \"completion_usd_per_token\": 0.002,\n            \"max_completion_tokens\": 100,\n        }],\n    }\n    write_json(td / \"job-spend.json\", job)\n    return job, td / \"job-spend.json\"\n\n\ndef make_messages(td: Path) -> None:\n    write_json(td / \"messages.json\", [{\"role\": \"user\", \"content\": \"hi\"}])\n\n\ndef make_mock(mock: Path, usage: float = 0.0, total_cost: float = 0.01,\n              provider: str = \"test\") -> None:\n    mock.mkdir(parents=True, exist_ok=True)\n    write_json(mock / \"key.json\", {\n        \"status\": 200,\n        \"headers\": {},\n        \"body\": {\"data\": {\"usage\": usage}},\n    })\n    write_json(mock / \"chat.json\", {\n        \"status\": 200,\n        \"headers\": {\"Date\": \"Wed, 01 Jan 2025 00:00:00 GMT\"},\n        \"body\": {\n            \"id\": \"gen-1\",\n            \"provider\": provider,\n            \"choices\": [{\"message\": {\"content\": \"reply\"}}],\n            \"usage\": {\"cost\": 0.01},\n        },\n    })\n    write_json(mock / \"generation.json\", {\n        \"status\": 200,\n        \"headers\": {},\n        \"body\": {\"data\": {\"total_cost\": total_cost, \"provider_name\": provider}},\n    })\n\n\ndef run_call(td: Path, mock: Path, *extra: str) -> subprocess.CompletedProcess:\n    cmd = [\n        sys.executable, str(OR_CALL),\n        \"--seat\", \"maker\",\n        \"--log\", str(td / \"harness-maker.log\"),\n        \"--model\", \"test/model\",\n        \"--tag\", \"test/fp8\",\n        \"--pin-provider\", \"test\",\n        \"--messages\", str(td / \"messages.json\"),\n        \"--out\", str(td / \"reply.txt\"),\n        \"--job-spend\", str(td / \"job-spend.json\"),\n        \"--mock-transport\", str(mock),\n    ]\n    cmd += list(extra)\n    return subprocess.run(cmd, capture_output=True, text=True)\n\n\nclass TestOrCallSpend(unittest.TestCase):\n    def test_mock_call_writes_job1_log_entry_and_status(self):\n        with tempfile.TemporaryDirectory() as td:\n            td = Path(td)\n            make_job(td)\n            make_messages(td)\n            mock = td / \"mock\"\n            make_mock(mock)\n            r = run_call(td, mock)\n            self.assertEqual(r.returncode, 0, r.stderr)\n            self.assertEqual((td / \"reply.txt\").read_text(encoding=\"utf-8\"), \"reply\")\n\n            entries = json.loads((td / \"harness-maker.log\").read_text(encoding=\"utf-8\"))\n            self.assertEqual(len(entries), 1)\n            e = entries[0]\n            for key in (\"call\", \"seat\", \"request\", \"sent_at\", \"response_status\",\n                        \"response_headers\", \"response\", \"received_at\", \"generation\",\n                        \"generation_status\", \"generation_fetched_at\", \"harness\", \"verdict\"):\n                self.assertIn(key, e)\n            self.assertEqual(e[\"request\"][\"headers\"][\"Authorization\"], \"Bearer [REDACTED]\")\n            self.assertTrue(e[\"verdict\"][\"ok\"])\n            self.assertTrue(e[\"harness\"][\"name\"].endswith(\"tools/edi/or_call.py\"))\n\n            rows = [json.loads(line) for line in\n                    (td / \"spend\" / \"ledger.jsonl\").read_text(encoding=\"utf-8\").splitlines()\n                    if line.strip()]\n            self.assertEqual([row[\"event\"] for row in rows], [\"reserve\", \"settle\"])\n\n            status = td / \"status.json\"\n            r = subprocess.run([\n                sys.executable, str(OR_CALL),\n                \"--spend-status\", \"--out\", str(status),\n                \"--job-spend\", str(td / \"job-spend.json\"),\n                \"--mock-transport\", str(mock),\n            ], capture_output=True, text=True)\n            self.assertEqual(r.returncode, 0, r.stderr)\n            st = json.loads(status.read_text(encoding=\"utf-8\"))\n            for key in (\"read_at\", \"writer\", \"job_id\", \"key_usage_usd\", \"baseline_usd\",\n                        \"key_delta_usd\", \"ledger_sum_usd\", \"total_usd\", \"last_settle_at\"):\n                self.assertIn(key, st)\n            self.assertTrue(st[\"writer\"].startswith(\"tools/edi/or_call.py@\"))\n\n    def test_key_at_job_limit_refused_before_chat(self):\n        with tempfile.TemporaryDirectory() as td:\n            td = Path(td)\n            make_job(td)\n            make_messages(td)\n            mock = td / \"mock\"\n            make_mock(mock, usage=0.0)\n            r = subprocess.run([\n                sys.executable, str(OR_CALL),\n                \"--init-spend\",\n                \"--job-spend\", str(td / \"job-spend.json\"),\n                \"--mock-transport\", str(mock),\n            ], capture_output=True, text=True)\n            self.assertEqual(r.returncode, 0, r.stderr)\n            make_mock(mock, usage=5.0)\n            r = run_call(td, mock)\n            self.assertEqual(r.returncode, 6, r.stderr)\n            self.assertFalse((td / \"harness-maker.log\").exists())\n            reqs = [json.loads(line) for line in\n                    (mock / \"requests.jsonl\").read_text(encoding=\"utf-8\").splitlines()\n                    if line.strip()]\n            self.assertFalse(any(x[\"method\"] == \"POST\" for x in reqs))\n\n    def test_max_cost_before_send_writes_nothing(self):\n        with tempfile.TemporaryDirectory() as td:\n            td = Path(td)\n            make_job(td)\n            make_messages(td)\n            mock = td / \"mock\"\n            make_mock(mock)\n            r = run_call(td, mock, \"--max-cost\", \"0.0001\")\n            self.assertEqual(r.returncode, 8, r.stderr)\n            self.assertFalse((td / \"harness-maker.log\").exists())\n            self.assertFalse((mock / \"requests.jsonl\").exists())\n\n    def test_over_cap_after_settle_logs_and_writes_no_reply(self):\n        with tempfile.TemporaryDirectory() as td:\n            td = Path(td)\n            make_job(td)\n            make_messages(td)\n            mock = td / \"mock\"\n            make_mock(mock, total_cost=0.9)\n            r = run_call(td, mock, \"--max-cost\", \"0.5\")\n            self.assertEqual(r.returncode, 9, r.stderr)\n            self.assertFalse((td / \"reply.txt\").exists())\n            self.assertTrue((td / \"harness-maker.log\").exists())\n            rows = [json.loads(line) for line in\n                    (td / \"spend\" / \"ledger.jsonl\").read_text(encoding=\"utf-8\").splitlines()\n                    if line.strip()]\n            settles = [row for row in rows if row[\"event\"] == \"settle\"]\n            self.assertEqual(len(settles), 1)\n            self.assertTrue(settles[0].get(\"over_cap\"))\n\n    def test_job_total_uses_max_of_ledger_and_key_delta(self):\n        with tempfile.TemporaryDirectory() as td:\n            td = Path(td)\n            job, _ = make_job(td, bound=1.0)\n            make_messages(td)\n            mock = td / \"mock\"\n            make_mock(mock, usage=0.1)\n            ledger = Path(job[\"spend_ledger\"])\n            ledger.parent.mkdir(parents=True, exist_ok=True)\n            ledger.write_text(json.dumps({\n                \"event\": \"settle\", \"id\": \"old\", \"at\": \"2025-01-01T00:00:00Z\",\n                \"call\": \"old\", \"cost_usd\": 0.8,\n            }) + \"\\n\", encoding=\"utf-8\")\n            (ledger.parent / \"key-usage-baseline.json\").write_text(json.dumps({\n                \"job\": \"test-job\", \"usage\": 0.0, \"at\": \"2025-01-01T00:00:00Z\",\n                \"writer\": \"test\",\n            }) + \"\\n\", encoding=\"utf-8\")\n            r = run_call(td, mock)\n            self.assertEqual(r.returncode, 6, r.stderr)\n            self.assertFalse((td / \"harness-maker.log\").exists())\n            reqs = [json.loads(line) for line in\n                    (mock / \"requests.jsonl\").read_text(encoding=\"utf-8\").splitlines()\n                    if line.strip()]\n            self.assertFalse(any(x[\"method\"] == \"POST\" for x in reqs))\n\n    def test_missing_job_spend_is_exit_2(self):\n        with tempfile.TemporaryDirectory() as td:\n            td = Path(td)\n            make_messages(td)\n            r = subprocess.run([\n                sys.executable, str(OR_CALL),\n                \"--seat\", \"maker\",\n                \"--log\", str(td / \"harness-maker.log\"),\n                \"--model\", \"test/model\",\n                \"--messages\", str(td / \"messages.json\"),\n                \"--job-spend\", str(td / \"missing.json\"),\n            ], capture_output=True, text=True)\n            self.assertEqual(r.returncode, 2, r.stderr)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n<<<PLUMBLINE-END path=tests/test_edi_or_call.py>>>\n<<<PLUMBLINE-FILE path=tests/test_edi_extract_files.py>>>\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[1]\nEXTRACT = ROOT / \"tools\" / \"edi\" / \"extract_files.py\"\n\nREPLY = (\n    b\"<<<PLUMBLINE-FILE path=a.txt>>>\\n\"\n    b\"alpha\\n\"\n    b\"<<<PLUMBLINE-END path=a.txt>>>\\n\"\n    b\"<<<PLUMBLINE-FILE path=sub/b.txt>>>\\n\"\n    b\"beta\\n\"\n    b\"<<<PLUMBLINE-END path=sub/b.txt>>>\\n\"\n    b\"<<<PLUMBLINE-DONE files=2>>>\\n\"\n    b\"NOTES: ok\\n\"\n)\n\n\nclass TestExtractFiles(unittest.TestCase):\n    def test_check_validates_and_write_is_byte_exact(self):\n        with tempfile.TemporaryDirectory() as td:\n            td = Path(td)\n            reply = td / \"reply.txt\"\n            reply.write_bytes(REPLY)\n            target = td / \"target\"\n            target.mkdir()\n            r = subprocess.run([sys.executable, str(EXTRACT), str(reply), str(target), \"--check\"],\n                               capture_output=True, text=True)\n            self.assertEqual(r.returncode, 0, r.stderr)\n            self.assertEqual(list(target.iterdir()), [])\n            r = subprocess.run([sys.executable, str(EXTRACT), str(reply), str(target)],\n                               capture_output=True, text=True)\n            self.assertEqual(r.returncode, 0, r.stderr)\n            self.assertEqual((target / \"a.txt\").read_bytes(), b\"alpha\\n\")\n            self.assertEqual((target / \"sub\" / \"b.txt\").read_bytes(), b\"beta\\n\")\n\n    def test_missing_end_writes_nothing(self):\n        with tempfile.TemporaryDirectory() as td:\n            td = Path(td)\n            reply = td / \"reply.txt\"\n            reply.write_bytes(\n                b\"<<<PLUMBLINE-FILE path=a.txt>>>\\n\"\n                b\"alpha\\n\"\n                b\"<<<PLUMBLINE-DONE files=1>>>\\n\"\n            )\n            target = td / \"target\"\n            target.mkdir()\n            r = subprocess.run([sys.executable, str(EXTRACT), str(reply), str(target)],\n                               capture_output=True, text=True)\n            self.assertEqual(r.returncode, 1)\n            self.assertIn(\"no END\", r.stderr)\n            self.assertFalse((target / \"a.txt\").exists())\n\n    def test_duplicate_path_writes_nothing(self):\n        with tempfile.TemporaryDirectory() as td:\n            td = Path(td)\n            reply = td / \"reply.txt\"\n            reply.write_bytes(\n                b\"<<<PLUMBLINE-FILE path=a.txt>>>\\n\"\n                b\"one\\n\"\n                b\"<<<PLUMBLINE-END path=a.txt>>>\\n\"\n                b\"<<<PLUMBLINE-FILE path=a.txt>>>\\n\"\n                b\"two\\n\"\n                b\"<<<PLUMBLINE-END path=a.txt>>>\\n\"\n                b\"<<<PLUMBLINE-DONE files=2>>>\\n\"\n            )\n            target = td / \"target\"\n            target.mkdir()\n            r = subprocess.run([sys.executable, str(EXTRACT), str(reply), str(target)],\n                               capture_output=True, text=True)\n            self.assertEqual(r.returncode, 1)\n            self.assertIn(\"returned twice\", r.stderr)\n            self.assertFalse((target / \"a.txt\").exists())\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n<<<PLUMBLINE-END path=tests/test_edi_extract_files.py>>>\n<<<PLUMBLINE-FILE path=tests/test_edi_judge_batch.py>>>\nimport json\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[1]\nJUDGE = ROOT / \"tools\" / \"edi\" / \"judge_batch.py\"\n\n\ndef write_json(path: Path, obj) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    path.write_text(json.dumps(obj, indent=2) + \"\\n\", encoding=\"utf-8\")\n\n\ndef make_job(td: Path) -> Path:\n    spend = td / \"spend\" / \"ledger.jsonl\"\n    job = {\n        \"job_id\": \"test-job\",\n        \"bound_usd\": 2.0,\n        \"reserve_usd\": 0.0,\n        \"spend_ledger\": str(spend),\n        \"prices\": [{\n            \"model\": \"test/model\",\n            \"tag\": \"test/fp8\",\n            \"prompt_usd_per_token\": 0.001,\n            \"completion_usd_per_token\": 0.002,\n            \"max_completion_tokens\": 100,\n        }],\n    }\n    path = td / \"job-spend.json\"\n    write_json(path, job)\n    return path\n\n\ndef make_mock(mock: Path) -> None:\n    mock.mkdir(parents=True, exist_ok=True)\n    write_json(mock / \"key.json\", {\n        \"status\": 200,\n        \"headers\": {},\n        \"body\": {\"data\": {\"usage\": 0.0}},\n    })\n    write_json(mock / \"chat.json\", {\n        \"status\": 200,\n        \"headers\": {\"Date\": \"Wed, 01 Jan 2025 00:00:00 GMT\"},\n        \"body\": {\n            \"id\": \"gen-1\",\n            \"provider\": \"test\",\n            \"choices\": [{\"message\": {\"content\": \"reply\"}}],\n            \"usage\": {\"cost\": 0.01},\n        },\n    })\n    write_json(mock / \"generation.json\", {\n        \"status\": 200,\n        \"headers\": {},\n        \"body\": {\"data\": {\"total_cost\": 0.01, \"provider_name\": \"test\"}},\n    })\n\n\nclass TestJudgeBatch(unittest.TestCase):\n    def test_rotation_order_summary_and_one_call_per_item(self):\n        with tempfile.TemporaryDirectory() as td:\n            td = Path(td)\n            items = [\n                {\"id\": \"a\", \"text\": \"one\"},\n                {\"id\": \"b\", \"text\": \"two\"},\n                {\"id\": \"c\", \"text\": \"three\"},\n            ]\n            write_json(td / \"items.json\", items)\n            (td / \"rubric.txt\").write_text(\"rubric\\n\", encoding=\"utf-8\")\n            job_spend = make_job(td)\n            mock = td / \"mock\"\n            make_mock(mock)\n            out = td / \"out\"\n            r = subprocess.run([\n                sys.executable, str(JUDGE),\n                \"--items\", str(td / \"items.json\"),\n                \"--batch\", \"2\",\n                \"--rubric\", str(td / \"rubric.txt\"),\n                \"--out\", str(out),\n                \"--job-spend\", str(job_spend),\n                \"--log\", str(td / \"harness-judge.log\"),\n                \"--model\", \"test/model\",\n                \"--tag\", \"test/fp8\",\n                \"--pin-provider\", \"test\",\n                \"--mock-transport\", str(mock),\n            ], capture_output=True, text=True)\n            self.assertEqual(r.returncode, 0, r.stderr)\n            summary = json.loads((out / \"summary.json\").read_text(encoding=\"utf-8\"))\n            self.assertEqual(summary[\"order\"], [\"b\", \"c\", \"a\"])\n            self.assertTrue(summary[\"writer\"].startswith(\"tools/edi/judge_batch.py@\"))\n            self.assertIn(\"started_at\", summary)\n            self.assertIn(\"finished_at\", summary)\n            self.assertEqual(len(summary[\"results\"]), 3)\n            for result in summary[\"results\"]:\n                self.assertEqual(result[\"exit\"], 0)\n                self.assertTrue(Path(result[\"reply_file\"]).exists())\n            reqs = [json.loads(line) for line in\n                    (mock / \"requests.jsonl\").read_text(encoding=\"utf-8\").splitlines()\n                    if line.strip()]\n            self.assertEqual(sum(1 for x in reqs if x[\"method\"] == \"POST\"), 3)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n<<<PLUMBLINE-END path=tests/test_edi_judge_batch.py>>>\n<<<PLUMBLINE-DONE files=9>>>\nNOTES: Added the tools/edi product harness files and focused tests fo