            "content": "<<<PLUMBLINE-FILE path=schemas/x-plumbline/x-plumbline-v1.schema.json>>>\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"plumbline/schemas/x-plumbline/x-plumbline-v1.schema.json\",\n  \"title\": \"Plumbline custody record with x-plumbline v1\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"_type\", \"subject\", \"predicateType\", \"predicate\"],\n  \"properties\": {\n    \"_type\": {\"const\": \"https://in-toto.io/Statement/v1\"},\n    \"subject\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/subjectItem\"}},\n    \"predicateType\": {\"const\": \"https://evaluatordriven.com/custody/v1\"},\n    \"predicate\": {\"$ref\": \"#/$defs/predicate\"}\n  },\n  \"$defs\": {\n    \"subjectItem\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"name\", \"digest\"],\n      \"properties\": {\n        \"name\": {\"type\": \"string\"},\n        \"digest\": {\n          \"type\": \"object\",\n          \"additionalProperties\": false,\n          \"required\": [\"sha256\"],\n          \"properties\": {\"sha256\": {\"type\": \"string\", \"pattern\": \"^[0-9a-f]{64}$\"}}\n        }\n      }\n    },\n    \"predicate\": {\n      \"type\": \"object\",\n      \"additionalProperties\": true,\n      \"required\": [\"x-plumbline\"],\n      \"properties\": {\n        \"x-plumbline\": {\"$ref\": \"#/$defs/xPlumbline\"}\n      }\n    },\n    \"xPlumbline\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"schema\", \"hand_times\"],\n      \"properties\": {\n        \"job_id\": {\"type\": \"string\"},\n        \"sources\": {\"type\": \"object\", \"additionalProperties\": {\"type\": \"string\"}},\n        \"events_log\": {\"type\": \"object\", \"additionalProperties\": true},\n        \"terminal_state\": {\"type\": [\"string\", \"null\"]},\n        \"outcome\": {\"type\": [\"string\", \"null\"]},\n        \"verdict\": {\"type\": [\"string\", \"null\"]},\n        \"iteration\": {\"type\": [\"integer\", \"null\"]},\n        \"s5_record\": {\"type\": \"object\", \"additionalProperties\": true},\n        \"earlier_iterations\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n        \"pass_rule\": {},\n        \"disposition_source\": {\"type\": \"string\"},\n        \"packet\": {\"type\": \"object\", \"additionalProperties\": true},\n        \"emitter\": {\"type\": \"object\", \"additionalProperties\": true},\n        \"time_tolerance_s\": {\"type\": \"integer\"},\n        \"times\": {\"type\": \"object\", \"additionalProperties\": {\"type\": \"string\"}},\n        \"timeSources\": {\"type\": \"object\", \"additionalProperties\": true},\n        \"time_sources\": {\"type\": \"object\", \"additionalProperties\": true},\n        \"emittedAt\": {\"type\": \"string\"},\n        \"schema\": {\"const\": \"plumbline/x-plumbline/v1\"},\n        \"hand_times\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/handTime\"}},\n        \"allowances\": {\n          \"type\": \"object\",\n          \"additionalProperties\": true,\n          \"properties\": {\n            \"hand_times\": {\"$ref\": \"#/$defs/allowance\"}\n          }\n        },\n        \"generations\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/ledgerLine\"}},\n        \"evaluations\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/ledgerLine\"}},\n        \"relays\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/ledgerLine\"}},\n        \"amendments\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/ledgerLine\"}},\n        \"spend\": {\"$ref\": \"#/$defs/spend\"},\n        \"inputs\": {\"type\": \"object\", \"additionalProperties\": true},\n        \"gaps\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/gap\"}},\n        \"disposition_at_source\": {\"type\": \"string\"}\n      }\n    },\n    \"handTime\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"field\", \"file\", \"line\", \"source\"],\n      \"properties\": {\n        \"field\": {\"type\": \"string\"},\n        \"file\": {\"type\": \"string\"},\n        \"line\": {\"type\": [\"integer\", \"null\"]},\n        \"source\": {\"type\": \"string\"}\n      }\n    },\n    \"ledgerLine\": {\n      \"type\": \"object\",\n      \"additionalProperties\": true,\n      \"required\": [\"event\", \"at\", \"writer\", \"source\"],\n      \"properties\": {\n        \"event\": {\"type\": \"string\"},\n        \"at\": {\"type\": \"string\"},\n        \"writer\": {\"type\": \"string\"},\n        \"source\": {\"type\": \"string\"}\n      }\n    },\n    \"spend\": {\n      \"type\": \"object\",\n      \"additionalProperties\": true,\n      \"required\": [\"calls_sum_usd\", \"key_delta_usd\", \"total_usd\", \"tolerance_usd\"],\n      \"properties\": {\n        \"calls_sum_usd\": {\"type\": \"number\"},\n        \"key_delta_usd\": {\"type\": \"number\"},\n        \"total_usd\": {\"type\": \"number\"},\n        \"tolerance_usd\": {\"const\": 0.0001},\n        \"source\": {\"type\": [\"string\", \"null\"]}\n      }\n    },\n    \"gap\": {\n      \"type\": \"object\",\n      \"additionalProperties\": true,\n      \"required\": [\"field\", \"reason\", \"hard\"],\n      \"properties\": {\n        \"field\": {\"type\": \"string\"},\n        \"reason\": {\"type\": \"string\"},\n        \"hard\": {\"type\": \"boolean\"}\n      }\n    },\n    \"allowance\": {\n      \"type\": \"object\",\n      \"additionalProperties\": true,\n      \"required\": [\"switch\", \"writer\", \"at\"],\n      \"properties\": {\n        \"switch\": {\"const\": \"--allow-hand-times\"},\n        \"writer\": {\"type\": \"string\"},\n        \"at\": {\"type\": \"string\"}\n      }\n    },\n    \"xNested\": {\n      \"type\": \"object\",\n      \"additionalProperties\": true\n    }\n  }\n}\n<<<PLUMBLINE-END path=schemas/x-plumbline/x-plumbline-v1.schema.json>>>\n<<<PLUMBLINE-FILE path=kit/plumbline_verify.py>>>\n#!/usr/bin/env python3\n\"\"\"Verify a custody/v1 record at two layers: the standard checker, then x-plumbline.\n\nThe standard layer is `checker/check.py` from the pinned custody checkout. It knows nothing about `x-` keys\n(SPEC.md line 141): it reads the custody/v1 predicate and ignores every extension. The Plumbline layer is this\nfile: it runs the standard checker FIRST, then enforces the `x-plumbline` block the emitter writes.\n\n    plumbline_verify.py --record R --files F --evidence E --ledger L --custody <checkout> [--json OUT]\n\nThere is no switch that relaxes a check. The hand-time allowance is read from the record, never from the command\nline. Exit codes:\n  0  OK at both layers\n  3  the standard layer failed (kind `standard`; nothing else is checked)\n  4  the standard layer passed and a Plumbline check failed\n  2  cannot run (usage, a missing input, or a checker whose sha256 is not the pin)\n\nEvery failure prints one line: `FAIL <kind> <field> <file>:<line>`. Kinds: standard, schema, allowance,\nhand-time-unflagged, flag-without-source, events, relay-as-approval, spend, shadow.\n\nThis file must not import kit/emit_custody.py: the emitter's logic is checked by separate code (V7). It may use\nkit/custody_history.py to parse harness logs.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport math\nimport re\nimport subprocess\nimport sys\nfrom hashlib import sha256\nfrom pathlib import Path\n\nHERE = Path(__file__).resolve().parent\nREPO = HERE.parent\nsys.path.insert(0, str(HERE))\nimport custody_history as H  # noqa: E402\n\nSCHEMA_VERSION = \"plumbline/x-plumbline/v1\"\nSCHEMA_PATH = REPO / \"schemas\" / \"x-plumbline\" / \"x-plumbline-v1.schema.json\"\nSPEND_TOL = 0.0001\nLEDGER_REL = \"inputs/custody-events.jsonl\"\nOWNED = (\"verdict\", \"gaps\", \"times\", \"time_tolerance_s\", \"hand_times\", \"allowances\",\n         \"generations\", \"evaluations\", \"relays\", \"amendments\", \"spend\", \"schema\")\n\n\ndef file_sha(p: Path) -> str:\n    return sha256(Path(p).read_bytes()).hexdigest()\n\n\ndef load(p: Path):\n    return json.loads(Path(p).read_text(encoding=\"utf-8\"))\n\n\ndef relpath(job: Path, p: Path) -> str:\n    try:\n        return Path(p).resolve().relative_to(Path(job).resolve()).as_posix()\n    except ValueError:\n        return str(Path(p).resolve())\n\n\ndef ledger_lines(p: Path) -> list[tuple[int, dict]]:\n    out: list[tuple[int, dict]] = []\n    if not Path(p).is_file():\n        return out\n    for n, ln in enumerate(Path(p).read_text(encoding=\"utf-8\").splitlines(), 1):\n        if not ln.strip():\n            continue\n        try:\n            e = json.loads(ln)\n        except ValueError:\n            continue\n        if isinstance(e, dict):\n            e[\"_line\"] = n\n            out.append((n, e))\n    return out\n\n\ndef writer_source(e: dict):\n    w = e.get(\"writer\")\n    if w == \"hand\":\n        return \"ledger-hand\"\n    if w in (None, \"\"):\n        return \"ledger-no-writer\"\n    return None\n\n\ndef line_of(path: Path, value, key: str | None = None):\n    if value in (None, \"\") or not Path(path).is_file():\n        return None\n    try:\n        lines = Path(path).read_text(encoding=\"utf-8\").splitlines()\n    except OSError:\n        return None\n    vs = str(value)\n    hits = [n for n, ln in enumerate(lines, 1) if vs in ln and (key is None or f'\"{key}\"' in ln)]\n    if not hits:\n        hits = [n for n, ln in enumerate(lines, 1) if vs in ln]\n    return hits[0] if hits else None\n\n\ndef used_seats(ci: dict) -> set[str]:\n    seats: set[str] = set()\n    m = ci.get(\"maker\") or {}\n    if m.get(\"kind\") == \"model\":\n        seats.add(\"maker\")\n    for e in ci.get(\"evaluators\") or []:\n        if e.get(\"kind\") == \"model\":\n            seats.add(str(e.get(\"id\")))\n    return seats\n\n\ndef find_log(job: Path, ev_dir: Path, rel: str | None, pattern: str | None):\n    if rel:\n        for base in (ev_dir, job):\n            p = Path(base) / rel\n            if p.is_file():\n                return p\n        return None\n    hits = sorted(Path(ev_dir).glob(pattern)) if pattern and Path(ev_dir).is_dir() else []\n    return hits[0] if len(hits) == 1 else None\n\n\ndef read_calls(job: Path, ev_dir: Path, ci: dict):\n    by: dict[str, dict] = {}\n    allc: list = []\n\n    def add(seat: str, log):\n        if not log:\n            return\n        try:\n            calls = H.read_log(Path(log), H.Refusals(), str(seat))\n        except Exception:\n            return\n        d = by.setdefault(str(seat), {})\n        for c in calls:\n            name = getattr(c, \"name\", None) or str(getattr(c, \"i\", \"\"))\n            d[name] = c\n            allc.append(c)\n\n    if isinstance(ci, dict):\n        m = ci.get(\"maker\") or {}\n        if m.get(\"kind\") == \"model\":\n            add(\"maker\", find_log(job, ev_dir, m.get(\"harness_log\"), \"harness-maker*.log\"))\n        for e in ci.get(\"evaluators\") or []:\n            if e.get(\"kind\") == \"model\":\n                rel = e.get(\"harness_log\") or next(\n                    (x.get(\"evidence_file\") for x in ci.get(\"external\") or []\n                     if x.get(\"subject\") == e.get(\"id\")), None)\n                add(str(e.get(\"id\")), find_log(job, ev_dir, rel, None))\n    if not allc and Path(ev_dir).is_dir():\n        for log in sorted(Path(ev_dir).glob(\"*.log\")):\n            add(log.stem, log)\n    return by, allc\n\n\ndef call_cost(c) -> float:\n    raw = getattr(c, \"raw\", None)\n    if not isinstance(raw, dict):\n        return 0.0\n    resp = raw.get(\"response\") if isinstance(raw.get(\"response\"), dict) else {}\n    usage = resp.get(\"usage\") if isinstance(resp.get(\"usage\"), dict) else {}\n    for v in (raw.get(\"total_cost\"), resp.get(\"total_cost\"), usage.get(\"total_cost\"), usage.get(\"cost\")):\n        if isinstance(v, (int, float)) and not isinstance(v, bool):\n            return float(v)\n    return 0.0\n\n\ndef call_time(c):\n    return getattr(c, \"started\", None) or getattr(c, \"at\", None)\n\n\ndef ledger_array(lines: list[tuple[int, dict]], event: str, ledger_rel: str) -> list[dict]:\n    return [{**{k: v for k, v in e.items() if k != \"_line\"},\n             \"source\": f\"{ledger_rel}:{e['_line']}\"}\n            for _, e in lines if e.get(\"event\") == event]\n\n\ndef last_spend_line(lines: list[tuple[int, dict]]):\n    sp = None\n    for _, e in lines:\n        if e.get(\"event\") == \"spend\":\n            sp = e\n    return sp\n\n\ndef compute_spend_block(lines: list[tuple[int, dict]], all_calls, ledger_rel: str) -> dict:\n    sp = last_spend_line(lines)\n    calls_sum = round(sum(call_cost(c) for c in all_calls if getattr(c, \"at\", None)), 6)\n    key_delta = float(sp.get(\"key_delta_usd\") or 0) if sp else 0.0\n    return {\"calls_sum_usd\": calls_sum,\n            \"key_delta_usd\": key_delta,\n            \"total_usd\": max(calls_sum, key_delta),\n            \"tolerance_usd\": SPEND_TOL,\n            \"source\": f\"{ledger_rel}:{sp['_line']}\" if sp else None}\n\n\ndef hand_key(e: dict):\n    try:\n        line = int(e.get(\"line\")) if e.get(\"line\") is not None else None\n    except (TypeError, ValueError):\n        line = None\n    return (e.get(\"field\"), e.get(\"file\"), line, e.get(\"source\"))\n\n\ndef hand_time_set(job: Path, ledger_path: Path, custody_path: Path, record: dict, evidence: Path) -> list[dict]:\n    ci = load(custody_path) if Path(custody_path).is_file() else {}\n    lines = ledger_lines(ledger_path)\n    ledger_rel = relpath(job, ledger_path)\n    try:\n        inputs_rel = relpath(job, custody_path)\n    except Exception:\n        inputs_rel = str(custody_path)\n    seats = used_seats(ci)\n    calls_by_seat, _ = read_calls(job, evidence, ci)\n    hand: dict[str, dict] = {}\n    seen: set = set()\n\n    def mark(field: str, file: str, line, source: str) -> None:\n        hand[field] = {\"field\": field, \"file\": file, \"line\": line, \"source\": source}\n\n    for n, e in lines:\n        src = writer_source(e)\n        ev = e.get(\"event\")\n        field = None\n        if ev == \"freeze\":\n            seen.add(\"freeze\")\n            field = \"bar.frozenAt\"\n        elif ev == \"approve\":\n            role = e.get(\"role\")\n            seen.add((\"approve\", role))\n            for i, a in enumerate((ci.get(\"bar\") or {}).get(\"approvals\") or []):\n                if a.get(\"role\") == role:\n                    f = f\"bar.approvals[{i}].at\"\n                    if src:\n                        mark(f, ledger_rel, n, src)\n                    else:\n                        hand.pop(f, None)\n            continue\n        elif ev == \"dispose\":\n            seen.add(\"dispose\")\n            field = \"disposition.at\"\n        elif ev == \"pin\":\n            seat = e.get(\"seat\")\n            seen.add((\"pin\", seat))\n            if seat in seats:\n                field = f\"routing.{seat}.declaredAt\"\n        else:\n            continue\n        if field:\n            if src:\n                mark(field, ledger_rel, n, src)\n            else:\n                hand.pop(field, None)\n\n    bar = ci.get(\"bar\") or {}\n    if \"freeze\" not in seen and bar.get(\"frozenAt\"):\n        mark(\"bar.frozenAt\", inputs_rel, line_of(custody_path, bar.get(\"frozenAt\"), \"frozenAt\"),\n             \"inputs-no-ledger\")\n    for i, a in enumerate(bar.get(\"approvals\") or []):\n        if (\"approve\", a.get(\"role\")) not in seen and a.get(\"at\"):\n            mark(f\"bar.approvals[{i}].at\", inputs_rel, line_of(custody_path, a.get(\"at\"), \"at\"),\n                 \"inputs-no-ledger\")\n    for seat in seats:\n        if (\"pin\", seat) not in seen:\n            pin = (ci.get(\"routing\") or {}).get(seat) or {}\n            if pin.get(\"declaredAt\"):\n                mark(f\"routing.{seat}.declaredAt\", inputs_rel,\n                     line_of(custody_path, pin.get(\"declaredAt\"), \"declaredAt\"), \"inputs-no-ledger\")\n    if \"dispose\" not in seen:\n        d = ci.get(\"disposition\") or {}\n        if d.get(\"at\"):\n            mark(\"disposition.at\", inputs_rel, line_of(custody_path, d.get(\"at\"), \"at\"), \"inputs-no-ledger\")\n\n    mcalls = calls_by_seat.get(\"maker\") or {}\n    if not mcalls:\n        if ci.get(\"startedAt\"):\n            mark(\"startedAt\", inputs_rel, line_of(custody_path, ci.get(\"startedAt\"), \"startedAt\"),\n                 \"inputs-no-ledger\")\n        if ci.get(\"producedAt\"):\n            mark(\"producedAt\", inputs_rel, line_of(custody_path, ci.get(\"producedAt\"), \"producedAt\"),\n                 \"inputs-no-ledger\")\n\n    for pid, f in (ci.get(\"passes\") or {}).items():\n        if not isinstance(f, dict) or not f.get(\"at\"):\n            continue\n        calls = calls_by_seat.get(str(f.get(\"evaluator\"))) or {}\n        linked = (f.get(\"call\") in calls) if f.get(\"call\") else len(calls) == 1\n        if not linked:\n            mark(f\"passes.{pid}.at\", inputs_rel, line_of(custody_path, f.get(\"at\"), \"at\"),\n                 \"inputs-no-ledger\")\n\n    for k in ci.get(\"controls\") or []:\n        if not k.get(\"at\"):\n            continue\n        calls = calls_by_seat.get(str(k.get(\"evaluator\"))) or {}\n        linked = (k.get(\"call\") in calls) if k.get(\"call\") else len(calls) == 1\n        if not linked:\n            mark(f\"controls[{k.get('id')}].at\", inputs_rel, line_of(custody_path, k.get(\"at\"), \"at\"),\n                 \"inputs-no-ledger\")\n\n    logs = []\n    if Path(evidence).is_dir():\n        logs += sorted(Path(evidence).glob(\"*.log\"))\n    if Path(job).is_dir():\n        logs += sorted(Path(job).glob(\"*.log\"))\n    for log in dict.fromkeys(logs):\n        try:\n            calls = H.read_log(Path(log), H.Refusals(), \"verify\")\n        except Exception:\n            continue\n        for c in calls:\n            try:\n                entries = c.hand_time_entries()\n            except Exception:\n                entries = []\n            for e in entries:\n                if isinstance(e, dict) and e.get(\"field\"):\n                    hand[str(e[\"field\"])] = e\n    return [hand[k] for k in sorted(hand)]\n\n\ndef check_hand_times(hand: list[dict], record: dict) -> list[dict]:\n    fails: list[dict] = []\n    xp = (record.get(\"predicate\") or {}).get(\"x-plumbline\") if isinstance(record, dict) else None\n    if not isinstance(xp, dict):\n        return fails\n    flags = xp.get(\"hand_times\")\n    if not isinstance(flags, list):\n        return fails\n    recomp = {hand_key(e) for e in hand if isinstance(e, dict)}\n    got = {hand_key(e) for e in flags if isinstance(e, dict)}\n    for k in sorted(recomp - got):\n        fails.append({\"kind\": \"hand-time-unflagged\", \"field\": k[0], \"file\": k[1], \"line\": k[2]})\n    for k in sorted(got - recomp):\n        fails.append({\"kind\": \"flag-without-source\", \"field\": k[0], \"file\": k[1], \"line\": k[2]})\n    if recomp:\n        allowance = (xp.get(\"allowances\") or {}).get(\"hand_times\")\n        if not isinstance(allowance, dict):\n            fails.append({\"kind\": \"allowance\", \"field\": \"x-plumbline.allowances.hand_times\",\n                          \"file\": \"\", \"line\": 0})\n        else:\n            if allowance.get(\"switch\") != \"--allow-hand-times\":\n                fails.append({\"kind\": \"allowance\", \"field\": \"x-plumbline.allowances.hand_times.switch\",\n                              \"file\": \"\", \"line\": 0})\n            if not str(allowance.get(\"writer\", \"\")).startswith(\"kit/emit_custody.py@\"):\n                fails.append({\"kind\": \"allowance\", \"field\": \"x-plumbline.allowances.hand_times.writer\",\n                              \"file\": \"\", \"line\": 0})\n            if not H.parse_ts(allowance.get(\"at\")):\n                fails.append({\"kind\": \"allowance\", \"field\": \"x-plumbline.allowances.hand_times.at\",\n                              \"file\": \"\", \"line\": 0})\n    return fails\n\n\ndef check_events(job: Path, ledger_path: Path, record: dict, calls_by_seat: dict) -> list[dict]:\n    fails: list[dict] = []\n    xp = (record.get(\"predicate\") or {}).get(\"x-plumbline\") if isinstance(record, dict) else None\n    if not isinstance(xp, dict):\n        return fails\n    lines = ledger_lines(ledger_path)\n    ledger_rel = relpath(job, ledger_path)\n    for ev, key in ((\"generation\", \"generations\"), (\"evaluation\", \"evaluations\"),\n                    (\"relay\", \"relays\"), (\"amendment\", \"amendments\")):\n        expected = ledger_array(lines, ev, ledger_rel)\n        got = xp.get(key)\n        if got != expected:\n            fails.append({\"kind\": \"events\", \"field\": f\"x-plumbline.{key}\", \"file\": str(ledger_path), \"line\": 0})\n\n    for _, e in lines:\n        if e.get(\"event\") != \"evaluation\":\n            continue\n        vf = e.get(\"verdict_file\")\n        want = e.get(\"verdict_sha256\")\n        if not vf:\n            continue\n        p = Path(vf) if Path(vf).is_absolute() else Path(job) / vf\n        if not p.is_file() or file_sha(p) != want:\n            fails.append({\"kind\": \"events\", \"field\": f\"evaluations[{e.get('batch')}].verdict_sha256\",\n                          \"file\": vf, \"line\": e.get(\"_line\", 0)})\n\n    opens: dict = {}\n    closes: dict = {}\n    for _, e in lines:\n        if e.get(\"event\") != \"generation\":\n            continue\n        k = (e.get(\"seat\"), e.get(\"n\"))\n        if e.get(\"action\") == \"open\":\n            opens[k] = e\n        elif e.get(\"action\") == \"close\":\n            closes[k] = e\n    maker_calls = list((calls_by_seat.get(\"maker\") or {}).values())\n    for k, o in opens.items():\n        c = closes.get(k)\n        if not c:\n            fails.append({\"kind\": \"events\", \"field\": f\"generations[{k[0]}#{k[1]}].close\",\n                          \"file\": str(ledger_path), \"line\": o.get(\"_line\", 0)})\n            continue\n        t0, t1 = H.parse_ts(o.get(\"at\")), H.parse_ts(c.get(\"at\"))\n        if t0 and t1:\n            found = any(call_time(x) and t0 <= call_time(x) <= t1 for x in maker_calls)\n            if not found:\n                fails.append({\"kind\": \"events\", \"field\": f\"generations[{k[0]}#{k[1]}].calls\",\n                              \"file\": str(ledger_path), \"line\": o.get(\"_line\", 0)})\n\n    relays = [e for _, e in lines if e.get(\"event\") == \"relay\"]\n    approvals = ((record.get(\"predicate\") or {}).get(\"bar\") or {}).get(\"approvals\") or []\n    for r in relays:\n        for a in approvals:\n            if (a.get(\"kind\") == \"relay\" or a.get(\"relay\") or a.get(\"role\") == \"relay\"\n                    or a.get(\"by\") == r.get(\"from\") or a.get(\"quote\") == r.get(\"quote\")):\n                fails.append({\"kind\": \"relay-as-approval\", \"field\": \"predicate.bar.approvals\",\n                              \"file\": str(ledger_path), \"line\": r.get(\"_line\", 0)})\n                break\n    return fails\n\n\ndef check_spend(job: Path, ledger_path: Path, record: dict, all_calls) -> list[dict]:\n    fails: list[dict] = []\n    xp = (record.get(\"predicate\") or {}).get(\"x-plumbline\") if isinstance(record, dict) else None\n    if not isinstance(xp, dict):\n        return fails\n    lines = ledger_lines(ledger_path)\n    ledger_rel = relpath(job, ledger_path)\n    expected = compute_spend_block(lines, all_calls, ledger_rel)\n    sp = xp.get(\"spend\")\n    if not isinstance(sp, dict):\n        return [{\"kind\": \"spend\", \"field\": \"x-plumbline.spend\", \"file\": str(ledger_path), \"line\": 0}]\n    for k in (\"calls_sum_usd\", \"key_delta_usd\", \"total_usd\", \"tolerance_usd\"):\n        if k not in sp:\n            fails.append({\"kind\": \"spend\", \"field\": f\"x-plumbline.spend.{k}\", \"file\": str(ledger_path), \"line\": 0})\n    calls_sum = float(sp.get(\"calls_sum_usd\") or 0)\n    key_delta = float(sp.get(\"key_delta_usd\") or 0)\n    total = float(sp.get(\"total_usd\") or 0)\n    tol = float(sp.get(\"tolerance_usd\") or 0)\n    if abs(calls_sum - expected[\"calls_sum_usd\"]) > SPEND_TOL:\n        fails.append({\"kind\": \"spend\", \"field\": \"x-plumbline.spend.calls_sum_usd\",\n                      \"file\": str(ledger_path), \"line\": 0})\n    if abs(key_delta - expected[\"key_delta_usd\"]) > 1e-9:\n        fails.append({\"kind\": \"spend\", \"field\": \"x-plumbline.spend.key_delta_usd\",\n                      \"file\": str(ledger_path), \"line\": 0})\n    if abs(total - max(calls_sum, key_delta)) > 1e-9:\n        fails.append({\"kind\": \"spend\", \"field\": \"x-plumbline.spend.total_usd\",\n                      \"file\": str(ledger_path), \"line\": 0})\n    if abs(tol - SPEND_TOL) > 1e-12:\n        fails.append({\"kind\": \"spend\", \"field\": \"x-plumbline.spend.tolerance_usd\",\n                      \"file\": str(ledger_path), \"line\": 0})\n\n    sp_line = last_spend_line(lines)\n    if sp_line:\n        lp = Path(sp_line.get(\"spend_ledger\") or \"\")\n        if not lp.is_absolute():\n            lp = Path(job) / lp\n        if not lp.is_file():\n            fails.append({\"kind\": \"spend\", \"field\": \"spend_ledger\", \"file\": str(lp), \"line\": sp_line.get(\"_line\", 0)})\n        else:\n            labels = {getattr(c, \"name\", None) or str(getattr(c, \"i\", \"\")) for c in all_calls}\n            for n, ln in enumerate(lp.read_text(encoding=\"utf-8\").splitlines(), 1):\n                if not ln.strip():\n                    continue\n                try:\n                    x = json.loads(ln)\n                except ValueError:\n                    continue\n                if x.get(\"event\") == \"settle\":\n                    call = x.get(\"call\") or x.get(\"id\")\n                    if call and call not in labels:\n                        fails.append({\"kind\": \"spend\", \"field\": f\"settle[{call}]\",\n                                      \"file\": str(lp), \"line\": n})\n        rp = Path(sp_line.get(\"key_reading\") or \"\")\n        if not rp.is_absolute():\n            rp = Path(job) / rp\n        if not rp.is_file():\n            fails.append({\"kind\": \"spend\", \"field\": \"key_reading\", \"file\": str(rp), \"line\": sp_line.get(\"_line\", 0)})\n        else:\n            try:\n                r = load(rp)\n            except Exception:\n                r = {}\n            if not r.get(\"read_at\") or not r.get(\"writer\"):\n                fails.append({\"kind\": \"spend\", \"field\": \"key_reading.read_at\",\n                              \"file\": str(rp), \"line\": 0})\n            else:\n                read_at = H.parse_ts(r.get(\"read_at\"))\n                last = H.parse_ts(sp_line.get(\"last_settle_at\"))\n                if read_at and last and (read_at - last).total_seconds() < 180:\n                    fails.append({\"kind\": \"spend\", \"field\": \"key_reading.read_at\",\n                                  \"file\": str(rp), \"line\": 0})\n                if abs(float(r.get(\"key_delta_usd\") or 0) - key_delta) > 1e-6:\n                    fails.append({\"kind\": \"spend\", \"field\": \"key_reading.key_delta_usd\",\n                                  \"file\": str(rp), \"line\": 0})\n    elif expected[\"calls_sum_usd\"] > 0:\n        fails.append({\"kind\": \"spend\", \"field\": \"x-plumbline.spend.source\",\n                      \"file\": str(ledger_path), \"line\": 0})\n    return fails\n\n\ndef check_shadow(job: Path, ledger_path: Path, record: dict, all_calls, hand: list[dict],\n                 calls_by_seat: dict) -> list[dict]:\n    fails: list[dict] = []\n    xp = (record.get(\"predicate\") or {}).get(\"x-plumbline\") if isinstance(record, dict) else None\n    if not isinstance(xp, dict):\n        return fails\n    inputs = xp.get(\"inputs\")\n    if not isinstance(inputs, dict):\n        inputs = {}\n    lines = ledger_lines(ledger_path)\n    ledger_rel = relpath(job, ledger_path)\n    derived: dict = {\n        \"schema\": SCHEMA_VERSION,\n        \"time_tolerance_s\": H.TOLERANCE_S,\n        \"hand_times\": hand,\n        \"generations\": ledger_array(lines, \"generation\", ledger_rel),\n        \"evaluations\": ledger_array(lines, \"evaluation\", ledger_rel),\n        \"relays\": ledger_array(lines, \"relay\", ledger_rel),\n        \"amendments\": ledger_array(lines, \"amendment\", ledger_rel),\n        \"spend\": compute_spend_block(lines, all_calls, ledger_rel),\n    }\n    s5 = xp.get(\"s5_record\") or {}\n    if s5.get(\"name\"):\n        p = Path(s5[\"name\"]) if Path(s5[\"name\"]).is_absolute() else Path(job) / s5[\"name\"]\n        if p.is_file():\n            try:\n                rec = load(p)\n                if \"verdict\" in rec:\n                    derived[\"verdict\"] = rec.get(\"verdict\")\n            except Exception:\n                pass\n    mcalls = calls_by_seat.get(\"maker\") or {}\n    derived[\"times\"] = {\"startedAt\": \"harness log\" if mcalls else \"hand-entered\",\n                        \"producedAt\": \"harness log\" if mcalls else \"hand-entered\"}\n\n    for key in OWNED:\n        if key not in derived or key not in xp:\n            continue\n        if key == \"hand_times\":\n            if {hand_key(e) for e in xp.get(key) or [] if isinstance(e, dict)} != \\\n                    {hand_key(e) for e in derived[key] or [] if isinstance(e, dict)}:\n                fails.append({\"kind\": \"shadow\", \"field\": f\"x-plumbline.{key}\",\n                              \"file\": str(ledger_path), \"line\": 0})\n        elif xp.get(key) != derived[key]:\n            fails.append({\"kind\": \"shadow\", \"field\": f\"x-plumbline.{key}\",\n                          \"file\": str(ledger_path), \"line\": 0})\n    for key in OWNED:\n        if key in inputs and key in xp and key in derived:\n            if xp.get(key) == inputs.get(key) and xp.get(key) != derived[key]:\n                fails.append({\"kind\": \"shadow\", \"field\": f\"x-plumbline.inputs.{key}\",\n                              \"file\": str(ledger_path), \"line\": 0})\n    return fails\n\n\ndef _type_ok(v, t: str) -> bool:\n    if t == \"object\":\n        return isinstance(v, dict)\n    if t == \"array\":\n        return isinstance(v, list)\n    if t == \"string\":\n        return isinstance(v, str)\n    if t == \"integer\":\n        return isinstance(v, int) and not isinstance(v, bool)\n    if t == \"number\":\n        return isinstance(v, (int, float)) and not isinstance(v, bool)\n    if t == \"boolean\":\n        return isinstance(v, bool)\n    if t == \"null\":\n        return v is None\n    return True\n\n\ndef _validate(inst, sch, root, path: str) -> list[tuple[str, str]]:\n    errs: list[tuple[str, str]] = []\n    if sch is True or sch == {}:\n        return errs\n    if sch is False:\n        return [(path, \"false schema\")]\n    if \"$ref\" in sch:\n        ref = sch[\"$ref\"]\n        if isinstance(ref, str) and ref.startswith(\"#/$defs/\"):\n            name = ref.split(\"/\")[-1]\n            return _validate(inst, root[\"$defs\"][name], root, path)\n        return errs\n    if \"const\" in sch and inst != sch[\"const\"]:\n        errs.append((path, \"const\"))\n    if \"enum\" in sch and inst not in sch[\"enum\"]:\n        errs.append((path, \"enum\"))\n    if \"type\" in sch:\n        ts = sch[\"type\"] if isinstance(sch[\"type\"], list) else [sch[\"type\"]]\n        if not any(_type_ok(inst, t) for t in ts):\n            errs.append((path, \"type\"))\n    for sub in sch.get(\"allOf\") or []:\n        errs += _validate(inst, sub, root, path)\n    if \"anyOf\" in sch:\n        if not any(not _validate(inst, sub, root, path) for sub in sch[\"anyOf\"]):\n            errs.append((path, \"anyOf\"))\n    if \"oneOf\" in sch:\n        ok = sum(1 for sub in sch[\"oneOf\"] if not _validate(inst, sub, root, path))\n        if ok != 1:\n            errs.append((path, \"oneOf\"))\n    if isinstance(inst, dict):\n        for r in sch.get(\"required\") or []:\n            if r not in inst:\n                errs.append((path + \".\" + r, \"required\"))\n        props = sch.get(\"properties\") or {}\n        for k, v in inst.items():\n            if k in props:\n                errs += _validate(v, props[k], root, path + \".\" + k)\n            else:\n                ap = sch.get(\"additionalProperties\", True)\n                if ap is False:\n                    errs.append((path + \".\" + k, \"additionalProperties\"))\n                elif isinstance(ap, dict):\n                    errs += _validate(v, ap, root, path + \".\" + k)\n    if isinstance(inst, list) and \"items\" in sch:\n        for i, v in enumerate(inst):\n            errs += _validate(v, sch[\"items\"], root, f\"{path}[{i}]\")\n    if isinstance(inst, str):\n        if \"minLength\" in sch and len(inst) < sch[\"minLength\"]:\n            errs.append((path, \"minLength\"))\n        if \"pattern\" in sch and not re.search(sch[\"pattern\"], inst):\n            errs.append((path, \"pattern\"))\n    if isinstance(inst, (int, float)) and not isinstance(inst, bool):\n        if \"minimum\" in sch and inst < sch[\"minimum\"]:\n            errs.append((path, \"minimum\"))\n        if \"maximum\" in sch and inst > sch[\"maximum\"]:\n            errs.append((path, \"maximum\"))\n    return errs\n\n\ndef iter_xplumbline(obj, path: str = \"\"):\n    if isinstance(obj, dict):\n        for k, v in obj.items():\n            p = f\"{path}.{k}\" if path else k\n            if k == \"x-plumbline\":\n                yield p, v\n            else:\n                yield from iter_xplumbline(v, p)\n    elif isinstance(obj, list):\n        for i, v in enumerate(obj):\n            yield from iter_xplumbline(v, f\"{path}[{i}]\")\n\n\ndef check_schema(record: dict, schema_path: Path) -> list[dict]:\n    fails: list[dict] = []\n    if not Path(schema_path).is_file():\n        return [{\"kind\": \"schema\", \"field\": \"schema file\", \"file\": str(schema_path), \"line\": 0}]\n    try:\n        schema = load(schema_path)\n    except Exception:\n        return [{\"kind\": \"schema\", \"field\": \"schema file\", \"file\": str(schema_path), \"line\": 0}]\n    for p, _ in _validate(record, schema, schema, \"$\"):\n        fails.append({\"kind\": \"schema\", \"field\": p, \"file\": str(schema_path), \"line\": 0})\n    xp = (record.get(\"predicate\") or {}).get(\"x-plumbline\") if isinstance(record, dict) else None\n    if not isinstance(xp, dict):\n        fails.append({\"kind\": \"schema\", \"field\": \"predicate.x-plumbline\", \"file\": \"\", \"line\": 0})\n        return fails\n    for p, _ in _validate(xp, schema[\"$defs\"][\"xPlumbline\"], schema, \"x-plumbline\"):\n        fails.append({\"kind\": \"schema\", \"field\": p, \"file\": str(schema_path), \"line\": 0})\n    if xp.get(\"schema\") != SCHEMA_VERSION:\n        fails.append({\"kind\": \"schema\", \"field\": \"x-plumbline.schema\", \"file\": \"\", \"line\": 0})\n    for p, val in iter_xplumbline(record):\n        if p == \"predicate.x-plumbline\":\n            continue\n        for q, _ in _validate(val, schema[\"$defs\"][\"xNested\"], schema, p):\n            fails.append({\"kind\": \"schema\", \"field\": q, \"file\": str(schema_path), \"line\": 0})\n    return fails\n\n\ndef _strip_sha(v):\n    if isinstance(v, str):\n        v = v.strip()\n        if v.startswith(\"sha256:\"):\n            v = v[7:]\n        return v\n    return v\n\n\ndef _is_pin(v) -> bool:\n    v = _strip_sha(v)\n    return isinstance(v, str) and re.fullmatch(r\"[0-9a-f]{64}\", v) is not None\n\n\ndef _find_pin_in(obj, sha: str):\n    if isinstance(obj, dict):\n        for k, v in obj.items():\n            if isinstance(v, str):\n                vv = _strip_sha(v)\n                if vv == sha:\n                    return vv\n                if vv.startswith(\"aaeb7e05\") and vv.endswith(\"bcd18\"):\n                    return vv\n                if \"checker/check.py\" in str(k) and _is_pin(v):\n                    return vv\n            if isinstance(v, dict):\n                path = str(v.get(\"path\") or v.get(\"file\") or \"\")\n                if \"checker/check.py\" in path:\n                    for kk in (\"sha256\", \"digest\", \"hash\"):\n                        if _is_pin(v.get(kk)):\n                            return _strip_sha(v.get(kk))\n                r = _find_pin_in(v, sha)\n                if r:\n                    return r\n            if isinstance(v, list):\n                r = _find_pin_in(v, sha)\n                if r:\n                    return r\n    elif isinstance(obj, list):\n        for v in obj:\n            r = _find_pin_in(v, sha)\n            if r:\n                return r\n    return None\n\n\ndef find_pin(custody: Path, check: Path):\n    sha = file_sha(check)\n    for p in (Path(custody) / \"tools\" / \"pin.json\", REPO / \"tools\" / \"pin.json\"):\n        if not p.is_file():\n            continue\n        try:\n            doc = load(p)\n        except Exception:\n            continue\n        found = _find_pin_in(doc, sha)\n        if found:\n            return found\n    return None\n\n\ndef standard_check(record: Path, custody: Path):\n    check = None\n    for rel in (\"checker/check.py\", \"check.py\", \"tools/checker/check.py\"):\n        p = Path(custody) / rel\n        if p.is_file():\n            check = p\n            break\n    if check is None:\n        p = REPO / \"checker\" / \"check.py\"\n        if p.is_file():\n            check = p\n    if check is None:\n        return 2, \"no checker\"\n    pin = find_pin(custody, check)\n    if pin is None:\n        return 2, \"no pin\"\n    if file_sha(check) != pin:\n        return 2, \"pin mismatch\"\n    level = \"CL1\"\n    try:\n        rec = load(record)\n        level = (rec.get(\"predicate\") or {}).get(\"levelClaimed\") or \"CL1\"\n    except Exception:\n        pass\n    forms = [\n        [str(record), \"--level\", level],\n        [\"--record\", str(record), \"--level\", level],\n        [str(record), level],\n        [\"--level\", level, str(record)],\n    ]\n    last = None\n    for form in forms:\n        rv = subprocess.run([sys.executable, str(check), *form], capture_output=True, text=True)\n        last = rv\n        if rv.returncode == 0:\n            return 0, rv\n        text = (rv.stdout + rv.stderr).lower()\n        if any(x in text for x in (\"usage\", \"unrecognized arguments\", \"error: argument\",\n                                   \"no such option\", \"invalid choice\")):\n            continue\n        return 1, rv\n    return (2 if last is None else 1), last\n\n\ndef snapshot(paths) -> dict:\n    out: dict = {}\n    for p in paths:\n        p = Path(p)\n        if p.is_file():\n            out[str(p)] = file_sha(p)\n        elif p.is_dir():\n            for f in sorted(p.rglob(\"*\")):\n                if f.is_file():\n                    out[str(f)] = file_sha(f)\n    return out\n\n\ndef finish(code: int, failures: list[dict], json_out: str | None) -> int:\n    for f in failures:\n        print(f\"FAIL {f.get('kind')} {f.get('field')} {f.get('file', '')}:{f.get('line', 0)}\")\n    if json_out:\n        Path(json_out).write_text(json.dumps({\"exit\": code, \"failures\": failures}, indent=2) + \"\\n\",\n                                  encoding=\"utf-8\")\n    return code\n\n\ndef main(argv=None) -> int:\n    ap = argparse.ArgumentParser(description=\"Verify a custody/v1 record at the standard and Plumbline layers.\")\n    ap.add_argument(\"--record\", required=True)\n    ap.add_argument(\"--files\", required=True)\n    ap.add_argument(\"--evidence\", required=True)\n    ap.add_argument(\"--ledger\", required=True)\n    ap.add_argument(\"--custody\", required=True)\n    ap.add_argument(\"--json\")\n    a = ap.parse_args(argv)\n\n    record = Path(a.record).expanduser()\n    files = Path(a.files).expanduser()\n    evidence = Path(a.evidence).expanduser()\n    ledger = Path(a.ledger).expanduser()\n    custody = Path(a.custody).expanduser()\n\n    if not record.is_file():\n        return finish(2, [{\"kind\": \"standard\", \"field\": \"record\", \"file\": str(record), \"line\": 0}], a.json)\n    if not ledger.is_file():\n        return finish(2, [{\"kind\": \"standard\", \"field\": \"ledger\", \"file\": str(ledger), \"line\": 0}], a.json)\n    if not custody.is_dir():\n        return finish(2, [{\"kind\": \"standard\", \"field\": \"custody\", \"file\": str(custody), \"line\": 0}], a.json)\n\n    before = snapshot([record, files, evidence, ledger])\n    code, _ = standard_check(record, custody)\n    if code == 2:\n        return finish(2, [{\"kind\": \"standard\", \"field\": \"checker\", \"file\": str(custody), \"line\": 0}], a.json)\n    if code != 0:\n        return finish(3, [{\"kind\": \"standard\", \"field\": \"record\", \"file\": str(record), \"line\": 0}], a.json)\n\n    try:\n        rec = load(record)\n    except Exception:\n        return finish(2, [{\"kind\": \"standard\", \"field\": \"record\", \"file\": str(record), \"line\": 0}], a.json)\n\n    failures = check_schema(rec, SCHEMA_PATH)\n    if failures:\n        return finish(4, failures, a.json)\n\n    job = ledger.parent.parent if ledger.parent.name == \"inputs\" else files\n    if not (job / \"packet.json\").is_file() and (evidence.parent.parent / \"packet.json\").is_file():\n        job = evidence.parent.parent\n    custody_json = ledger.parent / \"custody.json\"\n    ci = load(custody_json) if custody_json.is_file() else {}\n    calls_by_seat, all_calls = read_calls(job, evidence, ci)\n    hand = hand_time_set(job, ledger, custody_json, rec, evidence)\n\n    failures += check_hand_times(hand, rec)\n    failures += check_events(job, ledger, rec, calls_by_seat)\n    failures += check_spend(job, ledger, rec, all_calls)\n    failures += check_shadow(job, ledger, rec, all_calls, hand, calls_by_seat)\n\n    after = snapshot([record, files, evidence, ledger])\n    if before != after:\n        failures.append({\"kind\": \"writes\", \"field\": \"inputs\", \"file\": str(job), \"line\": 0})\n\n    return finish(4 if failures else 0, failures, a.json)\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n<<<PLUMBLINE-END path=kit/plumbline_verify.py>>>\n<<<PLUMBLINE-FILE path=kit/plumbline_job.py>>>\n#!/usr/bin/env python3\n\"\"\"The two commands a job has. `open` and `close` are the job's own lifecycle, and neither can be skipped.\n\nWHY A WRAPPER RATHER THAN TWO TOOLS AND A HABIT. The emitters fixed the PRODUCTION of readable terms; they did\nnothing about the fact that running them is a thing someone must remember to do. That is the same failure one\nlevel up — and it is measurable: four consecutive jobs in a real deployment shipped terms no checker could\nread, produced by authors who had already been told to produce machine-readable ones. A tool you must remember\nis advice. This is the join: a job folder comes into existence BY the packet emitter, and it ends BY the record\nemitter and the close. There is no third path, and no folder without a packet.\n\nWHAT IT ENCODES, THAT INDIVIDUAL TOOLS CANNOT. The folder's own conventions: `packet.json` is the terms, the\n`iteration-N-*` files are the records, `inputs/` holds the briefs and run files a reader must not judge as\nterms, and `superseded/` holds what a job has replaced. Naming them in one place is what keeps a run file from\nbeing held to the §5 record schema (measured: it was) and a replaced record from blocking a close (measured: it\ndid).\n\n    plumbline_job.py open  --brief brief.json --job-dir dot-plumbline/jobs/<job-id> [--corpus PATH]\n    plumbline_job.py close --job-dir dot-plumbline/jobs/<job-id> --run run.json [--run run2.json] [--corpus PATH]\n                           [--terminal-state accepted|needs_owner|rejected [--outcome O]]\n    plumbline_job.py custody --job-dir dot-plumbline/jobs/<job-id> [--out-dir DIR]    (no corpus needed)\n\n`open` creates the directory, emits the packet, and files the brief under `inputs/`. If the packet emitter\nrefuses the brief, THE DIRECTORY IS REMOVED: a job folder that exists without readable terms is the exact\nartifact this kit was built to stop. `close` emits a §5 record for every run file, files the run files under\n`inputs/`, then runs the close — and if any emitter refuses, nothing closes.\n\nCUSTODY. A close that leaves the packet at a terminal state (accepted / needs_owner / rejected) also writes\n`custody/record.custody.json` — a custody/v1 in-toto Statement (kit/emit_custody.py, docs/custody-emission.md)\n— from the job's own files plus `inputs/custody.json`. It is written AFTER the close and changes none of the\nclose's artifacts. If it cannot be written whole, the close stands and the command says so and exits non-zero:\na job is closed by its §5 records; its custody record is a second, public reading of the same facts.\n`custody` re-emits it on its own, with no corpus.\n\nVERIFY. Close and custody run `kit/plumbline_verify.py` on the record the emitter just wrote. A verify failure\nrefuses the close: no `closed` row, a `close_refused` row carrying the failure kind, and the verifier's exit\ncode. The hand-time allowance is the emitter's switch; the verifier never takes a switch.\n\"\"\"\nfrom __future__ import annotations\nimport argparse, json, os, shutil, subprocess, sys\nfrom pathlib import Path\n\nHERE = Path(__file__).resolve().parent\n\n\ndef log_row(job: Path, event: str, extra: dict, override: str | None = None) -> None:\n    \"\"\"Append a row naming this job, at open and at close.\n\n    An audit that enumerates from the index reads a short body SILENTLY — measured by the corpus maintainer\n    2026-10-05: 8 job folders on disk, 7 named in the log. A row written by the tool is a fact; a row written\n    by a reconciliation someone must remember is a habit. Rows carry `event` so a reader can tell an open from\n    a close; the older rows have no `event` and are runs.\n    \"\"\"\n    from datetime import datetime, timezone\n    path = Path(override).expanduser() if override else job.parent.parent / \"run-log.json\"\n    # READ THE SHAPE THE LOG IS IN. The log is {\"note\": ..., \"runs\": [...]} — measured 2026-10-05, twice: my\n    # loop check read the top level as rows and reported five folders unnamed that are named, and then this\n    # function refused to write because it expected a list. A reader that does not know what it is reading\n    # is the defect; both readers now read the log's own key, and refuse loudly if it is missing.\n    try:\n        doc = json.loads(path.read_text()) if path.is_file() else {\"runs\": []}\n    except Exception as exc:\n        print(f\"  NOTE: {path} is unreadable ({exc}) — the run-log row was NOT written.\"); return\n    if isinstance(doc, list):\n        doc = {\"runs\": doc}\n    if not isinstance(doc, dict) or not isinstance(doc.get(\"runs\"), list):\n        print(f\"  NOTE: {path} is not recognisable as a run log (no list under `runs`) — the row was NOT \"\n              f\"written. Fix the log first; a job nothing records is how a short body starts.\"); return\n    doc[\"runs\"].append({\"job_id\": job.name,\n                        \"date\": datetime.now(timezone.utc).strftime(\"%Y-%m-%d\"),\n                        \"event\": event, **extra})\n    try:\n        path.parent.mkdir(parents=True, exist_ok=True)\n        path.write_text(json.dumps(doc, indent=2) + \"\\n\")\n        print(f\"  run-log: appended the {event} row for {job.name} ({len(doc['runs'])} rows)\")\n    except OSError as exc:\n        print(f\"  NOTE: could not write the run-log row ({exc}). The job itself is unaffected, but an audit \"\n              f\"reading the index will not see this job — say so rather than leaving it short.\")\n\n\ndef corpus_arg(given: str | None) -> str | None:\n    return given or os.environ.get(\"EDI_CORPUS\") or None\n\n\ndef call(script: str, args: list[str]) -> int:\n    \"\"\"Run a sibling tool with this interpreter, streaming its report through unchanged.\"\"\"\n    return subprocess.run([sys.executable, str(HERE / script), *args]).returncode\n\n\ndef packet_mode(job: Path) -> str | None:\n    try:\n        return json.loads((job / \"packet.json\").read_text()).get(\"mode\")\n    except Exception:\n        return None\n\n\ndef run_verifier(job: Path, a, record: Path | None = None) -> tuple[int, str]:\n    \"\"\"Run kit/plumbline_verify.py as its own subprocess; return (exit code, first failure kind).\"\"\"\n    custody = (getattr(a, \"custody\", None) or os.environ.get(\"PLUMBLINE_CUSTODY\") or \"\").strip()\n    if not custody:\n        print(\"NOT CLOSED: Plumbline verify cannot run: no --custody and no $PLUMBLINE_CUSTODY.\")\n        return 2, \"cannot-run\"\n    rec = record or (job / \"custody\" / \"record.custody.json\")\n    args = [\"--record\", str(rec),\n            \"--files\", str(job / \"custody\" / \"files\"),\n            \"--evidence\", str(job / \"custody\" / \"evidence\"),\n            \"--ledger\", str(job / \"inputs\" / \"custody-events.jsonl\"),\n            \"--custody\", custody]\n    rv = subprocess.run([sys.executable, str(HERE / \"plumbline_verify.py\"), *args],\n                        capture_output=True, text=True)\n    sys.stdout.write(rv.stdout)\n    sys.stderr.write(rv.stderr)\n    kind = \"verify\"\n    for line in rv.stdout.splitlines():\n        if line.startswith(\"FAIL \"):\n            parts = line.split()\n            if len(parts) >= 2:\n                kind = parts[1]\n            break\n    return rv.returncode, kind\n\n\ndef do_open(a) -> int:\n    job = Path(a.job_dir).expanduser()\n    if (job / \"packet.json\").is_file():\n        print(f\"REFUSED: this job is already open — {job}/packet.json exists. A job opens once; a job that \"\n              f\"needs new terms is a new job (a moved rubric is never a correction of an old one, C30).\")\n        return 1\n    if not Path(a.brief).is_file():\n        print(f\"REFUSED: no brief at {a.brief} — the terms of a job are the one thing a tool must not invent.\")\n        return 2\n    c = corpus_arg(a.corpus)\n    if c is None:\n        print(\"REFUSED: no corpus resolved. Set --corpus or $EDI_CORPUS.\"); return 2\n\n    job.mkdir(parents=True, exist_ok=True)\n    code = call(\"emit_packet.py\", [\"--brief\", a.brief, \"--out-dir\", str(job), \"--corpus\", c])\n    if code != 0:\n        shutil.rmtree(job, ignore_errors=True)\n        print(f\"\\nREFUSED AND UNDONE: the packet emitter refused the brief, so {job} was removed.\")\n        print(\"  A job folder that exists without readable terms is the artifact this kit exists to stop.\")\n        return code\n\n    (job / \"inputs\").mkdir(exist_ok=True)\n    dest = job / \"inputs\" / \"brief.json\"\n    # A caller that prepared the brief INSIDE the job — which a re-emit does — makes source and destination the\n    # same file, and shutil.copy raises SameFileError. Measured 2026-10-06, by running it.\n    if Path(a.brief).expanduser().resolve() != dest.resolve():\n        shutil.copy(a.brief, dest)\n    log_row(job, \"opened\", {\"mode\": packet_mode(job), \"artifact\": json.loads((job / \"packet.json\").read_text()).get(\"artifact\")},\n            a.run_log)\n    print(f\"\\njob open: {job}\")\n    print(f\"  packet.json  the terms, readable by the gate\")\n    print(f\"  inputs/      the brief (kept, and skipped by the close — an input is not a term)\")\n    print(f\"\\nclose it with:  plumbline_job.py close --job-dir {job} --run <run.json>\")\n    return 0\n\n\ndef do_close(a) -> int:\n    job = Path(a.job_dir).expanduser()\n    if not (job / \"packet.json\").is_file():\n        print(f\"REFUSED: {job} has no packet.json. An unopened job cannot be closed — close what open made.\")\n        return 2\n    c = corpus_arg(a.corpus)\n    if c is None:\n        print(\"REFUSED: no corpus resolved. Set --corpus or $EDI_CORPUS.\"); return 2\n    runs = [Path(r).expanduser() for r in a.run]\n    if not runs:\n        # A readings job files no §5 record — its record IS the reading — so --run is optional. But the\n        # converse would be a hole: a SCORED job closing with no record at all. Measured by reading this\n        # wrapper after writing it, which is the only way that hole was ever going to be found.\n        packet = json.loads((job / \"packet.json\").read_text())\n        if packet.get(\"mode\") == \"scored\":\n            print(\"REFUSED: this is a scored job and no --run was given. A scored job files at least one §5 \"\n                  \"record; a close without one would make a missing reading look like a closed job.\")\n            return 2\n        print(\"  no --run given: this job's packet is not `mode: scored`, so the close proceeds on the packet. \"\n              \"The reading itself is the record.\")\n    missing = [str(r) for r in runs if not r.is_file()]\n    if missing:\n        print(f\"REFUSED: run file(s) not found: {', '.join(missing)}\"); return 2\n\n    (job / \"inputs\").mkdir(exist_ok=True)\n    for r in runs:\n        code = call(\"emit_record.py\", [\"--run\", str(r), \"--out-dir\", str(job), \"--corpus\", c])\n        if code != 0:\n            print(f\"\\nNOT CLOSED: the record emitter refused {r.name}. A close on a refused record would make \"\n                  f\"the refusal invisible, which is the failure this wrapper exists to prevent.\")\n            return code\n        shutil.copy(r, job / \"inputs\" / r.name)\n\n    print(\"\\nclose:\")\n    code = call(\"plumbline.py\", [\"--job-close\", \"--record-close\", \"--corpus\", c, str(job)])\n    # THE END-OF-JOB FACTS, written before the close so the close records them in one packet. Validated\n    # against the corpus gate, and rolled back whole if the packet stops reading — a fact written into a\n    # packet the law can no longer read is worse than the fact being absent.\n    packet_path = job / \"packet.json\"\n    before = packet_path.read_text()\n    doc0 = json.loads(before)\n    if a.disposition in (\"given\", \"declined\"):\n        doc0[\"disposition\"] = a.disposition if a.disposition == \"declined\" else (a.disposition_note or \"given\")\n        doc0[\"disposition_state\"] = a.disposition\n    else:\n        doc0[\"disposition_state\"] = \"not_yet_given\"\n    if a.terminal_state:                       # the job's end state, as the Orchestrator rules it — never inferred\n        doc0[\"terminal_state\"] = a.terminal_state\n        if a.outcome:\n            doc0[\"outcome\"] = a.outcome\n    extra = {}\n    if a.billed_reroll:\n        extra[\"billed_reroll\"] = True\n    if a.escalation_kind:\n        extra[\"escalation_kind\"] = a.escalation_kind\n    if a.misalignment_iteration:\n        extra[\"misalignment\"] = {\"found_at_iteration\": a.misalignment_iteration,\n                                 **({\"spend_usd\": a.misalignment_spend} if a.misalignment_spend is not None else {}),\n                                 **({\"note\": a.misalignment_note} if a.misalignment_note else {})}\n    if extra or True:\n        doc0[\"close\"] = {**(doc0.get(\"close\") or {}), **extra}\n    packet_path.write_text(json.dumps(doc0, indent=2) + \"\\n\")\n    gate = Path(c) / \"tools\" / \"validate_job_packet.py\"\n    rv = subprocess.run([sys.executable, str(gate), str(packet_path)], capture_output=True, text=True)\n    if rv.returncode != 0:\n        packet_path.write_text(before)\n        print(\"REFUSED: writing the end-of-job facts made the packet unreadable — nothing kept:\")\n        print(\"  \" + (rv.stdout + rv.stderr).strip().replace(\"\\n\", \"\\n  \")[:300])\n        return rv.returncode\n    print(f\"  packet: disposition_state={doc0['disposition_state']}\"\n          + (f\" · billed_reroll={extra['billed_reroll']}\" if extra.get(\"billed_reroll\") else \"\")\n          + (f\" · misalignment at iteration {a.misalignment_iteration}\" if extra.get(\"misalignment\") else \"\"))\n\n    if code == 0:\n        doc = json.loads((job / \"packet.json\").read_text())\n        # THE STATE, NEVER THE ABSENCE. An accepted artifact with no disposition is a COMPLETE record: the\n        # Owner's act simply has not happened yet. A reader that stores null here later reads it as zero and\n        # manufactures the non-conformance it reports (corpus maintainer, 2026-10-05).\n        disp = doc.get(\"disposition\")\n        if isinstance(disp, dict):\n            state = disp.get(\"state\") or \"given\"\n        elif disp in (None, {}, []):\n            state = \"not_yet_given\"\n        else:\n            state = \"given\"\n        if doc.get(\"terminal_state\") in TERMINALS:\n            print(\"\\ncustody:\")\n            cargs = [\"--job-dir\", str(job)]\n            if getattr(a, \"allow_hand_times\", False):\n                cargs.append(\"--allow-hand-times\")\n            cc = call(\"emit_custody.py\", cargs)\n            if cc != 0:\n                why = (\"the refusals above name the fact the record would have misstated (fix its source: the harness \"\n                       \"log, inputs/custody.json, inputs/custody-events.jsonl, or the emitter checkout)\") if cc == 3 \\\n                    else \"the gaps above name what inputs/custody.json must supply\"\n                print(f\"\\nCLOSED, BUT THE CUSTODY RECORD IS {'INCOMPLETE' if cc == 1 else 'NOT WRITTEN'}: {why}; \"\n                      f\"re-emit with `plumbline_job.py custody`.\")\n                return cc\n            vc, kind = run_verifier(job, a)\n            if vc != 0:\n                print(f\"NOT CLOSED: Plumbline verify failed ({kind})\")\n                log_row(job, \"close_refused\", {\"kind\": kind, \"exit\": vc}, a.run_log)\n                return vc\n        log_row(job, \"closed\", {\"mode\": doc.get(\"mode\"), \"outcome\": doc.get(\"outcome\"),\n                                \"disposition_state\": state}, a.run_log)\n        print(f\"\\njob closed: {job}\")\n        if doc.get(\"terminal_state\") not in TERMINALS:\n            print(f\"  (no custody record: the packet's terminal_state is {doc.get('terminal_state')!r}, not terminal)\")\n    return code\n\n\nTERMINALS = (\"accepted\", \"needs_owner\", \"rejected\")\n\n\ndef do_custody(a) -> int:\n    \"\"\"Emit (or re-emit) the custody/v1 record for a job that has ended. Reads only the job's own files.\"\"\"\n    job = Path(a.job_dir).expanduser()\n    args = [\"--job-dir\", a.job_dir]\n    if a.out_dir:\n        args += [\"--out-dir\", a.out_dir]\n    if a.inputs:\n        args += [\"--inputs\", a.inputs]\n    if a.expect_revision:\n        args += [\"--expect-revision\", a.expect_revision]\n    if getattr(a, \"allow_hand_times\", False):\n        args.append(\"--allow-hand-times\")\n    code = call(\"emit_custody.py\", args)\n    if code != 0:\n        return code\n    rec = None\n    if a.out_dir:\n        try:\n            packet = json.loads((job / \"packet.json\").read_text())\n            job_id = packet.get(\"job_id\") or job.name\n        except Exception:\n            job_id = job.name\n        rec = Path(a.out_dir).expanduser() / f\"{job_id}.custody.json\"\n    vc, kind = run_verifier(job, a, rec)\n    if vc != 0:\n        print(f\"NOT CLOSED: Plumbline verify failed ({kind})\")\n    return vc\n\n\ndef main() -> int:\n    ap = argparse.ArgumentParser(description=\"A job's two commands: open and close. Neither is skippable.\")\n    sub = ap.add_subparsers(dest=\"cmd\", required=True)\n    o = sub.add_parser(\"open\", help=\"create the job folder BY emitting its packet; nothing else creates one\")\n    o.add_argument(\"--brief\", required=True)\n    o.add_argument(\"--job-dir\", required=True)\n    o.add_argument(\"--corpus\")\n    o.add_argument(\"--run-log\", help=\"override the run-log path (default: ../../run-log.json from the job dir)\")\n    c = sub.add_parser(\"close\", help=\"emit a §5 record for every run, then close and record the close\")\n    c.add_argument(\"--job-dir\", required=True)\n    c.add_argument(\"--disposition\", choices=[\"given\", \"declined\"], help=\"the Owner's disposition, when there \"\n                   \"is one. Absent means NOT YET GIVEN and is recorded as such — never as the absence of a \"\n                   \"disposition, which a reader would otherwise count as zero\")\n    c.add_argument(\"--disposition-note\", help=\"what the Owner did, in his words (the corpus field is free text)\")\n    c.add_argument(\"--billed-reroll\", action=\"store_true\", help=\"the Contracts' own fact: a regeneration was \"\n                   \"tasked with a violation the Maker could not act on\")\n    c.add_argument(\"--escalation-kind\", choices=[\"capability_gap\", \"cap_reached\", \"below_floor\", \"other\"])\n    c.add_argument(\"--misalignment-iteration\", type=int, help=\"O2's fact: the iteration where the run diverged\")\n    c.add_argument(\"--misalignment-spend\", type=float, help=\"the spend at that point, in USD\")\n    c.add_argument(\"--misalignment-note\")\n    c.add_argument(\"--run\", action=\"append\", default=[], help=\"the run file for one iteration (required when \"\n                                                             \"the packet's mode is `scored`; a readings job \"\n                                                             \"files no §5 record)\")\n    c.add_argument(\"--terminal-state\", choices=list(TERMINALS), help=\"the job's end state; when given (or \"\n                   \"already in the packet) the close also writes the custody/v1 record\")\n    c.add_argument(\"--outcome\", help=\"the packet outcome to record with --terminal-state (corpus vocabulary)\")\n    c.add_argument(\"--allow-hand-times\", action=\"store_true\",\n                   help=\"pass the hand-time allowance to the emitter; the verifier still enforces the flags\")\n    c.add_argument(\"--custody\", help=\"the custody checker checkout (default: $PLUMBLINE_CUSTODY)\")\n    c.add_argument(\"--corpus\")\n    c.add_argument(\"--run-log\", help=\"override the run-log path (default: ../../run-log.json from the job dir)\")\n    k = sub.add_parser(\"custody\", help=\"write the custody/v1 record of an ended job (no corpus needed)\")\n    k.add_argument(\"--job-dir\", required=True)\n    k.add_argument(\"--out-dir\", help=\"write <out-dir>/<job_id>.custody.json instead of <job>/custody/\")\n    k.add_argument(\"--inputs\", help=\"custody inputs (default: <job>/inputs/custody.json)\")\n    k.add_argument(\"--expect-revision\", help=\"the emitter revision (commit or tree) the record must be written by\")\n    k.add_argument(\"--allow-hand-times\", action=\"store_true\",\n                   help=\"pass the hand-time allowance to the emitter; the verifier still enforces the flags\")\n    k.add_argument(\"--custody\", help=\"the custody checker checkout (default: $PLUMBLINE_CUSTODY)\")\n    a = ap.parse_args()\n    return {\"open\": do_open, \"close\": do_close, \"custody\": do_custody}[a.cmd](a)\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n<<<PLUMBLINE-END path=kit/plumbline_job.py>>>\n<<<PLUMBLINE-FILE path=tests/test_plumbline_verify.py>>>\nimport json\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\nfrom hashlib import sha256\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[1]\nVERIFIER = ROOT / \"kit\" / \"plumbline_verify.py\"\nsys.path.insert(0, str(ROOT / \"kit\"))\nimport plumbline_verify as V  # noqa: E402\n\n\ndef write_fake_custody(tmp: Path, ok: bool = True):\n    c = tmp / \"custody\"\n    (c / \"checker\").mkdir(parents=True)\n    check = c / \"checker\" / \"check.py\"\n    check.write_text(\"import sys\\nsys.exit(0 if %r else 1)\\n\" % ok, encoding=\"utf-8\")\n    (c / \"tools\").mkdir(parents=True)\n    pin = sha256(check.read_bytes()).hexdigest() if ok else \"0\" 