ct(self, args):\n    err = io.StringIO()\n    code = None\n    with contextlib.redirect_stderr(err):\n        try:\n            code = L.main(args)\n        except SystemExit as exc:\n            code = exc.code\n    return code, err.getvalue()\n```\n\nThen assert code == 2 and any line startswith \"REFUSED:\".\n\nAlso check that ledger and custody.json bytes unchanged after all cases.\n\nAlso for evaluation with no --verdict and no --summary: our new check returns refuse(..., 2) with REFUSED. Good — but careful: argparse previously required --verdict; now not required. So that path reaches our refusal.\n\nWait — is `--evaluator` required? yes. In case [\"evaluation\", \"--job-dir\", job, \"--batch\", \"B\"] → missing --evaluator → argparse error → REFUSED via parser. Good.\n\nNow test L1a:\n\n```python\ndef test_evaluation_summary_without_verdict(self):\n    summary = self.job / \"summary.json\"\n    summary.write_text(json.dumps({\n        \"started_at\": \"...\", \"finished_at\": \"...\", \"writer\": \"tools/edi/x@abc\"}), encoding=\"utf-8\")\n    before = self.events.read_bytes()\n    self.assertEqual(self.run_cmd(\"evaluation\", \"--job-dir\", str(self.job), \"--batch\", \"B1\",\n                                  \"--evaluator\", \"e1\", \"--summary\", str(summary)), 0)\n    ev = self.read_events()[-1]\n    self.assertEqual(ev[\"summary_file\"], \"summary.json\")\n    self.assertEqual(ev[\"verdict_file\"], \"summary.json\")\n    self.assertEqual(ev[\"verdict_sha256\"], sha256(summary.read_bytes()).hexdigest())\n    self.assertEqual(ev[\"summary_sha256\"], sha256(summary.read_bytes()).hexdigest())\n    self.assertEqual(ev[\"summary_writer\"], \"tools/edi/x@abc\")\n    self.assertEqual(ev[\"started_at\"], ...)\n    self.assertEqual(ev[\"finished_at\"], ...)\n    # unstamped summary refused\n    bad = self.job / \"bad.json\"\n    bad.write_text(json.dumps({\"started_at\": \"x\"}), encoding=\"utf-8\")\n    before = self.events.read_bytes()\n    code, err = ...\n   