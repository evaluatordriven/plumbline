t_sha256\": \"b\" * 64, \"at\": \"2026-10-20T10:30:00Z\", \"writer\": \"kit/custody_ledger.py@abc123def456\"},\n    {\"event\": \"relay\", \"kind\": \"relay\", \"quote\": \"buyer likes it\", \"from\": \"relay-bot\",\n     \"source_chat\": \"chat-1\", \"source_at\": \"2026-10-20T10:31:00Z\", \"at\": \"2026-10-20T10:32:00Z\",\n     \"writer\": \"kit/custody_ledger.py@abc123def456\"},\n    {\"event\": \"amendment\", \"file\": \"amend.md\", \"file_sha256\": \"c\" * 64, \"quote\": \"tighten D2\",\n     \"channel\": \"chat-1\", \"said_at\": \"2026-10-20T10:33:00Z\", \"at\": \"2026-10-20T10:34:00Z\",\n     \"writer\": \"kit/custody_ledger.py@abc123def456\"},\n)))\no = TMP / \"f1h.json\"\nrc, out = emit(j, o, allow_hand=True)\nrx = json.loads(o.read_text())[\"predicate\"][\"x-plumbline\"] if o.is_file() else {}\nok = (rc == 0\n      and any(e.get(\"action\") == \"open\" and e.get(\"n\") == 1 for e in rx.get(\"generations\") or [])\n      and any(e.get(\"batch\") == \"b1\" for e in rx.get(\"evaluations\") or [])\n      and any(e.get(\"quote\") == \"buyer likes it\" for e in rx.get(\"relays\") or [])\n      and any(e.get(\"quote\") == \"tighten D2\" for e in rx.get(\"amendments\") or [])\n      and all(str(e.get(\"source\", \"\")).startswith(\"inputs/custody-events.jsonl:\")\n              for k in (\"generations\", \"evaluations\", \"relays\", \"amendments\") for e in rx.get(k) or []))\nres((f\"{S} · F1h the emitter carries generations/evaluations/relays/amendments into x-plumbline with file:line\",\n     ok, f\"exit {rc}: {out.strip()[-140:]}\"))\n\n# ---- X1: the inputs' own x-plumbline is deep-equal under .inputs and cannot shadow the emitter's keys ----\nj = job_copy(\"x1-inputs\")\nc = json.loads((j / \"inputs\" / \"custody.json\").read_text())\ninp = {\"note\": \"from inputs\", \"verdict\": \"JUNK\", \"gaps\": [\"JUNK\"], \"times\": \"JUNK\",\n       \"hand_times\": \"JUNK\", \"nested\": {\"k\": [1, 2, 3]}}\nc[\"x-plumbline\"] = inp\n(j / \"inputs\" / \"custody.json\").write_text(json.dumps(c, indent=2) + \"\\n\")\no = TMP / \"x1.json\"\nrc, out = emit(j, o, allow_hand=True)\nrx = json.loads(o.read_text())[\"predicate\"][\"x-plumbline\"] if o.is_file() else {}\nres((f\"{S} · X1 an inputs x-plumbline is deep-equal under .inputs and cannot shadow the emitter's own keys\",\n     rc == 0 and rx.get(\"inputs\") == inp and rx.get(\"verdict\") != \"JUNK\"\n     and isinstance(rx.get(\"gaps\"), list) and isinstance(rx.get(\"hand_times\"), list)\n     and rx.get(\"times\") != \"JUNK\", f\"exit {rc}: {out.strip()[-140:]}\"))\n\n# ---- T4/E1/E3: a job whose every time comes from the kit's own tools, and the hand-time coverage they need ----\ndef _iso(dt):\n    return dt.astimezone(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef _ts(s):\n    return datetime.strptime(s, \"%Y-%m-%dT%H:%M:%SZ\").replace(tzinfo=timezone.utc)\n\n\ndef stamp_log(path, at):\n    \"\"\"Write the logger's own sent_at/received_at into every call of a harness log, as tools/edi/or_call.py\n    does. Without them every call is a hand time (T7b), and a job the tools built has none.\"\"\"\n    text = path.read_text(encoding=\"utf-8\")\n    try:\n        doc = json.loads(text)\n        items, array = (doc, True) if isinstance(doc, list) else ([doc], False)\n    except ValueError:\n        items, array = [json.loads(ln) for ln in text.splitlines() if ln.strip()], False\n    for c in items:\n        if isinstance(c, dict):\n            c[\"sent_at\"] = c[\"received_at\"] = at\n    path.write_text((json.dumps(items, indent=2) + \"\\n\") if array\n                    else \"\".join(json.dumps(c) + \"\\n\" for c in items), encoding=\"utf-8\")\n\n\ndef tool_built_job(name):\n    \"\"\"The fixture's static facts with every typed time removed, rebuilt only by kit/custody_ledger.py:\n    freeze / approve / pin / generation / evaluation / dispose --decided-at (T4, F1b).\"\"\"\n    j = job_copy(name)\n    cj = json.loads((j / \"inputs\" / \"custody.json\").read_text(encoding=\"utf-8\"))\n    roles = [(a.get(\"role\"), a.get(\"by\")) for a in (cj.get(\"bar\") or {}).get(\"approvals\") or []]\n    dsp = cj.get(\"disposition\") or {}\n    ev_id = str(((cj.get(\"evaluators\") or [{}])[0]).get(\"id\") or \"eval-a\")\n    for k in (\"frozenAt\", \"approvals\"):\n        (cj.get(\"bar\") or {}).pop(k, None)\n    for k in (\"disposition\", \"routing\", \"startedAt\", \"producedAt\"):\n        cj.pop(k, None)\n    for f in (cj.get(\"passes\") or {}).values():\n        f.pop(\"at\", None)\n    for k in cj.get(\"controls\") or []:\n        k.pop(\"at\", None)\n    (j / \"inputs\" / \"custody.json\").write_text(json.dumps(cj, indent=2) + \"\\n\", encoding=\"utf-8\")\n    (j / \"inputs\" / \"custody-events.jsonl\").unlink(missing_ok=True)\n    pk = json.loads((j / \"packet.json\").read_text(encoding=\"utf-8\"))\n    pk.pop(\"close\", None)          # the tool's clock stamps the events; a fixture close date would pre-date them\n    (j / \"packet.json\").write_text(json.dumps(pk, indent=2) + \"\\n\", encoding=\"utf-8\")\n\n    def run(*args):\n        rc, out = run_py([str(LEDGER), *args, \"--job-dir\", str(j)])\n        if rc != 0:\n            raise RuntimeError(f\"ledger {args[0]} refused: {out.strip()[-200:]}\")\n        return out\n\n    # a pin is declared before the seat's first call (custody_ledger.py pin): put the fixture's log back after\n    mlog = next(iter((j / \"custody\" / \"evidence\").glob(\"harness-maker*.log\")), None)\n    saved = mlog.read_bytes() if mlog and mlog.is_file() else None\n    if saved is not None:\n        mlog.unlink()\n    run(\"freeze\")\n    evs = [json.loads(x) for x in (j / \"inputs\" / \"custody-events.jsonl\").read_text().splitlines() if x.strip()]\n    fz = _ts(evs[-1][\"at\"])\n    for role, by in roles:\n        run(\"approve\", \"--role\", role, \"--by\", by)\n    run(\"pin\", \"--seat\", \"maker\", \"--provider\", \"DeepInfra\", \"--slug\", \"deepinfra/fp8\", \"--host\", \"api.deepinfra.com\")\n    if saved is not None:\n        mlog.write_bytes(saved)\n    run(\"generation\", \"open\", \"--seat\", \"maker\", \"--prompt\", \"custody/bar.md\")\n    run(\"generation\", \"close\", \"--seat\", \"maker\", \"--n\", \"1\", \"--outcome\", \"done\")\n    run(\"evaluation\", \"--batch\", \"b1\", \"--evaluator\", ev_id, \"--verdict\", \"custody/bar.md\")\n    # the tools wrote the logs, so every call carries the logger's own times (T7b); the freeze stays earliest\n    for lg in (j / \"custody\" / \"evidence\").glob(\"harness-*.log\"):\n        stamp_log(lg, _iso(fz + timedelta(seconds=1)))\n    # dispose --decided-at: the Owner's time, bounded by the last logged check and the tool's clock (F1b, E1)\n    last = max([_ts(e[\"at\"]) for e in evs if e.get(\"at\")] + [fz + timedelta(seconds=2)])\n    args = [\"dispose\", \"--by\", dsp.get(\"by\") or \"Fixture Owner\"]\n    if dsp.get(\"state\") in (\"given\", \"declined\"):\n        args += [\"--state\", dsp[\"state\"]]\n    for _ in range(6):\n        decided = last + timedelta(seconds=1)\n        while time.time() < decided.timestamp() + 1.9:\n            time.sleep(0.05)\n        rc, out = run_py([str(LEDGER), *args, \"--job-dir\", str(j), \"--decided-at\", _iso(decided),\n                          \"--decided-source\", \"chat\"])\n        if rc == 0:\n            return j\n        if \"before the last logged check\" not in out:\n            raise RuntimeError(f\"ledger dispose refused: {out.strip()[-200:]}\")\n        last += timedelta(seconds=1)\n    raise RuntimeError(\"ledger dispose kept refusing (decided_at before the last logged check)\")\n\n\ntry:\n    TJ = tool_built_job(\"tool-built\")\n    tj = json.loads((TJ / \"inputs\" / \"custody.json\").read_text(encoding=\"utf-8\"))\n    tj[\"x-plumbline\"] = {\"note\": \"from the ledger's inputs\", \"verdict\": \"JUNK\", \"gaps\": [\"JUNK\"],\n                         \"times\": \"JUNK\", \"hand_times\": [\"JUNK\"], \"nested\": {\"k\": [1, 2, 3]}}\n    (TJ / \"inputs\" / \"custody.json\").write_text(json.dumps(tj, indent=2) + \"\\n\", encoding=\"utf-8\")\n    o = TMP / \"tool-built.json\"\n    rc, out = emit(TJ, o, allow_hand=False)\n    rt = json.loads(o.read_text(encoding=\"utf-8\"))[\"predicate\"] if o.is_file() else {}\n    rx = rt.get(\"x-plumbline\") or {}\n    res((f\"{S} · T4 a job built only with kit/custody_ledger.py emits with no switch (exit 0, empty hand_times)\",\n         rc == 0 and rx.get(\"hand_times\") == [], f\"exit {rc}: {out.strip()[-160:]}\"))\n    dispo = [json.loads(x) for x in (TJ / \"inputs\" / \"custody-events.jsonl\").read_text().splitlines()\n             if x.strip() and json.loads(x).get(\"event\") == \"dispose\"]\n    res((f\"{S} · F1b the record's disposition.at is the line's decided_at, not the tool clock\",\n         bool(dispo) and (rt.get(\"disposition\") or {}).get(\"at\") == dispo[-1].get(\"decided_at\")\n         and dispo[-1].get(\"decided_at\") != dispo[-1].get(\"at\"),\n         f\"decided_at {dispo[-1].get('decided_at') if dispo else None}\"))\n    res((f\"{S} · F1h/X1 the tool-built record carries the ledger arrays with file:line and the inputs deep-equal\",\n         all(str(e.get(\"source\", \"\")).startswith(\"inputs/custody-events.jsonl:\")\n             for k in (\"generations\", \"evaluations\") for e in rx.get(k) or [])\n         and bool(rx.get(\"generations\")) and bool(rx.get(\"evaluations\"))\n         and rx.get(\"inputs\") == tj[\"x-plumbline\"] and rx.get(\"verdict\") != \"JUNK\"\n         and isinstance(rx.get(\"hand_times\"), list)\n         and (rx.get(\"spend\") or {}).get(\"tolerance_usd\") == 0.0001,\n         json.dumps(rx.get(\"inputs\"))[:140]))\nexcept Exception as exc:\n    res((f\"{S} · T4 a job built only with kit/custody_ledger.py emits with no switch (exit 0, empty hand_times)\",\n         False, f\"{type(exc).__name__}: {exc}\"[:160]))\n\n# E2: a typed pass time is a hand time even when a harness call is linked\nj = job_copy(\"t2-pass-at\")\nc = json.loads((j / \"inputs\" / \"custody.json\").read_text(encoding=\"utf-8\"))\nc[\"passes\"][\"pass-a\"][\"at\"] = \"2026-10-20T12:00:02Z\"\n(j / \"inputs\" / \"custody.json\").write_text(json.dumps(c, indent=2) + \"\\n\", encoding=\"utf-8\")\nrc, out = emit(j, TMP / \"t2pass.json\", allow_hand=False)\nres((f\"{S} · T2c/E2 a typed passes.<id>.at is a hand time even when a call is linked (inputs-no-ledger)\",\n     rc == 3 and \"passes.pass-a.at\" in out and \"inputs-no-ledger\" in out, f\"exit {rc}: {out.strip()[-140:]}\"))\no = TMP / \"t2pass-allow.json\"\nrc, out = emit(j, o, allow_hand=True)\nht = {e.get(\"field\"): e for e in ((json.loads(o.read_text())[\"predicate\"][\"x-plumbline\"][\"hand_times\"])\n                                  if o.is_file() else [])}\nres((f\"{S} · E2 under --allow-hand-times the typed pass time is listed and the record carries the call's time\",\n     rc == 0 and (ht.get(\"passes.pass-a.at\") or {}).get(\"source\") == \"inputs-no-ledger\"\n     and json.loads(o.read_text())[\"predicate\"][\"checks\"][0][\"at\"] == \"2026-10-20T12:00:03Z\",\n     f\"exit {rc}: {out.strip()[-140:]}\"))\n\n# E3: every call of every harness log read, both fields (the fixture's evaluator log has no logger sent_at)\nrc, out = emit(FIX, TMP / \"e3.json\", allow_hand=False)\nres((f\"{S} · T7b/E3 every evaluator call the logger did not stamp is named (harness-eval-a.log, server time)\",\n     rc == 3 and out.count(\"harness-eval-a.log#\") >= 3 and \".sent_at\" in out\n     and (\"server-header\" in out or \"response-created\" in out), f\"exit {rc}: {out.strip()[-160:]}\"))\n\n# E1: a real disagreement between custody.json's disposition.at and the line's decided_at still refuses\nj = job_copy(\"dispose-mismatch\")\nc = json.loads((j / \"inputs\" / \"custody.json\").read_text(encoding=\"utf-8\"))\nc.setdefault(\"disposition\", {}).update({\"at\": \"2026-10-20T12:30:00Z\",\n                                        \"by\": (c.get(\"disposition\") or {}).get(\"by\") or \"Fixture Owner\"})\n(j / \"inputs\" / \"custody.json\").write_text(json.dumps(c, indent=2) + \"\\n\", encoding=\"utf-8\")\nappend_text(j / \"inputs\" / \"custody-events.jsonl\", json.dumps(\n    {\"event\": \"dispose\", \"by\": c[\"disposition\"][\"by\"], \"at\": \"2026-10-20T13:00:00Z\",\n     \"decided_at\": \"2026-10-20T12:31:00Z\", \"writer\": \"kit/custody_ledger.py@abc123def456\"}) + \"\\n\")\nrc, out = emit(j, TMP / \"dispose-mismatch.json\", allow_hand=True)\nres((f\"{S} · E1 a dispose line whose decided_at disagrees with custody.json still refuses (time)\",\n     rc == 3 and \"disposition:\" in out and \"[time]\" in out, f\"exit {rc}: {out.strip()[-140:]}\"))\n\n# ---- V1/V3/T2: a record the emitter wrote verifies at both layers with exit 0 (the verifier's own logic) ----\ndef _stand_in_checkout(name):\n    \"\"\"A temp custody checkout holding a stand-in checker that refuses unless `--bar` is given (so a verifier\n    that forgets it cannot pass again), pinned by its own sha256.\"\"\"\n    d = TMP / name\n    (d / \"checker\").mkdir(parents=True)\n    (d / \"tools\").mkdir(parents=True)\n    checker = d / \"checker\" / \"check.py\"\n    checker.write_text(\n        \"import json, sys\\n\"\n        \"from hashlib import sha256\\n\"\n        \"from pathlib import Path\\n\"\n        \"def arg(n):\\n\"\n        \"    a = sys.argv[1:]\\n\"\n        \"    return a[a.index(n) + 1] if n in a and a.index(n) + 1 < len(a) else None\\n\"\n        \"if not arg('--bar'):\\n\"\n        \"    print('checker: --bar is required', file=sys.stderr)\\n\"\n        \"    sys.exit(2)\\n\"\n        \"rec = Path(sys.argv[1])\\n\"\n        \"files = arg('--files')\\n\"\n        \"doc = json.loads(rec.read_text(encoding='utf-8'))\\n\"\n        \"for s in doc.get('subject') or []:\\n\"\n        \"    p = (Path(files) / s['name']) if files else None\\n\"\n        \"    want = (s.get('digest') or {}).get('sha256')\\n\"\n        \"    if p is None or not p.is_file() or sha256(p.read_bytes()).hexdigest() != want:\\n\"\n        \"        print('checker: subject mismatch for ' + str(s.get('name')), file=sys.stderr)\\n\"\n        \"        sys.exit(1)\\n\"\n        \"sys.exit(0)\\n\", encoding=\"utf-8\")\n    (d / \"tools\" / \"pin.json\").write_text(\n        json.dumps({\"checker/check.py\": hashlib.sha256(checker.read_bytes()).hexdigest()}) + \"\\n\",\n        encoding=\"utf-8\")\n    return d\n\n\ndef verify_record(rec, job, co):\n    return run_py([str(SNAP / \"kit\" / \"plumbline_verify.py\"),\n                   \"--record\", str(rec),\n                   \"--files\", str(job / \"custody\" / \"files\"),\n                   \"--evidence\", str(job / \"custody\" / \"evidence\"),\n                   \"--ledger\", str(job / \"inputs\" / \"custody-events.jsonl\"),\n                   \"--custody\", str(co)])\n\n\nVCO = _stand_in_checkout(\"verify-checkout\")\nrt_rec = TMP / \"roundtrip.custody.json\"\nrc, out = emit(FIX, rt_rec, allow_hand=True)\nvrc, vout = verify_record(rt_rec, FIX, VCO)\nrt_xp = json.loads(rt_rec.read_text())[\"predicate\"][\"x-plumbline\"] if rt_rec.is_file() else {}\nres((f\"{S} · V1/V3/T2 a job emitted with --allow-hand-times verifies with exit 0 \"\n     f\"(no flag-without-source, no shadow)\",\n     rc == 0 and vrc == 0 and \"flag-without-source\" not in vout and \"shadow\" not in vout,\n     f\"emit {rc}, verify {vrc}: {vout.strip()[-160:]}\"))\nres((f\"{S} · T3 every hand time the emitter flagged is in x-plumbline.hand_times with file:line\",\n     bool(rt_xp.get(\"hand_times\"))\n     and all(e.get(\"field\") and e.get(\"file\") and e.get(\"line\") is not None\n             for e in rt_xp.get(\"hand_times\") or []),\n     json.dumps((rt_xp.get(\"hand_times\") or [])[:2])[:160]))\n\n# ---- F1f: a relay is a report, never an approval (the emitter refuses a relay-only buyer approval) ----\nj = job_copy(\"f1f-relay\")\ncj = json.loads((j / \"inputs\" / \"custody.json\").read_text(encoding=\"utf-8\"))\napps = (cj.get(\"bar\") or {}).get(\"approvals\") or []\nspec = next((a for a in apps if a.get(\"role\") == \"specialist\"), None)\ncj[\"bar\"][\"approvals\"] = [a for a in apps if a.get(\"role\") != \"buyer\"]\n(j / \"inputs\" / \"custody.json\").write_text(json.dumps(cj, indent=2) + \"\\n\", encoding=\"utf-8\")\nled = j / \"inputs\" / \"custody-events.jsonl\"\nlines = [json.loads(x) for x in led.read_text(encoding=\"utf-8\").splitlines() if x.strip()] if led.is_file() else []\nlines = [e for e in lines if not (e.get(\"event\") == \"approve\" and e.get(\"role\") == \"buyer\")]\nwhen = (spec or {}).get(\"at\") or \"2026-10-20T10:10:00Z\"\nif spec and not any(e.get(\"event\") == \"approve\" and e.get(\"role\") == \"specialist\" for e in lines):\n    lines.append({\"event\": \"approve\", \"role\": \"specialist\", \"by\": spec.get(\"by\"), \"at\": when,\n                  \"writer\": \"kit/custody_ledger.py@abc123def456\"})\nlines.append({\"event\": \"relay\", \"kind\": \"relay\", \"quote\": \"the buyer is happy\", \"from\": \"relay-bot\",\n              \"source_chat\": \"chat-1\", \"source_at\": when, \"at\": when,\n              \"writer\": \"kit/custody_ledger.py@abc123def456\"})\nled.write_text(\"\".join(json.dumps(e) + \"\\n\" for e in lines), encoding=\"utf-8\")\no = TMP / \"f1f-relay.json\"\nrc, out = emit(j, o, allow_hand=True)\nres((f\"{S} · F1f a buyer approval that exists only as a relay is refused (approval, buyer, nothing written)\",\n     rc == 3 and \"[approval]\" in out and \"buyer\" in out and not o.exists(), f\"exit {rc}: {out.strip()[-140:]}\"))\nlines.append({\"event\": \"approve\", \"role\": \"buyer\", \"by\": \"Fixture Buyer\", \"at\": when,\n              \"writer\": \"kit/custody_ledger.py@abc123def456\"})\nled.write_text(\"\".join(json.dumps(e) + \"\\n\" for e in lines), encoding=\"utf-8\")\no2 = TMP / \"f1f-relay-ok.json\"\nrc2, out2 = emit(j, o2, allow_hand=True)\nres((f\"{S} · F1f a direct buyer approve line removes the relay-only refusal\",\n     rc2 == 0, f\"exit {rc2}: {out2.strip()[-140:]}\"))\n\nshutil.rmtree(TMP, ignore_errors=True)\n\n# ---------------------------------------------------------------- report\n\nprint()\nwidth = max(len(n) for n, _, _ in results)\nfor name, ok, why in results:\n    print(f\"[{'PASS' if ok else 'FAIL'}] {name:<{width}} {why}\")\nfailed = [n for n, ok, _ in results if not ok]\nprint()\nif failed:\n    print(f\"{len(results) - len(failed)}/{len(results)} PASSED — {len(failed)} FAILED:\")\n    for n in failed:\n        print(f\"  - {n}\")\n    sys.exit(1)\nprint(f\"ALL {len(results)} CASES BEHAVED AS DESIGNED\")\n```\n\n## FILE tests/test_custody_ledger.py (as committed at your iteration-3 attempt-2 commit 4c2444c3; allowed in this request)\n\n```\nimport contextlib\nimport io\nimport json\nimport sys\nimport tempfile\nimport unittest\nfrom datetime import datetime, timedelta, timezone\nfrom hashlib import sha256\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(ROOT / \"kit\"))\nimport custody_ledger as L  # noqa: E402\nimport custody_history as H  # noqa: E402\n\n# 2026-01-01T00:00:00Z, the epoch of the response `created` times the log fixtures carry.\nCREATED = 1767225600\n\n\ndef iso(dt):\n    return dt.astimezone(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\nclass LedgerTest(unittest.TestCase):\n    def setUp(self):\n        self.tmp = tempfile.TemporaryDirectory()\n        self.job = Path(self.tmp.name) / \"job\"\n        (self.job / \"inputs\").mkdir(parents=True)\n        self.ci = {\"custody_inputs\": \"plumbline/custody-inputs/v1\", \"bar\": {}}\n        self.write_ci()\n        self.events = self.job / \"inputs\" / \"custody-events.jsonl\"\n        self.events.touch()\n        self.bar = self.job / \"custody\" / \"bar.md\"\n        self.bar.parent.mkdir()\n        self.bar.write_text(\"bar\\n\", encoding=\"utf-8\")\n\n    def tearDown(self):\n        self.tmp.cleanup()\n\n    def write_ci(self):\n        (self.job / \"inputs\" / \"custody.json\").write_text(\n            json.dumps(self.ci, indent=2, ensure_ascii=False) + \"\\n\", encoding=\"utf-8\")\n\n    def read_events(self):\n        return [json.loads(x) for x in self.events.read_text(encoding=\"utf-8\").splitlines() if x.strip()]\n\n    def run_cmd(self, *args):\n        return L.main(list(args))\n\n    def run_capture(self, *args):\n        \"\"\"Run a command, catching argparse's SystemExit, and return (code, stderr text).\"\"\"\n        err = io.StringIO()\n        try:\n            with contextlib.redirect_stderr(err):\n                code = L.main(list(args))\n        except SystemExit as exc:\n            code = exc.code if isinstance(exc.code, int) else 2\n        return code, err.getvalue()\n\n    def test_writer_stamp_on_every_line(self):\n        self.assertEqual(self.run_cmd(\"freeze\", \"--job-dir\", str(self.job)), 0)\n        ev = self.read_events()[-1]\n        sha12 = sha256((ROOT / \"kit\" / \"custody_ledger.py\").read_bytes()).hexdigest()[:12]\n        self.assertEqual(ev[\"writer\"], f\"kit/custody_ledger.py@{sha12}\")\n        self.assertIn(\"at\", ev)\n        # base dispose also carries it\n        self.assertEqual(self.run_cmd(\"dispose\", \"--job-dir\", str(self.job), \"--by\", \"Owner\"), 0)\n        ev = self.read_events()[-1]\n        self.assertEqual(ev[\"writer\"], f\"kit/custody_ledger.py@{sha12}\")\n\n    def test_generation_open_close(self):\n        self.assertEqual(self.run_cmd(\"freeze\", \"--job-dir\", str(self.job)), 0)\n        prompt = self.job / \"prompt.md\"\n        prompt.write_text(\"prompt\\n\", encoding=\"utf-8\")\n        before = self.events.read_bytes()\n        self.assertEqual(self.run_cmd(\"generation\", \"open\", \"--job-dir\", str(self.job),\n                                      \"--seat\", \"maker\", \"--prompt\", str(prompt)), 0)\n        after = self.events.read_bytes()\n        self.assertTrue(after.startswith(before))\n        self.assertEqual(len(self.read_events()), 2)\n        ev = self.read_events()[-1]\n        self.assertEqual(ev[\"action\"], \"open\")\n        self.assertEqual(ev[\"n\"], 1)\n        self.assertEqual(ev[\"prompt_sha256\"], sha256(prompt.read_bytes()).hexdigest())\n        # second open refused, nothing appended\n        before = self.events.read_bytes()\n        self.assertNotEqual(self.run_cmd(\"generation\", \"open\", \"--job-dir\", str(self.job),\n                                         \"--seat\", \"maker\", \"--prompt\", str(prompt)), 0)\n        self.assertEqual(self.events.read_bytes(), before)\n        # close\n        self.assertEqual(self.run_cmd(\"generation\", \"close\", \"--job-dir\", str(self.job),\n                                      \"--seat\", \"maker\", \"--n\", \"1\"), 0)\n        self.assertEqual(self.read_events()[-1][\"action\"], \"close\")\n        # close again refused\n        before = self.events.read_bytes()\n        self.assertNotEqual(self.run_cmd(\"generation\", \"close\", \"--job-dir\", str(self.job),\n                                         \"--seat\", \"maker\", \"--n\", \"1\"), 0)\n        self.assertEqual(self.events.read_bytes(), before)\n        # next open n=2\n        self.assertEqual(self.run_cmd(\"generation\", \"open\", \"--job-dir\", str(self.job),\n                                      \"--seat\", \"maker\", \"--prompt\", str(prompt)), 0)\n        self.assertEqual(self.read_events()[-1][\"n\"], 2)\n\n    def test_evaluation_sha_and_summary(self):\n        verdict = self.job / \"verdict.txt\"\n        verdict.write_text(\"v\\n\", encoding=\"utf-8\")\n        self.assertEqual(self.run_cmd(\"evaluation\", \"--job-dir\", str(self.job), \"--batch\", \"B1\",\n                                      \"--evaluator\", \"e1\", \"--verdict\", str(verdict)), 0)\n        ev = self.read_events()[-1]\n        self.assertEqual(ev[\"verdict_sha256\"], sha256(verdict.read_bytes()).hexdigest())\n        # missing verdict refused\n        before = self.events.read_bytes()\n        self.assertNotEqual(self.run_cmd(\"evaluation\", \"--job-dir\", str(self.job), \"--batch\", \"B1\",\n                                         \"--evaluator\", \"e1\", \"--verdict\", str(self.job / \"nope\")), 0)\n        self.assertEqual(self.events.read_bytes(), before)\n        # summary with stamp\n        summary = self.job / \"summary.json\"\n        summary.write_text(json.dumps({\n            \"started_at\": \"2026-01-01T00:00:00Z\",\n            \"finished_at\": \"2026-01-01T00:01:00Z\",\n            \"writer\": \"tools/edi/x@abc\",\n        }), encoding=\"utf-8\")\n        self.assertEqual(self.run_cmd(\"evaluation\", \"--job-dir\", str(self.job), \"--batch\", \"B2\",\n                                      \"--evaluator\", \"e1\", \"--verdict\", str(verdict),\n                                      \"--summary\", str(summary)), 0)\n        ev = self.read_events()[-1]\n        self.assertEqual(ev[\"summary_writer\"], \"tools/edi/x@abc\")\n        self.assertEqual(ev[\"started_at\"], \"2026-01-01T00:00:00Z\")\n        # summary without stamp refused\n        bad = self.job / \"bad.json\"\n        bad.write_text(\"{}\", encoding=\"utf-8\")\n        before = self.events.read_bytes()\n        self.assertNotEqual(self.run_cmd(\"evaluation\", \"--job-dir\", str(self.job), \"--batch\", \"B3\",\n                                         \"--evaluator\", \"e1\", \"--verdict\", str(verdict),\n                                         \"--summary\", str(bad)), 0)\n        self.assertEqual(self.events.read_bytes(), before)\n\n    def test_evaluation_summary_without_verdict(self):\n        \"\"\"L1(a): `evaluation --summary FILE` with no --verdict appends the stamped line (F1d).\"\"\"\n        summary = self.job / \"summary.json\"\n        summary.write_text(json.dumps({\n            \"started_at\": \"2026-01-01T00:00:00Z\",\n            \"finished_at\": \"2026-01-01T00:01:00Z\",\n            \"writer\": \"tools/edi/x@abc\",\n        }), encoding=\"utf-8\")\n        before = self.events.read_bytes()\n        self.assertEqual(self.run_cmd(\"evaluation\", \"--job-dir\", str(self.job), \"--batch\", \"B1\",\n                                      \"--evaluator\", \"e1\", \"--summary\", str(summary)), 0)\n        after = self.events.read_bytes()\n        self.assertTrue(after.startswith(before))\n        ev = self.read_events()[-1]\n        sha = sha256(summary.read_bytes()).hexdigest()\n        self.assertEqual(ev[\"event\"], \"evaluation\")\n        self.assertEqual(ev[\"verdict_file\"], \"summary.json\")\n        self.assertEqual(ev[\"verdict_sha256\"], sha)\n        self.assertEqual(ev[\"summary_file\"], \"summary.json\")\n        self.assertEqual(ev[\"summary_sha256\"], sha)\n        self.assertEqual(ev[\"summary_writer\"], \"tools/edi/x@abc\")\n        self.assertEqual(ev[\"started_at\"], \"2026-01-01T00:00:00Z\")\n        self.assertEqual(ev[\"finished_at\"], \"2026-01-01T00:01:00Z\")\n        self.assertEqual(ev[\"writer\"], L.writer_stamp())\n        # a summary with no stamp is refused with a REFUSED: line, and nothing is appended\n        bad = self.job / \"bad.json\"\n        bad.write_text(json.dumps({\"started_at\": \"2026-01-01T00:00:00Z\"}), encoding=\"utf-8\")\n        before = self.events.read_bytes()\n        code, err = self.run_capture(\"evaluation\", \"--job-dir\", str(self.job), \"--batch\", \"B2\",\n                                     \"--evaluator\", \"e1\", \"--summary\", str(bad))\n        self.assertEqual(code, 3, err)\n        self.assertTrue(any(ln.startswith(\"REFUSED:\") for ln in err.splitlines()), err)\n        self.assertEqual(self.events.read_bytes(), before)\n\n    def test_usage_errors_refuse_with_refused_line(self):\n        \"\"\"L1(b): every usage error, argparse errors included, exits 2 with a `REFUSED:` line, writing nothing.\"\"\"\n        before_ev = self.events.read_bytes()\n        before_ci = (self.job / \"inputs\" / \"custody.json\").read_bytes()\n        cases = [\n            [\"nonsense\", \"--job-dir\", str(self.job)],\n            [\"freeze\"],\n            [\"generation\", \"close\", \"--job-dir\", str(self.job), \"--seat\", \"maker\", \"--n\", \"x\"],\n            [\"evaluation\", \"--job-dir\", str(self.job), \"--batch\", \"B1\"],\n            [\"evaluation\", \"--job-dir\", str(self.job), \"--batch\", \"B1\", \"--evaluator\", \"e1\"],\n            [\"dispose\", \"--job-dir\", str(self.job)],\n        ]\n        for args in cases:\n            code, err = self.run_capture(*args)\n            self.assertEqual(code, 2, (args, err))\n            self.assertTrue(any(ln.startswith(\"REFUSED:\") for ln in err.splitlines()), (args, err))\n            self.assertEqual(self.events.read_bytes(), before_ev, args)\n            self.assertEqual((self.job / \"inputs\" / \"custody.json\").read_bytes(), before_ci, args)\n\n    def test_amendment_bounds(self):\n        self.assertEqual(self.run_cmd(\"freeze\", \"--job-dir\", str(self.job)), 0)\n        frozen = self.read_events()[-1][\"at\"]\n        amend = self.job / \"amend.md\"\n        amend.write_text(\"a\\n\", encoding=\"utf-8\")\n        now = datetime.now(timezone.utc)\n        # before freeze\n        before = self.events.read_bytes()\n        self.assertNotEqual(self.run_cmd(\"amendment\", \"--job-dir\", str(self.job), \"--file\", str(amend),\n                                         \"--quote\", \"q\", \"--channel\", \"c\",\n                                         \"--said-at\", iso(now - timedelta(days=1))), 0)\n        self.assertEqual(self.events.read_bytes(), before)\n        # after now\n        self.assertNotEqual(self.run_cmd(\"amendment\", \"--job-dir\", str(self.job), \"--file\", str(amend),\n                                         \"--quote\", \"q\", \"--channel\", \"c\",\n                                         \"--said-at\", iso(now + timedelta(days=1))), 0)\n        # inside custody\n        inside = self.job / \"custody\" / \"amend.md\"\n        inside.write_text(\"a\\n\", encoding=\"utf-8\")\n        self.assertNotEqual(self.run_cmd(\"amendment\", \"--job-dir\", str(self.job), \"--file\", str(inside),\n                                         \"--quote\", \"q\", \"--channel\", \"c\", \"--said-at\", frozen), 0)\n        # accepted at the freeze bound\n        self.assertEqual(self.run_cmd(\"amendment\", \"--job-dir\", str(self.job), \"--file\", str(amend),\n                                      \"--quote\", \"q\", \"--channel\", \"c\", \"--said-at\", frozen), 0)\n        ev = self.read_events()[-1]\n        self.assertEqual(ev[\"quote\"], \"q\")\n        self.assertEqual(ev[\"file_sha256\"], sha256(amend.read_bytes()).hexdigest())\n\n    def test_relay_bounds_and_verbatim(self):\n        self.assertEqual(self.run_cmd(\"freeze\", \"--job-dir\", str(self.job)), 0)\n        frozen = self.read_events()[-1][\"at\"]\n        now = datetime.now(timezone.utc)\n        before = self.events.read_bytes()\n        self.assertNotEqual(self.run_cmd(\"relay\", \"--job-dir\", str(self.job), \"--quote\", \"q\",\n                                         \"--from\", \"BOT\", \"--source-chat\", \"c\",\n                                         \"--source-at\", iso(now - timedelta(days=1))), 0)\n        self.assertEqual(self.events.read_bytes(), before)\n        self.assertNotEqual(self.run_cmd(\"relay\", \"--job-dir\", str(self.job), \"--quote\", \"q\",\n                                         \"--from\", \"BOT\", \"--source-chat\", \"c\",\n                                         \"--source-at\", iso(now + timedelta(days=1))), 0)\n        self.assertEqual(self.run_cmd(\"relay\", \"--job-dir\", str(self.job), \"--quote\", \" q \",\n                                      \"--from\", \"BOT\", \"--source-chat\", \"c\",\n                                      \"--source-at\", frozen), 0)\n        ev = self.read_events()[-1]\n        self.assertEqual(ev[\"quote\"], \" q \")\n        self.assertEqual(ev[\"kind\"], \"relay\")\n\n    def test_spend_bounds_and_stamp(self):\n        now = datetime.now(timezone.utc)\n        settle_at = iso(now - timedelta(minutes=10))\n        ledger = self.job / \"spend.jsonl\"\n        ledger.write_text(json.dumps({\"event\": \"settle\", \"at\": settle_at, \"cost_usd\": 0.01}) + \"\\n\",\n                          encoding=\"utf-8\")\n        reading = self.job / \"reading.json\"\n        # 1 min after settle: refused\n        reading.write_text(json.dumps({\n            \"read_at\": iso(now - timedelta(minutes=9)),\n            \"writer\": \"tools/edi/or_call.py@abc\",\n            \"key_delta_usd\": 0.02,\n        }), encoding=\"utf-8\")\n        before = self.events.read_bytes()\n        self.assertNotEqual(self.run_cmd(\"spend\", \"--job-dir\", str(self.job), \"--spend-ledger\", str(ledger),\n                                         \"--key-reading\", str(reading)), 0)\n        self.assertEqual(self.events.read_bytes(), before)\n        # 4 min after settle: accepted\n        reading.write_text(json.dumps({\n            \"read_at\": iso(now - timedelta(minutes=6)),\n            \"writer\": \"tools/edi/or_call.py@abc\",\n            \"key_delta_usd\": 0.02,\n        }), encoding=\"utf-8\")\n        self.assertEqual(self.run_cmd(\"spend\", \"--job-dir\", str(self.job), \"--spend-ledger\", str(ledger),\n                                      \"--key-reading\", str(reading)), 0)\n        ev = self.read_events()[-1]\n        self.assertEqual(ev[\"ledger_sum_usd\"], 0.01)\n        self.assertEqual(ev[\"key_delta_usd\"], 0.02)\n        self.assertEqual(ev[\"total_usd\"], 0.02)\n        self.assertEqual(ev[\"spend_ledger_sha256\"], sha256(ledger.read_bytes()).hexdigest())\n        # no stamp refused\n        reading.write_text(json.dumps({\"read_at\": iso(now - timedelta(minutes=5))}), encoding=\"utf-8\")\n        before = self.events.read_bytes()\n        self.assertNotEqual(self.run_cmd(\"spend\", \"--job-dir\", str(self.job), \"--spend-ledger\", str(ledger),\n                                         \"--key-reading\", str(reading)), 0)\n        self.assertEqual(self.events.read_bytes(), before)\n\n    def test_dispose_bounds(self):\n        now = datetime.now(timezone.utc)\n        last = now - timedelta(minutes=10)\n        self.events.write_text(json.dumps({\n            \"event\": \"evaluation\", \"batch\": \"B\", \"evaluator\": \"e1\",\n            \"verdict_file\": \"v\", \"verdict_sha256\": \"0\" * 64,\n            \"started_at\": iso(last), \"finished_at\": iso(last), \"at\": iso(last),\n            \"writer\": \"kit/custody_ledger.py@abc\",\n        }) + \"\\n\", encoding=\"utf-8\")\n        before = self.events.read_bytes()\n        self.assertNotEqual(self.run_cmd(\"dispose\", \"--job-dir\", str(self.job), \"--by\", \"Owner\",\n                                         \"--state\", \"given\",\n                                         \"--decided-at\", iso(last - timedelta(seconds=1)),\n                                         \"--decided-source\", \"chat\"), 0)\n        self.assertEqual(self.events.read_bytes(), before)\n        self.assertNotEqual(self.run_cmd(\"dispose\", \"--job-dir\", str(self.job), \"--by\", \"Owner\",\n                                         \"--state\", \"given\",\n                                         \"--decided-at\", iso(now + timedelta(days=1)),\n                                         \"--decided-source\", \"chat\"), 0)\n        self.assertEqual(self.run_cmd(\"dispose\", \"--job-dir\", str(self.job), \"--by\", \"Owner\",\n                                      \"--state\", \"given\",\n                                      \"--decided-at\", iso(last),\n                                      \"--decided-source\", \"chat\"), 0)\n        ev = self.read_events()[-1]\n        self.assertEqual(ev[\"decided_at\"], iso(last))\n        self.assertEqual(ev[\"decided_source\"], \"chat\")\n        ci = json.loads((self.job / \"inputs\" / \"custody.json\").read_text(encoding=\"utf-8\"))\n        self.assertEqual(ci[\"disposition\"][\"at\"], iso(last))\n        self.assertEqual(ci[\"disposition\"][\"state\"], \"given\")\n\n    def test_tolerance_unchanged(self):\n        self.assertEqual(H.TOLERANCE_S, 60)\n\n    def test_fill_logger_times_does_not_write(self):\n        log = self.job / \"harness.log\"\n        content = json.dumps({\n            \"call\": \"c1\",\n            \"request\": {\"url\": \"https://openrouter.ai/api/v1/chat/completions\"},\n            \"response\": {\"created\": CREATED},\n            \"response_headers\": {\"Date\": \"Thu, 01 Jan 2026 00:00:00 GMT\"},\n        }) + \"\\n\"\n        log.write_text(content, encoding=\"utf-8\")\n        before = log.read_bytes()\n        self.assertFalse(H.fill_logger_times(log))\n        self.assertEqual(log.read_bytes(), before)\n\n    def test_hand_time_entries_for_missing_logger_times(self):\n        log = self.job / \"harness.log\"\n        content = json.dumps({\n            \"call\": \"c1\",\n            \"request\": {\"url\": \"https://openrouter.ai/api/v1/chat/completions\"},\n            \"response\": {\"created\": CREATED},\n            \"response_headers\": {\"Date\": \"Thu, 01 Jan 2026 00:00:00 GMT\"},\n        }) + \"\\n\"\n        log.write_text(content, encoding=\"utf-8\")\n        ref = H.Refusals()\n        calls = H.read_log(log, ref, \"maker\")\n        self.assertEqual(len(calls), 1)\n        entries = calls[0].hand_time_entries()\n        fields = {e[\"field\"]: e for e in entries}\n        self.assertIn(\"harness.log#c1.sent_at\", fields)\n        self.assertIn(\"harness.log#c1.received_at\", fields)\n        self.assertEqual(fields[\"harness.log#c1.sent_at\"][\"source\"], \"response-created\")\n        self.assertEqual(fields[\"harness.log#c1.received_at\"][\"source\"], \"server-header\")\n        self.assertEqual(fields[\"harness.log#c1.sent_at\"][\"file\"], \"harness.log\")\n\n    def test_read_log_accepts_path_alone(self):\n        \"\"\"L2 (P1): read_log(path) reads the calls without a Refusals or a who.\"\"\"\n        log = self.job / \"harness.log\"\n        log.write_text(json.dumps({\n            \"call\": \"c1\",\n            \"request\": {\"url\": \"https://api.deepinfra.com/v1/openai/chat/completions\"},\n            \"sent_at\": \"2026-01-01T00:00:00Z\",\n            \"received_at\": \"2026-01-01T00:00:05Z\",\n            \"response\": {\"created\": CREATED},\n        }) + \"\\n\", encoding=\"utf-8\")\n        calls = H.read_log(log)\n        self.assertEqual(len(calls), 1)\n        self.assertEqual(calls[0].name, \"c1\")\n        self.assertEqual(H.iso(calls[0].received), \"2026-01-01T00:00:05Z\")\n        # an unreadable log still returns [] rather than raising\n        self.assertEqual(H.read_log(self.job / \"missing.log\"), [])\n\n    def test_read_log_accepts_str_path(self):\n        \"\"\"P1: a frozen caller passes the log path as a string; read_log accepts a str as well as a Path.\"\"\"\n        log = self.job / \"harness.log\"\n        log.write_text(json.dumps({\n            \"call\": \"c1\",\n            \"request\": {\"url\": \"https://api.deepinfra.com/v1/openai/chat/completions\"},\n            \"sent_at\": \"2026-01-01T00:00:00Z\",\n            \"received_at\": \"2026-01-01T00:00:05Z\",\n            \"response\": {\"created\": CREATED},\n        }) + \"\\n\", encoding=\"utf-8\")\n        calls = H.read_log(str(log))\n        self.assertEqual(len(calls), 1)\n        self.assertEqual(calls[0].name, \"c1\")\n        self.assertEqual(H.iso(calls[0].received), \"2026-01-01T00:00:05Z\")\n        # a string path that does not exist still returns [] rather than raising\n        self.assertEqual(H.read_log(str(self.job / \"missing.log\")), [])\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n```\n\n## CONTEXT (read only; not in this request) kit/custody_ledger.py at 4c2444c3\n\n```\n#!/usr/bin/env python3\n\"\"\"Log a job's custody events WHEN THEY HAPPEN, so no time in the custody record is typed from memory.\n\nThe emitter (kit/emit_custody.py) reads model-call times from harness logs. Three events have no harness log:\nthe bar's freeze, each approval of the bar, and the Owner's disposition. This tool stamps each with the clock at\nthe moment it is run, writes it into inputs/custody.json, and appends it to inputs/custody-events.jsonl. The\nemitter then refuses a ledger value that differs from the logged one, and refuses the bar if it changed after the\nfreeze. Run it at the moment the thing happens, not afterwards: a late stamp is a wrong time.\n\nEvery line this tool appends carries `writer: \"kit/custody_ledger.py@<sha12>\"` (the sha256 of the file that ran)\nand `at` (the tool's clock), so a reader can tell a tool stamp from a hand-typed one (T1).\n\n    custody_ledger.py freeze  --job-dir J [--bar custody/bar.md] [--orchestrator \"Agent name\" [--orchestrator-alias A]]\n    custody_ledger.py approve --job-dir J --role buyer|specialist --by \"Name\" [--kind person|agent]\n                              [--adopted-document D --adopted-version V]\n    custody_ledger.py dispose --job-dir J --by \"Name\" [--state given|declined]\n                              [--decided-at T --decided-source S] [--words W]\n    custody_ledger.py pin     --job-dir J --seat maker|<evaluator id> --provider \"DeepInfra\" --slug deepinfra/fp8\n                              --host api.deepinfra.com [--via openrouter.ai]\n    custody_ledger.py show    --job-dir J\n\n    custody_ledger.py generation open  --job-dir J --seat S --prompt FILE\n    custody_ledger.py generation close --job-dir J --seat S --n N [--outcome TEXT] [--fix-kind TEXT]\n    custody_ledger.py evaluation --job-dir J --batch B --evaluator ID [--verdict FILE] [--summary FILE] [--iteration N]\n    custody_ledger.py amendment  --job-dir J --file F --quote Q --channel C --said-at T\n    custody_ledger.py relay      --job-dir J --quote Q --from BOT --source-chat C --source-at T\n    custody_ledger.py spend      --job-dir J --spend-ledger L --key-reading R\n\n`approve` records the digest of the bar file AT THAT MOMENT as the digest approved. It records who approved; it\nis not a signature (custody: approvals are records). An approval by the orchestrating agent or a model is refused\nhere as it is by the emitter.\n\n`pin` declares, BEFORE the seat's first model call, which single upstream provider will serve that seat through\nthe aggregator: the provider's name as OpenRouter's responses give it (`provider`), the slug the request's\nprovider.order will carry (`slug`), and the provider's own API host (`host`), which becomes the custody endpoint.\nIt is refused once the seat's harness log records a call. The emitter refuses the record if any call was served\nby, or also tried at, another provider, if the log does not say who served a call, or if the pin was declared\nafter the first call.\n\n`generation`, `evaluation`, `amendment`, `relay` and `spend` record the batch's own events as they happen, so the\nemitter can carry them into `x-plumbline.generations[]`, `evaluations[]`, `amendments[]`, `relays[]` and `spend`\n(F1a-F1h). `dispose --decided-at` bounds the Owner's decision between the last logged check and the tool's clock\n(F1b). `evaluation` takes `--verdict FILE`; when `--verdict` is omitted the `--summary FILE` (which must carry the\ninstrument's own `started_at`/`finished_at`/`writer` stamp) also serves as the verdict file. Every refusal,\nusage errors included, exits non-zero (2 = usage, 3 = refused), prints a line starting `REFUSED:` on stderr, and\nchanges neither the ledger nor `custody.json`. Stdlib only.\n\"\"\"\nfrom __future__ import annotations\nimport argparse, json, sys\nfrom datetime import datetime, timezone\nfrom hashlib import sha256\nfrom pathlib import Path\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nimport custody_history as H          # noqa: E402\n\n\ndef now() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef writer_stamp() -> str:\n    \"\"\"`kit/custody_ledger.py@<sha12>` for the file that is running (T1).\"\"\"\n    try:\n        d = sha256(Path(__file__).resolve().read_bytes()).hexdigest()[:12]\n    except OSError:\n        d = \"0\" * 12\n    return f\"kit/custody_ledger.py@{d}\"\n\n\ndef relpath(job: Path, p: Path) -> str:\n    \"\"\"A path relative to the job dir when inside it, else absolute (INTERFACE section 1).\"\"\"\n    try:\n        return p.resolve().relative_to(job.resolve()).as_posix()\n    except ValueError:\n        return str(p.resolve())\n\n\ndef read_events(job: Path) -> list[dict]:\n    p = job / \"inputs\" / \"custody-events.jsonl\"\n    if not p.is_file():\n        return []\n    out = []\n    for line in p.read_text(encoding=\"utf-8\").splitlines():\n        if line.strip():\n            try:\n                ev = json.loads(line)\n            except ValueError:\n                continue\n            if isinstance(ev, dict):\n                out.append(ev)\n    return out\n\n\ndef seat_logs(job: Path, ci: dict, seat: str) -> list[Path]:\n    \"\"\"Harness logs that may already hold this seat's calls (named in the inputs, or by the usual file names).\"\"\"\n    ev = job / ci.get(\"evidence_dir\", \"custody/evidence\")\n    if seat == \"maker\":\n        named, pat = (ci.get(\"maker\") or {}).get(\"harness_log\"), \"harness-maker*.log\"\n    else:\n        e = next((x for x in ci.get(\"evaluators\") or [] if str(x.get(\"id\")) == seat), {})\n        named = e.get(\"harness_log\") or next((x.get(\"evidence_file\") for x in ci.get(\"external\") or []\n                                              if x.get(\"subject\") == seat), None)\n        pat = f\"harness-{seat}*.log\"\n    out = [b / named for b in (ev, job) if named and (b / named).is_file()]\n    out += sorted(ev.glob(pat)) if ev.is_dir() else []\n    return list(dict.fromkeys(out))\n\n\ndef last_check_time(job: Path, ci: dict) -> datetime | None:\n    \"\"\"The latest logged check: evaluator `received_at`, `evaluation` line times, instrument `finished_at` (F1b).\"\"\"\n    times = []\n    for ev in read_events(job):\n        if ev.get(\"event\") == \"evaluation\":\n            for k in (\"started_at\", \"finished_at\", \"at\"):\n                d = H.parse_ts(ev.get(k))\n                if d:\n                    times.append(d)\n            sf = ev.get(\"summary_file\")\n            if sf:\n                p = Path(sf)\n                if not p.is_absolute():\n                    p = job / p\n                if p.is_file():\n                    try:\n                        s = json.loads(p.read_text(encoding=\"utf-8\"))\n                        d = H.parse_ts(s.get(\"finished_at\"))\n                        if d:\n                            times.append(d)\n                    except (ValueError, OSError):\n                        pass\n    for e in ci.get(\"evaluators\") or []:\n        seat = str(e.get(\"id\"))\n        for log in seat_logs(job, ci, seat):\n            ref = H.Refusals()\n            for c in H.read_log(log, ref, seat):\n                if c.received:\n                    times.append(c.received)\n    evdir = job / ci.get(\"evidence_dir\", \"custody/evidence\")\n    if evdir.is_dir():\n        for p in evdir.rglob(\"*.json\"):\n            try:\n                s = json.loads(p.read_text(encoding=\"utf-8\"))\n            except (ValueError, OSError):\n                continue\n            if isinstance(s, dict) and str(s.get(\"writer\", \"\")).startswith(\"tools/edi/\"):\n                d = H.parse_ts(s.get(\"finished_at\"))\n                if d:\n                    times.append(d)\n    return max(times) if times else None\n\n\ndef append_event(job: Path, ev: dict) -> None:\n    p = job / \"inputs\" / \"custody-events.jsonl\"\n    p.parent.mkdir(parents=True, exist_ok=True)\n    with p.open(\"a\", encoding=\"utf-8\") as fh:\n        fh.write(json.dumps(ev, ensure_ascii=False) + \"\\n\")\n\n\ndef write_custody(job: Path, ci: dict) -> None:\n    p = job / \"inputs\" / \"custody.json\"\n    p.parent.mkdir(parents=True, exist_ok=True)\n    p.write_text(json.dumps(ci, indent=2, ensure_ascii=False) + \"\\n\", encoding=\"utf-8\")\n\n\ndef refuse(msg: str, code: int = 3) -> int:\n    print(f\"REFUSED: {msg}\", file=sys.stderr)\n    return code\n\n\nclass RefusingParser(argparse.ArgumentParser):\n    \"\"\"argparse's own usage errors exit 2 with a `REFUSED:` line, like every other refusal (F1a, INTERFACE 1).\"\"\"\n\n    def error(self, message):\n        self.print_usage(sys.stderr)\n        print(f\"REFUSED: {message}\", file=sys.stderr)\n        raise SystemExit(2)\n\n\ndef main(argv=None) -> int:\n    ap = RefusingParser(description=__doc__.split(\"\\n\")[0])\n    sub = ap.add_subparsers(dest=\"cmd\", required=True)\n\n    for n in (\"freeze\", \"approve\", \"dispose\", \"pin\", \"show\"):\n        s = sub.add_parser(n)\n        s.add_argument(\"--job-dir\", required=True)\n        if n == \"freeze\":\n            s.add_argument(\"--bar\", default=None, help=\"bar file, relative to the job (default: the ledger's, else custody/bar.md)\")\n            s.add_argument(\"--orchestrator\", help=\"the orchestrating agent's name, as approvals would name it\")\n            s.add_argument(\"--orchestrator-alias\", action=\"append\", default=[])\n        if n in (\"approve\", \"dispose\"):\n            s.add_argument(\"--by\", required=True)\n        if n == \"pin\":\n            s.add_argument(\"--seat\", required=True, help=\"maker, or an evaluator's id\")\n            s.add_argument(\"--provider\", required=True, help=\"provider name as OpenRouter's response `provider` gives it\")\n            s.add_argument(\"--slug\", required=True, help=\"the provider slug the requests' provider.order carries\")\n            s.add_argument(\"--host\", required=True, help=\"the provider's own API host (the custody endpoint)\")\n            s.add_argument(\"--via\", default=\"openrouter.ai\")\n        if n == \"approve\":\n            s.add_argument(\"--role\", required=True, choices=(\"buyer\", \"specialist\"))\n            s.add_argument(\"--kind\", default=\"person\", choices=(\"person\", \"agent\"))\n            s.add_argument(\"--adopted-document\")\n            s.add_argument(\"--adopted-version\")\n        if n == \"dispose\":\n            s.add_argument(\"--state\", choices=(\"given\", \"declined\"))\n            s.add_argument(\"--decided-at\")\n            s.add_argument(\"--decided-source\")\n            s.add_argument(\"--words\")\n\n    g = sub.add_parser(\"generation\")\n    g.add_argument(\"action\", choices=(\"open\", \"close\"))\n    g.add_argument(\"--job-dir\", required=True)\n    g.add_argument(\"--seat\", required=True)\n    g.add_argument(\"--prompt\")\n    g.add_argument(\"--n\", type=int)\n    g.add_argument(\"--outcome\")\n    g.add_argument(\"--fix-kind\")\n\n    ev = sub.add_parser(\"evaluation\")\n    ev.add_argument(\"--job-dir\", required=True)\n    ev.add_argument(\"--batch\", required=True)\n    ev.add_argument(\"--evaluator\", required=True)\n    ev.add_argument(\"--verdict\", help=\"the verdict file; may be omitted when --summary is given \"\n                                      \"(the summary is then also the verdict)\")\n    ev.add_argument(\"--summary\")\n    ev.add_argument(\"--iteration\")\n\n    am = sub.add_parser(\"amendment\")\n    am.add_argument(\"--job-dir\", required=True)\n    am.add_argument(\"--file\", required=True)\n    am.add_argument(\"--quote\", required=True)\n    am.add_argument(\"--channel\", required=True)\n    am.add_argument(\"--said-at\", required=True)\n\n    rl = sub.add_parser(\"relay\")\n    rl.add_argument(\"--job-dir\", required=True)\n    rl.add_argument(\"--quote\", required=True)\n    rl.add_argument(\"--from\", dest=\"from_\", required=True)\n    rl.add_argument(\"--source-chat\", required=True)\n    rl.add_argument(\"--source-at\", required=True)\n\n    sp = sub.add_parser(\"spend\")\n    sp.add_argument(\"--job-dir\", required=True)\n    sp.add_argument(\"--spend-ledger\", required=True)\n    sp.add_argument(\"--key-reading\", required=True)\n\n    a = ap.parse_args(argv)\n    job = Path(a.job_dir).expanduser().resolve()\n    ledger_p, events_p = job / \"inputs\" / \"custody.json\", job / \"inputs\" / \"custody-events.jsonl\"\n    try:\n        ci = (json.loads(ledger_p.read_text(encoding=\"utf-8\")) if ledger_p.is_file()\n              else {\"custody_inputs\": \"plumbline/custody-inputs/v1\"})\n    except (ValueError, OSError) as exc:\n        return refuse(f\"cannot read {ledger_p} ({exc})\", 2)\n    if not isinstance(ci, dict):\n        return refuse(f\"{ledger_p} does not hold a JSON object\", 2)\n    if a.cmd == \"show\":\n        print(events_p.read_text(encoding=\"utf-8\") if events_p.is_file() else \"(no events logged)\", end=\"\")\n        return 0\n\n    bar = ci.setdefault(\"bar\", {})\n    t = now()\n    ci_changed = a.cmd in (\"freeze\", \"approve\", \"pin\", \"dispose\")\n\n    if a.cmd == \"freeze\":\n        rel = a.bar or bar.get(\"file\") or \"custody/bar.md\"\n        if not (job / rel).is_file():\n            return refuse(f\"no bar file at {job / rel}\", 2)\n        if bar.get(\"frozenAt\"):\n            return refuse(f\"the bar was already frozen at {bar['frozenAt']}; a bar is frozen once\", 2)\n        d = sha256((job / rel).read_bytes()).hexdigest()\n        bar.update({\"file\": rel, \"frozenAt\": t})\n        if a.orchestrator:\n            ci[\"orchestrator\"] = {\"name\": a.orchestrator, \"kind\": \"agent\", \"aliases\": a.orchestrator_alias}\n        ev = {\"event\": \"freeze\", \"at\": t, \"bar_file\": rel, \"bar_sha256\": d}\n\n    elif a.cmd == \"approve\":\n        if not bar.get(\"frozenAt\") or not (job / str(bar.get(\"file\"))).is_file():\n            return refuse(\"freeze the bar first (custody_ledger.py freeze); an approval names a frozen bar\", 2)\n        adopted = None\n        if a.adopted_document or a.adopted_version:\n            adopted = {\"document\": a.adopted_document, \"version\": a.adopted_version}\n        appr = {\"role\": a.role, \"by\": a.by, \"kind\": a.kind,\n                \"barDigest\": sha256((job / bar[\"file\"]).read_bytes()).hexdigest(), \"at\": t, \"adopted\": adopted}\n        ref = H.Refusals()\n        pk = job / \"packet.json\"\n        H.check_approval(appr, 0, ci, json.loads(pk.read_text(encoding=\"utf-8\")) if pk.is_file() else {}, ref)\n        if ref:\n            for _, m in ref.rows:\n                print(f\"REFUSED: {m}\")\n            return 3\n        bar[\"approvals\"] = [x for x in bar.get(\"approvals\") or [] if x.get(\"role\") != a.role] + [appr]\n        ev = {\"event\": \"approve\", **{k: appr[k] for k in (\"role\", \"by\", \"kind\", \"at\", \"barDigest\", \"adopted\")}}\n\n    elif a.cmd == \"pin\":\n        host, via = a.host.strip().lower(), a.via.strip().lower()\n        if not H.HOST.match(host) or host in H.AGGREGATORS:\n            return refuse(f\"{a.host!r} is not an upstream provider's host name (the aggregator is --via)\", 2)\n        if via not in H.AGGREGATORS:\n            return refuse(f\"--via {a.via!r} is not a known aggregator ({', '.join(sorted(H.AGGREGATORS))}); \"\n                          f\"a call made straight to a provider needs no pin\", 2)\n        for log in seat_logs(job, ci, a.seat):\n            calls = H.read_log(log, H.Refusals(), a.seat)\n            if calls:\n                return refuse(f\"{log.name} already records {len(calls)} call(s) for {a.seat}; a pin declared \"\n                              f\"after the seat's first call is not a pin. Declare it before the seat starts.\", 3)\n        pin = {\"via\": via, \"provider\": a.provider, \"slug\": a.slug, \"host\": host, \"declaredAt\": t}\n        ci.setdefault(\"routing\", {})[a.seat] = pin\n        ev = {\"event\": \"pin\", \"seat\": a.seat, **{k: pin[k] for k in (\"via\", \"provider\", \"slug\", \"host\")}, \"at\": t}\n\n    elif a.cmd == \"dispose\":\n        if a.decided_at:\n            dt = H.parse_ts(a.decided_at)\n            if dt is None:\n                return refuse(f\"--decided-at {a.decided_at!r} is not RFC 3339 UTC (...Z)\", 2)\n            if not a.decided_source:\n                return refuse(\"--decided-at requires --decided-source\", 2)\n            last = last_check_time(job, ci)\n            if last and dt < last:\n                return refuse(f\"decided_at {a.decided_at} is before the last logged check at {H.iso(last)}\", 3)\n            if dt > H.parse_ts(t):\n                return refuse(f\"decided_at {a.decided_at} is after the tool's clock {t}\", 3)\n            decided_at = a.decided_at\n        else:\n            decided_at = t\n        disp = {**(ci.get(\"disposition\") or {}), \"by\": a.by, \"at\": decided_at}\n        if a.state:\n            disp[\"state\"] = a.state\n        if a.words:\n            disp[\"words\"] = a.words\n        ci[\"disposition\"] = disp\n        ev = {\"event\": \"dispose\", \"by\": a.by, \"at\": t}\n        if a.decided_at:\n            ev.update({\"decided_at\": a.decided_at, \"decided_source\": a.decided_source})\n        if a.state:\n            ev[\"state\"] = a.state\n        if a.words:\n            ev[\"words\"] = a.words\n\n    elif a.cmd == \"generation\":\n        events = read_events(job)\n        seat_events = [x for x in events if x.get(\"event\") == \"generation\" and x.get(\"seat\") == a.seat]\n        opens = {}\n        last_action = None\n        for x in seat_events:\n            n = x.get(\"n\")\n            if x.get(\"action\") == \"open\":\n                opens[n] = False\n                last_action = (\"open\", n)\n            elif x.get(\"action\") == \"close\":\n                if n in opens:\n                    opens[n] = True\n                last_action = (\"close\", n)\n        if a.action == \"open\":\n            if not a.prompt:\n                return refuse(\"generation open requires --prompt FILE\", 2)\n            if last_action and last_action[0] == \"open\":\n                return refuse(f\"generation {last_action[1]} for {a.seat} is still open; close it first\", 3)\n            n = max(opens) + 1 if opens else 1\n            p = Path(a.prompt)\n            if not p.is_absolute():\n                p = job / p\n            if not p.is_file():\n                return refuse(f\"no prompt file at {p}\", 2)\n            d = sha256(p.read_bytes()).hexdigest()\n            ev = {\"event\": \"generation\", \"action\": \"open\", \"seat\": a.seat, \"n\": n,\n                  \"prompt_file\": relpath(job, p), \"prompt_sha256\": d, \"at\": t}\n        else:\n            if a.n is None:\n                return refuse(\"generation close requires --n N\", 2)\n            if a.n not in opens:\n                return refuse(f\"no open generation {a.n} for {a.seat}\", 3)\n            if opens[a.n]:\n                return refuse(f\"generation {a.n} for {a.seat} is already closed\", 3)\n            ev = {\"event\": \"generation\", \"action\": \"close\", \"seat\": a.seat, \"n\": a.n,\n                  \"outcome\": a.outcome, \"fix_kind\": a.fix_kind, \"at\": t}\n\n    elif a.cmd == \"evaluation\":\n        target = a.verdict or a.summary\n        if not target:\n            return refuse(\"evaluation requires --verdict FILE (or --summary FILE to serve as the verdict)\", 2)\n        p = Path(target)\n        if not p.is_absolute():\n            p = job / p\n        if not p.is_file():\n            return refuse(f\"no {'verdict' if a.verdict else 'summary'} file at {p}\", 2)\n        vsha = sha256(p.read_bytes()).hexdigest()\n        ev = {\"event\": \"evaluation\", \"batch\": a.batch, \"evaluator\": a.evaluator,\n              \"verdict_file\": relpath(job, p), \"verdict_sha256\": vsha, \"at\": t}\n        if a.iteration is not None:\n            ev[\"iteration\"] = a.iteration\n        if a.summary:\n            sp = Path(a.summary)\n            if not sp.is_absolute():\n                sp = job / sp\n            if not sp.is_file():\n                return refuse(f\"no summary file at {sp}\", 2)\n            try:\n                s = json.loads(sp.read_text(encoding=\"utf-8\"))\n            except (ValueError, OSError) as exc:\n                return refuse(f\"summary {sp} is not JSON ({exc})\", 2)\n            for k in (\"started_at\", \"finished_at\", \"writer\"):\n                if not s.get(k):\n                    return refuse(f\"summary {sp} has no {k} stamp; an instrument summary must stamp itself\", 3)\n            ev.update({\"summary_file\": relpath(job, sp), \"summary_sha256\": sha256(sp.read_bytes()).hexdigest(),\n                       \"started_at\": s[\"started_at\"], \"finished_at\": s[\"finished_at\"],\n                       \"summary_writer\": s[\"writer\"]})\n\n    elif a.cmd == \"amendment\":\n        p = Path(a.file)\n        if not p.is_absolute():\n            p = job / p\n        if not p.is_file():\n            return refuse(f\"no amendment file at {p}\", 2)\n        custody_dir = (job / \"custody\").resolve()\n        try:\n            p.resolve().relative_to(custody_dir)\n            return refuse(f\"amendment file {p} is inside custody/; amendments go beside the frozen set\", 3)\n        except ValueError:\n            pass\n        said = H.parse_ts(a.said_at)\n        if said is None:\n            return refuse(f\"--said-at {a.said_at!r} is not RFC 3339 UTC (...Z)\", 2)\n        frozen = H.parse_ts((ci.get(\"bar\") or {}).get(\"frozenAt\"))\n        if frozen and said < frozen:\n            return refuse(f\"--said-at {a.said_at} is before the freeze at {ci['bar']['frozenAt']}\", 3)\n        if said > H.parse_ts(t):\n            return refuse(f\"--said-at {a.said_at} is after the tool's clock {t}\", 3)\n        ev = {\"event\": \"amendment\", \"file\": relpath(job, p), \"file_sha256\": sha256(p.read_bytes()).hexdigest(),\n              \"quote\": a.quote, \"channel\": a.channel, \"said_at\": a.said_at, \"at\": t}\n\n    elif a.cmd == \"relay\":\n        said = H.parse_ts(a.source_at)\n        if said is None:\n            return refuse(f\"--source-at {a.source_at!r} is not RFC 3339 UTC (...Z)\", 2)\n        frozen = H.parse_ts((ci.get(\"bar\") or {}).get(\"frozenAt\"))\n        if frozen and said < frozen:\n            return refuse(f\"--source-at {a.source_at} is before the freeze at {ci['bar']['frozenAt']}\", 3)\n        if said > H.parse_ts(t):\n            return refuse(f\"--source-at {a.source_at} is after the tool's clock {t}\", 3)\n        ev = {\"event\": \"relay\", \"kind\": \"relay\", \"quote\": a.quote, \"from\": a.from_,\n              \"source_chat\": a.source_chat, \"source_at\": a.source_at, \"at\": t}\n\n    elif a.cmd == \"spend\":\n        lp = Path(a.spend_ledger)\n        if not lp.is_absolute():\n            lp = job / lp\n        rp = Path(a.key_reading)\n        if not rp.is_absolute():\n            rp = job / rp\n        if not lp.is_file():\n            return refuse(f\"no spend ledger at {lp}\", 2)\n        if not rp.is_file():\n            return refuse(f\"no key reading at {rp}\", 2)\n        try:\n            r = json.loads(rp.read_text(encoding=\"utf-8\"))\n        except (ValueError, OSError) as exc:\n            return refuse(f\"key reading {rp} is not JSON ({exc})\", 2)\n        if not r.get(\"read_at\") or not r.get(\"writer\"):\n            return refuse(f\"key reading {rp} has no read_at/writer stamp; run tools/edi/or_call.py --spend-status\", 3)\n        read_at = H.parse_ts(r[\"read_at\"])\n        if read_at is None:\n            return refuse(f\"key reading read_at {r['read_at']!r} is not RFC 3339 UTC\", 2)\n        ledger_sum = 0.0\n        last_settle = None\n        try:\n            for line in lp.read_text(encoding=\"utf-8\").splitlines():\n                if not line.strip():\n                    continue\n                x = json.loads(line)\n                if x.get(\"event\") == \"settle\":\n                    ledger_sum += float(x.get(\"cost_usd\") or 0)\n                    d = H.parse_ts(x.get(\"at\"))\n                    if d and (last_settle is None or d > last_settle):\n                        last_settle = d\n        except (ValueError, OSError) as exc:\n            return refuse(f\"spend ledger {lp} is not JSON Lines ({exc})\", 2)\n        if last_settle and (read_at - last_settle).total_seconds() < 180:\n            return refuse(f\"key reading at {r['read_at']} is less than 3 min after the last settle at \"\n                          f\"{H.iso(last_settle)}; read the key again later\", 3)\n        key_delta = float(r.get(\"key_delta_usd\") or 0)\n        total = max(ledger_sum, key_delta)\n        ev = {\"event\": \"spend\", \"spend_ledger\": relpath(job, lp),\n              \"spend_ledger_sha256\": sha256(lp.read_bytes()).hexdigest(),\n              \"key_reading\": relpath(job, rp), \"key_reading_sha256\": sha256(rp.read_bytes()).hexdigest(),\n              \"ledger_sum_usd\": ledger_sum, \"key_delta_usd\": key_delta, \"total_usd\": total,\n              \"read_at\": r[\"read_at\"], \"last_settle_at\": H.iso(last_settle) if last_settle else None, \"at\": t}\n\n    else:\n        return refuse(f\"unknown command {a.cmd!r}\", 2)\n\n    ev[\"writer\"] = writer_stamp()\n    if ci_changed:\n        write_custody(job, ci)\n    append_event(job, ev)\n    extra = \"\"\n    if a.cmd == \"approve\":\n        extra = f\" ({ev.get('role')} by {ev.get('by')})\"\n    elif a.cmd == \"pin\":\n        extra = f\" ({a.seat} -> {a.provider} [{a.slug}] at {ev['host']} via {ev['via']})\"\n    print(f\"logged {ev['event']} at {t}{extra}\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```\n\n## Tests present now under tests/\n\ntest_custody_ledger.py\ntest_discoverability_gate.py\ntest_discoverability_gate_doors.py\ntest_discoverability_gate_host_shape.py\ntest_edi_extract_files.py\ntest_edi_fixture_run.py\ntest_edi_judge_batch.py\ntest_edi_or_call.py\ntest_plumbline_verify.py\nvalidate_audit.py\nvalidate_constitution.py\nvalidate_pi