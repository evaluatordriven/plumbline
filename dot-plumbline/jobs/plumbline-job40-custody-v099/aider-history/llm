USER         print(f"no table at {table}")
USER         return 2
USER     data = json.loads(table.read_text(encoding="utf-8"))
USER     rows = data.get("rows") or []
USER     checker = ROOT / "checker" / "check.py"
USER     out, bad = [], 0
USER     print(f"checker sha256 {__import__('hashlib').sha256(checker.read_bytes()).hexdigest()}")
USER     for row in rows:
USER         r = subprocess.run([sys.executable, str(checker), row["record"], "--files", row["files"],
USER                             "--evidence", row["evidence"], "--bar", row["bar"]],
