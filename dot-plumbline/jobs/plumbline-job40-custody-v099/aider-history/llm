USER # ---- CR-2: field presence and type (SPEC.md section 4). "key:kind" pairs, "?" allows null --
USER 
USER KIND = {
USER     "str": lambda v: isinstance(v, str) and v.strip() != "", "text": lambda v: isinstance(v, str),
USER     "list": lambda v: isinstance(v, list), "dict": lambda v: isinstance(v, dict),
USER     "nonempty": lambda v: isinstance(v, list) and len(v) > 0, "bool": lambda v: isinstance(v, bool),
USER     "int": lambda v: isinstance(v, int) and not isinstance(v, bool) and v >= 0,
USER     "pos": lambda v: isinstance(v, int) and not isinstance(v, bool) and v >= 1,
USER     "num": lambda v: is_num(v),
USER     "ts": lambda v: isinstance(v, str) and bool(TS.match(v)),
