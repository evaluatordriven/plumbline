USER OK, FAILED, NC = "OK", "FAILED", "NOT-CHECKABLE"
USER 
USER 
USER class Fail(Exception):
USER     """A requirement the record breaks."""
USER 
USER 
USER class Unchecked(Exception):
USER     """A requirement that what was supplied cannot decide."""
USER 
USER 
USER def need(bad):
USER     if bad:
USER         raise Fail("; ".join(bad[:5]))
USER 
USER 
USER def when(ts):
USER     return datetime.fromisoformat(ts.replace("Z", "+00:00"))
USER 
USER 
USER def same(a, b):
USER     return a.strip().casefold() == b.strip().casefold()
