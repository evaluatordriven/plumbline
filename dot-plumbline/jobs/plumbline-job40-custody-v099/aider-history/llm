USER # ---------------------------------------------------------------------------------------------
USER # The one write gate. Anything this bar writes goes through here and lands in a private temp root.
USER # ---------------------------------------------------------------------------------------------
USER class WriteGate:
USER     """A write primitive that refuses any destination outside the root it was made for."""
USER 
USER     def __init__(self, root: Path):
USER         self.root = Path(root).resolve()
USER         self.written: list[Path] = []
USER 
USER     def write_file(self, path: Path, data: str | bytes) -> Path:
USER         target = Path(path).resolve()
USER         if target != self.root and self.root not in target.parents:
USER             raise PermissionError(f"the bar tried to write outside its temp root: {target}")
USER         body = data.encode("utf-8") if isinstance(data, str) else bytes(data)
USER         # The whole write is checked, not just the first filesystem call: a destination that fails
USER         # only part-way must not leave bytes behind, and the caller must see the refusal.
USER         try:
USER             target.parent.mkdir(parents=True, exist_ok=True)
USER             target.write_bytes(body)
USER         except OSError as e:
USER             raise PermissionError(f"{target}: the write failed ({e}) and no bytes were kept") from e
USER         self.written.append(target)
USER         return target
USER 
USER 
USER class BarBase(unittest.TestCase):
USER     """The subject tree, and planting helpers that go through the gate."""
USER 
USER     @classmethod
USER     def setUpClass(cls):
USER         # The checkout this file lives in. No environment variable decides this: a clone runs the bar
USER         # on itself, which is what D2 asks for.
USER         cls.subject = Path(__file__).resolve().parents[1]
