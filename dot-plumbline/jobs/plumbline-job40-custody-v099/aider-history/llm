USER     def test_00_the_release_lands(self):
USER         """RED at base. THE RELEASE GATE: a tree that has not been released must not pass this.
USER 
USER         The case asserts the subject is CLEAN and the gate is SENSITIVE, and neither half is
USER         optional:
USER 
USER           * the subject — ``measure_release_lands(self.subject)`` must return zero problems. On the
USER             un-released base tree it reports exactly three: the header's version is not later than
USER             ``git show 534d873:SPEC.md``'s, the header's date is not later than that header's, and
USER             ``record/RECORD-GAP-v0.9.8.md`` carries the release's own name. Those three are the
USER             base reading; they are not filtered or named away.
USER           * the plant — the base commit's own SPEC.md, written over a copy of the subject, must be
USER             reported as un-released. Without it the assertion above could go green on a
USER             ``measure_release_lands`` that had stopped measuring anything.
USER 
USER         The remaining bites are crafted so each fires on the DECLARED release, whatever it is, and
USER         does not depend on the version being a particular number:
USER 
USER           * bite 1 — a copy whose SPEC.md is the base commit's SPEC.md: the header reverts to the
USER             base release, so the "not later than base" check must fire.
USER           * bite 2 — a copy whose newest CHANGELOG entry is re-headed to a version the header does
USER             not declare: the changelog-agrreement check must fire.
USER           * bite 3 — a copy whose header date is set to the base header's date: the date check must
USER             fire.
USER         """
USER         version = release_version(self.subject)
USER         problems = measure_release_lands(self.subject)
USER         # THE GATE ASSERTS THE SUBJECT IS CLEAN. This is the only polarity a release gate can have:
USER         # the instrument's sensitivity is what the five bites below prove, on planted copies; the
USER         # subject is required to have LANDED. The earlier revision asserted `assertTrue(problems)` and
USER         # was therefore green on an un-released tree and red on a released one — it measured the
USER         # instrument's ability to complain instead of the tree's conformance, which is the opposite
USER         # of a gate.
USER         self.assertEqual(problems, [], "\n".join(problems))
USER 
USER         # THE PLANT that makes this a gate and not a tautology: the base commit's own SPEC.md written
USER         # over the working one is an un-released tree, copied byte for byte from this tree's history,
USER         # independent of which release this tree declares. The gate MUST report it. If this plant is
USER         # green, measure_release_lands() has stopped measuring and the case above certifies nothing.
USER         base_spec = git_show(self.subject, BASE_COMMIT, "SPEC.md")
USER         if base_spec is not None:
USER             unreleased = self._plant_text("SPEC.md", base_spec)
USER             planted = measure_release_lands(unreleased)
USER             self.assertTrue(planted,
USER                             f"PLANTED UN-RELEASED COPY PASSED THE GATE: SPEC.md was replaced with "
USER                             f"{BASE_COMMIT[:12]}'s own bytes and measure_release_lands() returned []")
USER             self.assertTrue(any("not later than the base" in p or "has not been cut" in p
USER                                 for p in planted),
USER                             f"the planted un-released copy was reported, but not as un-released: "
USER                             f"{planted}")
USER         else:
USER             # No history to read: the tree cannot pin its base, so the gate must say so rather than
USER             # pass by default. This is not a skip; a gate with nothing to compare is red.
USER             self.assertTrue(any("cannot be derived" in p for p in problems),
USER                             f"there is no git history to read and the gate returned {problems}, which "
USER                             f"does not report that the base cannot be derived")
USER         base_spec = git_show(self.subject, BASE_COMMIT, "SPEC.md")
USER         if base_spec is not None:
USER             self.assert_bites(measure_release_lands, self._plant_text("SPEC.md", base_spec),
USER                               "not later than the base", "test_00 bite 1")
USER         # bite 2: the newest CHANGELOG entry re-headed to a version the header does not declare.
USER         other = f"{version.rsplit('.', 1)[0]}.{int(version.rsplit('.', 1)[1]) + 5}"
USER 
USER         def rehead_changelog(t: str) -> str:
USER             return re.sub(rf"^(#{{0,3}}\s*){re.escape(version)}\b", rf"\g<1>{other}", t,
USER                           count=1, flags=re.M)
USER 
USER         self.assert_bites(measure_release_lands, self._edit("CHANGELOG.md", rehead_changelog),
USER                           "the newest entry is", "test_00 bite 2")
USER         # bite 3: the header dated exactly as the base header -> "not strictly later" fires.
USER         base_date, _ = base_header_date(self.subject)
USER         self.assertIsNotNone(base_date, "the base header's date cannot be derived")
USER         base_date = str(base_date)
USER         self.assert_bites(measure_release_lands, self._edit("SPEC.md", lambda t: HEADER_RE.sub(
USER             lambda m: m.group(0).replace(m.group("date"), base_date), t, count=1)),
USER             "not strictly later than the base header's date", "test_00 bite 3")
USER         # bite 4: an example left at a version the header does not declare -> "not the release" fires.
USER         # The base example carries the base version; on an un-released tree that IS the declared
USER         # version, so planting the base file is an identity and would not bite. Plant a version the
USER         # header definitely does not name instead, so the example stratum is exercised on any tree.
USER         stale_example = f"{version.rsplit('.', 1)[0]}.{int(version.rsplit('.', 1)[1]) + 3}"
USER         self.assert_bites(measure_release_lands,
USER                           self._edit("examples/minimal/record.json", lambda t: re.sub(
USER                               r'("specVersion"\s*:\s*")[^"]+(")',
USER                               rf"\g<1>{stale_example}\g<2>", t, count=1)),
USER                           "not the release", "test_00 bite 4")
USER         # bite 5: a gap note carrying the release's name is refused.
USER         gaproot, gate = self.planted_copy()
USER         gate.write_file(gaproot / "record" / f"RECORD-GAP-v{version}.md", "# a gap\n")
USER         self.assert_bites(measure_release_lands, gaproot, "a gap note carries the release's name",
USER                           "test_00 bite 5")
