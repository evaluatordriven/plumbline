USER def _changelog_entry(text: str, version: str) -> str:
USER     """The entry for `version`, up to the next version heading."""
USER     m = re.search(rf"^#{{0,3}}\s*{re.escape(version)}\b.*$", text, flags=re.M)
USER     if m is None:
USER         return ""
USER     rest = text[m.end():]
USER     nxt = re.search(r"^#{1,3}\s*\d+\.\d+\.\d+", rest, flags=re.M)
