USER def fields(obj, spec, where, bad, optional=None):
USER     for key, kind in list(spec.items()) + [(k, v) for k, v in (optional or {}).items() if k in obj]:
USER         v = obj.get(key, ...)
USER         if v is ... or not ((kind.endswith("?") and v is None) or KIND[kind.rstrip("?")](v)):
USER             bad.append(f"{where}.{key} missing or not {kind}")
USER         elif key in ENUMS and v not in ENUMS[key]:
USER             bad.append(f"{where}.{key} is {v!r}")
USER         elif key in SUB and isinstance(v, dict):
USER             fields(v, SUB[key], f"{where}.{key}", bad)
