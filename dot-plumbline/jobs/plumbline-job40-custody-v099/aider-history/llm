USER def shape_bad(p, field, spec, optional=None):
USER     """CR-2's own shape test for a list field, so a CL1 rule defers to it (RULING-G5.1)."""
USER     bad = []
USER     items = p.get(field)
USER     if not isinstance(items, list):
USER         return [f"{field} is not a list"]
USER     for i, e in enumerate(items):
USER         if not isinstance(e, dict):
USER             bad.append(f"{field}[{i}] is not an object")
USER             continue
USER         fields(e, spec, f"{field}[{i}]", bad, optional)
USER     return bad
