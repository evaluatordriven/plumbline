USER def carried_verbatim(haystack: str, needle: str) -> bool:
USER     """Is `needle` carried verbatim, however the document WRAPPED it across lines?
USER 
USER     Two readings, and the amendment passes if either holds: the text as typed, and the text with
USER     markdown's own wrap points restored to spaces. A sentence wrapped for a 100-column document is
USER     the same sentence, so this measurement may not depend on where the author's line broke. A
USER     wrapped word joins with a space, which is what the ``-`` arm below undoes.
USER 
USER     A paraphrase still fails: the words are compared as a sequence, and a reworded run of them does
USER     not appear in either reading.
USER     """
USER     if needle in " ".join(haystack.split()):
USER         return True
USER     joined = re.sub(r"[\s\u2014-]*\n\s*", " ", haystack)
USER     joined = " ".join(joined.split())
USER     return needle in joined
USER 
USER 
USER def _wrap_in_two(sentence: str) -> str:
USER     """The sentence the way a document wrapped for a narrow column writes it: broken at the middle
USER     word boundary, with the rest on the next line. Used by test_06 to write the wrapped form itself."""
USER     words = sentence.split()
USER     mid = len(words) // 2
USER     return " ".join(words[:mid]) + "\n" + " ".join(words[mid:])
USER 
USER 
USER def _wrap_all_matching(text: str, sentence: str) -> str:
USER     """`text` with EVERY copy of `sentence` wrapped across a line. Every copy, because a tree may
USER     already carry the sentence once (a conforming release) and the plant inserts a second — wrapping
USER     one and leaving the other leaves a valid sentence in place for the removal plant to find."""
USER     return text.replace(sentence, _wrap_in_two(sentence))
USER 
USER 
USER def _wrap_clean(text: str) -> str:
USER     """The text with its line wraps normalised away, so "is the sentence still in there, wrapped or
USER     not" is one comparison. Used to prove a removal plant actually removed the sentence."""
USER     return " ".join(text.replace("\n", " ").split())
USER 
USER 
USER def _remove_wrapped(text: str, sentence: str) -> str:
USER     """`text` with the sentence removed, whether or not it was wrapped.
USER 
USER     The span is located on a whitespace-flattened copy of the text, then mapped back to the original
USER     by character offset, so every line the sentence touches is cut — including the second half of a
USER     sentence that wrapped. ``str.replace`` cannot do this on wrapped text: it looks for the whole
USER     sentence on one line, finds nothing, and returns the text unchanged, which is how the old removal
USER     plant came to compare a tree to itself and report a bite it had not made.
USER     """
USER     # Flatten with an index map: flat[i] came from text[pos[i]].
USER     flat, pos = _flatten_with_map(text)
USER     target = " ".join(sentence.split())
USER     out = text
USER     # Every occurrence, not just the first: a conforming tree may carry the sentence once and the
USER     # plant inserts a second, and removing one of two would leave the measurement satisfied.
USER     while True:
USER         at = flat.find(target)
USER         if at < 0:
USER             return out
USER         start_in_text = pos[at]
USER         end_in_text = pos[at + len(target) - 1] + 1
USER         out = out[:start_in_text] + out[end_in_text:]
USER         flat, pos = _flatten_with_map(out)
USER 
USER 
USER def _flatten_with_map(text: str) -> tuple[str, list[int]]:
USER     """`text` with runs of whitespace collapsed to one space, and for each flat index the index in
USER     `text` it came from. The map is what lets a span found on the flat text be cut out of the
USER     original, wrap points and all."""
USER     chars: list[str] = []
USER     pos: list[int] = []
USER     prev_space = False
USER     for i, ch in enumerate(text):
USER         if ch.isspace():
USER             if prev_space:
USER                 continue
USER             chars.append(" ")
USER             pos.append(i)
USER             prev_space = True
USER         else:
USER             chars.append(ch)
USER             pos.append(i)
USER             prev_space = False
USER     return "".join(chars), pos
USER 
USER 
