USER def measure_count_except_record(root: Path) -> list[str]:
USER     """Every count.py problem EXCEPT the release's missing record must be zero, and the record problem
USER     must be present. Both halves matter: the first is the Maker's bar, the second is the proof that the
USER     problem was carried and named rather than filtered away by a predicate that matches nothing.
USER 
USER     A zero exit is read against the release: on a tree that declares the GAP_EXCEPTIONS release, a zero
USER     exit IS the ordinary green and there is no record problem to carry; on any other release, a zero
USER     exit is the ordinary green only when the release's record is on disk, and otherwise it can only
USER     have come from a gap note count.py's glob did not refuse.
USER     """
USER     version = release_version(root)
USER     code, problems, err = count_problems(root)
USER     if not problems and code != 0:
USER         return [f"tools/count.py exited {code} with no parseable problem list: {err.strip()[:300]}"]
USER     record_on_disk = (root / "record" / f"custody-v{version}.json").is_file()
USER     if code == 0:
USER         if version == GAP_EXCEPTION_VERSION or record_on_disk:
USER             return []
USER         return [f"tools/count.py exited 0 on a tree that declares {version}, carries no record for "
USER                 f"it, and has no gap note on disk. That green is not a pass: on a frozen count.py "
USER                 f"(GAP_EXCEPTIONS = {{\"{GAP_EXCEPTION_VERSION}\"}}) a documents-only tree reaches "
USER                 f"exit 0 only through a gap note, and a gap note on {version} is refused. Either the "
USER                 f"record exists — which is Instrument 2's output, not the Maker's — or a gap note "
USER                 f"was planted"]
USER     parts = partition_count(problems, version)
USER     bad = [f"count.py: {p}" for p in parts["stale"] + parts["rest"]]
USER     if not parts["record"]:
USER         bad.append(f"count.py reported no missing-record problem for {version}, so this case cannot "
USER                    f"show it carried that problem rather than filtering it away")
