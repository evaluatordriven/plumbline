USER # -- 07 ---------------------------------------------------------------------------------------
USER def sentences(text: str) -> list[str]:
USER     """One unit per sentence-ish span, with the hard-wrap of markdown joined back up.
USER 
USER     A closing hyphen at end of line means the word continues on the next line ("count.py" wraps at a
USER     period but "RECORD-GAP-v0.9.8.md" and ``—`` do not), so that line joins with no space; any other
USER     line joins with one space. Paragraphs break at a blank line, a heading, a table row, a list item,
USER     or a fence. Joining is what lets a sentence be compared after a reflow — which is exactly what a
USER     Maker rewriting a wrapped sentence does to it."""
USER     out: list[str] = []
USER     buf = ""
USER 
USER     def flush():
USER         nonlocal buf
USER         if buf:
USER             out.append(buf)
USER             buf = ""
USER 
USER     for line in text.splitlines():
USER         s = line.strip()
USER         if not s or s.startswith(("|", "-", "*", "#", ">", "```")) or re.match(r"^\d+\.\s", s):
USER             flush()
USER             if s:
USER                 out.append(s)
USER             continue
USER         if buf.endswith("-") or buf.endswith("—"):
USER             buf += s
USER         elif buf:
USER             buf += " " + s
USER         else:
USER             buf = s
USER     flush()
USER     return out
USER 
USER 
USER def carries_version_fact(sentence: str, exception_version: str = GAP_EXCEPTION_VERSION) -> bool:
USER     """Does this sentence still state the gap fact? Three halves, none of which may be dropped:
USER 
USER       * it reports that a release shipped with no record,
USER       * it names WHICH release — cited, or in words — and
USER       * it names where the note that explains it is, so a reader can open it.
USER 
USER     Never the version. The version in the sentence is the defect test_07 is about: count.py refuses
USER     any 0.x.y token in a current document (tools/count.py:142-151), so the reference cannot keep its
USER     number and the release has to be named in words. What may not happen is the claim losing the
USER     release it is about, or the note losing its address.
USER     """
USER     flat = " ".join(sentence.split())
USER     claims = re.search(r"(?i)\bshipped without (one|it|a record|its record)\b|\bno record\b", flat)
USER     names = re.search(r"(?i)\b(the (previous|last|preceding|prior) release|release before (this|it))"
USER                       r"\b|\b0\.9\.[0-9]+\b", flat)
USER     where = re.search(r"`?record/`?|`?RECORD-GAP", flat, re.I)
USER     return bool(claims and names and where)
USER 
USER 
USER def _squash_code_ticks(text: str) -> str:
USER     """The text with markdown backticks removed, so ``record/`` and record/ read the same. Used where a
USER     measurement cares about the words a document carries, not about how it typeset them."""
USER     return text.replace("`", "")
USER 
USER 
USER GAP_NOTE_CLAIM_RE = re.compile(r"(?i)\bshipped without (one|it|a record|its record)\b|\bno record\b")
USER # The clause that names the release a gap sentence is about, if it names one at all.
USER GAP_RELEASE_NAMED_RE = re.compile(r"(?i)\b(the (previous|last|preceding|prior) release|release before "
USER                                   r"(this|it))\b|\b0\.9\.[0-9]+\b")
USER # The clause that names the note a reader can open, if it names one at all.
USER GAP_NOTE_NAMED_RE = re.compile(r"`?record/`?|`?RECORD-GAP", re.I)
USER 
USER 
USER def measure_stale_stamp(root: Path) -> list[str]:
USER     """CONTRIBUTING.md:16's problem, in both directions, AND the claim the sentence makes.
USER 
USER     Three things are measured, all of them against the BASE commit's own text so the subject exists
USER     on an un-cut tree and on a cut one alike:
USER 
USER       (a) TOKEN. count.py's scanner (tools/count.py:142-151) reads every current document for a bare
USER           ``0.x.y`` and refuses any that is not the release's. On the un-cut tree the sentence's
USER           token is a non-release number; on the cut tree it names the older release. Either way it
USER           cannot be left as typed. Red on: a token count.py reads.
USER 
USER       (b) FACT, both directions. The base commit's sentence states a fact a reader needs: one release
USER           shipped without a record, and a note in ``record/`` says why. The rewritten sentence must
USER           still state it — a claim with no release in it, or a note with no address, is a sentence
USER           about nothing — and it must not drop the note's location. Red on: the paragraph removed; the
USER           claim reworded so no release is named; the note left without a place a reader can look.
USER 
USER       (c) THE CLAIM, which is the defect this revision repairs. The old rule only asked whether the
USER           sentence's VERSION token differed from the release's, so a sentence naming the release
USER           itself — a sentence naming the current release — was accepted. That
USER           sentence is false: this release does not ship without a record. A sentence that asserts a
USER           bare release shipped without a record is refused; a sentence that attributes the absence to
USER           some other release is accepted; and if this tree ships a gap note of its own, the absence is
USER           attributed to THIS release and the sentence must name it. Red on: the false sentence, in
USER           both of the ways a Maker can write it.
USER 
USER     The subject of (c) is located by clause, not by sentence: the claim, the release it names, and the
USER     note it cites are each searched for separately, so moving the amendment out of the sentence that
USER     carries the claim does not take the claim with it.
USER     """
USER     bad: list[str] = []
USER     version = release_version(root)
USER     p = root / "CONTRIBUTING.md"
USER     if not p.is_file():
USER         return ["CONTRIBUTING.md: missing"]
USER     text = p.read_text(encoding="utf-8")
USER     base = git_show(root, BASE_COMMIT, "CONTRIBUTING.md")
USER     if base is None:
USER         return [f"CONTRIBUTING.md: cannot read CONTRIBUTING.md at {BASE_COMMIT[:12]}; this "
USER                 f"comparison has no subject and this case will not pass on it"]
USER     # (a) the scanner's reading.
USER     survivors = sorted({v for v in version_tokens(text) if v != version})
USER     if survivors:
USER         where = [s for s in sentences(text) if any(v in survivors for v in version_tokens(s))]
USER         bad.append(f"CONTRIBUTING.md: still carries {survivors}, which tools/count.py refuses in a "
USER                    f"current document. The sentence was not rewritten; it was left in the form the "
USER                    f"scanner reads. First: {where[0][:200]!r}" if where else
USER                    f"CONTRIBUTING.md: still carries {survivors}")
USER     # (b) the fact survives, with its release and its note's address.
USER     base_fact = [s for s in sentences(base) if carries_version_fact(s)]
USER     if not base_fact:
USER         return bad + [f"CONTRIBUTING.md at {BASE_COMMIT[:12]}: no sentence states the gap fact, so "
USER                       f"this comparison has no subject and this case will not pass on it"]
USER     now_units = sentences(text)
USER     now_fact = [s for s in now_units if carries_version_fact(s)]
USER     base_units = sentences(base)
USER     base_fact_units = set(base_fact)
USER     if not now_fact:
USER         bad.append(f"CONTRIBUTING.md: the sentence that explained the missing record is gone. "
USER                    f"Rewriting it is the fix; deleting it leaves a reader with a rule and no "
USER                    f"reason, and count.py at {BASE_COMMIT[:12]} cited the fact the sentence "
USER                    f"carries ({len(base_fact)} sentence(s))")
USER     else:
USER         flat_now = " ".join(now_fact)
USER         if not GAP_RELEASE_NAMED_RE.search(flat_now):
USER             bad.append(f"CONTRIBUTING.md: the rewritten sentence does not say WHICH release shipped "
USER                        f"without a record, so a reader cannot tell what the exception covers")
USER         if not GAP_NOTE_NAMED_RE.search(flat_now):
USER             bad.append(f"CONTRIBUTING.md: the rewritten sentence does not say where the note that "
USER                        f"explains the missing record is kept, so a reader cannot open it")
USER     # (c) THE CLAIM. The clause that asserts an absence, and the clause that names a release, are each
USER     # taken from the flat text so a reflow or an insertion cannot hide either from this measurement.
USER     flat = " ".join(_squash_code_ticks(text).split())
USER     claim = GAP_NOTE_CLAIM_RE.search(flat)
USER     if claim is not None:
USER         after = flat[claim.end():]
USER         before = flat[:claim.start()]
USER         # Clause boundaries, nearest first. `.` is one only when it ends a sentence, so
USER         # `record/…v<version>.md` and `count.py` do not cut a clause in half.
USER         opens = [i + 1 for i in (before.rfind(","), before.rfind(";"), before.rfind("—")) if i >= 0]
USER         for m in re.finditer(r"\.(?=\s|$)", before):
USER             opens.append(m.end())
USER         closes = [i for i in (after.find(","), after.find(";"), after.find("—")) if i >= 0]
USER         closes += [m.start() for m in re.finditer(r"\.(?=\s|$)", after)]
USER         clause_start = max([0] + opens)
USER         clause_end = min([len(after)] + closes)
USER         clause = (before[clause_start:] + claim.group(0) + after[:clause_end]).strip()
USER         named = GAP_RELEASE_NAMED_RE.search(clause)
USER         own_note = (root / "record" / f"RECORD-GAP-v{version}.md").is_file()
USER         names_this_release = named is not None and named.group(0).find(version) >= 0
USER         if named is None:
USER             # An absence attributed to no release at all: the reader cannot tell whose absence it
USER             # is, and the sentence is refused. The base commit's own sentence names one.
USER             if own_note:
USER                 bad.append(f"CONTRIBUTING.md: this release ships record/RECORD-GAP-v{version}.md, but "
USER                            f"the sentence that explains the missing record does not name it: "
USER                            f"{clause[:160]!r}")
USER         elif names_this_release and not own_note:
USER             bad.append(f"CONTRIBUTING.md: the sentence says {clause[:160]!r} — that is, this release, "
USER                        f"{version}, shipped without a record — and this tree ships no "
USER                        f"record/RECORD-GAP-v{version}.md. The sentence is false: the claim must test "
USER                        f"whether this release ships a record, not which release the sentence names")
USER         # When this tree ships a note of its own, the sentence naming it is the correct sentence —
USER         # that is what (b) requires, and what the tree that declares the exception's release carries.
USER         # Nothing further is measured here: a second rule would refuse the fix this case asks for.
USER     # (d) every sentence of the base file that did not carry the fact still has a successor, compared
USER     # with version tokens masked. This is what stops a Maker from clearing the token by deleting the
USER     # paragraph around it. A base sentence that CONTAINS a fact-carrying unit is exempt too: an
USER     # insertion into the cadence paragraph (the Owner's amendment, which this release adds)
USER     # legitimately re-cuts the unit it was inserted into, and that is a rewrite, not a deletion. The
USER     # fact's own sentence is exempted by identity for the same reason.
USER     masked_now = {_body_without_versions(s) for s in now_units}
USER     lost = []
USER     for s in base_units:
USER         if s in base_fact_units or _body_without_versions(s) in masked_now:
USER             continue
USER         if any(f in s for f in base_fact_units):
USER             continue
USER         if any(s.startswith(u) for u in UNSTABLE_PREFIXES):
USER             # the sentence the amendment is inserted into: it must still be there in some form
USER             head = " ".join(s.split()[:8])
USER             if not any(head in _body_without_versions(n) for n in now_units):
USER                 lost.append(s)
USER             continue
USER         lost.append(s)
USER     if lost:
USER         bad.append(f"CONTRIBUTING.md: {len(lost)} sentence(s) of the base commit are gone, which is "
USER                    f"not a rewrite of one sentence: {lost[0][:180]!r}")
USER     return bad
USER 
