USER def examples_declaring(root: Path) -> dict[str, list[str]]:
USER     """path -> every specVersion value the file carries, found by walking it, exactly as
USER     tests/example_version_check.py walks it."""
USER     out: dict[str, list[str]] = {}
USER     for rel in EXAMPLES:
USER         p = root / rel
USER         if not p.is_file():
USER             out[rel] = ["<missing>"]
USER             continue
USER         try:
USER             doc = json.loads(p.read_text(encoding="utf-8"))
USER         except json.JSONDecodeError as e:
USER             out[rel] = [f"<not JSON: {e}>"]
USER             continue
USER         found: list[str] = []
USER 
USER         def walk(o):
USER             if isinstance(o, dict):
USER                 for k, v in o.items():
USER                     if k == "specVersion":
USER                         found.append(str(v))
USER                     else:
USER                         walk(v)
USER             elif isinstance(o, list):
USER                 for v in o:
USER                     walk(v)
USER 
USER         walk(doc)
USER         out[rel] = found
USER     return out
