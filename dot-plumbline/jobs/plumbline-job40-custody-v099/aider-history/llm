USER     fields(p, PRED, "predicate", bad)
USER     extra = {"CL2": {"spread": "list"}, "CL3": {"spread": "list", "demonstrations": "list"}}
USER     fields(p, extra.get(p.get("levelClaimed"), {}), "predicate", bad)
USER     for path, spec in ITEMS.items():
USER         head, _, tail = path.partition(".")
USER         node = p.get(head)
USER         node = node.get(tail) if tail and isinstance(node, dict) else node
USER         for i, item in enumerate(node if isinstance(node, list) else [node] if node else []):
USER             fields(item if isinstance(item, dict) else {}, spec, f"{path}[{i}]", bad,
USER                    OPTIONAL.get(path))
USER     need(bad)
