USER def _spec_body_without_header(text: str) -> str:
USER     """SPEC.md with the header line and the VERSION TOKEN of section 4's ``specVersion`` example
USER     replaced by fixed marks. Those two are the only places a release may move.
USER 
USER     The row is masked in ONE cell, and inside that cell only the version token is masked — not the
USER     prose around it. Earlier revisions went further in two steps, and each step hid a real change:
USER     the first replaced the entire row with a template,
USER     ``| `specVersion` | string | yes | <example removed> |``, which wrote back a required cell the
USER     document may not hold, so a tree that flipped that cell to ``no`` was compared against a template
USER     that said ``yes``; the second masked the whole notes cell, which erased the difference between
USER     ``This document's version, e.g. `0.9.8``` and ``The version this document declares, for example
USER     `0.9.8```. Only the digits move with the release (see measure_spec_section4, which compares every
USER     other cell, and this one with its tokens masked). Masking is by shape so a move is recognised as a
USER     move; the field name is matched with or without backticks so re-typing it does not smuggle a
USER     change past this comparison either.
USER     """
USER     text = HEADER_RE.sub("**Version <removed>**", text, count=1)
USER 
USER     def mask_example(m: re.Match) -> str:
USER         cells = m.group(0).strip().strip("|").split("|")
USER         if len(cells) < 4:
USER             return "<example removed>"
USER         cells[-1] = " " + _body_without_versions(cells[-1]) + " "
USER         return "|" + "|".join(cells) + "|"
USER 
USER     return SPEC_VERSION_ROW_LOOSE_RE.sub(mask_example, text, count=1)
