USER # -- 00 ---------------------------------------------------------------------------------------
USER def base_version(root: Path) -> tuple[str | None, str]:
USER     """(version, how) — the release the tree REPLACES, read from the tree's own evidence, never a
USER     literal and never a flag.
USER 
USER     Clone-portable, in descending order of authority, and every step is measured, not assumed:
USER 
USER       1. ``git show <BASE_COMMIT>:SPEC.md`` — a clone carries ``.git``, so this is the normal path.
USER          This is what a bar means when it says "the base commit". Verified: a fresh ``git clone`` of
USER          this tree answers it.
USER       2. If there is no history to read (a bare tarball, or the base commit is not in this clone's
USER          history), the base CANNOT be derived from the documents, and this function returns None with
USER          the reason. It does NOT fall back to the CHANGELOG's previous entry or to the highest
USER          ``record/custody-vX.Y.Z.json``: those were measured and REJECTED, because cutting a release
USER          does not remove the previous release from either. On the un-released tree the CHANGELOG's
USER          newest entry is the header's own release and the highest record is one release behind, so a
USER          header equal to the newest CHANGELOG entry would read as "later than the record's release"
USER          and the gate would be GREEN with nothing cut — the exact defect this bar exists to prevent.
USER          A base the documents cannot pin must fail loudly, not be guessed.
USER 
USER     ``how`` is a short string naming which path was used, or why no base could be derived, so a case
USER     can print it and an evaluator can see the base was derived rather than assumed.
USER     """
USER     base_spec = git_show(root, BASE_COMMIT, "SPEC.md")
USER     if base_spec is not None:
USER         m = HEADER_RE.search(base_spec)
USER         if m is not None:
USER             return m.group("v"), f"git show {BASE_COMMIT[:12]}:SPEC.md"
USER     return None, ("no git history to read: a bare tarball cannot pin the base commit's release, and "
USER                   "the CHANGELOG/record fallback was measured and rejected (it lets an un-released "
USER                   "tree pass). Run this bar in a clone, which carries .git")
USER 
USER 
USER def version_key(v: str) -> tuple[int, int, int]:
USER     major, minor, patch = (int(x) for x in v.split("."))
USER     return major, minor, patch
USER 
USER 
USER def base_header_date(root: Path) -> tuple[str | None, str]:
USER     """The date the replaced header carried, from the base SPEC.md, or from the base release's own
USER     CHANGELOG entry if history is unavailable. (None, why) when neither exists."""
USER     base_spec = git_show(root, BASE_COMMIT, "SPEC.md")
USER     if base_spec is not None:
USER         m = HEADER_RE.search(base_spec)
USER         if m is not None:
USER             return m.group("date"), f"git show {BASE_COMMIT[:12]}:SPEC.md header"
USER     bv, _ = base_version(root)
USER     if bv is not None:
USER         changelog = (root / "CHANGELOG.md").read_text(encoding="utf-8")
USER         m = re.search(rf"^#{{0,3}}\s*{re.escape(bv)}\b.*?(\d{{4}}-\d{{2}}-\d{{2}})", changelog,
USER                       flags=re.M | re.S)
USER         if m is not None:
USER             return m.group(1), f"CHANGELOG.md's {bv} entry"
USER     return None, "neither the base SPEC.md nor a dated base CHANGELOG entry exists"
USER 
