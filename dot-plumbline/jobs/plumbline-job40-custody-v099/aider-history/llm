USER def measure_header(root: Path) -> list[str]:
USER     """The header names the release, states a status, is dated in the past and strictly later than the
USER     header it replaces, and section 4's example is the release's own version."""
USER     bad: list[str] = []
USER     m = read_header(root)
USER     if m is None:
USER         return ["SPEC.md: no `**Version X.Y.Z · status · YYYY-MM-DD**` header"]
USER     declared = m.group("v")
