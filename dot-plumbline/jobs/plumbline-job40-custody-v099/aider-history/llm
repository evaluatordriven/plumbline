USER def _body_without_versions(text: str) -> str:
USER     """The text with every version-shaped token replaced by a mark, so two documents that differ only
USER     in which release they are about compare equal. Used to prove each document still says what it said,
USER     not to excuse the tokens: test_09 and test_02 measure the tokens themselves."""
USER     return re.sub(r"\b[vV]?0\.\d+\.\d+\b", "<version>", text)
