USER # -- 08 ---------------------------------------------------------------------------------------
USER def measure_document_consistency(root: Path) -> list[str]:
USER     """README, CONTRIBUTING and DRAFT-NOTE agree with the release and with each other, and each still
USER     states the phrases it stated at the base commit. Deleting a paragraph is not consistency."""
USER     bad: list[str] = []
USER     version = release_version(root)
USER     for name, patterns in (("CONTRIBUTING.md", CONTRIBUTING_REQUIRED_PHRASES),
USER                            ("README.md", README_REQUIRED_PHRASES),
USER                            ("DRAFT-NOTE.md", DRAFT_NOTE_REQUIRED_PHRASES)):
USER         p = root / name
USER         if not p.is_file():
USER             bad.append(f"{name}: missing")
USER             continue
USER         text = p.read_text(encoding="utf-8")
USER         flat = " ".join(text.split())
USER         for _, pat, what in patterns:
USER             # Every required phrase is prose, so it is matched against the flattened text: a reflow is
USER             # not a deletion, and the sentence-level cases (07, 08's DRAFT-NOTE arm) separately prove
USER             # that a deletion is caught.
USER             if not pat.search(flat):
USER                 bad.append(f"{name}: no longer says {what} ({pat.pattern!r})")
USER     readme = (root / "README.md")
USER     if readme.is_file():
USER         text = readme.read_text(encoding="utf-8")
USER         m = re.search(r"\*\*Status:\s*v?(\d+\.\d+\.\d+)", text)
USER         if m is None:
USER             bad.append("README.md: no `**Status: vX.Y.Z ...**` line")
USER         elif m.group(1) != version:
USER             bad.append(f"README.md: status says {m.group(1)} but SPEC.md declares {version}")
USER     draft = root / "DRAFT-NOTE.md"
USER     if draft.is_file():
USER         text = draft.read_text(encoding="utf-8")
USER         first = next((ln for ln in text.splitlines() if ln.strip().startswith("#")), "")
USER         shown = version_tokens(first)
USER         if shown and shown[0] != version:
USER             bad.append(f"DRAFT-NOTE.md: its title names {shown[0]} but SPEC.md declares {version}")
USER         stale = sorted({v for v in version_tokens(text) if v != version})
USER         if stale:
USER             bad.append(f"DRAFT-NOTE.md: still names {stale}; the draft note describes THIS release "
USER                        f"and a token it carries is read by tools/count.py")
USER         bad.extend(measure_draft_note_claims_frozen(root, text))
USER     return bad
USER 
USER 
USER # -- 08: DRAFT-NOTE.md may not claim a frozen path changed ---------------------------------------
USER # The hunk inventory is a LIST OF FILES THE RELEASE TOUCHED. This release freezes the checker, the
USER # count/verdict tools, the schema, the fixtures and this bar file (the packet's `artifact.frozen`).
USER # A draft note that lists a hunk in one of them is claiming a change the release did not make, and
USER # the note is the document a reviewer reads to decide what to look at.
USER #
USER # THE VERDICT ON A CUT TREE IS ZERO CLAIMS. An earlier revision only required that the claims be
USER # REPORTED — the case passed when ``measure_draft_note_claims_frozen`` returned 41 problems and
USER # ``measure_document_consistency`` reported the same 41, so a DRAFT-NOTE bumped in its version line
USER # and left carrying the base tree's whole 41-claim frozen inventory passed. Reporting a claim is not
USER # correcting it. ``CI_FROZEN_PATH_CLAIMS`` below is the reading; ``measure_draft_note_claims_frozen``
USER # and the case that calls it now require it to be zero on a cut tree.
USER #
USER # WHERE THE ZERO APPLIES. On a cut tree — the subject this bar measures, once it declares a release
USER # later than the base commit's — zero. On the BASE TREE the answer is not zero and is not required to
USER # be: the base DRAFT-NOTE.md does carry the 41 claims, and a reading taken before the release is cut
USER # must report that fact rather than fail on it. The base tree's GREEN comes from the "the note is
USER # unchanged from the base" arm, which is a measurement of the tree, not a pass on the claims.
USER #
USER # The frozen paths, and the two ways a document names one. A backticked path is how the inventory
USER # writes them; a bare repo-relative path is how prose writes one. The regexes are built from these
USER # paths so the list has one home.
USER FROZEN_PATHS = ("checker/check.py", "tools/count.py", "tools/check_verdicts.py",
USER                 "schema/custody-v1.schema.json", "fixtures/expected.json",
USER                 "tests/example_version_check.py")
USER # The directories the job freezes whole, as well as by path. A file under one of them that is not
USER # FROZEN_PATHS is still a file this job does not let anyone change (fixtures/, tests/). Named
USER # separately so a claim about `fixtures/generate.py` is read as a claim about a frozen tree even
USER # though only `fixtures/expected.json` is listed above.
USER FROZEN_DIRECTORIES = ("checker/", "fixtures/", "schema/", "tools/")
USER # Paths under a frozen directory that this release DOES move: the two examples the Owner put in the
USER # editable set ("Include", ruling 1) and the documents themselves. Everything else under a frozen
USER # directory is frozen. A path named here is not read as a frozen claim.
USER FROZEN_DIRECTORY_EXCEPTIONS = ("examples/minimal/inputs.json", "examples/minimal/record.json")
USER 
USER 
USER def _frozen_in(line: str) -> list[str]:
USER     """Every frozen path this line names, as typed. A backticked token is read as a path; so is a
USER     bare token that names a frozen directory. Returns the tokens as found, so a failure can quote what
USER     the document actually said. Deduplicated within the line, and nowhere else: a measurement holds no
USER     state between lines or between calls."""
USER     hits: list[str] = []
USER 
USER     def add(tok: str) -> None:
USER         if tok not in hits:
USER             hits.append(tok)
USER 
USER     tokens = re.findall(r"`([^`]+)`", line) + re.findall(
USER         r"(?<![\w/.-])((?:checker|fixtures|schema|tools|tests)/[\w./-]+)", line)
USER     for tok in tokens:
USER         tok = tok.strip()
USER         if tok in FROZEN_PATHS:
USER             add(tok)
USER             continue
USER         if any(tok.startswith(d) for d in FROZEN_DIRECTORIES) \
USER                 and not any(tok == e for e in FROZEN_DIRECTORY_EXCEPTIONS):
USER             add(tok)
USER     return hits
USER 
USER 
USER # Verbs that assert a path was CHANGED by this release. A draft note may DISCUSS a frozen path — the
USER # base commit touched it, and reasoning about that is what a draft note is for — but it may not claim
USER # this release moved it. The claim is what is measured, so the rule looks for the pairing.
USER CHANGE_VERB_RE = re.compile(r"(?i)\b(chang(?:e[sd]?|ing)|bump(?:s|ed)?|mov(?:e[sd]?|ing)|"
USER                             r"edit(?:s|ed)?|rewr(?:ote|ite|ites|itten)|modif(?:y|ies|ied)|"
USER                             r"updat(?:e[sd]?|ing)|regenerat(?:e[sd]?|ing)|total|hunk)\b")
USER # The hunk-map table: | `path` | n | item | — every row is a file the release touched, by definition.
USER HUNK_MAP_ROW_RE = re.compile(r"^\|\s*`(?P<path>[^`]+)`\s*\|\s*\d+\s*\|")
USER 
USER 
USER def measure_draft_note_claims_frozen(root: Path, text: str | None = None) -> list[str]:
USER     """Every line of a draft note that CLAIMS this release touched a frozen path.
USER 
USER     Three shapes, because a draft note makes the claim three ways:
USER 
USER       * an inventory line — `1. `path` (+n -m) — ...` — every numbered entry is a file the release
USER         touched, so naming a frozen path there is the claim, whatever verb follows;
USER       * a hunk-map row — `| `path` | 3 | item |` — the same, in table form;
USER       * a sentence in the prose that names a frozen path AND a change verb. A sentence that names a
USER         frozen path while reasoning about the base commit makes no claim about this release and is not
USER         reported.
USER 
USER     A glob (`fixtures/cl1-fail-*`) is not a path: it names a family the note is describing, not a
USER     file the release moved.
USER 
USER     Measured on the document as it stands, not against the base: the draft note describes the
USER     release, so every path it claims to have touched is a claim about this release, whoever typed it.
USER     Green on a note that DISCUSSES a frozen path without claiming the release moved it.
USER 
USER     WHAT A GREEN MEANS IS ``[]``. This function is the reading a case compares to zero on a cut tree;
USER     it reports every claim and says nothing when the note makes none. It does NOT report a claim as
USER     "acceptable" or "expected" — an earlier revision's caller did, and a note that carried the base
USER     tree's 41 claims while its version line had been bumped passed on that. See the block above.
USER     """
USER     if text is None:
USER         p = root / "DRAFT-NOTE.md"
USER         if not p.is_file():
USER             return ["DRAFT-NOTE.md: missing"]
USER         text = p.read_text(encoding="utf-8")
USER     bad: list[str] = []
USER     for n, line in enumerate(text.splitlines(), start=1):
USER         stripped = line.strip()
USER         inventory = re.match(r"^\d+\.\s+`[^`]+`", stripped) is not None
USER         hunk_row = HUNK_MAP_ROW_RE.match(stripped) is not None
USER         hits = [h for h in _frozen_in(line) if "*" not in h]
USER         if not hits:
USER             continue
USER         if inventory or hunk_row:
USER             bad.append(f"DRAFT-NOTE.md:{n}: the hunk inventory lists {hits}, which this job freezes. "
USER                        f"The inventory is what the release touched, and this release does not touch "
USER                        f"them. Line: {stripped[:180]!r}")
USER         elif CHANGE_VERB_RE.search(line):
USER             bad.append(f"DRAFT-NOTE.md:{n}: the draft note claims this release changed {hits}, which "
USER                        f"this job freezes. Line: {stripped[:180]!r}")
USER     return bad
USER 
USER 
USER # ---------------------------------------------------------------------------------------------
USER # 09b: THE EXAMPLES' DIGESTS, CHECKED AGAINST SOMETHING ------------------------------------------
USER # record.json carries digests. A digest is a claim about bytes, and a claim nobody compares to bytes is
USER # decoration: an earlier revision said the examples' digests "are what count.py and the checker read",
USER # and measured neither, so `examples/minimal/record.json` with `/subject/0/digest/sha256` set to
USER # sixty-four zeros returned [] from measure_documents_clean. Nothing reported it.
USER #
USER # WHAT THE CHECK IS, and why it needs no custody record. Every digest in examples/minimal/record.json
USER # names a file in examples/minimal/, and examples/minimal/inputs.json — a document in this tree, not a
USER # record — names which file each digest is about (`"file"`, `"evidenceFile"`). So the tree carries both
USER # halves: the digest, and the file it is a digest of. The check is a direct digest comparison, resolved
USER # through inputs.json. It reads no custody record, no log, and no verdict row. (A record's `subject`
USER # entries carry their own `name`, so those resolve without inputs.json; the rest are resolved by
USER # walking inputs.json and the record together, in the same order.)
USER #
USER # THE FROZEN CHECKER IS ALSO RUN where it applies. tools/check_verdicts.py re-runs checker/check.py over
USER # examples/minimal/record.json and requires the frozen verdict. It is run here and its exit code is
USER # required to be 0. It is NOT the whole check: measured, setting the rubric or method digest to zeros
USER # still exits 0 from check_verdicts.py (the checker does not compare those digests), so the direct
USER # comparison above is what covers them. Both are run; each catches what the other does not.
USER EXAMPLE_DIGEST_DIR = "examples/minimal"
USER EXAMPLE_RECORD = "examples/minimal/record.json"
USER EXAMPLE_INPUTS = "examples/minimal/inputs.json"
USER 
USER 
USER def _example_digest_pairs(root: Path) -> tuple[list[tuple[str, str, str]], list[str]]:
USER     """(label, digest, path relative to examples/minimal/), and the problems that stop it resolving.
USER 
USER     Every digest in the record is paired with the file inputs.json names for it. Where inputs.json
USER     does not name a file — the record's own `subject` entries, which carry a `name` — the record's
USER     name is used. A digest with no resolvable file is reported as a problem, because a digest that
USER     names nothing is a claim nobody can check.
USER     """
USER     base = root / EXAMPLE_DIGEST_DIR
USER     rec_p, inp_p = root / EXAMPLE_RECORD, root / EXAMPLE_INPUTS
USER     problems: list[str] = []
USER     pairs: list[tuple[str, str, str]] = []
USER     for p in (rec_p, inp_p):
USER         if not p.is_file():
USER             return [], [f"{p.relative_to(root)}: missing, so its digests cannot be checked"]
USER     try:
USER         rec = json.loads(rec_p.read_text(encoding="utf-8"))
USER         inp = json.loads(inp_p.read_text(encoding="utf-8"))
USER     except json.JSONDecodeError as e:
USER         return [], [f"{EXAMPLE_RECORD} or {EXAMPLE_INPUTS}: not JSON ({e})"]
USER 
USER     pred = rec.get("predicate") or {}
USER 
USER     def add(label: str, dig, rel) -> None:
USER         if not isinstance(dig, str) or not dig:
USER             problems.append(f"{EXAMPLE_RECORD}: {label} carries no sha256 digest")
USER             return
USER         if not rel:
USER             problems.append(f"{EXAMPLE_RECORD}: {label} has a digest but {EXAMPLE_INPUTS} names no "
USER                             f"file for it, so the digest is a claim about nothing this tree holds")
USER             return
USER         pairs.append((label, dig, str(rel)))
USER 
USER     for i, s in enumerate(rec.get("subject") or []):
USER         add(f"subject[{i}]", (s.get("digest") or {}).get("sha256"), s.get("name"))
USER     subj_files = (inp.get("subject") or {}).get("files") or []
USER     for i, s in enumerate(rec.get("subject") or []):
USER         if not s.get("name") and i < len(subj_files):
USER             pairs[:] = [x for x in pairs if x[0] != f"subject[{i}]"]
USER             add(f"subject[{i}]", (s.get("digest") or {}).get("sha256"), subj_files[i])
USER     bar, inp_bar = pred.get("bar") or {}, inp.get("bar") or {}
USER     add("predicate.bar.digest", (bar.get("digest") or {}).get("sha256"),
USER         (inp_bar.get("digest") or {}).get("file"))
USER     for i, a in enumerate(bar.get("approvals") or []):
USER         src = (inp_bar.get("approvals") or [])
USER         add(f"predicate.bar.approvals[{i}].barDigest", (a.get("barDigest") or {}).get("sha256"),
USER             ((src[i].get("barDigest") or {}).get("file") if i < len(src) else None))
USER     maker, inp_maker = pred.get("maker") or {}, inp.get("maker") or {}
USER     add("predicate.maker.method", (maker.get("method") or {}).get("sha256"),
USER         (inp_maker.get("method") or {}).get("file"))
USER     inst, inp_inst = pred.get("instrument") or {}, inp.get("instrument") or {}
USER     for name in ("rubric", "runner"):
USER         add(f"predicate.instrument.{name}", (inst.get(name) or {}).get("sha256"),
USER             (inp_inst.get(name) or {}).get("file"))
USER     inp_checks = inp.get("checks") or []
USER     for i, c in enumerate(pred.get("checks") or []):
USER         src = inp_checks[i] if i < len(inp_checks) else {}
USER         add(f"predicate.checks[{i}].evidence", (c.get("evidence") or {}).get("sha256"),
USER             (src.get("evidence") or {}).get("evidenceFile"))
USER     inp_controls = inp.get("controls") or []
USER     for i, c in enumerate(pred.get("controls") or []):
USER         src = inp_controls[i] if i < len(inp_controls) else {}
USER         add(f"predicate.controls[{i}].case", (c.get("case") or {}).get("sha256"),
USER             (src.get("case") or {}).get("file"))
USER     return pairs, problems
USER 
USER 
USER def measure_example_digests(root: Path) -> list[str]:
USER     """Every digest in examples/minimal/record.json, compared to the bytes of the file it names.
USER 
USER     A doctored digest — the Owner's `/subject/0/digest/sha256` set to sixty-four zeros — must be
USER     reported here. So must a digest whose file is missing, and a digest whose file has the right
USER     digest for the wrong content. The comparison is sha256 of the file's bytes, resolved relative to
USER     examples/minimal/, which is where inputs.json's relative paths point.
USER 
USER     The frozen checker is run as well, over the example record, and a non-zero exit is reported:
USER     tools/check_verdicts.py is the tree's own statement of what that record must read, and a record
USER     whose verdict drifted is a record whose content moved. Its exit 1 on a doctored subject digest is
USER     the same defect as the direct comparison catches, from the other side.
USER     """
USER     bad: list[str] = []
USER     pairs, unresolved = _example_digest_pairs(root)
USER     bad.extend(unresolved)
USER     base = root / EXAMPLE_DIGEST_DIR
USER     if not pairs:
USER         bad.append(f"{EXAMPLE_RECORD}: no digests resolved, so this case measured nothing")
USER     for label, dig, rel in pairs:
USER         p = base / rel
USER         if not p.is_file():
USER             bad.append(f"{EXAMPLE_RECORD}: {label} names {rel!r}, which does not exist under "
USER                        f"{EXAMPLE_DIGEST_DIR}/")
USER             continue
USER         got = sha256_file(p)
USER         if got != dig:
USER             bad.append(f"{EXAMPLE_RECORD}: {label} says sha256 {dig}, but {EXAMPLE_DIGEST_DIR}/{rel} "
USER                        f"hashes to {got}. The digest is a claim about those bytes and it is false.")
USER     cv = root / "tools" / "check_verdicts.py"
USER     if cv.is_file():
USER         r = run([sys.executable, "tools/check_verdicts.py"], root)
USER         if r.returncode != 0:
USER             body = (r.stdout or "").strip() or (r.stderr or "").strip()
USER             bad.append(f"tools/check_verdicts.py exited {r.returncode} over {EXAMPLE_RECORD}: "
USER                        f"{body.splitlines()[-1][:300] if body else 'no output'}")
USER     return bad
USER 
