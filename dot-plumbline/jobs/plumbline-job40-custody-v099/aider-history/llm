USER     def planted_copy(self) -> tuple[Path, WriteGate]:
USER         """A copy of the subject, excluding nothing (`.git` travels with it, so measure_spec_change and
USER         the base-commit comparisons work on it) and excluding only ``__pycache__``. Returns (root, gate)."""
USER         tmp = Path(tempfile.mkdtemp(prefix="job35-bar-"))
USER         root = tmp / "tree"
USER         shutil.copytree(self.subject, root, ignore=shutil.ignore_patterns("__pycache__"))
USER         self.addCleanup(shutil.rmtree, tmp, ignore_errors=True)
USER         return root, WriteGate(tmp)
USER 
USER     def _plant(self, rel: str, data: str | bytes) -> Path:
USER         """A copy with one file replaced, through the gate."""
USER         root, gate = self.planted_copy()
USER         gate.write_file(root / rel, data)
USER         return root
USER 
USER     def _plant_text(self, rel: str, text: str) -> Path:
USER         return self._plant(rel, text)
USER 
USER     def _edit(self, rel: str, fn) -> Path:
USER         """A copy with one file's text passed through `fn`. On a tree where `fn` is a no-op — the
USER         tree's header already IS the base release — the copy is returned unchanged and the caller's
USER         bite assertion is what fails, with the reason."""
USER         text = (self.subject / rel).read_text(encoding="utf-8")
USER         new = fn(text)
USER         if new == text:
USER             root, _ = self.planted_copy()
USER             return root
USER         return self._plant_text(rel, new)
USER 
USER     # -- the shared bite helper: every GREEN-at-base case proves its plant reddens the SAME function --
