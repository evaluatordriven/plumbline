USER def _required_cell_normalised(cell: str) -> str:
USER     """The required? cell, reduced to the two answers section 4 can give: NOT required, or required.
USER     An empty cell is required (the table's contract is that a field with nothing in that cell is
USER     required), and `no` is the other way of saying not-required. Everything else reads as required —
USER     which is deliberate: `yes` and `no` are different answers and must not compare equal."""
USER     flat = cell.replace("`", "").strip().lower()
USER     if flat in ("", "yes", "y") or flat == "required" or flat.startswith("yes,"):
USER         return "required"
USER     if flat.startswith(("not required", "no", "optional", "n/a")):
USER         return SPEC_FIELD_NOT_REQUIRED
USER     return f"<unread: {cell.strip()[:40]}>"
USER 
