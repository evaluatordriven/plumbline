USER # -- 09 ---------------------------------------------------------------------------------------
USER LICENSE_NAMES = {
USER     "CC BY 4.0": re.compile(r"CC[ -]BY[ -]4\.0|Creative Commons Attribution 4\.0"),
USER     "Apache-2.0": re.compile(r"Apache[ -](?:License,? Version )?2\.0|Apache License"),
USER     "MIT": re.compile(r"\bMIT\b"), "GPL": re.compile(r"\bA?GPL"), "BSD": re.compile(r"\bBSD\b"),
USER     "MPL": re.compile(r"\bMPL\b"), "CC0": re.compile(r"\bCC0\b"),
USER     "CC BY-SA": re.compile(r"CC[ -]BY[ -]SA|Attribution-ShareAlike"),
USER     "CC BY-NC": re.compile(r"CC[ -]BY[ -]NC|NonCommercial"),
USER     "Unlicense": re.compile(r"\bUnlicense\b"),
USER }
USER 
USER 
USER def measure_documents_clean(root: Path) -> list[str]:
USER     """No current document, NOTICE or example carries a version token that is not the release's; the
USER     license names are the two this repository carries and no other; and the examples' DIGESTS are
USER     checked against the bytes of the files they name.
USER 
USER     The digest arm is ``measure_example_digests``. An earlier revision claimed here that the examples'
USER     digests "are what count.py and the checker read" and measured nothing of the kind — a record with
USER     ``/subject/0/digest/sha256`` set to sixty-four zeros returned [] from this function. A digest
USER     nobody compares to bytes is decoration, and this function now compares every one of them.
USER     """
USER     bad: list[str] = []
USER     version = release_version(root)
USER     allowed = {"CC BY 4.0", "Apache-2.0"}
USER     for name in CURRENT_DOCUMENTS + EXAMPLES:
USER         p = root / name
USER         if not p.is_file():
USER             bad.append(f"{name}: missing")
USER             continue
USER         text = p.read_text(encoding="utf-8")
USER         if name.endswith(".json"):
USER             # A JSON example's version lives in its `specVersion` field, not in prose; read that
USER             # field rather than scanning the whole file for a token.
USER             found_sv = set(re.findall(r'"specVersion"\s*:\s*"(\d+\.\d+\.\d+)"', text))
USER             stale = sorted(v for v in found_sv if v != version)
USER         else:
USER             stale = sorted({v for v in version_tokens(text) if v != version})
USER         if stale:
USER             bad.append(f"{name}: names {stale}, which is not the release ({version})")
USER         if name != "SPEC.md":
USER             for lic, pat in LICENSE_NAMES.items():
USER                 if lic not in allowed and pat.search(text):
USER                     bad.append(f"{name}: names license {lic}; this repository carries CC BY 4.0 (text) "
USER                                f"and Apache-2.0 (code)")
USER     notice = root / "NOTICE"
USER     if notice.is_file():
USER         body = notice.read_text(encoding="utf-8")
USER         if not LICENSE_NAMES["Apache-2.0"].search(body):
USER             bad.append("NOTICE: does not say the code is Apache-2.0")
USER         if not re.search(r"(?is)(text|SPEC\.md|documentation).{0,150}?"
USER                          r"(CC[ -]BY[ -]4\.0|Creative Commons Attribution 4\.0)", body):
USER             bad.append("NOTICE: does not say the text is CC BY 4.0")
USER     bad.extend(measure_example_digests(root))
USER     return bad
USER 
