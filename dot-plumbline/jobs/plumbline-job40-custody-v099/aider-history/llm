USER def requirement_rows(text: str) -> dict[str, str]:
USER     """id -> requirement text, whitespace-collapsed. Section 5's rows are `| ID | text | class |`."""
USER     out: dict[str, str] = {}
USER     for m in REQ_ROW_RE.finditer(text):
USER         cells = [c.strip() for c in m.group("rest").split("|")]
USER         if len(cells) < 2:
USER             continue
