USER def measure_release_lands(root: Path) -> list[str]:
USER     """THE RELEASE GATE. The release must actually have been cut, and every claim below is measured
USER     against the tree's OWN history, not against a literal and not against a flag:
USER 
USER       * the working SPEC.md header declares a version STRICTLY LATER than the base commit's, and not
USER         in the future;
USER       * the newest CHANGELOG.md entry names that same version;
USER       * both examples/minimal/*.json declare that same version;
USER       * the header's date is a real day, not in the future, and strictly later than the base
USER         header's date.
USER 
USER     On an un-released tree (a 0.9.8 tree, where the base is 0.9.8) EVERY one of these is false by
USER     construction: the version is equal and not later, the changelog names the base release, the
USER     examples declare the base release, and the header date equals the base header's date. That is
USER     why this function is RED at base and green only on a tree that has been released — a Maker who
USER     does nothing cannot pass it.
USER 
USER     The version is never a literal: it is read from this tree's header, and the base is read from
USER     this tree's history. Nothing here knows which number the next release will carry.
USER     """
USER     bad: list[str] = []
USER     m = read_header(root)
USER     if m is None:
USER         return ["SPEC.md: no `**Version X.Y.Z · status · YYYY-MM-DD**` header"]
USER     version = m.group("v")
USER     base_v, base_how = base_version(root)
USER     if base_v is None:
USER         return [f"SPEC.md: the base release cannot be derived ({base_how}); a release gate with no "
USER                 f"base has nothing to measure, so this case will not pass by default"]
USER     # (1) strictly later than the base, and a real version
USER     if version_key(version) <= version_key(base_v):
USER         bad.append(f"SPEC.md: the header declares {version}, which is not later than the base "
USER                    f"release {base_v} (derived from {base_how}); the release has not been cut")
USER     # (2) the newest CHANGELOG entry names this same version
USER     changelog = (root / "CHANGELOG.md")
USER     if not changelog.is_file():
USER         bad.append("CHANGELOG.md: missing")
USER     else:
USER         newest = re.search(r"^#{0,3}\s*(\d+\.\d+\.\d+)\b",
USER                            changelog.read_text(encoding="utf-8"), flags=re.M)
USER         if newest is None:
USER             bad.append("CHANGELOG.md: no version heading at all")
USER         elif newest.group(1) != version:
USER             bad.append(f"CHANGELOG.md: the newest entry is {newest.group(1)}, not {version}; a "
USER                        f"release whose changelog has no entry for it has not been documented")
USER     # (3) both examples declare this same version
USER     for rel, found in examples_declaring(root).items():
USER         if not found:
USER             bad.append(f"{rel}: carries no specVersion")
USER         for v in found:
USER             if v != version:
USER                 bad.append(f"{rel}: specVersion {v!r}, not the release {version!r}")
USER     # (4) the header date: real, not future, and strictly later than the base header's date
USER     try:
USER         dated = datetime.date.fromisoformat(m.group("date"))
USER     except ValueError:
USER         bad.append(f"SPEC.md: header date {m.group('date')!r} is not a calendar day")
USER     else:
USER         if dated > datetime.date.today():
USER             bad.append(f"SPEC.md: header is dated {dated.isoformat()}, which is in the future")
USER         base_date, date_how = base_header_date(root)
USER         if base_date is None:
USER             bad.append(f"SPEC.md: the base header's date cannot be derived ({date_how}); a release "
USER                        f"whose date is not later than the header it replaces is un-released")
USER         else:
USER             try:
USER                 if dated <= datetime.date.fromisoformat(base_date):
USER                     bad.append(f"SPEC.md: header is dated {dated.isoformat()}, which is not strictly "
USER                                f"later than the base header's date {base_date} (from {date_how}); "
USER                                f"a later release carries a later date")
USER             except ValueError:
USER                 bad.append(f"SPEC.md: base header date {base_date!r} is not a calendar day")
USER     # (5) no gap note carries the release's name: this release ships a record (Instrument 2)
USER     gap = root / "record" / f"RECORD-GAP-v{version}.md"
USER     if gap.is_file():
USER         bad.append(f"record/{gap.name}: a gap note carries the release's name; this release ships a "
USER                    f"record (Instrument 2), and a gap is the exception {GAP_EXCEPTION_VERSION} "
USER                    f"argued for")
USER     return bad
USER 
