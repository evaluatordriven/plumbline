USER     """The section-4 `specVersion` row with its example cell set to `version`. Used by a plant that
USER     makes the example disagree with the header; the row's shape is kept."""
USER     cells = row.strip().strip("|").split("|")
USER     if len(cells) < 4:
USER         return row
USER     cells[-1] = f" This document's version, e.g. `{version}` "
USER     return "|" + "|".join(cells) + "|"
