USER def partition_count(problems: list[str], version: str) -> dict[str, list[str]]:
USER     """Split count.py's problems into the ones Instrument 2's record closes, the two that are the
USER     Maker's to fix from the documents, and everything else (which is the Maker's too, unnamed here)."""
USER     record, gap, stale, rest = [], [], [], []
USER     for p in problems:
USER         rm = RECORD_PROBLEM_RE.match(p)
USER         if rm and rm.group(1) == version:
USER             record.append(p)
USER             continue
USER         gm = GAP_PROBLEM_RE.search(p)
USER         if gm and gm.group("v") == version:
USER             gap.append(p)
USER             continue
USER         sm = STALE_PROBLEM_RE.match(p)
USER         if sm:
USER             stale.append(p)
USER             continue
USER         rest.append(p)
USER     return {"record": record, "gap": gap, "stale": stale, "rest": rest}
