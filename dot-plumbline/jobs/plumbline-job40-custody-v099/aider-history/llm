USER         try:
USER             got = json.loads(r.stdout)
USER         except json.JSONDecodeError:
USER             print(f"FAIL     {row['record']:44} no JSON (exit {r.returncode}): {r.stderr.strip()[:120]}")
USER             bad += 1
USER             continue
USER         want, failed = row["expect"], sorted(k for k, v in got["requirements"].items()
USER                                              if v.get("status") == "FAILED")
USER         ok = (got["verdict"] == want["verdict"] and got["levelAchieved"] == want["levelAchieved"]
USER               and failed == sorted(want["failed"]))
USER         print(f"{'PASS' if ok else 'FAIL':8} {row['record']:44} "
USER               f"{got['verdict']}/{got['levelAchieved'] or '-'} failed={failed}")
USER         out.append({"record": row["record"], "command": row.get("command"), "ok": ok, "failed": failed})
USER         bad += 0 if ok else 1
USER     for u in data.get("unfreezable") or []:
USER         print(f"UNFROZEN {u['record']:44} {u['why']}")
