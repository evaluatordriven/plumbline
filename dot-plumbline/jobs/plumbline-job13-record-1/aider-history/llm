USER def maker_history(job: Path, ev_dir: Path, ci: dict, m: dict, ref: H.Refusals, pin: dict | None = None,
USER                   gaps: Gaps | None = None, hand: dict | None = None) -> dict:
USER     """startedAt / producedAt / endpoint for a model maker, read from its harness log."""
USER     log = find_log(job, ev_dir, m.get("harness_log"), "harness-maker*.log")
USER     if log is None:
USER         ref.add("time", f"maker: a model maker needs its harness log (maker.harness_log, or exactly one "
USER                         f"harness-maker*.log in the evidence folder); none {'at ' + repr(m['harness_log']) if m.get('harness_log') else 'found'}, "
USER                         f"so startedAt, producedAt and the endpoint have no source")
USER         return {}
USER     # The emitter never writes its inputs (T7): the log is read as it is. Every call the logger did not stamp is
USER     # a hand time (T7b), whether or not it is the first or the last.
USER     log_calls = H.read_log(log, ref, "maker")
USER     flag_calls(log_calls, hand)
USER     calls = log_calls
USER     if m.get("calls"):
USER         calls = [c for c in calls if c.name in m["calls"]]
USER     calls = [c for c in calls if c.at]
USER     if not calls:
USER         return {}
USER     if gaps is not None and any("sent_at" in c.raw or "received_at" in c.raw for c in calls):
USER         for c in calls:
USER             missing = [k for k in ("sent_at", "received_at") if not c.raw.get(k)]
USER             if missing:
USER                 gaps.add(f"maker.{c.label}", f"the Maker harness call {c.label} carries no "
USER                           f"{' or '.join(missing)}; startedAt/producedAt cannot be read from the log")
USER     annotate(calls, "maker", (m.get("model") or {}).get("identifier"), ref, pin)
USER     check_pin_order(pin, calls, "maker", ref)
USER     first = min(calls, key=lambda c: c.started)
USER     last = max(calls, key=lambda c: c.at)
USER     started, produced = first.started, last.at
USER     H.cross_check(ref, "startedAt", ci.get("startedAt"), started, f"harness log {first.label}")
USER     H.cross_check(ref, "producedAt", ci.get("producedAt"), produced, f"harness log {last.label}")
USER     out = {"startedAt": H.iso(started), "producedAt": H.iso(produced), "endpoint": last.endpoint,
USER            "_calls": calls,
USER            "x": {**route_x(log, calls),
USER                  "startedAt_basis": (f"{first.label} sent_at" if first.sent else
USER                                      (f"{first.label} response created" if first.created else
USER                                       f"{first.label} response Date header")),
USER                  "producedAt_basis": (f"{last.label} received_at" if last.received else
USER                                       f"{last.label} {last.at_basis}"),
USER                  "startedAt_source": first.source_started(),
USER                  "producedAt_source": last.source_at()}}
USER     rx = routing_x(calls, pin, "maker", gaps if gaps is not None else Gaps())
USER     if rx:
USER         out["x"]["routing"] = rx
USER     hand_ep = (m.get("model") or {}).get("endpoint")
USER     if hand_ep and last.endpoint and hand_ep != last.endpoint:
USER         ref.add("endpoint", f"maker.model.endpoint: hand-entered {hand_ep!r} but {last.label} "
USER                             + (f"went to {last.host} and was answered upstream by {last.route.get('upstream_provider')!r} "
USER                                f"({last.endpoint})" if last.route.get("aggregator") else f"was answered by {last.endpoint}"))
USER     return out
USER 
USER 
USER def evaluator_history(job: Path, ev_dir: Path, ci: dict, e: dict, ref: H.Refusals, pin: dict | None = None,
USER                       gaps: Gaps | None = None, hand: dict | None = None) -> dict:
USER     who = f"evaluator {e.get('id')}"
USER     rel = e.get("harness_log") or next((x.get("evidence_file") for x in ci.get("external") or []
USER                                         if x.get("subject") == e.get("id")), None)
USER     log = find_log(job, ev_dir, rel, None)
USER     if log is None:
USER         ref.add("time", f"{who}: a model evaluator needs its harness log (evaluators[].harness_log, or the CL1-15 "
USER                         f"external entry for it); {'not found: ' + repr(rel) if rel else 'none named'}, so its check "
USER                         f"times and endpoint have no source")
USER         return {}
USER     # The emitter never writes its inputs (T7): the log is read as it is. Every call counts for T7b, not only the
USER     # call a check is linked to.
USER     log_calls = H.read_log(log, ref, who)
USER     flag_calls(log_calls, hand)
USER     # A model evaluator's CHECK time must come from an instant its own harness log records: the logger's
USER     # `received_at`, or the server-set response `Date` header. A call with neither leaves only the response
USER     # `created` epoch, which the logger never stamped. `--allow-hand-times` admits a time a person typed; it cannot
USER     # make a machine's unstamped clock a person's, so every such call is refused BY ID and nothing is written (T7b).
USER     for c in log_calls:
USER         if c.received is None and c.date is None:
USER             ref.add("check-time", f"{who}: {c.label} carries no logger `received_at` and no response `Date` header, "
USER                                   f"so its check time would be the response `created` epoch the logger never "
USER                                   f"stamped. --allow-hand-times admits a time a person typed; it cannot make a "
USER                                   f"machine's clock a person's, so this check time is refused.")
USER     calls = [c for c in log_calls if c.at]
USER     if not calls:
USER         return {}
USER     annotate(calls, who, (e.get("model") or {}).get("identifier"), ref, pin)
USER     check_pin_order(pin, calls, who, ref)
USER     first = min(calls, key=lambda c: c.at)
USER     hand_ep = (e.get("model") or {}).get("endpoint")
USER     if hand_ep and first.endpoint and hand_ep != first.endpoint:
USER         ref.add("endpoint", f"evaluators[{e.get('id')}].model.endpoint: hand-entered {hand_ep!r} but {first.label} "
USER                             + (f"went to {first.host} and was answered upstream by "
USER                                f"{first.route.get('upstream_provider')!r} ({first.endpoint})"
USER                                if first.route.get("aggregator") else f"was answered by {first.endpoint}"))
USER     named = {}
USER     for c in calls:
USER         named.setdefault(c.name or str(c.i), c)
USER     x = route_x(log, calls)
USER     rx = routing_x(calls, pin, str(e.get("id")), gaps if gaps is not None else Gaps())
USER     if rx:
USER         x["routing"] = rx
USER     return {"calls": named, "endpoint": first.endpoint, "x": x}
USER 
USER 
USER def link_call(ev_calls: dict, ev_id, named, default, where: str, ref: H.Refusals):
USER     """The harness call a check or control came from. Only model evaluators have one."""
USER     if ev_id not in ev_calls:
USER         return None
USER     calls = ev_calls[ev_id]
USER     if not calls:
USER         return None                                          # the log itself was already refused
USER     name = named or (default if default in calls else None)
USER     if name is None and not named and len(calls) == 1:
USER         name = next(iter(calls))
USER     if name not in calls:
USER         ref.add("time", f"{where}: no harness call of evaluator {ev_id} is linked to it "
USER                         f"({'call ' + repr(named) + ' is not in the log' if named else 'set `call` to one of ' + ', '.join(sorted(calls))}); "
USER                         f"its time cannot be read from the log")
USER         return None
USER     return calls[name]
USER 
