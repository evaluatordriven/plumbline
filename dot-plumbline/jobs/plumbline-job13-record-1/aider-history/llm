USER def time_sources(pred: dict, xp: dict) -> dict:
USER     """Every time field the record carries -> the `file:line` that carries it (custody N3).
USER 
USER     `x-plumbline.sources` holds only `file:line` strings; this copies it and adds the per-check, per-control
USER     and per-approval entries under their index keys, so a reader can look a field up by either name."""
USER     out = {k: v for k, v in (xp.get("sources") or {}).items() if isinstance(v, str) and v}
USER     if out.get("bar.frozenAt"):
USER         out.setdefault("frozenAt", out["bar.frozenAt"])
USER     bar = pred.get("bar") or {}
USER     for i, a in enumerate(bar.get("approvals") or []):
USER         s = (a.get("x-plumbline") or {}).get("at_source")
USER         if s:
USER             out[f"bar.approvals[{i}].at"] = s
USER             out[f"approvals[{i}].at"] = s
USER     for i, c in enumerate(pred.get("checks") or []):
USER         s = (c.get("x-plumbline") or {}).get("at_source")
USER         if s:
USER             out[f"checks[{i}].at"] = s
USER     for i, k in enumerate(pred.get("controls") or []):
USER         s = (k.get("x-plumbline") or {}).get("at_source")
USER         if s:
USER             out[f"controls[{i}].at"] = s
USER     return out
USER 
USER 
USER def check_order(pred: dict, packet: dict, ci: dict, now: datetime, ref: H.Refusals) -> None:
USER     """The record's events in the order they happened, none after the close or the emission."""
USER     P = H.parse_ts
USER     tol = timedelta(seconds=H.TOLERANCE_S)
USER     bar = pred.get("bar") or {}
USER     F, S, Pd = P(bar.get("frozenAt")), P(pred.get("startedAt")), P(pred.get("producedAt"))
USER     checks = [(f"checks[{(c.get('x-plumbline') or {}).get('pass_id', '?')}/{c.get('dimension')}].at", P(c.get("at")),
USER                bool((c.get("x-plumbline") or {}).get("call"))) for c in pred.get("checks") or []]
USER     ctls = [(f"controls[{k.get('id')}].at", P((k.get("x-plumbline") or {}).get("at")),
USER              bool((k.get("x-plumbline") or {}).get("call"))) for k in pred.get("controls") or []]
USER     apprs = [(f"bar.approvals[{i}].at ({a.get('role')})", P(a.get("at"))) for i, a in enumerate(bar.get("approvals") or [])]
USER     D = P((pred.get("disposition") or {}).get("at"))
USER     from_log = (pred.get("x-plumbline") or {}).get("times", {})
USER     events = [("bar.frozenAt", F, False), *[(n, t, False) for n, t in apprs],
USER               ("startedAt", S, from_log.get("startedAt") == "harness log"),
USER               ("producedAt", Pd, from_log.get("producedAt") == "harness log"), *checks, *ctls,
USER               ("disposition.at", D, False)]
USER 
USER     def before(an, a, bn, b, strict=False):
USER         if a and b and (a >= b if strict else a > b):
USER             ref.add("order", f"{an} {H.iso(a)} is {'not before' if strict else 'after'} {bn} {H.iso(b)}")
USER 
USER     before("bar.frozenAt", F, "startedAt", S, strict=True)
USER     for n, t in apprs:
USER         before("bar.frozenAt", F, n, t)
USER         before(n, t, "startedAt (the maker's first call)", S)
USER     before("startedAt", S, "producedAt", Pd)
USER     for n, t, _ in checks:
USER         before("producedAt", Pd, n, t)
USER     last = max([t for _, t, _ in checks if t] or [None], key=lambda t: t or datetime.min.replace(tzinfo=timezone.utc))
USER     if last:
USER         before("the last check", last, "disposition.at", D)
USER     close = P(((packet.get("close") or {}) if isinstance(packet.get("close"), dict) else {}).get("date"))
USER     for n, t, logged in events:
USER         if not t:
USER             continue
USER         if n != "disposition.at" and close and t > close + (tol if logged else timedelta(0)):
USER             ref.add("order", f"{n} {H.iso(t)} is after the job's close (packet close.date {H.iso(close)})")
USER         if t > now + (tol if logged else timedelta(0)):
USER             ref.add("after-emit", f"{n} {H.iso(t)} is after this record's emission at {H.iso(now)}: a record cannot "
USER                                   f"report an event that had not happened")
USER 
USER 
USER def s_key(pl_name: dict, dim: str) -> str:
USER     """The Plumbline dimension name a bar dimension id was mapped from (quotes are keyed by it)."""
USER     for k, v in pl_name.items():
USER         if v == dim:
USER             return k
USER     return dim
USER 
