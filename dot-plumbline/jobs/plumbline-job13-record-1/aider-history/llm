USER def main(argv=None) -> int:
USER     ap = argparse.ArgumentParser(description="Emit a custody/v1 record for a job at a terminal state.")
USER     ap.add_argument("--job-dir", required=True)
USER     ap.add_argument("--inputs", help="custody inputs (default: <job>/inputs/custody.json)")
USER     g = ap.add_mutually_exclusive_group()
USER     g.add_argument("--out", help="output file (default: <job>/custody/record.custody.json)")
USER     g.add_argument("--out-dir", help="write <out-dir>/<job_id>.custody.json")
USER     ap.add_argument("--print-only", action="store_true")
USER     ap.add_argument("--allow-hand-times", action="store_true",
USER                     help="write the record with the hand-entered times listed in x-plumbline.hand_times[] and the "
USER                          "allowance recorded (default: refuse them, exit 3)")
USER     ap.add_argument("--expect-revision", help="the emitter revision (commit or tree, >= 7 hex) this record must "
USER                                               "be written by; also $PLUMBLINE_EXPECT_REVISION")
USER     a = ap.parse_args(argv)
USER     job = Path(a.job_dir).expanduser().resolve()
USER     if not (job / "packet.json").is_file():
USER         print(f"REFUSED: {job} has no packet.json — custody is written for a job, and a job is its packet.")
USER         return 2
USER     try:
USER         packet = load(job / "packet.json")
USER     except Exception as exc:
USER         print(f"REFUSED: packet.json unreadable ({exc})"); return 2
USER     if packet.get("terminal_state") not in TERMINALS:
USER         print(f"REFUSED: the packet's terminal_state is {packet.get('terminal_state')!r}, not one of {TERMINALS}. "
USER               f"A custody record is written when a job ENDS; close it with --terminal-state first.")
USER         return 2
USER     inputs = Path(a.inputs).expanduser() if a.inputs else job / "inputs" / "custody.json"
USER     ref = H.Refusals()
USER     try:
