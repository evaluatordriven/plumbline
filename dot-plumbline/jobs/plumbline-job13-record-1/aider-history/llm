USER def _packet_blocks(packet: dict) -> list[dict]:
USER     """packet.json itself, then the finish/summary objects loop() nests the stamps under."""
USER     blocks = [packet]
USER     for key in ("finish", "summary"):
USER         if isinstance(packet.get(key), dict):
USER             blocks.append(packet[key])
USER     return blocks
USER 
USER 
USER def _first_stamp(packet: dict, names: tuple) -> str | None:
USER     for block in _packet_blocks(packet):
USER         for name in names:
USER             value = block.get(name)
USER             if isinstance(value, str) and value.strip():
USER                 return value
USER     return None
USER 
USER 
USER def _instant_text(value) -> str | None:
USER     """The instant `value` names, spelled as the custody schema's timestamp (UTC, ...Z)."""
USER     if not isinstance(value, str) or not value.strip():
USER         return None
USER     text = value.strip()
USER     if text.endswith("Z"):
USER         text = text[:-1] + "+00:00"
USER     try:
USER         parsed = datetime.fromisoformat(text)
USER     except ValueError:
USER         return None
USER     if parsed.tzinfo is None:
USER         return None
USER     return H.iso(parsed.astimezone(timezone.utc))
USER 
