USER def events_log(job: Path, ref: H.Refusals) -> dict:
USER     """inputs/custody-events.jsonl, written as things happen by kit/custody_ledger.py. Latest row per key wins."""
USER     p = job / LEDGER_REL
USER     out = {"_file": None, "approve": {}, "pin": {}}
USER     if not p.is_file():
USER         return out
USER     out["_file"] = {"name": LEDGER_REL, "sha256": file_digest(p)}
USER     for n, ln in enumerate(p.read_text(encoding="utf-8").splitlines(), 1):
USER         if not ln.strip():
USER             continue
USER         try:
USER             e = json.loads(ln)
USER         except ValueError:
USER             ref.add("time", f"{LEDGER_REL} line {n} is not JSON"); continue
USER         e["_line"] = n
USER         if e.get("event") == "approve":
USER             out["approve"][e.get("role")] = e
USER         elif e.get("event") == "pin":
USER             out["pin"][e.get("seat")] = e
USER         elif e.get("event"):
USER             out[e["event"]] = e
USER     return out
