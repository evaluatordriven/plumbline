USER def pin_for(ci: dict, ev_log: dict, seat: str, ref: H.Refusals) -> dict | None:
USER     """The seat's declared provider pin (inputs routing.<seat>), which must be the one logged live."""
USER     pin = (ci.get("routing") or {}).get(seat)
USER     live = ev_log["pin"].get(seat)
USER     if not pin and not live:
USER         return None
USER     if not live:
USER         ref.add("endpoint", f"routing.{seat}: a provider pin is in the custody inputs but not in "
USER                             f"{LEDGER_REL}; a pin is declared with custody_ledger.py pin so its time "
USER                             f"is stamped, not typed")
USER         return None
USER     if not pin:
USER         pin = {k: live.get(k) for k in PIN_KEYS} | {"declaredAt": live.get("at")}
USER     for k in PIN_KEYS:
USER         if str(pin.get(k)) != str(live.get(k)):
USER             ref.add("endpoint", f"routing.{seat}.{k}: the inputs say {pin.get(k)!r} but the pin logged in "
USER                                 f"{LEDGER_REL} says {live.get(k)!r}")
USER     if pin.get("declaredAt") != live.get("at"):
USER         ref.add("time", f"routing.{seat}.declaredAt: the inputs say {pin.get('declaredAt')!r} but the pin was "
USER                         f"logged at {live.get('at')!r}")
USER     host = str(pin.get("host") or "")
USER     if not H.HOST.match(host) or host in H.AGGREGATORS:
USER         ref.add("endpoint", f"routing.{seat}.host {host!r} is not an upstream provider's host name")
USER     return dict(pin, declaredAt=live.get("at"))
USER 
USER 
USER PIN_KEYS = ("via", "provider", "slug", "host")
USER 
USER 
USER def check_pin_order(pin: dict | None, calls, who: str, ref: H.Refusals) -> None:
USER     if not pin or not calls:
USER         return
USER     first = min(calls, key=lambda c: c.started)
USER     at = H.parse_ts(pin.get("declaredAt"))
USER     if at is None or at > first.started:
USER         ref.add("order", f"{who}: provider pin declared at {pin.get('declaredAt')!r}, after the seat's first call "
USER                          f"{first.label} ({H.iso(first.started)}); a pin chosen after the calls is not a pin")
USER 
USER 
USER def routing_x(calls, pin: dict | None, seat: str, gaps: Gaps) -> dict | None:
USER     """What each aggregator call asked OpenRouter for; a request that did not ask for the pin is a hard gap."""
USER     agg = [c for c in calls if c.host in H.AGGREGATORS]
USER     if not agg or not pin:
USER         return None
USER     reqs, bad = {}, {}
USER     for c in agg:
USER         key = json.dumps(c.routing, sort_keys=True)
USER         reqs.setdefault(key, []).append(c.label)
USER         probs = H.routing_problems(c.routing, pin)
USER         if probs:
USER             bad[c.label] = probs
USER     for label, probs in bad.items():
USER         gaps.add(f"routing.{seat}.request", f"{label} did not ask OpenRouter for the pin: " + "; ".join(probs)
USER                  + ". The served provider is still read from the log, but nothing in the request kept the prompt "
USER                    "on one zero-retention provider. Re-emitting cannot fix this; the run's own request did it.")
USER     return {"pin": {k: pin.get(k) for k in (*PIN_KEYS, "declaredAt")},
USER             "requests": [{"provider": json.loads(k), "calls": v} for k, v in reqs.items()],
USER             "request_ok": not bad}
USER 
USER 
USER def annotate(calls, who: str, identifier, ref: H.Refusals, pin: dict | None = None) -> None:
USER     for c in calls:
USER         c.endpoint, c.route = H.endpoint_of(c, ref, who, pin)
USER         if identifier and not H.model_matches(c.model, identifier):
USER             ref.add("model", f"{who}: {c.label} ran model {c.model!r}, not the recorded identifier {identifier!r}")
USER 
USER 
USER def route_x(log: Path, calls) -> dict:
USER     x = {"harness_log": log.name, "calls": [c.label for c in calls]}
USER     aggs = sorted({c.route.get("aggregator") for c in calls if c.route.get("aggregator")})
USER     if aggs:
USER         x["aggregator"] = aggs[0] if len(aggs) == 1 else aggs
USER         ups = sorted({str(c.route.get("upstream_provider")) for c in calls if c.route.get("upstream_provider")})
USER         x["upstream_provider"] = ups[0] if len(ups) == 1 else ups
USER         sl = sorted({str(c.route.get("provider_slug")) for c in calls if c.route.get("provider_slug")})
USER         if sl:
USER             x["provider_slug"] = sl[0] if len(sl) == 1 else sl
USER     bases = sorted({c.route.get("endpoint_basis") for c in calls if c.route.get("endpoint_basis")})
USER     if bases:
USER         x["endpoint_basis"] = bases[0] if len(bases) == 1 else bases
USER     return x
USER 
