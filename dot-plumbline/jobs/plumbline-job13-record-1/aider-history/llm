USER             # the event does not carry is not compared (the ledger is not required to restate it).
USER             for k in ("by", "at"):
USER                 if a.get(k) and live.get(k) and live.get(k) != a.get(k):
USER                     ref.add("time" if k == "at" else "approval",
USER                             f"bar.approvals[{i}].{k}: the ledger says {a.get(k)!r} but {LEDGER_REL} "
USER                             f"logged {live.get(k)!r} when it happened")
USER             xa["time_source"] = "logged live (inputs/custody-events.jsonl)"
USER             if live.get("at"):
USER                 xa["at_source"] = f"{LEDGER_REL}:{live['_line']}"
USER         elif a.get("at"):
USER             n = line_in(inputs_path, a.get("at"), "at")
USER             if n:
USER                 xa["at_source"] = f"{rel_inputs}:{n}"
USER         if xa.get("at_source"):
USER             xp["sources"][f"bar.approvals[{i}].at"] = xa["at_source"]
USER         approvals.append({"role": a.get("role"), "by": a.get("by"),
USER                           "barDigest": hexdigest(a.get("barDigest"), f"bar.approvals[{i}].barDigest", gaps),
USER                           "at": ts(a.get("at"), f"bar.approvals[{i}].at", gaps), "adopted": a.get("adopted"),
USER                           "x-plumbline": xa})
USER     if not approvals:
USER         gaps.add("bar.approvals", "no buyer/specialist approval recorded")
USER     # F1f: a relay is a report, never an approval. A buyer approval whose only evidence is a relay line is
USER     # refused as a missing approval: the emitter will not count the relay.
USER     if have_inputs and relay_only_buyer(ci, packet, lines):
USER         ref.add("approval", f"buyer: the buyer's approval exists only as a relay ({LEDGER_REL}); a relay is a "
USER                             f"report, not an approval (F1f). The buyer must approve directly: "
