USER 
USER     # ---- subject: the artifact files, by digest ----
USER     files_dir = job / ci.get("files_dir", "custody/files")
USER     names = ci.get("subject")
USER     if names is None and files_dir.is_dir():
USER         names = sorted(str(p.relative_to(files_dir)) for p in files_dir.rglob("*") if p.is_file())
USER     subject = []
USER     for n in names or []:
USER         p = files_dir / n
USER         if p.is_file():
USER             subject.append({"name": n, "digest": {"sha256": file_digest(p)}})
USER         else:
USER             gaps.add(f"subject[{n}]", f"artifact file {n!r} not found under {files_dir.relative_to(job)}")
