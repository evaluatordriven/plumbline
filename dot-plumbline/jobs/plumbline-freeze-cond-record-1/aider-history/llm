USER def _problems(packet, record_dir, root, evaluator_fn) -> list[str]:
USER     problems = []
USER     if packet.get("ratified") is not True:
USER         problems.append("ratified is not true")
USER     if packet.get("mode") != "scored":
USER         problems.append("mode is not scored (%s)" % packet.get("mode"))
USER     if not str(packet.get("human_seat") or "").strip():
USER         problems.append("human_seat is blank")
USER     artifact = packet.get("artifact") if isinstance(packet.get("artifact"), dict) else {}
USER     maker = packet.get("maker") if isinstance(packet.get("maker"), dict) else {}
USER     evaluator = packet.get("evaluator") if isinstance(packet.get("evaluator"), dict) else {}
USER     bounds = packet.get("bounds") if isinstance(packet.get("bounds"), dict) else {}
USER     budget = bounds.get("budget") if isinstance(bounds.get("budget"), dict) else {}
USER     escalation = packet.get("escalation") if isinstance(packet.get("escalation"), dict) else {}
USER     if not _strings(artifact.get("test_cmd")):
USER         problems.append("artifact.test_cmd is not a non-empty list of strings")
USER     if not _strings(artifact.get("frozen")):
USER         problems.append("artifact.frozen is missing")
USER     editable = artifact.get("editable")
USER     if not isinstance(editable, list):
USER         problems.append("artifact.editable is not a list")
USER     else:
USER         for rel in editable:
USER             if not isinstance(rel, str) or not rel.strip():
USER                 problems.append("artifact.editable has an entry that is not a non-empty string")
USER                 continue
USER             if os.path.isabs(rel):
USER                 problems.append("artifact.editable entry is absolute: %s" % rel)
USER                 continue
USER             if not _inside(os.path.realpath(os.path.join(root, rel)), root):
USER                 problems.append("artifact.editable entry resolves outside cwd: %s" % rel)
USER     if not _strings(maker.get("cmd")):
USER         problems.append("maker.cmd is not a non-empty list of strings")
USER     if maker.get("handoff") != "rule12":
USER         problems.append("maker.handoff is not rule12")
USER     if evaluator_fn is None and not _strings(evaluator.get("cmd")):
USER         problems.append("evaluator.cmd is not a non-empty list of strings")
USER     runs = evaluator.get("runs")
USER     if type(runs) is not int or runs < 2:
USER         problems.append("evaluator.runs is not an int of at least 2")
USER     for name in ("T_accept", "T_dim", "T_reject"):
USER         if name not in bounds or not _number(bounds.get(name)):
USER             problems.append("%s is not a number" % name)
USER     cap = bounds.get("cap")
USER     if type(cap) is not int or cap < 1:
USER         problems.append("cap is not an int of at least 1")
USER     if "cap_counts" in bounds and bounds.get("cap_counts") != "generations":
USER         problems.append("cap_counts is not generations")
USER     if not _number(budget.get("time_hours_lt")) or budget.get("time_hours_lt") <= 0:
USER         problems.append("budget.time_hours_lt is not a positive number")
USER     if not _number(budget.get("amount")) or budget.get("amount") < 0:
USER         problems.append("budget.amount is not a number of 0 or more")
USER     if escalation.get("route") != ["Architect", "Owner"]:
USER         problems.append("escalation.route is not ['Architect', 'Owner']")
USER     if not isinstance(escalation.get("classes"), list):
USER         problems.append("escalation.classes is not a list")
USER     holders = escalation.get("holders") if isinstance(escalation.get("holders"), dict) else {}
USER     architect = str(holders.get("architect") or "")
USER     if not architect.strip():
USER         problems.append("holders.architect is blank")
USER     orch = holders.get("orchestrator")
USER     scripts = []
USER     escalations = []
USER     if isinstance(orch, list):
USER         for index, item in enumerate(orch):
USER             if not isinstance(item, dict):
USER                 continue
USER             if item.get("does") == "rounds" and item.get("kind") == "script":
USER                 scripts.append(item)
USER             if item.get("does") == "escalations":
USER                 escalations.append(item)
USER             if not str(item.get("tested") or "").strip():
USER                 problems.append(
USER                     "holders.orchestrator[%d] (%s) has no tested" % (index, item.get("does"))
USER                 )
USER     if len(scripts) != 1:
USER         problems.append("holders.orchestrator has no script holder for rounds")
USER     if len(escalations) != 1:
USER         problems.append("holders.orchestrator has no escalations holder")
USER     folded = architect.strip().casefold()
USER     names = []
USER     if isinstance(orch, list):
USER         names = [str(item.get("holder") or "").strip().casefold() for item in orch if isinstance(item, dict)]
USER     if folded and folded in names:
USER         problems.append("holders.architect equals an orchestrator holder")
USER     rec = conductor_software.resolve(record_dir, root)
USER     if _inside(rec, root):
USER         problems.append("record_dir resolves inside cwd")
USER     if _holds_files(record_dir):
USER         problems.append("record_dir already holds files")
USER     return problems
