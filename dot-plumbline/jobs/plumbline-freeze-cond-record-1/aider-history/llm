USER def _classify(result, clock_cut):
USER     if not result.get("dispatched"):
USER         return NOT_DISPATCHED, None
USER     if result.get("hashes_unchanged") is False or result.get("reason") == "edit outside editable":
USER         return TAMPERED, "maker"
