USER         "problems": problems,
USER         "question": None,
USER         "diagnosis": None,
USER         "why_unobservable": None,
USER         "options": None,
USER         "recommendation": None,
USER         "proposed_packet": None,
USER         "decision": None,
USER         "started_at": started_at,
