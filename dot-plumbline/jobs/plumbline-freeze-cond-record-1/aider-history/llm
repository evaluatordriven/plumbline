USER def _load(packet):
USER     if isinstance(packet, (str, os.PathLike)):
USER         raw = open(packet, "rb").read()
USER         return json.loads(raw.decode("utf-8")), hashlib.sha256(raw).hexdigest()
USER     raw = json.dumps(packet, sort_keys=True).encode("utf-8")
USER     return packet, hashlib.sha256(raw).hexdigest()
