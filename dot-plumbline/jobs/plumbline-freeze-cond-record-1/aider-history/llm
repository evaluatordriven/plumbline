USER def _strings(value) -> bool:
USER     return isinstance(value, list) and len(value) > 0 and all(isinstance(item, str) and item for item in value)
USER 
USER 
USER def _number(value) -> bool:
USER     return isinstance(value, (int, float)) and not isinstance(value, bool)
USER 
USER 
USER def _inside(child, parent) -> bool:
USER     try:
USER         return os.path.commonpath([child, parent]) == parent
USER     except ValueError:
USER         return False
USER 
USER 
USER def _holds_files(path) -> bool:
USER     if not os.path.isdir(path):
USER         return False
USER     for _dir, _names, files in os.walk(path):
USER         if files:
USER             return True
USER     return False
USER 
