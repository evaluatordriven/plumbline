USER def _custody_packet(packet, halt):
USER     """The ``packet.json`` a finish leaves for the emitter to read.
USER 
USER     The emitter reads the finish out of the job directory, so before the seam is
USER     called this module records what the finish says. Because the emitter never
USER     sees ``summary.json`` (that file is written only after a clean record), the
USER     finish has to be reachable from ``packet.json`` alone: its fields are
USER     written at the top level in the same snake_case the round records and the
USER     escalation use, again in the camelCase the record's gap vocabulary uses
USER     (``startedAt``, ``endedAt``), and nested under ``finish``/``summary`` so a
USER     reader that expects the summary as an object finds it. The ratified packet's
USER     own fields are kept alongside so the record's subject can be drawn from
USER     them.
USER     """
USER     descriptor = dict(packet) if isinstance(packet, dict) else {}
USER     finish = {
USER         "terminal_state": halt["terminal_state"],
USER         "outcome": halt["outcome"],
USER         "stop": halt["stop"],
USER         "rounds": halt["rounds"],
USER         "cap": halt["cap"],
USER         "accepted_round": halt["accepted_round"],
USER         "best_round": halt["best_round"],
USER         "cost": halt["cost"],
USER         "separation_gaps": halt["separation_gaps"],
USER         "started_at": halt["started_at"],
USER         "ended_at": halt["ended_at"],
USER         "packet_sha256": halt["packet_sha256"],
USER         "rounds_sha256": halt["rounds_sha256"],
USER         "commit": halt["commit"],
USER     }
USER     descriptor.update(finish)
USER     descriptor.update({
USER         "terminalState": halt["terminal_state"],
USER         "startedAt": halt["started_at"],
USER         "endedAt": halt["ended_at"],
USER         "packetSha256": halt["packet_sha256"],
USER         "roundsSha256": halt["rounds_sha256"],
USER         "bestRound": halt["best_round"],
USER         "acceptedRound": halt["accepted_round"],
USER         "finish": dict(finish),
USER         "summary": dict(finish),
USER     })
USER     return descriptor
USER 
