 def freeze_bar(record_dir, root):                                              
     """Freeze the bar in the ledger, live, before the Maker is dispatched.     
                                                                                
     The bar is ``<cwd>/custody/bar.md``. The ledger tool names a bar relative  
 to                                                                             
     the job directory, so the bar's bytes are copied there unchanged and the   
     tool is pointed at that copy. The tool stamps the freeze from its own      
 clock                                                                          
     and appends the event to ``inputs/custody-events.jsonl``; this module      
 types                                                                          
     no time. If the bar cannot be read, or the tool refuses, this raises       
 before                                                                         
     the Maker command runs: no Maker call and no ``emit_custody.py`` run.      
     """                                                                        
     source = os.path.join(root, "custody", "bar.md")                           
     if not os.path.isfile(source):                                             
         raise RuntimeError("no bar file at %s; cannot freeze before dispatch"  
 % source)                                                                      
     job = os.path.abspath(str(record_dir))                                     
     rel = "custody/bar.md"                                                     
     dest = os.path.join(job, rel)                                              
     os.makedirs(os.path.dirname(dest), exist_ok=True)                          
     shutil.copyfile(source, dest)                                              
     ledger = os.path.join(os.path.dirname(os.path.abspath(__file__)),          
 "custody_ledger.py")                                                           
     proc = subprocess.run(                                                     
         [sys.executable, ledger, "freeze", "--job-dir", job, "--bar", rel],    
         capture_output=True,                                                   
         text=True,                                                             
     )                                                                          
     if proc.returncode != 0:                                                   
         detail = (proc.stderr or proc.stdout or "").strip() or "exit %s" %     
 proc.returncode                                                                
         raise RuntimeError("the bar could not be frozen in %s: %s" % (job,     
 detail))                                                                       
                                                                                

