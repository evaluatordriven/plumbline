             body = json.load(handle)                                           
     except (OSError, ValueError):                                              
         return None                                                            
     bar = body.get("bar") if isinstance(body, dict) else None                  
     rel = bar.get("file") if isinstance(bar, dict) else None                   
     if not isinstance(rel, str) or not rel.strip():                            
         return None                                                            
     return rel                                                                 
                                                                                

