USER def _stamp_logger_times(path):
USER     """WRITE the logger's own sent_at/received_at into every call of ONE COPY of a harness log that carries
USER     neither, preserving the file's format (JSON list, single object, or JSONL).
USER 
USER     This function WRITES. It is never called on the fixture itself (FIX), only on a copy made by
USER     logger_stamped(): the cases that exist to test what the emitter does with a call the logger did NOT stamp
USER     (E2, T7b/E3, the 59-second tolerance) must keep an unstamped log, so they run on FIX or on job_copy_raw().
USER     A call that already carries both times is left exactly as it is.
USER     """
USER     text = path.read_text(encoding="utf-8")
USER     try:
USER         doc = json.loads(text)
USER     except ValueError:
USER         doc = None
USER     array, single = isinstance(doc, list), isinstance(doc, dict)
USER     items = doc if array else ([doc] if single else [json.loads(ln) for ln in text.splitlines() if ln.strip()])
USER     for e in items:
USER         if isinstance(e, dict) and not e.get("sent_at") and not e.get("received_at"):
USER             at = _server_instant(e)
USER             if at:
USER                 e["sent_at"] = e["received_at"] = at
USER     if array:
USER         path.write_text(json.dumps(items, indent=2) + "\n", encoding="utf-8")
USER     elif single:
USER         path.write_text(json.dumps(items[0], indent=2) + "\n", encoding="utf-8")
USER     else:
USER         path.write_text("".join(json.dumps(e) + "\n" for e in items), encoding="utf-8")
USER 
