USER def tool_built_job(name):
USER     """The fixture's static facts with every typed time removed, rebuilt only by kit/custody_ledger.py:
USER     freeze / approve / pin / generation / evaluation / dispose --decided-at (T4, F1b)."""
USER     j = job_copy(name)
