USER def stamp_log(path, at):
USER     """Write the logger's own sent_at/received_at into every call of a harness log, as tools/edi/or_call.py
USER     does. Without them every call is a hand time (T7b), and a job the tools built has none."""
USER     text = path.read_text(encoding="utf-8")
USER     try:
USER         doc = json.loads(text)
USER         items, array = (doc, True) if isinstance(doc, list) else ([doc], False)
USER     except ValueError:
USER         items, array = [json.loads(ln) for ln in text.splitlines() if ln.strip()], False
USER     for c in items:
USER         if isinstance(c, dict):
USER             c["sent_at"] = c["received_at"] = at
USER     path.write_text((json.dumps(items, indent=2) + "\n") if array
USER                     else "".join(json.dumps(c) + "\n" for c in items), encoding="utf-8")
