USER def _server_instant(e):
USER     """The instant a call's own response carried: its `created` epoch, else its Date header. Same precedence as
USER     kit/custody_history.py (Call.at: received_at, then created, then the header), so stamping the logger's times
USER     onto the value the reader already derived moves nothing in the fixture's timeline."""
USER     created = (e.get("response") or {}).get("created")
USER     if isinstance(created, (int, float)) and not isinstance(created, bool):
USER         return datetime.fromtimestamp(created, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
USER     hdrs = e.get("response_headers") or e.get("headers") or (e.get("response") or {}).get("headers") or {}
USER     date = hdrs.get("Date") or hdrs.get("date")
USER     if isinstance(date, str) and date:
USER         try:
USER             parsed = parsedate_to_datetime(date)
USER         except (TypeError, ValueError):
USER             return None
USER         if parsed.tzinfo is None:
USER             parsed = parsed.replace(tzinfo=timezone.utc)
USER         return parsed.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
USER     return None
USER 
