 dirs_exist_ok=True)                                                            
     return d                                                                   
                                                                                
                                                                                
 def emitted_copy(name, overlay=None):                                          
     """A throwaway copy of the committed job-emitted fixture.                  
                                                                                
     job-emitted's harness logs carry the logger's own sent_at/received_at on   
 EVERY call, so a model evaluator's                                             
     check times have a logged source and a record can be written. The          
 emit-path cases run here; the checks that                                      
     must REFUSE an unstamped call stay on job_copy() (job-rejected). No        
 stamping happens at run time: the two                                          
     committed directories make the stamped-vs-raw difference visible in `ls`   
 and in git diff.                                                               
     """                                                                        
     d = TMP / name                                                             
     shutil.copytree(FIX_EMITTED, d)                                            
     if overlay:                                                                
         shutil.copytree(FIX.parent / "failures" / overlay, d,                  
 dirs_exist_ok=True)                                                            
     return d                                                                   
                                                                                

