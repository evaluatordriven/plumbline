 def _server_instant(e):                                                        
     """The instant a call's own response carried: its `created` epoch, else    
 its Date header. Same precedence as                                            
     kit/custody_history.py (Call.at: received_at, then created, then the       
 header), so stamping the logger's times                                        
     onto the value the reader already derived moves nothing in the fixture's   
 timeline."""                                                                   
     created = (e.get("response") or {}).get("created")                         
     if isinstance(created, (int, float)) and not isinstance(created, bool):    
         return datetime.fromtimestamp(created,                                 
 timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")                                   
     hdrs = e.get("response_headers") or e.get("headers") or (e.get("response") 
 or {}).get("headers") or {}                                                    
     date = hdrs.get("Date") or hdrs.get("date")                                
     if isinstance(date, str) and date:                                         
         try:                                                                   
             parsed = parsedate_to_datetime(date)                               
         except (TypeError, ValueError):                                        
             return None                                                        
         if parsed.tzinfo is None:                                              
             parsed = parsed.replace(tzinfo=timezone.utc)                       
         return parsed.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")  
     return None                                                                
                                                                                
                                                                                
 def _stamp_logger_times(path):                                                 
     """WRITE the logger's own sent_at/received_at into every call of ONE COPY  
 of a harness log that carries                                                  
     neither, preserving the file's format (JSON list, single object, or        
 JSONL).                                                                        
                                                                                
     This function WRITES. It is never called on the fixture itself (FIX), only 
 on a copy made by                                                              
     logger_stamped(): the cases that exist to test what the emitter does with  
 a call the logger did NOT stamp                                                
     (E2, T7b/E3, the 59-second tolerance) must keep an unstamped log, so they  
 run on FIX or on job_copy_raw().                                               
     A call that already carries both times is left exactly as it is.           
     """                                                                        
     text = path.read_text(encoding="utf-8")                                    
     try:                                                                       
         doc = json.loads(text)                                                 
     except ValueError:                                                         
         doc = None                                                             
     array, single = isinstance(doc, list), isinstance(doc, dict)               
     items = doc if array else ([doc] if single else [json.loads(ln) for ln in  
 text.splitlines() if ln.strip()])                                              
     for e in items:                                                            
         if isinstance(e, dict) and not e.get("sent_at") and not                
 e.get("received_at"):                                                          
             at = _server_instant(e)                                            
             if at:                                                             
                 e["sent_at"] = e["received_at"] = at                           
     if array:                                                                  
         path.write_text(json.dumps(items, indent=2) + "\n", encoding="utf-8")  
     elif single:                                                               
         path.write_text(json.dumps(items[0], indent=2) + "\n",                 
 encoding="utf-8")                                                              
     else:                                                                      
         path.write_text("".join(json.dumps(e) + "\n" for e in items),          
 encoding="utf-8")                                                              
                                                                                
                                                                                
 def logger_stamped(name):                                                      
     """A copy of the job-rejected fixture whose harness logs carry the         
 logger's own sent_at and received_at on                                        
     every call -- the entry shape the frozen bar asserts                       
 (tests/test_evaluator_harness_log.py D1-D3: sent_at,                           
     received_at, request.url, response.model). The fixture's logs carry server 
 times only, so a MODEL evaluator's                                             
     check times have no logged source and the emitter REFUSES the record       
 (D6/D7); every case that needs a WRITTEN                                       
     record runs on a copy built here."""                                       
     d = TMP / name                                                             
     shutil.copytree(FIX, d)                                                    
     for lg in sorted((d / "custody" / "evidence").glob("harness-*.log")):      
         _stamp_logger_times(lg)                                                
     return d                                                                   
                                                                                
                                                                                
 LOGGED = logger_stamped("fixture-logged")                                      
                                                                                
                                                                                
 def job_copy(name, overlay=None):                                              
     """A throwaway copy of the job-rejected fixture, WITH the logger's own     
 times in its harness logs (LOGGED):                                            
     a record can only be written from a log the emitter can honestly read. The 
 cases that assert a refusal                                                    
     depending on the fixture's server-times-only log drive FIX directly (T2,   
 T2b, T2d, T7b/E3), or                                                          
     job_copy_raw() when they need a copy of their own.                         
     """                                                                        
     d = TMP / name                                                             
     shutil.copytree(LOGGED, d)                                                 
     if overlay:                                                                
         shutil.copytree(FIX.parent / "failures" / overlay, d,                  
 dirs_exist_ok=True)                                                            
     return d                                                                   
                                                                                
                                                                                
 def job_copy_raw(name, overlay=None):                                          
     """A throwaway copy of the job-rejected fixture WITHOUT stamping its       
 harness logs.                                                                  
                                                                                
     For the cases that exist to test an UNSTAMPED call: T7b/E3 naming every    
 call the logger did not stamp, and                                             
     the hand-time tolerance refusals. Handing one of those a job_copy()        
 (stamped) would delete the condition                                           
     under test, so they take this copy. A case that needs unstamped calls      
 cannot silently drift here.                                                    
     """                                                                        
     d = TMP / name                                                             
     shutil.copytree(FIX, d)                                                    
     if overlay:                                                                
         shutil.copytree(FIX.parent / "failures" / overlay, d,                  
 dirs_exist_ok=True)                                                            
     return d                                                                   
                                                                                
                                                                                
 def job_copy_logged(name, overlay=None):                                       
     """A throwaway copy whose harness logs carry the logger's own              
 sent_at/received_at on EVERY call, for the                                     
     cases that must EMIT a record while still exercising a hand time or the    
 tolerance window. E3/T7b does not use                                          
     this: naming the calls the logger did not stamp is the whole of that       
 check, so it stays on job_copy_raw().                                          
     """                                                                        
     d = TMP / name                                                             
     shutil.copytree(FIX, d)                                                    
     for lg in sorted((d / "custody" / "evidence").glob("harness-*.log")):      
         _stamp_logger_times(lg)                                                
     if overlay:                                                                
         shutil.copytree(FIX.parent / "failures" / overlay, d,                  
 dirs_exist_ok=True)                                                            
     return d                                                                   
                                                                                

