 def job_copy(name, overlay=None):                                              
     """A throwaway copy of the committed job-rejected fixture.                 
                                                                                
     The refusal cases (T2, T2b, T2d, T7b/E3, the plain refusal cases) run on   
 this copy: the fixture's harness                                               
     logs carry server times only, which is the condition those checks exist to 
 measure. A copy is needed because                                              
     the cases mutate packet.json / custody.json / the ledger.                  
     """                                                                        
     d = TMP / name                                                             
     shutil.copytree(FIX, d)                                                    
     if overlay:                                                                
         shutil.copytree(FIX.parent / "failures" / overlay, d,                  
 dirs_exist_ok=True)                                                            
     return d                                                                   
                                                                                
                                                                                
 def emitted_copy(name, overlay=None):                                          
     """A throwaway copy of the committed job-emitted fixture.                  
                                                                                
     job-emitted's harness logs carry the logger's own sent_at/received_at on   
 every call (D6/D7), so a model                                                 
     evaluator's check times have a logged source and a record can be written.  
 The emit-path cases run here; the                                              
     checks that must REFUSE stay on job_copy() (job-rejected). No stamping     
 happens at run time: the two fixture                                           
     directories make the stamped-vs-raw difference visible in `ls` and git     
 diff.                                                                          
     """                                                                        
     d = TMP / name                                                             
     shutil.copytree(FIX_EMITTED, d)                                            
     if overlay:                                                                
         shutil.copytree(FIX.parent / "failures" / overlay, d,                  
 dirs_exist_ok=True)                                                            
     return d                                                                   
                                                                                

