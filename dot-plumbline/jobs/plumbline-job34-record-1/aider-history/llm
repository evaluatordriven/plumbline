USER def find_log(job: Path, ev_dir: Path, rel: str | None, pattern: str | None) -> Path | None:
USER     if rel:
USER         for base in (ev_dir, job):
USER             if (base / rel).is_file():
USER                 return base / rel
USER         return None
USER     hits = sorted(ev_dir.glob(pattern)) if pattern and ev_dir.is_dir() else []
USER     return hits[0] if len(hits) == 1 else None
USER 
