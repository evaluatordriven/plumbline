USER def selftest_rules_seen(text: str) -> dict:
USER     """The rule names a selftest's `[PASS]`/`[FAIL]` lines report, mapped to their verdict line.
USER 
USER     The selftest prints one line per rule: `  [PASS] selftest <rule>: N violation(s), expected M`.
USER     This reads the rules OUT OF THE OUTPUT, so a rule that was deleted shows up as absent rather
USER     than as an assumption this bar makes.
USER     """
USER     seen = {}
USER     for line in text.splitlines():
USER         hit = re.search(r"\[(PASS|FAIL)\]\s+selftest\s+(.+?):\s*(\d+)\s+violation\(s\),\s*expected\s+(\d+)",
USER                         line)
USER         if hit:
USER             seen[hit.group(2).strip()] = {"verdict": hit.group(1), "got": hit.group(3),
USER                                           "expected": hit.group(4), "line": line.strip()}
USER     return seen
