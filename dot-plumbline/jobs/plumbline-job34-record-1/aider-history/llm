USER def endpoint_of(c: Call, ref: Refusals, who: str, pin: dict | None = None) -> tuple[str | None, dict]:
USER     """The host that answered this call, and how that was read. `pin`: the seat's declared provider pin."""
USER     if not c.host:
USER         ref.add("endpoint", f"{who}: {c.label} names no request URL, so the service that answered is unknown")
USER         return None, {}
USER     if c.host not in AGGREGATORS:
USER         if pin:
USER             ref.add("endpoint", f"{who}: {c.label} went to {c.host}, but this seat's provider pin says its calls go "
USER                                 f"via {pin.get('via')} to {pin.get('provider')!r}; the log contradicts the pin")
USER             return None, {}
USER         return c.host, {"endpoint_basis": "request URL host", "request_host": c.host}
USER     route = {"aggregator": c.host, "upstream_provider": c.provider}
USER     if not pin:
USER         ref.add("endpoint", f"{who}: {c.label} went to the aggregator {c.host} and no provider pin was declared for "
USER                             f"this seat (custody_ledger.py pin, before its first call); the emitter will not guess "
USER                             f"which host answered (custody SPEC 4: a router is not the service that answered)")
USER         return None, route
USER     if not c.served:
USER         ref.add("endpoint", f"{who}: {c.label} went to {c.host} and the log does not say which provider served it "
USER                             f"(no response `provider`, no `openrouter_metadata`, no logged /api/v1/generation "
USER                             f"stats); the pin to {pin.get('provider')!r} cannot be confirmed and the emitter will "
USER                             f"not guess")
USER         return None, route
USER     if not c.has_generation:
USER         ref.add("endpoint", f"{who}: {c.label} went to {c.host} but the log carries no /api/v1/generation reply, so "
USER                             f"the provider that answered is not evidenced (custody CL1-15); the emitter will not "
USER                             f"derive the endpoint from the provider pin or routing config")
USER         return None, route
USER     if not c.generation_names_provider:
USER         ref.add("endpoint", f"{who}: {c.label} went to {c.host} but its /api/v1/generation reply names no provider, "
USER                             f"so which provider answered is not evidenced (custody CL1-15 absent for this pass); "
USER                             f"the emitter will not derive the endpoint from the provider pin or routing config")
USER         return None, route
USER     other = {src: n for src, n in c.served.items() if not pin_matches(n, pin)}
USER     if other:
USER         said = ", ".join(f"{n!r} ({src})" for src, n in other.items())
USER         ref.add("endpoint", f"{who}: {c.label} was served by {said}, not the pinned provider {pin.get('provider')!r} "
USER                             f"({pin.get('slug')}): a fallback to another provider; the record would name "
USER                             f"{pin.get('host')} for a call it did not answer")
USER         return None, route
USER     tried = sorted({n for ns in c.tried.values() for n in ns if not pin_matches(n, pin)})
USER     if tried:
USER         ref.add("endpoint", f"{who}: {c.label} was also sent to {', '.join(map(repr, tried))} "
USER                             f"({', '.join(c.tried)}), not only the pinned provider {pin.get('provider')!r}: a fallback "
USER                             f"was attempted, so the prompt reached a provider the pin excludes")
USER         return None, route
USER     route.update({"provider_slug": pin.get("slug"),
USER                   "endpoint_basis": f"declared pin ({pin.get('declaredAt')}) to {pin.get('provider')!r} at "
USER                                     f"{pin.get('host')}, served-by confirmed from {', '.join(sorted(c.gen_served))}"})
USER     return pin.get("host"), route
USER 
USER 
USER def routing_problems(r: dict | None, pin: dict) -> list[str]:
USER     """What a pinned, ZDR routing request lacks. Empty = it asked for exactly the pin, no fallbacks, ZDR/deny."""
USER     if r is None:
USER         return ["the log does not carry the request body, so the routing request cannot be read"]
USER     out = []
USER     show = lambda v: "absent" if v is None else repr(v)    # noqa: E731
USER     order = r.get("order")
USER     if not (isinstance(order, list) and len(order) == 1):
USER         out.append(f"provider.order is {show(order)}, not exactly one provider")
USER     elif str(order[0]).lower() != str(pin.get("slug") or "").lower():
USER         out.append(f"provider.order names {order[0]!r}, not the pinned slug {pin.get('slug')!r}")
USER     if r.get("allow_fallbacks") is not False:
USER         out.append(f"provider.allow_fallbacks is {show(r.get('allow_fallbacks'))}, not false (OpenRouter's default is "
USER                    f"true: other providers may serve)")
USER     if r.get("zdr") is not True and r.get("data_collection") != "deny":
USER         out.append(f"neither provider.zdr true nor provider.data_collection \"deny\" (zdr {show(r.get('zdr'))}, "
USER                    f"data_collection {show(r.get('data_collection'))})")
USER     if isinstance(r.get("models"), list) and len(r["models"]) > 1:
USER         out.append(f"models lists {len(r['models'])} models: a model fallback was allowed")
USER     return out
USER 
