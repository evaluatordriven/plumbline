USER     def emit(self, job: Path, out: Path, *extra: str):
USER         cmd = [PY, EMITTER_REL, "--job-dir", str(job), "--out", str(out), "--allow-hand-times", *extra]
USER         proc = subprocess.run(cmd, cwd=str(self.tree), capture_output=True, text=True)
USER         record = None
USER         if out.is_file():
USER             try:
USER                 record = json.loads(out.read_text(encoding="utf-8"))
USER             except ValueError:
USER                 record = None
USER         return proc.returncode, (proc.stdout or "") + (proc.stderr or ""), record
