USER         approvals.append({"role": a.get("role"), "by": a.get("by"),
USER                           "barDigest": hexdigest(a.get("barDigest"), f"bar.approvals[{i}].barDigest", gaps),
USER                           "at": ts(a.get("at"), f"bar.approvals[{i}].at", gaps), "adopted": a.get("adopted"),
USER                           "x-plumbline": xa})
USER     if not approvals:
