USER def round_records(job: Path) -> list[tuple[int, Path, dict]]:
USER     """The round records loop() wrote, in round order: (number, path, record)."""
USER     out = []
USER     for path in job.glob("round-*.json"):
USER         m = re.fullmatch(r"round-(\d+)\.json", path.name)
USER         if not m:
USER             continue
USER         try:
USER             body = load(path)
USER         except Exception:
USER             continue
USER         if isinstance(body, dict):
USER             out.append((int(m.group(1)), path, body))
USER     out.sort(key=lambda row: row[0])
USER     return out
USER 
