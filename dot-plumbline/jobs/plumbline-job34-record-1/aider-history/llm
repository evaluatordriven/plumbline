USER def revision(here: Path, job: Path, expect: str | None, ref: Refusals) -> dict:
USER     """The emitter's own commit and tree, refused when dirty or not the stated revision."""
USER     try:
USER         top = Path(git(["rev-parse", "--show-toplevel"], here).strip())
USER         commit = git(["rev-parse", "HEAD"], top).strip()
USER         tree = git(["rev-parse", "HEAD^{tree}"], top).strip()
USER         status = git(["status", "--porcelain=v1", "-z", "--untracked-files=all"], top)
USER     except (OSError, subprocess.CalledProcessError) as exc:
USER         ref.add("revision", f"the emitter is not running from a readable git checkout ({str(exc).strip()[:120]}); "
USER                             f"its revision cannot be recorded, so no record is written")
USER         return {}
USER     try:
USER         job_rel = job.resolve().relative_to(top.resolve()).as_posix()
USER     except ValueError:
USER         job_rel = None
USER     dirty = []
USER     for ent in status.split("\0"):
USER         if len(ent) < 4:
USER             continue
USER         p = ent[3:]
USER         if p.startswith("dot-plumbline/") or (job_rel and (p == job_rel or p.startswith(job_rel + "/"))):
USER             continue                                  # job state, not the emitter's code
USER         if "__pycache__/" in p or p.endswith(".pyc"):
USER             continue                                  # a bytecode cache is not a change to the code
USER         dirty.append(ent[:2].strip() + " " + p)
USER     if dirty:
