USER     def document(self, name: str, body: str = DOC_BODY, commit: bool = True) -> Path:
USER         """A custody checkout: `SPEC.md`, and (when committed) a git work tree at its own HEAD."""
USER         d = self.root / name
USER         d.mkdir(parents=True, exist_ok=True)
USER         (d / "SPEC.md").write_text(body, encoding="utf-8")
USER         if commit:
USER             _commit_tree(d, "bar: a custody checkout")
USER         return d
