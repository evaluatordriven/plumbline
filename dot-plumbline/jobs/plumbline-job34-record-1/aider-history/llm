USER     def __init__(self):
USER         self.root = Path(tempfile.mkdtemp(prefix="plumbline-emit-spec-"))
USER         self.tree = self.root / "tree"
USER         shutil.copytree(REPO, self.tree,
USER                         ignore=shutil.ignore_patterns(".git", "__pycache__", "*.pyc"))
USER         _commit_tree(self.tree, "bar: the committed tree, one commit")
USER 
USER     def clean_after_commit(self) -> str:
USER         return _porcelain(self.tree)
USER 
USER     def job(self, rel: str, name: str) -> Path:
USER         src = REPO / rel
USER         if not src.is_dir():
USER             die(f"the job {rel} is not in the tree the bar was run from: {src}")
USER         dst = self.root / name
USER         shutil.copytree(src, dst)
USER         return dst
