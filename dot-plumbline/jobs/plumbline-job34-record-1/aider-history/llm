USER def _instant_text(value) -> str | None:
USER     """The instant `value` names, spelled as the custody schema's timestamp (UTC, ...Z)."""
USER     if not isinstance(value, str) or not value.strip():
USER         return None
USER     text = value.strip()
USER     if text.endswith("Z"):
USER         text = text[:-1] + "+00:00"
USER     try:
USER         parsed = datetime.fromisoformat(text)
USER     except ValueError:
USER         return None
USER     if parsed.tzinfo is None:
USER         return None
USER     return H.iso(parsed.astimezone(timezone.utc))
USER 
USER 
USER def _editable_files(job: Path, number: int | None = None) -> list[tuple[str, Path]]:
USER     """Every file under round-NN/editable/, as (job-relative path, path)."""
USER     if number is not None:
USER         bases = [job / ("round-%02d" % number) / "editable"]
USER     else:
USER         bases = sorted(path / "editable" for path in job.glob("round-*") if path.is_dir())
USER     found = []
USER     for base in bases:
USER         if not base.is_dir():
USER             continue
USER         for path in sorted(base.rglob("*")):
USER             if path.is_file():
USER                 found.append((path.relative_to(job).as_posix(), path))
USER     found.sort(key=lambda row: row[0])
USER     return found
USER 
