USER def plant_emitter_disagreement(src_tree: Path, dst: Path, version: str = PLANTED_EMITTER_VERSION) -> Path:
USER     """A committed copy of `src_tree` whose emitter stamps `version` instead of whatever it holds.
USER 
USER     The literal at the emitter's stamp site is replaced with another WELL-FORMED version, and nothing
USER     else is touched: `tools/check_version_claims.py` is left exactly as it is, so its claim still
USER     matches, still publishes, and now disagrees with the pin. That is the DEFANGED claim — the shape
USER     a hurried fix takes — as opposed to the vanished claim a dropped literal produces.
USER 
USER     The file is rewritten and the copy re-committed, so a fix that refuses to run on a dirty tree
USER     (custody_history.py:515-518) still reaches its assertion here.
USER     """
USER     if dst.exists():
USER         die(f"the disagreement copy already exists at {dst}; the bar does not overwrite it")
USER     shutil.copytree(src_tree, dst, ignore=shutil.ignore_patterns(".git", "__pycache__", "*.pyc"))
USER     emitter = dst / EMITTER_REL
USER     text = emitter.read_text(encoding="utf-8")
USER     hit = re.search(_LITERAL_RE, text, re.M)
USER     if hit is None:
USER         die(f"{EMITTER_REL} in the copy declares no `SPEC_VERSION = \"x.y.z\"` literal to plant "
USER             f"against, so this case cannot construct the disagreement it grades")
USER     emitter.write_text(text[:hit.start()] + hit.group(1) + version + hit.group(3) + text[hit.end():],
USER                        encoding="utf-8")
USER     _commit_tree(dst, f"bar: a planted disagreement, emitter stamps {version}")
USER     return dst
USER 
