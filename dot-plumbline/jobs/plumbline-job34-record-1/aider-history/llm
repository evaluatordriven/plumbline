USER def resolve_spec_version(job: Path, ci: dict | None, override: str | None,
USER                          ref: H.Refusals) -> tuple[str | None, dict]:
USER     """The version this record attests: the custody document the job names, else --spec-version, else a refusal.
USER 
USER     R1: `inputs/custody.json: custody_spec` points at a custody checkout; the record carries the version its
USER     SPEC.md declares, digested, with the line that declares it. R3: `--spec-version` is the fallback for a job
USER     whose artifact is not a custody tree. R2: with neither, or with a document that cannot be read, the emitter
USER     REFUSES (kind `spec-version`) rather than fall back to the flag or to a literal. Both are given and they
USER     disagree: refused, because a record can attest only one version.
USER     """
USER     given = (ci or {}).get("custody_spec")
USER     doc_version, block = None, {}
USER     if given:
USER         checkout = Path(str(given)).expanduser()
USER         if not checkout.is_absolute():
USER             checkout = job / checkout
USER         spec_md = checkout / "SPEC.md"
USER         if not checkout.is_dir():
USER             ref.add("spec-version", f"inputs/custody.json custody_spec {str(given)!r} is not a directory "
USER                                     f"({checkout}): the document the job attests cannot be read")
USER         elif not spec_md.is_file():
USER             ref.add("spec-version", f"the custody checkout {checkout} carries no SPEC.md: the version the job "
USER                                     f"attests cannot be read")
USER         else:
USER             doc_version, line = spec_md_version(spec_md)
USER             block = {"origin": "document", "path": str(checkout),
USER                      "source": f"{spec_md}:{line}" if line else str(spec_md),
USER                      "sha256": file_digest(spec_md)}
USER             if doc_version is None:
USER                 ref.add("spec-version", f"{spec_md} declares no `**Version X.Y.Z**`: the version the job attests "
USER                                         f"cannot be read")
USER             else:
USER                 checkout_head(checkout, ref)
USER     if given and doc_version is None:
USER         return None, block                     # a named document that cannot be read never falls back (R2)
USER     if override:
USER         version = str(override).strip()
USER         if not VERSION_RE.match(version):
USER             ref.add("spec-version", f"--spec-version {override!r} is not an X.Y.Z version")
USER             return None, block
USER         if doc_version is not None:
USER             if version != doc_version:
USER                 ref.add("spec-version", f"--spec-version {version!r} disagrees with the document "
USER                                         f"{block.get('path')}/SPEC.md, which declares {doc_version!r}: the record "
USER                                         f"can attest only one version, and the emitter will not choose silently")
USER                 return None, block
USER             return doc_version, block
USER         return version, {"origin": "--spec-version", "path": None,
USER                          "source": "--spec-version", "sha256": None}
USER     if doc_version is not None:
USER         return doc_version, block
USER     ref.add("spec-version", "the job names no custody document (inputs/custody.json: custody_spec) and no "
USER                             "--spec-version was given: predicate.specVersion would have no source, and the "
USER                             "emitter refuses rather than guess")
USER     return None, {}
USER 
