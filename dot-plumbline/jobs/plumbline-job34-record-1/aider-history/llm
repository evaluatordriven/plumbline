USER class Call:
USER     def __init__(self, log: str, i: int, raw: dict, lines: list[str] | None = None):
USER         self.log, self.i, self.raw = log, i, raw
USER         self.lines = lines or []
USER         req, resp = raw.get("request") or {}, raw.get("response") or {}
USER         hdrs = raw.get("response_headers") or raw.get("headers") or {}
USER         self.name = raw.get("call") or raw.get("name")
USER         self.url = req.get("url") or raw.get("url")
USER         self.host = (urlparse(self.url).hostname or "").lower() if self.url else None
USER         self.model = resp.get("model") or req.get("model")
USER         self.served, self.tried = served_by(raw)
USER         self.gen_served, self.gen_tried = generation_names(raw)
USER         self.generation_names_provider = bool(self.gen_served)
USER         self.provider = next(iter(self.served.values()), None)
USER         self.routing = routing_request(raw)
USER         self.sent = parse_ts(raw.get("sent_at"))
USER         self.received = parse_ts(raw.get("received_at"))
USER         self.has_generation = isinstance(raw.get("generation"), dict)
USER         d = _hdr(hdrs, "Date")
USER         try:
USER             self.date = parsedate_to_datetime(d).astimezone(timezone.utc) if d else None
USER         except (TypeError, ValueError):
USER             self.date = None
USER         c = resp.get("created")
USER         self.created = datetime.fromtimestamp(c, timezone.utc) if isinstance(c, (int, float)) else None
USER         self.at = self.received or self.date or self.created
USER         self.started = self.sent or self.created or self.date
USER         if self.received:
USER             self.at_basis = "received_at"
USER         elif self.date:
USER             self.at_basis = "response Date header"
USER         elif self.created:
USER             self.at_basis = "response created"
USER         else:
USER             self.at_basis = None
USER 
USER     @property
USER     def label(self) -> str:
USER         return f"{self.log}#{self.name or self.i}"
USER 
USER     def _line_of(self, value, key: str | None = None) -> int | None:
USER         """The 1-based line of this call's log that carries `value` (optionally under `"key":`)."""
USER         if value in (None, ""):
USER             return None
USER         vs = str(value)
USER         pat = f'"{key}"' if key else None
USER         hits = [n for n, ln in enumerate(self.lines, 1) if vs in ln and (pat is None or pat in ln)]
USER         if not hits:
USER             hits = [n for n, ln in enumerate(self.lines, 1) if vs in ln]
USER         if not hits:
USER             return None
USER         return hits[min(self.i, len(hits) - 1)]
USER 
USER     def source_of(self, key: str) -> str | None:
USER         n = self._line_of(self.raw.get(key), key)
USER         return f"{self.log}:{n}" if n else None
USER 
USER     def source_started(self) -> str | None:
USER         if self.sent:
USER             return self.source_of("sent_at")
USER         n = self._line_of((self.raw.get("response") or {}).get("created"), "created")
USER         if n:
USER             return f"{self.log}:{n}"
USER         n = self._line_of(_hdr(self.raw.get("response_headers") or self.raw.get("headers") or {}, "Date"), "Date")
USER         return f"{self.log}:{n}" if n else None
USER 
USER     def source_at(self) -> str | None:
USER         if self.received:
USER             return self.source_of("received_at")
USER         n = self._line_of(_hdr(self.raw.get("response_headers") or self.raw.get("headers") or {}, "Date"), "Date")
USER         if n:
USER             return f"{self.log}:{n}"
USER         n = self._line_of((self.raw.get("response") or {}).get("created"), "created")
USER         return f"{self.log}:{n}" if n else None
USER 
USER     def hand_time_entries(self) -> list[dict]:
USER         """Entries for `x-plumbline.hand_times[]` when the logger did not stamp sent_at/received_at.
USER 
USER         The time used is the response `Date` header (`server-header`) or the response `created` epoch
USER         (`response-created`), exactly as `Call.started` / `Call.at` read them. The emitter must not write
USER         these back to the log (T7)."""
USER         out = []
USER         resp = self.raw.get("response") if isinstance(self.raw.get("response"), dict) else {}
USER         hdrs = self.raw.get("response_headers") or self.raw.get("headers") or {}
USER         base = f"{self.log}#{self.name or self.i}"
USER         if self.sent is None:
USER             if self.created:
USER                 n = self._line_of(resp.get("created"), "created")
USER                 out.append({"field": f"{base}.sent_at", "file": self.log, "line": n,
USER                             "source": "response-created"})
USER             elif self.date:
USER                 n = self._line_of(_hdr(hdrs, "Date"), "Date")
USER                 out.append({"field": f"{base}.sent_at", "file": self.log, "line": n,
USER                             "source": "server-header"})
USER         if self.received is None:
USER             if self.date:
USER                 n = self._line_of(_hdr(hdrs, "Date"), "Date")
USER                 out.append({"field": f"{base}.received_at", "file": self.log, "line": n,
USER                             "source": "server-header"})
USER             elif self.created:
USER                 n = self._line_of(resp.get("created"), "created")
USER                 out.append({"field": f"{base}.received_at", "file": self.log, "line": n,
USER                             "source": "response-created"})
USER         return out
USER 
