USER def read_log(path: Path, ref: Refusals | None = None, who: str = "log") -> list[Call]:
USER     """A harness log: one JSON object per call, a JSON list of them, or JSON Lines.
USER 
USER     `path` may be a `str` or a `Path` (a caller that hands over the string from a job's inputs works, P1).
USER     `ref` and `who` are optional so a reader that only wants the calls can call `read_log(path)`:
USER     refusals then go to a throwaway Refusals(). Every caller that passes its own Refusals keeps working
USER     unchanged."""
USER     path = Path(path)
USER     if ref is None:
USER         ref = Refusals()
USER     try:
USER         text = path.read_text(encoding="utf-8")
USER     except OSError as exc:
USER         ref.add("harness-log", f"{who}: harness log {path.name} unreadable ({exc})"); return []
USER     lines = text.splitlines()
USER     try:
USER         doc = json.loads(text)
USER         items = doc if isinstance(doc, list) else [doc]
USER     except ValueError:
USER         try:
USER             items = [json.loads(ln) for ln in text.splitlines() if ln.strip()]
USER         except ValueError:
USER             ref.add("harness-log", f"{who}: {path.name} is not a JSON harness log (request/response/response_headers "
USER                                    f"per call), so no time or endpoint can be read from it")
USER             return []
USER     calls = [Call(path.name, i, it, lines) for i, it in enumerate(items) if isinstance(it, dict) and "request" in it]
USER     if not calls:
USER         ref.add("harness-log", f"{who}: {path.name} records no call (no object with a `request`)")
USER     for c in calls:
USER         if c.at is None:
USER             ref.add("time", f"{who}: {c.label} carries neither a response Date header nor a `created` time; "
USER                             f"its time cannot be read from the log")
USER         elif c.created and c.date and (c.created - c.date).total_seconds() > TOLERANCE_S:
USER             ref.add("time", f"{who}: {c.label} says it was created at {iso(c.created)}, after its own response "
USER                             f"Date {iso(c.date)}: the log contradicts itself")
USER     return calls
USER 
USER 
