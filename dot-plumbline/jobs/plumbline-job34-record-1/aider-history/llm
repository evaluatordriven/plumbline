USER def emitter_claim_verdict(listed) -> tuple[bool, str]:
USER     """(does the emitter's claim agree with the pin?, a sentence naming the values).
USER 
USER     Read PURELY from the tool's own claim list — no assumption about the spelling of the label beyond
USER     the file it names, and no assumption that there is exactly one such claim. A claim that is absent
USER     and a claim that is present-but-disagreeing are DIFFERENT failures, and the sentence says which.
USER     """
USER     pin = json.loads((REPO / "tools" / "pin.json").read_text(encoding="utf-8"))
USER     pinned = str(pin.get("custody", {}).get("specVersion", ""))
USER     rows = [row for row in (listed or []) if EMITTER_HINT in str(row[0])]
USER     if not rows:
USER         return False, (f"no claim about {EMITTER_REL} is published at all (the claim VANISHED); "
USER                        f"claims seen: {[str(r[0]) for r in (listed or [])]}")
USER     bad = [(str(r[0]), str(r[1]), str(r[2])) for r in rows if str(r[1]) != str(r[2])]
USER     if bad:
USER         detail = "; ".join(f"{label} claims {claimed!r} while the pin holds {actual!r}"
USER                            for label, claimed, actual in bad)
USER         return False, f"the claim about {EMITTER_REL} LIES: {detail}"
USER     named = [str(r[1]) for r in rows]
USER     if ("v" + pinned) not in named:
USER         return False, (f"the claim(s) about {EMITTER_REL} agree with something, but none names the pin's "
USER                        f"custody specVersion v{pinned}: they name {named}")
USER     return True, f"the claim about {EMITTER_REL} publishes and agrees with the pin (v{pinned})"
USER 
