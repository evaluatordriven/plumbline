USER     def __init__(self):
USER         self.root = Path(tempfile.mkdtemp(prefix="plumbline-emit-spec-"))
USER         self.tree = self.root / "tree"
USER         shutil.copytree(REPO, self.tree,
USER                         ignore=shutil.ignore_patterns(".git", "__pycache__", "*.pyc"))
USER         _commit_tree(self.tree, "bar: the committed tree, one commit")
USER 
USER     def clean_after_commit(self) -> str:
USER         return _porcelain(self.tree)
USER 
USER     def job(self, rel: str, name: str) -> Path:
USER         src = REPO / rel
USER         if not src.is_dir():
USER             die(f"the job {rel} is not in the tree the bar was run from: {src}")
USER         dst = self.root / name
USER         shutil.copytree(src, dst)
USER         return dst
USER 
USER     def document(self, name: str, body: str = DOC_BODY, commit: bool = True) -> Path:
USER         """A custody checkout: `SPEC.md`, and (when committed) a git work tree at its own HEAD."""
USER         d = self.root / name
USER         d.mkdir(parents=True, exist_ok=True)
USER         (d / "SPEC.md").write_text(body, encoding="utf-8")
USER         if commit:
USER             _commit_tree(d, "bar: a custody checkout")
USER         return d
USER 
USER     def emit(self, job: Path, out: Path, *extra: str):
USER         cmd = [PY, EMITTER_REL, "--job-dir", str(job), "--out", str(out), "--allow-hand-times", *extra]
USER         proc = subprocess.run(cmd, cwd=str(self.tree), capture_output=True, text=True)
USER         record = None
USER         if out.is_file():
USER             try:
USER                 record = json.loads(out.read_text(encoding="utf-8"))
USER             except ValueError:
USER                 record = None
USER         return proc.returncode, (proc.stdout or "") + (proc.stderr or ""), record
USER 
USER     def close(self):
USER         shutil.rmtree(self.root, ignore_errors=True)
