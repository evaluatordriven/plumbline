USER def pin_matches(name, pin: dict) -> bool:
USER     """A provider name from the log is the pinned provider: its display name, or its slug's provider part."""
USER     n = norm(name)
USER     return bool(n) and n in {norm(pin.get("provider")), norm(str(pin.get("slug") or "").split("/")[0])}
USER 
