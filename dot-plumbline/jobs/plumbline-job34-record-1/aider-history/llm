USER def cross_check(ref: Refusals, field: str, hand, derived: datetime | None, source: str) -> None:
USER     """A hand-entered time is a claim; the log is the evidence. Beyond TOLERANCE_S, refuse."""
USER     if hand in (None, "") or derived is None:
USER         return
USER     h = parse_ts(hand)
USER     if h is None:
USER         ref.add("time", f"{field}: hand-entered {hand!r} is not RFC 3339 UTC (...Z)"); return
USER     delta = (h - derived).total_seconds()
USER     if abs(delta) > TOLERANCE_S:
USER         ref.add("time", f"{field}: hand-entered {hand} but {source} puts it at {iso(derived)} "
USER                         f"({delta:+.0f} s; tolerance ±{TOLERANCE_S} s)")
USER 
USER 
USER def _norm(s) -> str:
USER     return re.sub(r"[^a-z0-9]+", " ", str(s or "").lower()).strip()
