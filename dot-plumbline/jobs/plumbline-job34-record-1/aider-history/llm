USER     for name in vendored:
USER         ref = name.split("@", 1)[1]
USER         out.append(("vendored corpus directory", ref, doctrine[:len(ref)]))
USER 
USER     # 2. Every `e-di@<hex>` in the README must be a prefix of the pinned doctrine commit.
USER     for ref in sorted(set(re.findall(r"e-di@([0-9a-f]{7,40})", readme))):
USER         out.append(("README e-di@ reference", ref, doctrine[:len(ref)]))
USER 
USER     # 3. The README's custody commit (the quickstart's `git -C custody checkout <sha>`) is the pin.
USER     for ref in sorted(set(re.findall(r"custody checkout ([0-9a-f]{7,40})", readme))):
USER         out.append(("README custody checkout", ref, custody[:len(ref)]))
