USER     disposition = {"state": state, "by": dsp.get("by"), "at": ts(at, "disposition.at", gaps),
USER                    "acknowledgesUnobserved": list(dsp.get("acknowledgesUnobserved") or [])}
USER     if not dsp.get("by"):
