USER def build_finish(job: Path, packet: dict, gaps: Gaps, ref: H.Refusals, now: datetime,
USER                  expect: str | None, allow_hand: bool = False, ci: dict | None = None,
USER                  override: str | None = None) -> tuple[dict, Gaps, list[str]]:
USER     """A custody/v1 record for a finish loop() filed, from the files loop() wrote.
USER 
USER     loop() writes packet.json (the finish's stamps and the ratified packet's own
USER     fields) and one round-NN.json per round — each evaluator run with its
USER     `parsed` reading, the round's `reading` and pass rule — plus that round's
USER     snapshot under round-NN/editable/. Those files are the sources this record
USER     reads. A fact they do not hold — a frozen bar, an approval, a maker's name,
USER     an instrument pin, a control, a retention, a disposition — is left null and
USER     named in x-plumbline.gaps with `hard: false`: the run did not hold it, so it
USER     is not a hard gap, and nothing is invented to fill it.
USER     """
USER     xp: dict = {"job_id": packet.get("job_id") or job.name, "sources": {}}
USER     rev = H.revision(HERE, job, expect or os.environ.get("PLUMBLINE_EXPECT_REVISION") or None, ref)
USER     version, version_block = resolve_spec_version(job, ci or {}, override, ref)
USER     rounds = round_records(job)
USER     packet_path = job / "packet.json"
USER 
USER     # ---- the finish's own stamps, exactly as packet.json holds them ----
USER     started_raw = _first_stamp(packet, ("started_at", "startedAt"))
USER     ended_raw = _first_stamp(packet, ("ended_at", "endedAt", "producedAt"))
USER     started = _instant_text(started_raw)
USER     produced = _instant_text(ended_raw)
USER     if started is None:
USER         gaps.add("startedAt", "packet.json holds no start instant for this finish", False)
USER     if produced is None:
USER         gaps.add("producedAt", "packet.json holds no end instant for this finish", False)
USER     for field, raw, key in (("startedAt", started_raw, "started_at"),
USER                             ("producedAt", ended_raw, "ended_at")):
USER         if raw:
USER             n = line_in(packet_path, raw, key)
USER             if n:
USER                 xp["sources"][field] = f"packet.json:{n}"
USER 
USER     # ---- subject: the artifact files the run wrote, under round-NN/editable/ ----
USER     best = packet.get("accepted_round")
USER     if not isinstance(best, int):
USER         best = packet.get("best_round")
USER     files = _editable_files(job, best if isinstance(best, int) else None) or _editable_files(job)
USER     subject = [{"name": rel, "digest": {"sha256": file_digest(path)}} for rel, path in files]
USER     if not subject:
USER         gaps.add("subject", "the run wrote no editable artifact file to name", False)
USER 
USER     # ---- facts the run did not hold: named, not hard, nothing invented ----
USER     bar = {"digest": None, "frozenAt": None, "author": None, "dimensions": [], "approvals": [],
USER            "publishedAt": None, "groundTruth": [], "dissent": []}
USER     for field, reason in (
USER         ("bar.digest", "the run wrote no frozen bar file, and its packet names none"),
USER         ("bar.frozenAt", "the run wrote no freeze time"),
USER         ("bar.author", "the run wrote no bar author"),
USER         ("bar.dimensions", "the run wrote no bar dimension"),
USER         ("bar.approvals", "the run recorded no approval"),
USER     ):
USER         gaps.add(field, reason, False)
USER 
USER     maker = {"name": None, "kind": None, "version": None, "method": None, "model": None}
USER     for key, reason in (
USER         ("name", "the packet's maker block names no name"),
USER         ("kind", "the packet's maker block names no kind"),
USER         ("version", "the packet's maker block names no version"),
USER         ("method", "the run wrote no maker method file"),
USER     ):
USER         gaps.add("maker." + key, reason, False)
USER 
USER     instrument = {"rubric": None, "runner": None}
USER     for key, reason in (
USER         ("rubric", "the run wrote no rubric file and pinned no rubric digest"),
USER         ("runner", "the run wrote no runner file and pinned no runner digest"),
USER     ):
USER         gaps.add("instrument." + key, reason, False)
USER 
USER     # ---- evaluators: what the packet's evaluator block says the run dispatched ----
USER     evaluator = packet.get("evaluator") if isinstance(packet.get("evaluator"), dict) else {}
USER     kind = evaluator.get("kind") if evaluator.get("kind") in ("person", "model", "script") else None
USER     name = evaluator.get("name") if isinstance(evaluator.get("name"), str) and evaluator.get("name") else None
USER     ev_id = evaluator.get("id") if isinstance(evaluator.get("id"), str) and evaluator.get("id") else (name or "evaluator")
USER     if name is None:
USER         gaps.add("evaluators[0].name", "the packet's evaluator block names no name", False)
USER     if kind is None:
USER         gaps.add("evaluators[0].kind", "the packet's evaluator block names no kind", False)
USER     evaluators = [{"id": ev_id, "name": name or ev_id, "kind": kind, "model": None, "script": None}]
USER 
USER     # ---- checks: what each round's evaluator read ----
USER     def reading_of(row: dict) -> dict:
USER         return row.get("reading") if isinstance(row.get("reading"), dict) else {}
USER 
USER     def dims_of(row: dict) -> list[dict]:
USER         found = [d for d in reading_of(row).get("dimensions") or [] if isinstance(d, dict)]
USER         if found:
USER             return found
USER         out = []
USER         for run in row.get("evaluator") or []:
USER             parsed = run.get("parsed") if isinstance(run, dict) else None
USER             if isinstance(parsed, dict):
USER                 out.extend(d for d in parsed.get("dimensions") or [] if isinstance(d, dict))
USER         return out
USER 
USER     checks = []
USER     for number, path, row in rounds:
USER         at_raw = row.get("ended_at")
USER         at = _instant_text(at_raw)
USER         at_line = line_in(path, at_raw, "ended_at") if isinstance(at_raw, str) else None
USER         reading = reading_of(row)
USER         for dimension in dims_of(row):
USER             score = dimension.get("score")
USER             x = {"round": number, "record": path.name, "pass_rule": row.get("pass_rule"),
USER                  "verdict": reading.get("verdict"), "stop": row.get("stop"),
USER                  "observation": dimension.get("observation")}
USER             if at_line:
USER                 x["at_source"] = f"{path.name}:{at_line}"
USER             checks.append({
USER                 "dimension": dimension.get("name"),
USER                 "evaluator": ev_id,
USER                 "run": number,
USER                 "batch": None,
USER                 "at": at,
USER                 "outcome": None,
USER                 "score": score if isinstance(score, (int, float)) and not isinstance(score, bool) else None,
USER                 "failureCondition": None,
USER                 "evidence": None,
USER                 "unobserved": None,
USER                 "x-plumbline": x,
USER             })
USER     if checks:
USER         for field, reason in (
USER             ("checks.batch", "the run's round records name no batch"),
USER             ("checks.failureCondition", "the packet declares no per-dimension failure condition"),
USER             ("checks.outcome", "the run's round records carry a score, not a custody outcome per dimension"),
USER             ("checks.evidence", "the run wrote no evaluator evidence file"),
USER         ):
USER             gaps.add(field, reason, False)
USER     else:
USER         gaps.add("checks", "the run's round records carry no evaluator reading", False)
USER 
USER     # ---- violations: what each round's evaluator filed ----
USER     violations = []
USER     for number, path, row in rounds:
USER         for item in reading_of(row).get("violations") or []:
USER             if isinstance(item, dict):
USER                 violations.append({
USER                     "dimension": item.get("dimension"),
USER                     "description": item.get("observation") or item.get("description") or "",
USER                     "x-plumbline": {"locator": item.get("class"), "id": item.get("id"),
USER                                     "round": number, "record": path.name},
USER                 })
USER 
USER     gaps.add("controls", "the run's round records carry no control case", False)
USER     gaps.add("external", "the run wrote no harness log, so no CL1-15 evidence exists", False)
USER     gaps.add("retention", "the run recorded no retention location", False)
USER 
USER     disposition = {"state": None, "by": None, "at": None, "acknowledgesUnobserved": []}
USER     gaps.add("disposition.state", "the packet holds no disposition_state", False)
USER     gaps.add("disposition.by", "the run named no approver", False)
USER     gaps.add("disposition.at", "the run recorded no disposition time", False)
USER 
USER     separation = [s for s in packet.get("separation_gaps") or [] if isinstance(s, str)] \
USER         if isinstance(packet.get("separation_gaps"), list) else []
USER 
USER     verdict = None
USER     for _, _, row in rounds:
USER         found = reading_of(row).get("verdict")
USER         if found in VERDICTS:
USER             verdict = found
USER     xp["terminal_state"] = packet.get("terminal_state")
USER     if packet.get("outcome") is not None:
USER         xp["outcome"] = packet.get("outcome")
USER     xp["verdict"] = verdict
USER     if packet.get("stop") is not None:
USER         xp["stop"] = packet.get("stop")
USER     xp["round_count"] = len(rounds)
USER     xp["rounds"] = [{"round": number, "record": path.name, "sha256": file_digest(path)}
USER                     for number, path, _ in rounds]
USER     xp["evaluator_runs"] = [
USER         {"round": number, "exit": run.get("exit"), "output_sha256": run.get("output_sha256")}
USER         for number, _, row in rounds for run in (row.get("evaluator") or []) if isinstance(run, dict)
USER     ]
USER     spend = 0.0
USER     for _, _, row in rounds:
USER         cost = row.get("cost")
USER         if isinstance(cost, (int, float)) and not isinstance(cost, bool):
USER             spend += float(cost)
USER     xp["spend"] = {"rounds_cost_usd": round(spend, 6), "source": "round-*.json cost"}
USER 
USER     level = packet.get("levelClaimed")
USER     if level not in ("CL1", "CL2", "CL3", "baseline"):
USER         level = "CL1"
USER     pred = {
USER         "specVersion": version,
USER         "levelClaimed": level,
USER         "bar": bar,
USER         "maker": maker,
USER         "startedAt": started,
USER         "producedAt": produced,
USER         "instrument": instrument,
USER         "evaluators": evaluators,
USER         "checks": checks,
USER         "controls": [],
USER         "disagreements": [],
USER         "violations": violations,
USER         "separationGaps": separation,
USER         "retention": None,
USER         "external": [],
USER         "disposition": disposition,
USER     }
USER     if xp.get("terminal_state") not in TERMINALS:
USER         gaps.add("x-plumbline.terminal_state", f"packet terminal_state is {xp.get('terminal_state')!r}")
USER     xp["schema"] = "plumbline/x-plumbline/v1"
USER     if version_block:
USER         xp["spec_version"] = version_block
USER     xp["emitter"] = {"name": "kit/emit_custody.py", "kit_revision": (rev.get("commit") or "")[:7] or None,
USER                      "commit": rev.get("commit"), "tree": rev.get("tree"), "dirty": rev.get("dirty"),
USER                      "statedRevision": rev.get("stated")}
USER     xp["time_tolerance_s"] = H.TOLERANCE_S
USER     xp["times"] = {"startedAt": "packet.json started_at", "producedAt": "packet.json ended_at"}
USER     xp["hand_times"] = []
USER     xp["timeSources"] = time_sources(pred, xp)
USER     xp["time_sources"] = dict(xp["timeSources"])
USER     check_order(pred, packet, {}, now, ref)
USER     xp["emittedAt"] = H.iso(now)
USER     xp["gaps"] = gaps.rows
USER     pred["x-plumbline"] = xp
USER     return ({"_type": STATEMENT, "subject": subject, "predicateType": PREDICATE_TYPE, "predicate": pred},
USER             gaps, [])
USER 
USER 
USER def build(job: Path, inputs_path: Path, ref: H.Refusals | None = None, now: datetime | None = None,
USER           expect: str | None = None, allow_hand: bool = False,
USER           spec_version: str | None = None) -> tuple[dict, Gaps, list[str]]:
USER     gaps, notes = Gaps(), []
USER     ref = ref if ref is not None else H.Refusals()
USER     now = now or datetime.now(timezone.utc).replace(microsecond=0)
USER     packet = load(job / "packet.json")
USER     have_inputs = inputs_path.is_file()
USER     if is_loop_finish(packet, job):
USER         # The round path reads the custody inputs for one thing only: the document the job attests. A malformed
USER         # inputs file is not this path's to police (it was never read here before), so it is treated as absent.
USER         round_ci = None
USER         if have_inputs:
USER             try:
USER                 round_ci = load(inputs_path)
USER             except (ValueError, OSError):
USER                 round_ci = None
USER         return build_finish(job, packet, gaps, ref, now, expect, allow_hand,
USER                             ci=round_ci if isinstance(round_ci, dict) else None, override=spec_version)
USER     ci = load(inputs_path) if have_inputs else None
USER     if ci is None:
USER         gaps.add("inputs/custody.json", f"no custody inputs at {inputs_path.relative_to(job) if inputs_path.is_relative_to(job) else inputs_path}: "
USER                  "bar, approvals, maker, evaluators, controls and retention have no source")
USER         ci = {}
USER     job_id = packet.get("job_id") or job.name
USER     xp: dict = {"job_id": job_id, "sources": {}}
USER     try:
USER         rel_inputs = inputs_path.relative_to(job).as_posix()
USER     except ValueError:
USER         rel_inputs = str(inputs_path)
USER     ev_dir = job / ci.get("evidence_dir", "custody/evidence")
USER     ev_log = events_log(job, ref)
USER     if ev_log["_file"]:
USER         xp["events_log"] = ev_log["_file"]
USER     lines = ledger_lines(job)
USER     hand: dict[str, dict] = {}
USER 
USER     def mark(field: str, file: str, line, source: str) -> None:
USER         hand[field] = {"field": field, "file": file, "line": line, "source": source}
USER 
USER     # ---- the emitter's own revision (refused when dirty or not the stated revision) ----
USER     rev = H.revision(HERE, job, expect or os.environ.get("PLUMBLINE_EXPECT_REVISION") or ci.get("emitter_revision"), ref)
USER     version, version_block = resolve_spec_version(job, ci, spec_version, ref)
USER 
USER     # ---- terminal state, verdict, disposition (three separate facts, three separate sources) ----
USER     xp["terminal_state"] = packet.get("terminal_state")
USER     if packet.get("outcome") is not None:
USER         xp["outcome"] = packet["outcome"]
USER     rec_path, rec = final_record(job)
USER     passes_src: list[dict] = []
USER     run = None
USER     if rec:
USER         xp["verdict"] = rec.get("verdict")
USER         xp["iteration"] = rec.get("iteration")
USER         xp["s5_record"] = {"name": rec_path.name, "sha256": file_digest(rec_path)}
USER         earlier = sorted(f.name for f in job.glob("iteration-*-eval-record.json") if f != rec_path)
USER         if earlier:
USER             xp["earlier_iterations"] = earlier
USER         if rec.get("pass_rule") is not None:
USER             xp["pass_rule"] = rec["pass_rule"]
USER         for pn in rec.get("passes") or []:
USER             pf = job / str(pn.get("artifact") or f"passes/{pn.get('pass_id')}.json")
USER             passes_src.append(load(pf) if pf.is_file() else {**pn, "_missing": str(pf.relative_to(job))})
USER         run = run_for(job, rec.get("iteration"))
USER     else:
USER         xp["verdict"] = ci.get("verdict")          # a readings job files no §5 record (kit/plumbline_job.py)
USER         if xp["verdict"] is None:
USER             gaps.add("x-plumbline.verdict", "no §5 record in the job and no verdict in the custody inputs", False)
USER     xp["disposition_source"] = "packet.json disposition_state"
USER     xp["packet"] = {"name": "packet.json", "sha256": file_digest(job / "packet.json")}
USER 
USER     # ---- subject: the artifact files, by digest ----
USER     files_dir = job / ci.get("files_dir", "custody/files")
USER     names = ci.get("subject")
USER     if names is None and files_dir.is_dir():
USER         names = sorted(str(p.relative_to(files_dir)) for p in files_dir.rglob("*") if p.is_file())
USER     subject = []
USER     for n in names or []:
USER         p = files_dir / n
USER         if p.is_file():
USER             subject.append({"name": n, "digest": {"sha256": file_digest(p)}})
USER         else:
USER             gaps.add(f"subject[{n}]", f"artifact file {n!r} not found under {files_dir.relative_to(job)}")
USER     if not subject:
USER         gaps.add("subject", "no artifact file to name")
USER 
USER     # ---- bar ----
USER     b = ci.get("bar") or {}
USER     bar_digest = digest_of(job, b.get("file"), "bar.digest", gaps)
USER     dims_in = b.get("dimensions") or []
USER     if not dims_in:
USER         gaps.add("bar.dimensions", "the custody inputs list no bar dimension")
USER     dims, fail_cond, pl_name = [], {}, {}
USER     for d in dims_in:
USER         dims.append({"id": d.get("id"), "criterion": d.get("criterion"), "scale": d.get("scale")})
USER         fail_cond[d.get("id")] = d.get("failureCondition")
USER         pl_name[d.get("plumbline_dimension", d.get("id"))] = d.get("id")
USER     approvals = []
USER     for i, a in enumerate(b.get("approvals") or []):
USER         xa = H.check_approval(a, i, ci, packet, ref)
USER         live = ev_log["approve"].get(a.get("role")) if have_inputs else None
USER         if live:
USER             src = writer_source(live)
USER             if src:
USER                 mark(f"bar.approvals[{i}].at", LEDGER_REL, live.get("_line"), src)
USER         elif a.get("at"):
USER             mark(f"bar.approvals[{i}].at", rel_inputs, line_in(inputs_path, a.get("at"), "at"), "inputs-no-ledger")
USER         xa["time_source"] = "hand-entered"
USER         if live:
USER             # The live event is the source of the time. A value the inputs also state must agree with it; a field
USER             # the event does not carry is not compared (the ledger is not required to restate it).
USER             for k in ("by", "at"):
USER                 if a.get(k) and live.get(k) and live.get(k) != a.get(k):
USER                     ref.add("time" if k == "at" else "approval",
USER                             f"bar.approvals[{i}].{k}: the ledger says {a.get(k)!r} but {LEDGER_REL} "
USER                             f"logged {live.get(k)!r} when it happened")
USER             xa["time_source"] = "logged live (inputs/custody-events.jsonl)"
USER             if live.get("at"):
USER                 xa["at_source"] = f"{LEDGER_REL}:{live['_line']}"
USER         elif a.get("at"):
USER             n = line_in(inputs_path, a.get("at"), "at")
USER             if n:
USER                 xa["at_source"] = f"{rel_inputs}:{n}"
USER         if xa.get("at_source"):
USER             xp["sources"][f"bar.approvals[{i}].at"] = xa["at_source"]
USER         approvals.append({"role": a.get("role"), "by": a.get("by"),
USER                           "barDigest": hexdigest(a.get("barDigest"), f"bar.approvals[{i}].barDigest", gaps),
USER                           "at": ts(a.get("at"), f"bar.approvals[{i}].at", gaps), "adopted": a.get("adopted"),
USER                           "x-plumbline": xa})
USER     if not approvals:
USER         gaps.add("bar.approvals", "no buyer/specialist approval recorded")
USER     # F1f: a relay is a report, never an approval. A buyer approval whose only evidence is a relay line is
USER     # refused as a missing approval: the emitter will not count the relay.
USER     if have_inputs and relay_only_buyer(ci, packet, lines):
USER         ref.add("approval", f"buyer: the buyer's approval exists only as a relay ({LEDGER_REL}); a relay is a "
USER                             f"report, not an approval (F1f). The buyer must approve directly: "
USER                             f"custody_ledger.py approve --role buyer, or a buyer entry in inputs/custody.json")
USER     ground = []
USER     for i, g in enumerate(b.get("groundTruth") or []):
USER         ground.append({"name": g.get("name"), "version": g.get("version"),
USER                        "digest": digest_of(job, g.get("file"), f"bar.groundTruth[{i}].digest", gaps)})
USER     # A live freeze/approval/disposition event is the source of its time, and a cross-check on the inputs' own
USER     # value. The events are read only when the custody inputs exist: they stamp and check the inputs' facts, and
USER     # a job emitted with no inputs at all is already reported in x-plumbline.gaps (it is not a refusal).
USER     fz = ev_log.get("freeze") if have_inputs else None
USER     if fz:
USER         if b.get("frozenAt") and fz.get("at") and fz.get("at") != b.get("frozenAt"):
USER             ref.add("time", f"bar.frozenAt: the ledger says {b.get('frozenAt')!r} but {LEDGER_REL} "
USER                             f"logged the freeze at {fz.get('at')!r}")
USER         if bar_digest and fz.get("bar_sha256") and fz["bar_sha256"] != bar_digest["sha256"]:
USER             ref.add("order", f"bar: frozen as {fz['bar_sha256'][:12]} ({LEDGER_REL}) but the bar file "
USER                              f"now hashes to {bar_digest['sha256'][:12]}: the bar changed after the freeze")
USER     frozen_at = b.get("frozenAt") or (fz or {}).get("at")
USER     if fz:
USER         src = writer_source(fz)
USER         if src:
USER             mark("bar.frozenAt", LEDGER_REL, fz.get("_line"), src)
USER     elif b.get("frozenAt"):
USER         mark("bar.frozenAt", rel_inputs, line_in(inputs_path, b.get("frozenAt"), "frozenAt"), "inputs-no-ledger")
USER     bar = {"digest": bar_digest, "frozenAt": ts(frozen_at, "bar.frozenAt", gaps),
USER            "author": b.get("author"), "dimensions": dims, "approvals": approvals,
USER            "publishedAt": b.get("publishedAt"), "groundTruth": ground, "dissent": b.get("dissent") or []}
USER     if fz and frozen_at:
USER         xp["sources"]["bar.frozenAt"] = f"{LEDGER_REL}:{fz['_line']}"
USER     elif b.get("frozenAt"):
USER         n = line_in(inputs_path, b.get("frozenAt"), "frozenAt")
USER         if n:
USER             xp["sources"]["bar.frozenAt"] = f"{rel_inputs}:{n}"
USER     if not b.get("author"):
USER         gaps.add("bar.author", "not recorded")
USER 
USER     # ---- maker ----
USER     m = ci.get("maker") or {}
USER     pm = packet.get("maker") if isinstance(packet.get("maker"), dict) else {}
USER     mk = maker_history(job, ev_dir, ci, m, ref, pin_for(ci, ev_log, "maker", ref), gaps, hand) if m.get("kind") == "model" else {}
USER     # A typed startedAt/producedAt is a hand time whether or not the maker has a logged call (V3): the tool's
USER     # time is the log's, and a time typed into custody.json has no tool behind it (as for pass and control times).
USER     if ci.get("startedAt"):
USER         mark("startedAt", rel_inputs, line_in(inputs_path, ci.get("startedAt"), "startedAt"), "inputs-no-ledger")
USER     if ci.get("producedAt"):
USER         mark("producedAt", rel_inputs, line_in(inputs_path, ci.get("producedAt"), "producedAt"), "inputs-no-ledger")
USER     # The endpoint comes only from the harness log (a direct call's URL host, or the pinned provider the
USER     # /api/v1/generation reply NAMES as the one that served it). A hand-entered endpoint in the inputs is never
USER     # used, and there is no fallback to routing config or a provider pin when the generation reply is missing or
USER     # names no provider.
USER     m_model = {k: v for k, v in (m.get("model") or {}).items() if k != "endpoint"}
