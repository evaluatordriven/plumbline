USER def generation_names(raw: dict) -> tuple[dict, list]:
USER     """({source: provider that served}, [providers tried]) as the /api/v1/generation reply alone states them."""
USER     g = raw.get("generation") if isinstance(raw.get("generation"), dict) else None
USER     if g is None:
USER         return {}, []
USER     g = g.get("data") if isinstance(g.get("data"), dict) else g
USER     served = {}
USER     if g.get("provider_name"):
USER         served["generation provider_name"] = str(g["provider_name"])
USER     tried = [str(x.get("provider_name") or x.get("provider")) for x in (g.get("provider_responses") or [])
USER              if isinstance(x, dict) and (x.get("provider_name") or x.get("provider"))]
USER     return served, tried
USER 
USER 
USER def served_by(raw: dict) -> tuple[dict, dict]:
USER     """({source: provider that served the call}, {source: [providers tried]}) as the log states them."""
USER     resp = raw.get("response") if isinstance(raw.get("response"), dict) else {}
USER     served, tried = {}, {}
USER     if resp.get("provider"):
USER         served["response provider"] = str(resp["provider"])
USER     om = resp.get("openrouter_metadata") if isinstance(resp.get("openrouter_metadata"), dict) else {}
USER     sel = [e.get("provider") for e in ((om.get("endpoints") or {}).get("available") or [])
USER            if isinstance(e, dict) and e.get("selected") and e.get("provider")]
USER     if sel:
USER         served["openrouter_metadata.endpoints selected"] = str(sel[-1])
USER     att = [str(a.get("provider")) for a in (om.get("attempts") or []) if isinstance(a, dict) and a.get("provider")]
USER     if att:
USER         tried["openrouter_metadata.attempts"] = att
USER     gserved, gtried = generation_names(raw)
USER     served.update(gserved)
USER     if gtried:
USER         tried["generation provider_responses"] = gtried
USER     return served, tried
USER 
USER 
USER def routing_request(raw: dict) -> dict | None:
USER     """The request body's `provider` preferences, or None when the log does not carry the request body."""
USER     req = raw.get("request") if isinstance(raw.get("request"), dict) else {}
USER     body = req.get("body", req.get("json"))
USER     if isinstance(body, str):
USER         try:
USER             body = json.loads(body)
USER         except ValueError:
USER             body = None
USER     if not isinstance(body, dict):
USER         body = req if any(k in req for k in ("messages", "provider", "input", "prompt")) else None
USER     if body is None:
USER         return None
USER     pv = body.get("provider") if isinstance(body.get("provider"), dict) else {}
USER     out = {k: pv.get(k) for k in ("order", "allow_fallbacks", "zdr", "data_collection", "only") if k in pv}
USER     if isinstance(body.get("models"), list):
USER         out["models"] = body["models"]
USER     return out
USER 
