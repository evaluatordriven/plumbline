USER def checkout_head(checkout: Path, ref: H.Refusals) -> None:
USER     """A checkout that names its own commit must be the commit its work tree is at (R2)."""
USER     own = _git_out(["rev-parse", "HEAD"], checkout)
USER     if not own:
USER         return
USER     top = _git_out(["rev-parse", "--show-toplevel"], checkout)
USER     if not top:
USER         return
USER     head = _git_out(["rev-parse", "HEAD"], Path(top))
USER     if head and head != own:
USER         ref.add("spec-version", f"the custody checkout {checkout} names commit {own[:12]} but the work tree at "
USER                                 f"{top} is at {head[:12]}: a SPEC.md read beside the wrong commit is not the "
USER                                 f"document the job attests")
