USER def model_block(m, field: str, gaps: Gaps):
USER     """custody `model`: {family, identifier, endpoint, readOnly} or null (a person / script)."""
USER     if m is None:
USER         return None
USER     out = {}
USER     for k in ("family", "identifier", "endpoint", "readOnly"):
USER         if k in m and m[k] not in (None, ""):
USER             out[k] = m[k]
USER         else:
USER             gaps.add(f"{field}.{k}", "not recorded in the custody inputs")
