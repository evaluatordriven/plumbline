USER     level = ci.get("levelClaimed") or "CL1"
USER     pred = {
USER         "specVersion": SPEC_VERSION, "levelClaimed": level, "bar": bar, "maker": maker,
USER         "startedAt": ts(mk.get("startedAt") or ci.get("startedAt"), "startedAt", gaps),
