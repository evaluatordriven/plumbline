USER def _commit_tree(tree: Path, message: str) -> None:
USER     """Commit every byte of `tree` at one commit: the copy is the source tree, clean."""
USER     for cmd in (["init", "-q"], ["add", "-A"], ["commit", "-qm", message]):
USER         r = _git(cmd, tree)
USER         if r.returncode != 0:
USER             die(f"git {cmd[0]} failed in {tree}: {(r.stderr or r.stdout).strip()[:300]}")
