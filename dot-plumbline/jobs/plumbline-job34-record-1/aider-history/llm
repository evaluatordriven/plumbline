USER def check_approval(a: dict, i: int, ci: dict, packet: dict, ref: Refusals) -> dict:
USER     """Refuse an approval that is not a record of a non-agent, non-model party (or a marked, adopting agent)."""
USER     role, by, kind = a.get("role"), a.get("by"), (a.get("kind") or "person")
USER     where = f"bar.approvals[{i}] ({role})"
USER     orch = ci.get("orchestrator") or {}
USER     orch_names = [n for n in [orch.get("name"), *(orch.get("aliases") or [])] if n]
USER     if not orch_names:
USER         ref.add("approval", f"{where}: the custody inputs do not name the orchestrating agent (`orchestrator`: "
USER                             f"{{name, aliases}}), so this approval cannot be shown not to be its")
USER     if not by:
USER         ref.add("approval", f"{where}: names no approver"); return {"kind": kind}
USER     if any(same_party(by, n) for n in orch_names):
USER         ref.add("approval", f"{where} is by {by!r}, the orchestrating agent. An approval counts only from someone "
USER                             f"who is not the orchestrator and not a model; the {role} must approve themselves")
USER         return {"kind": kind}
USER     m = ci.get("maker") or {}
USER     models = [m.get("name"), (m.get("model") or {}).get("identifier")] if m.get("kind") == "model" else []
USER     for e in ci.get("evaluators") or []:
USER         if e.get("kind") == "model":
USER             models += [e.get("name"), e.get("id"), (e.get("model") or {}).get("identifier")]
USER     if kind == "model" or any(same_party(by, n) for n in models if n):
USER         ref.add("approval", f"{where} is by {by!r}, a model; a model's output is not an approval")
USER         return {"kind": kind}
USER     if kind == "agent":
USER         ad = a.get("adopted")
USER         if not (isinstance(ad, dict) and ad.get("document") and ad.get("version")):
USER             ref.add("approval", f"{where} is by the agent {by!r} with adopted={ad!r}; an agent's approval counts "
USER                                 f"only as the adoption of a published document (`adopted`: {{document, version}})")
USER     elif kind == "person":
USER         w = looks_agent(by)
USER         if w:
USER             ref.add("approval", f"{where} is by {by!r}, which reads as an agent identity ({w!r}); refused unless "
USER                                 f"marked kind: \"agent\" with `adopted` set, or approved by the person themselves")
USER     else:
USER         ref.add("approval", f"{where}: kind {kind!r} is not person, agent or model")
USER     seat = packet.get(role) if role in ("buyer", "specialist") else None
USER     if isinstance(seat, str) and seat and not same_party(by, seat):
USER         ref.add("approval", f"{where} is by {by!r} but the job's packet names its {role} as {seat!r}; one of them "
USER                             f"misstates who held the seat")
USER     return {"kind": kind}
USER 
