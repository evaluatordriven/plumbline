USER def claims_report(root: Path, tool: Path):
USER     """Run the claims tool as a PROCESS, in its own tree: (exit, stdout, the claims it published).
USER 
USER     The claim list is read by importing the tool under test, from its own directory, after the exit
USER     code has been graded — the exit code is the process's, the list is the tool's own answer.
USER     A tool that does not import is not an error here: it simply publishes no claim, and case 7 says so.
USER     """
USER     proc = subprocess.run([PY, str(tool)], cwd=str(root), capture_output=True, text=True)
USER     listed = None
USER     try:
USER         import importlib.util
USER         spec = importlib.util.spec_from_file_location("claims_tool_under_test", tool)
USER         module = importlib.util.module_from_spec(spec)
USER         spec.loader.exec_module(module)
USER         listed = list(module.claims(root))
USER     except BaseException:                                      # noqa: BLE001 - any failure: no list
USER         listed = None
USER     return proc.returncode, (proc.stdout or "") + (proc.stderr or ""), listed
