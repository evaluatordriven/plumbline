USER def final_record(job: Path) -> tuple[Path | None, dict | None]:
USER     recs = []
USER     for f in job.glob("iteration-*-eval-record.json"):
USER         m = re.match(r"iteration-(\d+)-eval-record\.json$", f.name)
USER         if m:
USER             recs.append((int(m.group(1)), f))
USER     if not recs:
USER         return None, None
USER     recs.sort()
