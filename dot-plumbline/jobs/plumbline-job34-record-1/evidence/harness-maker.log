s it. So the planted copy still emits correct records. Fine; the tool must LIE. The tool reads the literal. Good.\n\n18. Now, the tool `claims()` claim 6 requires `spec_version` from pin and `match` on the literal; unchanged \u2192 6 claims. \n\nNow let me write `resolve_spec_version`.\n\n```python\nVERSION_RE = re.compile(r\"^\\d+\\.\\d+\\.\\d+$\")\nSPEC_DECL_RE = re.compile(r\"\\*\\*Version\\s+(\\d+\\.\\d+\\.\\d+)\\b\")\n\n\ndef spec_md_version(spec_md: Path) -> tuple[str | None, int | None]:\n    \"\"\"The version a custody SPEC.md declares (`**Version X.Y.Z \u00b7 ...**`), and the line it is declared on.\"\"\"\n    try:\n        lines = spec_md.read_text(encoding=\"utf-8\", errors=\"replace\").splitlines()\n    except OSError:\n        return None, None\n    for n, ln in enumerate(lines, 1):\n        hit = SPEC_DECL_RE.search(ln)\n        if hit:\n            return hit.group(1), n\n    return None, None\n\n\ndef resolve_spec_version(job: Path, ci: dict | None, override: str | None,\n                         ref: H.Refusals) -> tuple[str | None, dict]:\n    \"\"\"The version the record attests, read from the custody document the job names, else the override.\n\n    A record attests a document (R1): `inputs/custody.json: custody_spec` points at a custody checkout,\n    and the record carries the version its `SPEC.md` declares, with that file's digest and the line that\n    declares it. `--spec-version` is the fallback for a job whose artifact is not a custody tree (R3).\n    With neither, the emitter refuses (R2): nothing is written and no literal stands in for the answer.\n    \"\"\"\n    given = (ci or {}).get(\"custody_spec\")\n    doc_version = None\n    block: dict = {}\n    if given:\n        checkout = Path(str(given)).expanduser()\n        if not checkout.is_absolute():\n            checkout = job / checkout\n        spec_md = checkout / \"SPEC.md\"\n        if not checkout.is_dir():\n            ref.add(\"spec-version\", f\"inputs/custody.json custody_spec {str(given)!r} is not a directory \"\n                                    f\"({checkout}); the record would not know which document it attests\")\n        elif not spec_md.is_file():\n            ref.add(\"spec-version\", f\"the custody checkout {checkout} has no SPEC.md, so the version the job \"\n                                    f\"attests cannot be read\")\n        else:\n            doc_version, line = spec_md_version(spec_md)\n            if doc_version is None:\n                ref.add(\"spec-version\", f\"{spec_md} declares no `**Version X.Y.Z**`, so the version the job \"\n                                        f\"attests cannot be read\")\n            block = {\"source\": f\"{spec_md}:{line}\" if line else str(spec_md),\n                     \"path\": str(checkout),\n                     \"sha256\": file_digest(spec_md) if spec_md.is_file() else None,\n                     \"origin\": \"document\"}\n            if doc_version is not None:\n                refuse_moved_checkout(checkout, ref)\n    if override:\n        override = str(override).strip()\n        if not VERSION_RE.match(override):\n            ref.add(\"spec-version\", f\"--spec-version {override!r} is not a version (X.Y.Z)\")\n            return None, block or {}\n        if doc_version is not None:\n            if override != doc_version:\n                ref.add(\"spec-version\", f\"the document {block.get('path')}/SPEC.md declares {doc_version!r} but \"\n                                        f\"--spec-version says {override!r}: the record can only attest one, and \"\n                                        f\"the emitter will not choose silently\")\n                return None, block\n            return doc_version, block\n        if given and not doc_version:\n            return None, block or {}     # the document was named but unreadable: already refused, never the flag\n        return override, {\"source\": \"--spec-version\", \"path\": None, \"sha256\": None, \"origin\": \"--spec-version\"}\n    if doc_version is not None:\n        return doc_version, block\n    if given and not doc_version:\n        return None, block or {}\n    ref.add(\"spec-version\", \"the job names no custody document (inputs/custody.json: custody_spec) and no \"\n                            \"--spec-version was given: the record's predicate.specVersion would have no source, \"\n                            \"and the emitter refuses rather than guess\")\n    return None, {}\n```\n\nHmm, careful: the order here. If `given` is present but bad, we should NOT fall back to the override. R2: \"A custody_spec that does not exist, is not a directory, has no SPEC.md, or whose SPEC.md declares no Version is a REFUSAL, never a fall-back to the override, never a fall-back to the literal.\" In my code, after adding the refusal, if override is given and doc_version is None and `given` truthy \u2192 return None (keep refusal). Good, handled by `if given and not doc_version: return None, block or {}`. But the placement: the override branch first validates override format; then `if doc_version is not None:` compare. Else `if given and not doc_version: return None`. Good.\n\nWait, but that means when `given` is present but bad AND override given, we return None with ref non-empty \u2192 exit 3. Correct per R2.\n\nAnd when `given` is absent and override given \u2192 return override. Good.\n\nWhen `given` absent and no override \u2192 refuse. Good.\n\nNow `refuse_moved_checkout`: the git HEAD check.\n\n```python\ndef _git_out(args, cwd) -> str | None:\n    try:\n        return subprocess.run([\"git\", \"-C\", str(cwd), *args], capture_output=True, text=True,\n                              check=True).stdout.strip()\n    except (OSError, subprocess.CalledProcessError):\n        return None\n\n\ndef checkout_head_check(checkout: Path, ref: H.Refusals) -> None:\n    \"\"\"A checkout that names its own commit must be the commit its work tree is at (R2).\"\"\"\n    own = _git_out([\"rev-parse\", \"HEAD\"], checkout)\n    if not own:\n        return\n    top = _git_out([\"rev-parse\", \"--show-toplevel\"], checkout)\n    if not top:\n        return\n    head = _git_out([\"rev-parse\", \"HEAD\"], Path(top))\n    if head and head != own:\n        ref.add(\"spec-version\", f\"the custody checkout {checkout} names commit {own[:12]} but the work tree at \"\n                                f\"{top} is at {head[:12]}: a SPEC.md read beside the wrong commit is not the \"\n                                f\"document the job attests\")\n```\n\nHmm, \"names its own commit\" \u2014 `git -C dir rev-parse HEAD` answers even if `dir` is a subdirectory of a repo. Maybe require `dir/.git` exists? In the test, `d/.git` exists (git init). If `dir/.git` doesn't exist but is inside a repo, then `rev-parse HEAD` gives the containing repo's HEAD and top gives the same repo, so head == own \u2192 no refusal. So it doesn't matter. Keep simple.\n\nActually, maybe \"names its own commit\" means there's a `SPEC.md` sibling file naming a commit? Too speculative. The bar doesn't exercise a mismatch. Keep the simple version.\n\nHmm, but wait: should the head check run even if `doc_version` is None? Doesn't matter; we refuse already.\n\nNow the block for the document: should `sha256` be computed even if parse failed? We refuse anyway. Fine.\n\nLet me reorder so block is only built when spec_md is a file.\n\nAlso: `file_digest` is defined below `resolve_spec_version`? In Python, module-level function order doesn't matter at call time. But `resolve_spec_version` is called from `build`, after module load. Fine. However, `VERSION_RE`/`SPEC_DECL_RE` must be defined before use at runtime \u2014 module-level constants defined before `build` is called. Fine wherever.\n\nPlacement: put `resolve_spec_version` after `hexdigest`/`ts` helpers or near `SPEC_VERSION`. Let's put near the top after `SPEC_VERSION`? It references `file_digest` and `H.Refusals` \u2014 fine.\n\nBut there's an issue: `H.iso`, etc. Fine.\n\nNow, integrate into `build_finish`.\n\nCurrent signature:\n```python\ndef build_finish(job: Path, packet: dict, gaps: Gaps, ref: H.Refusals, now: datetime,\n                 expect: str | None, allow_hand: bool = False) -> tuple[dict, Gaps, list[str]]:\n```\nAdd `ci: dict | None = None, override: str | None = None`.\n\nAt the start:\n```python\n    xp: dict = {\"job_id\": ..., \"sources\": {}}\n    version, version_block = resolve_spec_version(job, ci or {}, override, ref)\n```\nand near the end:\n```python\n    pred = {\n        \"specVersion\": version,\n        ...\n    }\n    ...\n    if version_block:\n        xp[\"spec_version\"] = version_block\n```\n\nWhere exactly? `xp[\"spec_version\"] = version_block` before `pred[\"x-plumbline\"] = xp`.\n\nAlso for `build_finish`, `check_order(pred, packet, {}, now, ref)` runs even when version is None. Fine.\n\nHmm: one concern \u2014 if resolution refuses, `build_finish` continues and builds a record with `specVersion: None`, and might add other refusals too (e.g. from `H.revision`?). In the round path, `H.revision(HERE, job, ...)` \u2014 the scratch tree is clean, job outside, so fine.\n\nNow the inputs path `build`:\n\n```python\n    ci = load(inputs_path) if have_inputs else None\n```\nalready exists after the finish dispatch. Move the loading earlier:\n\n```python\n    packet = load(job / \"packet.json\")\n    have_inputs = inputs_path.is_file()\n    ci = load(inputs_path) if have_inputs else None\n    if is_loop_finish(packet, job):\n        return build_finish(job, packet, gaps, ref, now, expect, allow_hand, ci=ci, override=spec_version)\n    if ci is None:\n        gaps.add(...)\n        ci = {}\n```\n\nCareful: `load(inputs_path)` can raise ValueError/OSError; `main` catches those around `build` and returns 2. Currently, for a finish job, malformed inputs were never read. Now they would be read \u2192 exit 2 instead. Edge case; acceptable? Hmm, could break the round fixture if its inputs/cust