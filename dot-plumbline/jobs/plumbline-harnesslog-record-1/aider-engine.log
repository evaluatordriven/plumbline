Reading:                                                                        

                                                                                
 def read(path) -> dict[str, Entry]:                                            
     """Every call of the harness log at `path`, by call name. Raises           
 HarnessLogError."""                                                            
     p = Path(path)                                                             
     try:                                                                       
         text = p.read_text(encoding="utf-8")                                   
     except OSError as exc:                                                     
         raise HarnessLogError(p, f"cannot be read: {exc}")                     
     try:                                                                       
         data = json.loads(text)                                                
     except ValueError as exc:                                                  
         raise HarnessLogError(p, f"is not JSON: {exc}")                        
     entries = data if isinstance(data, list) else [data] if isinstance(data,   
 dict) else None                                                                
     if entries is None:                                                        
         raise HarnessLogError(p, "is neither a JSON list of harness entries    
 nor one entry object")                                                         
     lines = text.splitlines()                                                  
     out: dict[str, Entry] = {}                                                 
     for i, e in enumerate(entries, 1):                                         
         if not isinstance(e, dict):                                            
             raise HarnessLogError(p, f"entry {i} is not a JSON object")        
         call = e.get("call")                                                   
         name = call if isinstance(call, str) and call.strip() else None        
         if not name:                                                           
             # keep the refusal narrow but still name the entry: a log entry    
 the record links                                                               
             # checks to must say which call it is.                             
             raise HarnessLogError(p, f"entry {i} names no call", None)         
         sent = _parse_at(e.get("sent_at"))                                     
         received = _parse_at(e.get("received_at"))                             
         if sent is None:                                                       
             raise HarnessLogError(p, "sent_at is missing or not RFC 3339 UTC   
 (...Z)", name)                                                                 
         if received is None:                                                   
             raise HarnessLogError(p, "received_at is missing or not RFC 3339   
 UTC (...Z)", name)                                                             
         if received < sent:                                                    
             raise HarnessLogError(p, f"received_at {e['received_at']} is       
 before sent_at {e['sent_at']}", name)                                          
         out[name] = Entry(name, sent, received,                                
                           _line_of(lines, "sent_at", e["sent_at"]),            
                           _line_of(lines, "received_at", e["received_at"]),    
                           e, p.name)                                           
     return out                                                                 
                                                                                

