 def link_call(ev_calls: dict, ev_id, named, default, where: str, ref:          
 H.Refusals):                                                                   
     """The harness call a check or control came from. Only model evaluators    
 have one."""                                                                   
     if ev_id not in ev_calls:                                                  
         return None                                                            
     calls = ev_calls[ev_id]                                                    
     if not calls:                                                              
         return None                                                            
     name = named or (default if default in calls else None)                    
     if name is None and not named and len(calls) == 1:                         
         name = next(iter(calls))                                               
     if name not in calls:                                                      
         ref.add("time", f"{where}: no harness call of evaluator {ev_id} is     
 linked to it "                                                                 
                         f"({'call ' + repr(named) + ' is not in the log' if    
 named else 'set `call` to one of ' + ', '.join(sorted(calls))}); "             
                         f"its time cannot be read from the log")               
         return None                                                            
     return calls[name]                                                         
                                                                                

