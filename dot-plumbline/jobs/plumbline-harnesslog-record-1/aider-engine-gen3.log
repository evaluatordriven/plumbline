 def _with_logger_times(path):                                                  
     text = path.read_text(encoding="utf-8")                                    
     try:                                                                       
         doc = json.loads(text)                                                 
     except ValueError:                                                         
         doc = None                                                             
     if isinstance(doc, list):                                                  
         items, dump = doc, lambda it: json.dumps(it, indent=2) + "\n"          
     else:                                                                      
