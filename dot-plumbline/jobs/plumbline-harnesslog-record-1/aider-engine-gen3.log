Now, potential lint: lambda assignment (E731) — the file already does similar?  
stamp_log uses conditional expression with dump? It uses inline ternaries. To   
avoid E731, I'll structure differently:                                         

                                                                                
 def _stamp_logger_times(path):                                                 
     text = path.read_text(encoding="utf-8")                                    
     try:                                                                       
         doc = json.loads(text)                                                 
     except ValueError:                                                         
         doc = None                                                             
     array = isinstance(doc, list)                                              
     single = isinstance(doc, dict)                                             
     items = doc if array else ([doc] if single else [json.loads(ln) for ln in  
 text.splitlines() if ln.strip()])                                              
     for e in items:                                                            
         if isinstance(e, dict) and not e.get("sent_at") and not                
 e.get("received_at"):                                                          
             at = _server_instant(e)                                            
             if at:                                                             
                 e["sent_at"] = e["received_at"] = at                           
     if array:                                                                  
         path.write_text(json.dumps(items, indent=2) + "\n", encoding="utf-8")  
     elif single:                                                               
         path.write_text(json.dumps(items[0], indent=2) + "\n",                 
 encoding="utf-8")                                                              
     else:                                                                      
         path.write_text("".join(json.dumps(e) + "\n" for e in items),          
 encoding="utf-8")                                                              
                                                                                

