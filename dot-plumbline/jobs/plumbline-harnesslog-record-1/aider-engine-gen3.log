Define near job_copy:                                                           

                                                                                
 def logger_stamped(name):                                                      
     """A copy of the job-rejected fixture whose harness logs carry the         
 logger's own sent_at and                                                       
     received_at on every call -- the entry shape                               
 tests/test_evaluator_harness_log.py D1-D3 asserts                              
     (sent_at, received_at, request.url, response.model). The fixture's logs    
 carry server times only,                                                       
     so a MODEL evaluator's check times have no logged source and the emitter   
 REFUSES the record                                                             
     (D6/D7); a case that needs a WRITTEN record runs on this copy instead. The 
 instants are the ones                                                          
     the fixture already carries (the response `created` epoch, else its Date   
 header), so nothing the                                                        
     fixture asserts about its own timeline moves."""                           
     d = TMP / name                                                             
     shutil.copytree(FIX, d)                                                    
     for lg in sorted((d / "custody" / "evidence").glob("harness-*.log")):      
         _stamp_logger_times(lg)                                                
     return d                                                                   
                                                                                
                                                                                
 def _stamp_logger_times(path):                                                 
     text = path.read_text(encoding="utf-8")                                    
     try:                                                                       
         doc = json.loads(text)                                                 
     except ValueError:                                                         
         doc = None                                                             
     if isinstance(doc, list):                                                  
         items, dump = doc, lambda it: json.dumps(it, indent=2) + "\n"          
     elif isinstance(doc, dict):                                                
         items, dump = [doc], lambda it: json.dumps(it[0], indent=2) + "\n"     
     else:                                                                      
         items = [json.loads(ln) for ln in text.splitlines() if ln.strip()]     
         dump = lambda it: "".join(json.dumps(e) + "\n" for e in it)            
     for e in items:                                                            
         if not isinstance(e, dict) or e.get("sent_at") or                      
 e.get("received_at"):                                                          
             continue                                                           
         at = _server_instant(e)                                                
         if at:                                                                 
             e["sent_at"] = e["received_at"] = at                               
     path.write_text(dump(items), encoding="utf-8")                             
                                                                                
                                                                                
 def _server_instant(e):                                                        
     """The instant the fixture's response carried: its `created` epoch, else   
 its Date header."""                                                            
     created = (e.get("response") or {}).get("created")                         
     if isinstance(created, (int, float)) and not isinstance(created, bool):    
         return datetime.fromtimestamp(created,                                 
 timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")                                   
     hdrs = e.get("response_headers") or e.get("headers") or (e.get("response") 
 or {}).get("headers") or {}                                                    
     date = hdrs.get("Date") or hdrs.get("date")                                
     if isinstance(date, str) and date:                                         
         try:                                                                   
             from email.utils import parsedate_to_datetime                      
             parsed = parsedate_to_datetime(date)                               
         except (TypeError, ValueError):                                        
             return None                                                        
         if parsed.tzinfo is None:                                              
             parsed = parsed.replace(tzinfo=timezone.utc)                       
         return parsed.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")  
     return None                                                                
                                                                                

