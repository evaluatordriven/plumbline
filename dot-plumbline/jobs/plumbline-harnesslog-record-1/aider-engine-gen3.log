 def _server_instant(e):                                                        
     """The instant a call's own response carried: its `created` epoch, else    
 its Date header. Same precedence as                                            
     kit/custody_history.py (Call.at: received_at, then created, then the       
 header), so stamping the logger's times                                        
     onto the value the reader already derived moves nothing in the fixture's   
 timeline."""                                                                   
     created = (e.get("response") or {}).get("created")                         
     if isinstance(created, (int, float)) and not isinstance(created, bool):    
         return datetime.fromtimestamp(created,                                 
 timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")                                   
     hdrs = e.get("response_headers") or e.get("headers") or (e.get("response") 
 or {}).get("headers") or {}                                                    
     date = hdrs.get("Date") or hdrs.get("date")                                
     if isinstance(date, str) and date:                                         
         try:                                                                   
             parsed = parsedate_to_datetime(date)                               
         except (TypeError, ValueError):                                        
             return None                                                        
         if parsed.tzinfo is None:                                              
             parsed = parsed.replace(tzinfo=timezone.utc)                       
         return parsed.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")  
     return None                                                                
                                                                                
                                                                                
 def _stamp_logger_times(path):                                                 
     """Write the logger's own sent_at/received_at into every call of one       
 harness log that carries neither,                                              
     preserving the file's format (JSON list, single object, or JSONL). A call  
 that already carries them is                                                   
     left exactly as it is: the emitter only reads its inputs, and so does      
 this."""                                                                       
     text = path.read_text(encoding="utf-8")                                    
     try:                                                                       
         doc = json.loads(text)                                                 
     except ValueError:                                                         
         doc = None                                                             
     array, single = isinstance(doc, list), isinstance(doc, dict)               
     items = doc if array else ([doc] if single else [json.loads(ln) for ln in  
 text.splitlines() if ln.strip()])                                              
     for e in items:                                                            
         if isinstance(e, dict) and not e.get("sent_at") and not                
 e.get("received_at"):                                                          
             at = _server_instant(e)                                            
             if at:                                                             
                 e["sent_at"] = e["received_at"] = at                           
     if array:                                                                  
         path.write_text(json.dumps(items, indent=2) + "\n", encoding="utf-8")  
     elif single:                                                               
         path.write_text(json.dumps(items[0], indent=2) + "\n",                 
 encoding="utf-8")                                                              
     else:                                                                      
         path.write_text("".join(json.dumps(e) + "\n" for e in items),          
 encoding="utf-8")                                                              
                                                                                
                                                                                
 def logger_stamped(name):                                                      
     """A copy of the job-rejected fixture whose harness logs carry the         
 logger's own sent_at and received_at on                                        
     every call -- the entry shape the frozen bar asserts                       
 (tests/test_evaluator_harness_log.py D1-D3: sent_at,                           
     received_at, request.url, response.model). The fixture's logs carry server 
 times only, so a MODEL evaluator's                                             
     check times have no logged source and the emitter REFUSES the record       
 (D6/D7); every case that needs a WRITTEN                                       
     record runs on a copy built here."""                                       
     d = TMP / name                                                             
     shutil.copytree(FIX, d)                                                    
     for lg in sorted((d / "custody" / "evidence").glob("harness-*.log")):      
         _stamp_logger_times(lg)                                                
     return d                                                                   
                                                                                
                                                                                
 LOGGED = logger_stamped("fixture-logged")                                      
                                                                                
                                                                                
