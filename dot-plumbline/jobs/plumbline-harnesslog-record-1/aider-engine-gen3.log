 def logger_stamped(name):                                                      
     """A copy of the job-rejected fixture whose harness logs carry the         
 logger's own sent_at and received_at on                                        
     every call -- the entry shape the frozen bar asserts                       
 (tests/test_evaluator_harness_log.py D1-D3: sent_at,                           
     received_at, request.url, response.model). The fixture's logs carry server 
 times only, so a MODEL evaluator's                                             
     check times have no logged source and the emitter REFUSES the record       
 (D6/D7); a case that needs a WRITTEN                                           
     record runs on this copy. Each call keeps the instant the fixture already  
 carries (its response `created`                                                
     epoch, else its Date header), so nothing the fixture asserts about its own 
 timeline moves."""                                                             
     d = TMP / name                                                             
     shutil.copytree(FIX, d)                                                    
     for lg in sorted((d / "custody" / "evidence").glob("harness-*.log")):      
         _stamp_logger_times(lg)                                                
     return d                                                                   
                                                                                

