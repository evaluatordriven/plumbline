USER def maker_history(job: Path, ev_dir: Path, ci: dict, m: dict, ref: H.Refusals, pin: dict | None = None,
USER                   gaps: Gaps | None = None, hand: dict | None = None) -> dict:
USER     """startedAt / producedAt / endpoint for a model maker, read from its harness log."""
USER     log = find_log(job, ev_dir, m.get("harness_log"), "harness-maker*.log")
USER     if log is None:
USER         ref.add("time", f"maker: a model maker needs its harness log (maker.harness_log, or exactly one "
USER                         f"harness-maker*.log in the evidence folder); none {'at ' + repr(m['harness_log']) if m.get('harness_log') else 'found'}, "
USER                         f"so startedAt, producedAt and the endpoint have no source")
USER         return {}
USER     # The emitter never writes its inputs (T7): the log is read as it is. Every call the logger did not stamp is
USER     # a hand time (T7b), whether or not it is the first or the last.
USER     log_calls = H.read_log(log, ref, "maker")
USER     flag_calls(log_calls, hand)
USER     calls = log_calls
USER     if m.get("calls"):
USER         calls = [c for c in calls if c.name in m["calls"]]
USER     calls = [c for c in calls if c.at]
USER     if not calls:
USER         return {}
USER     if gaps is not None and any("sent_at" in c.raw or "received_at" in c.raw for c in calls):
USER         for c in calls:
USER             missing = [k for k in ("sent_at", "received_at") if not c.raw.get(k)]
USER             if missing:
USER                 gaps.add(f"maker.{c.label}", f"the Maker harness call {c.label} carries no "
USER                           f"{' or '.join(missing)}; startedAt/producedAt cannot be read from the log")
USER     annotate(calls, "maker", (m.get("model") or {}).get("identifier"), ref, pin)
USER     check_pin_order(pin, calls, "maker", ref)
USER     first = min(calls, key=lambda c: c.started)
USER     last = max(calls, key=lambda c: c.at)
USER     started, produced = first.started, last.at
USER     H.cross_check(ref, "startedAt", ci.get("startedAt"), started, f"harness log {first.label}")
USER     H.cross_check(ref, "producedAt", ci.get("producedAt"), produced, f"harness log {last.label}")
USER     out = {"startedAt": H.iso(started), "producedAt": H.iso(produced), "endpoint": last.endpoint,
USER            "_calls": calls,
USER            "x": {**route_x(log, calls),
USER                  "startedAt_basis": (f"{first.label} sent_at" if first.sent else
USER                                      (f"{first.label} response created" if first.created else
USER                                       f"{first.label} response Date header")),
USER                  "producedAt_basis": (f"{last.label} received_at" if last.received else
USER                                       f"{last.label} {last.at_basis}"),
USER                  "startedAt_source": first.source_started(),
USER                  "producedAt_source": last.source_at()}}
USER     rx = routing_x(calls, pin, "maker", gaps if gaps is not None else Gaps())
USER     if rx:
USER         out["x"]["routing"] = rx
USER     hand_ep = (m.get("model") or {}).get("endpoint")
USER     if hand_ep and last.endpoint and hand_ep != last.endpoint:
USER         ref.add("endpoint", f"maker.model.endpoint: hand-entered {hand_ep!r} but {last.label} "
USER                             + (f"went to {last.host} and was answered upstream by {last.route.get('upstream_provider')!r} "
USER                                f"({last.endpoint})" if last.route.get("aggregator") else f"was answered by {last.endpoint}"))
USER     return out
USER 
