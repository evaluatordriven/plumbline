USER             elif budget["amount"] == 0 and round_cost > 0:
USER                 stop = BUDGET
USER         reading = {}
USER         evaluator_rows = []
USER         pass_rule = None
USER         mismatch = False
USER         scores = None
USER         if stop is None and result.get("rerun", {}).get("exit") != 0:
USER             observation = "rerun exit %s sha256 %s" % (
USER                 result["rerun"]["exit"], result["rerun"]["output_sha256"],
USER             )
USER             violation = {
USER                 "id": "gate",
USER                 "class": "artifact_missed_standard",
USER                 "dimension": None,
USER                 "observation": observation,
USER             }
USER             reading = {
USER                 "from": "gate",
USER                 "verdict": "regenerate",
USER                 "dimensions": [],
USER                 "violations": [violation],
USER             }
USER             pass_rule = "regenerate"
USER             defects.append({
USER                 "round": number,
USER                 "id": "gate",
USER                 "class": "artifact_missed_standard",
USER                 "dimension": None,
USER                 "observation": observation,
USER             })
USER         elif stop is None:
USER             ev_stop, ev_by, evaluator_rows, scores, mismatch, fired, eval_costs, eval_missing = _evaluate(
USER                 loaded, result, number, editable_copy, root, deadline, timeout_s, evaluator_fn, record_dir,
USER             )
USER             for one in eval_costs:
USER                 round_cost += one
USER                 spend += one
USER             if ev_stop:
USER                 stop, by = ev_stop, ev_by
USER             elif budget["amount"] > 0 and eval_missing:
USER                 stop = BUDGET_UNMEASURED
USER             elif budget["amount"] > 0 and spend >= budget["amount"]:
USER                 stop = BUDGET
USER             elif budget["amount"] == 0 and round_cost > 0:
USER                 stop = BUDGET
USER             elif fired:
USER                 stop = ESCALATION_CLASS
USER             else:
USER                 pass_rule = _pass_rule(scores, bounds)
USER                 if pass_rule == ACCEPTED:
USER                     stop = ACCEPTED
USER                     accepted_round = number
USER                 elif pass_rule == REJECTED:
USER                     stop = REJECTED
USER                 else:
USER                     pass_rule = "regenerate"
USER             parsed_rows = _parsed(evaluator_rows)
USER             if parsed_rows:
USER                 first = parsed_rows[0]
USER                 reading = {
USER                     "from": "evaluator",
USER                     "verdict": first.get("verdict"),
USER                     "dimensions": first.get("dimensions"),
USER                     "violations": first.get("violations"),
USER                 }
USER             if scores:
USER                 for parsed in parsed_rows:
USER                     for item in parsed.get("violations") or []:
USER                         defects.append({
USER                             "round": number,
USER                             "id": item.get("id"),
USER                             "class": item.get("class"),
USER                             "dimension": item.get("dimension"),
USER                             "observation": item.get("observation"),
USER                         })
USER                         if item.get("remedy"):
USER                             solutions.append({
USER                                 "round": number, "id": item.get("id"), "remedy": item.get("remedy"),
USER                             })
USER         if produced and stop not in (NO_ARTIFACT, PACKET_REFUSED):
USER             if best_round is None:
USER                 best_round, best_scores = number, scores
USER             elif scores and (best_scores is None or _better(scores, best_scores)):
USER                 best_round, best_scores = number, scores
USER         held = {"method": _HELD_METHOD, "result": "pass" if not leak else "fail", "by": "loop()"}
USER         _write_round(
USER             record_dir, number, result, _sha_file(findings_path), held,
USER             evaluator_rows, reading, pass_rule, mismatch, best_round, round_cost, stop,
USER             round_started_at, _stamp(),
USER         )
USER         last = number
USER         round_paths.append(os.path.join(record_dir, "round-%02d.json" % number))
USER         if stop:
USER             break
USER         if number == cap:
USER             stop = CAP_REACHED
USER             break
USER 
USER     if stop is None:
USER         stop = CAP_REACHED
USER     ended_at = _stamp()
USER     state, outcome = _STATES[stop]
USER     halt = {
USER         "terminal_state": state,
USER         "outcome": outcome,
USER         "stop": stop,
USER         "rounds": last,
USER         "cap": cap,
USER         "accepted_round": accepted_round,
USER         "best_round": best_round,
USER         "cost": spend,
USER         "separation_gaps": [_GAP_GATE, _GAP_ARCH] if stop != ACCEPTED else [],
USER         "rounds_sha256": [_sha_file(path) for path in round_paths],
