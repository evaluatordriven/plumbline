USER def line_in(path: Path, value, key: str | None = None) -> int | None:
USER     """The 1-based line of `path` that carries `value` (optionally under `"key":`), if any."""
USER     if value in (None, "") or not path.is_file():
USER         return None
USER     try:
USER         lines = path.read_text(encoding="utf-8").splitlines()
USER     except OSError:
USER         return None
USER     vs = str(value)
USER     hits = [n for n, ln in enumerate(lines, 1) if vs in ln and (key is None or f'"{key}"' in ln)]
USER     if not hits:
USER         hits = [n for n, ln in enumerate(lines, 1) if vs in ln]
USER     return hits[0] if hits else None
USER 
USER 
USER def load(p: Path):
USER     return json.loads(p.read_text(encoding="utf-8"))
USER 
USER 
USER def final_record(job: Path) -> tuple[Path | None, dict | None]:
USER     recs = []
USER     for f in job.glob("iteration-*-eval-record.json"):
USER         m = re.match(r"iteration-(\d+)-eval-record\.json$", f.name)
USER         if m:
USER             recs.append((int(m.group(1)), f))
USER     if not recs:
USER         return None, None
USER     recs.sort()
USER     return recs[-1][1], load(recs[-1][1])
USER 
USER 
USER def run_for(job: Path, iteration) -> dict | None:
USER     d = job / "inputs"
USER     for f in sorted(d.glob("*.json")) if d.is_dir() else []:
USER         try:
USER             r = load(f)
USER         except Exception:
USER             continue
USER         if isinstance(r, dict) and "passes" in r and r.get("iteration") == iteration:
USER             return r
USER     return None
