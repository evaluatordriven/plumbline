USER def clean_checkout(dest):
USER     """The emitter refuses to run from a dirty tree (it records its own commit), so the cases below run it from a
USER     throwaway clean commit of this working tree: tracked + untracked-but-not-ignored files, as `git status` sees them."""
USER     dest.mkdir(parents=True)
USER     g = subprocess.run(["git", "-C", str(REPO), "ls-files", "-co", "--exclude-standard", "-z"], capture_output=True, text=True)
USER     names = [n for n in g.stdout.split("\0") if n] if g.returncode == 0 else \
USER         [str(q.relative_to(REPO)) for q in REPO.rglob("*") if q.is_file() and ".git" not in q.parts and "__pycache__" not in q.parts]
USER     for n in names:
USER         if (REPO / n).is_file():
USER             (dest / n).parent.mkdir(parents=True, exist_ok=True)
USER             shutil.copy2(REPO / n, dest / n)
USER     git = ["git", "-C", str(dest), "-c", "user.name=test", "-c", "user.email=test@localhost", "-c", "commit.gpgsign=false"]
USER     for args in (["init", "-q"], ["add", "-A"], ["commit", "-qm", "clean checkout for custody tests"]):
USER         subprocess.run(git + args, capture_output=True, check=True)
USER     return dest
