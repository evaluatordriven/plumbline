USER # ---- V1/V3/T2: a record the emitter wrote verifies at both layers with exit 0 (the verifier's own logic) ----
USER def _stand_in_checkout(name):
USER     """A temp custody checkout holding a stand-in checker that refuses unless `--bar` is given (so a verifier
USER     that forgets it cannot pass again), pinned by its own sha256."""
USER     d = TMP / name
USER     (d / "checker").mkdir(parents=True)
USER     (d / "tools").mkdir(parents=True)
USER     checker = d / "checker" / "check.py"
USER     checker.write_text(
USER         "import json, sys\n"
USER         "from hashlib import sha256\n"
USER         "from pathlib import Path\n"
USER         "def arg(n):\n"
USER         "    a = sys.argv[1:]\n"
USER         "    return a[a.index(n) + 1] if n in a and a.index(n) + 1 < len(a) else None\n"
USER         "if not arg('--bar'):\n"
USER         "    print('checker: --bar is required', file=sys.stderr)\n"
USER         "    sys.exit(2)\n"
USER         "rec = Path(sys.argv[1])\n"
USER         "files = arg('--files')\n"
USER         "doc = json.loads(rec.read_text(encoding='utf-8'))\n"
USER         "for s in doc.get('subject') or []:\n"
USER         "    p = (Path(files) / s['name']) if files else None\n"
USER         "    want = (s.get('digest') or {}).get('sha256')\n"
USER         "    if p is None or not p.is_file() or sha256(p.read_bytes()).hexdigest() != want:\n"
USER         "        print('checker: subject mismatch for ' + str(s.get('name')), file=sys.stderr)\n"
USER         "        sys.exit(1)\n"
USER         "sys.exit(0)\n", encoding="utf-8")
USER     (d / "tools" / "pin.json").write_text(
USER         json.dumps({"checker/check.py": hashlib.sha256(checker.read_bytes()).hexdigest()}) + "\n",
USER         encoding="utf-8")
USER     return d
