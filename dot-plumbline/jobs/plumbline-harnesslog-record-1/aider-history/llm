USER     throwaway clean commit of this working tree: tracked + untracked-but-not-ignored files, as `git status` sees them."""
USER     dest.mkdir(parents=True)
USER     g = subprocess.run(["git", "-C", str(REPO), "ls-files", "-co", "--exclude-standard", "-z"], capture_output=True, text=True)
USER     names = [n for n in g.stdout.split("\0") if n] if g.returncode == 0 else \
USER         [str(q.relative_to(REPO)) for q in REPO.rglob("*") if q.is_file() and ".git" not in q.parts and "__pycache__" not in q.parts]
USER     for n in names:
