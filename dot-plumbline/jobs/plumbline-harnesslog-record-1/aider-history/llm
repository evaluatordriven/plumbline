USER def loop(packet, *, record_dir, cwd=None, timeout_s=600, commit=None, evaluator_fn=None) -> dict:
USER     """Run the rounds the packet names, then file the finish and return it.
USER 
USER     ``packet`` is a path or a loaded dict. A refusal writes ``escalation.json``
USER     and raises ``ValueError`` before any command runs; a refusal is not a
USER     finish. Every other end calls ``emit_custody_for_finish`` once, after the
USER     round records and a ``packet.json`` describing the finish exist, and only if
USER     that seam returns 0 does it file its finish — ``summary.json``, and
USER     ``escalation.json`` for a stop a human must see — and return the summary.
USER     If the seam returns 1, 2 or 3, or the finish's stamps came from a replaced
USER     clock, it raises ``CustodyNotDone`` with what the record would have said and
USER     writes neither file. This function sends nothing and does not start another
USER     loop.
USER     """
USER     started_at = _stamp()
USER     try:
USER         loaded, packet_sha = _load(packet)
USER     except Exception as exc:
USER         os.makedirs(record_dir, exist_ok=True)
USER         _refuse(
USER             record_dir,
USER             packet if isinstance(packet, dict) else {},
USER             ["packet could not be loaded: %s" % exc],
USER             started_at,
USER         )
USER         raise
USER     root = os.path.realpath(cwd) if cwd is not None else os.path.realpath(os.getcwd())
USER     problems = _problems(loaded, record_dir, root, evaluator_fn)
USER     os.makedirs(record_dir, exist_ok=True)
USER     if problems:
USER         _refuse(record_dir, loaded, problems, started_at)
USER         raise ValueError("; ".join(problems))
USER 
USER     freeze_bar(record_dir, root)
USER 
USER     artifact = loaded["artifact"]
USER     bounds = loaded["bounds"]
USER     budget = bounds["budget"]
USER     cap = bounds["cap"]
USER     deadline = time.monotonic() + float(budget["time_hours_lt"]) * 3600
USER     spend = 0.0
USER     best_round = None
USER     best_scores = None
USER     defects: list[dict] = []
USER     solutions: list[dict] = []
USER     round_paths: list[str] = []
USER     stop = None
USER     by = None
USER     accepted_round = None
USER     last = 0
USER 
USER     for number in range(1, cap + 1):
USER         remaining = deadline - time.monotonic()
USER         if remaining <= 0:
USER             stop = CLOCK
USER             break
USER         round_started_at = _stamp()
USER         if number > 1 and best_round is not None and best_round != number - 1:
USER             _restore(root, artifact["editable"], _editable_dir(record_dir, best_round))
USER         findings = {
USER             "round": number,
USER             "cap": cap,
USER             "best": None if best_round is None else {
USER                 "round": best_round,
USER                 "editable": _editable_dir(record_dir, best_round),
USER                 "sha256": _tree_sha(_editable_dir(record_dir, best_round)),
USER             },
USER             "defects": defects,
USER             "solutions": solutions,
USER         }
USER         try:
USER             leak = _held_out(json.dumps(findings), loaded["evaluator"].get("held_out") or [])
USER         except OSError as exc:
USER             stop = HELD_OUT_UNREADABLE
USER             _write_round(
USER                 record_dir, number, None, None,
USER                 {"method": _HELD_METHOD, "result": "fail", "by": "loop()", "reason": str(exc)},
USER                 None, None, None, False, best_round, 0, stop,
USER                 round_started_at, _stamp(),
USER             )
USER             last = number
USER             round_paths.append(os.path.join(record_dir, "round-%02d.json" % number))
USER             break
USER         findings_path = os.path.join(record_dir, "findings-%02d.json" % number)
USER         if leak:
USER             stop = HELD_OUT
USER             _write_round(
USER                 record_dir, number, None, None, {"method": _HELD_METHOD, "result": "fail", "by": "loop()"},
USER                 None, None, None, False, best_round, 0, stop,
USER                 round_started_at, _stamp(),
USER             )
USER             last = number
USER             round_paths.append(os.path.join(record_dir, "round-%02d.json" % number))
USER             break
USER         _dump(findings_path, findings)
USER         bound = remaining if timeout_s is None else min(timeout_s, remaining)
USER         clock_cut = timeout_s is None or remaining <= timeout_s
USER         cost_path = os.path.join(record_dir, "cost-%02d-maker.json" % number)
USER         try:
USER             result = run(
USER                 artifact["test_cmd"],
USER                 artifact["frozen"],
USER                 artifact["editable"],
USER                 loaded["maker"]["cmd"],
USER                 commit=commit,
USER                 cwd=root,
USER                 timeout_s=bound,
USER                 ignore=artifact.get("ignore") or [],
USER                 require_red=(number == 1),
USER                 maker_env={
USER                     "PLUMBLINE_FINDINGS": findings_path,
USER                     "PLUMBLINE_COST": cost_path,
USER                 },
USER             )
USER         except ValueError as exc:
USER             if number == 1:
USER                 _refuse(record_dir, loaded, [str(exc)], started_at)
USER             raise
USER         editable_copy = _editable_dir(record_dir, number)
USER         _snapshot_editable(root, artifact["editable"], editable_copy)
USER         produced = result.get("reason") != NO_ARTIFACT
USER         stop, by = _classify(result, clock_cut)
USER         if stop is None and time.monotonic() >= deadline:
USER             stop, by = CLOCK, None
USER         maker_cost = _take_cost(cost_path)
USER         round_cost = 0.0
USER         if maker_cost is not None:
USER             round_cost += maker_cost
