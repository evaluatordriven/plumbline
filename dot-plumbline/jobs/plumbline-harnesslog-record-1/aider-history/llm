USER class datetime(_datetime):
USER     """The module's clock seam: tests replace ``datetime.now`` on this name.
USER 
USER     ``datetime.datetime`` is an immutable C type, so ``now`` cannot be replaced
USER     on it; a subclass of it can be, and answers exactly as the base class does
USER     when it is not replaced.
USER     """
USER 
USER 
USER class CustodyNotDone(Exception):
USER     """A finish this module does not file. Exit 0 is the only done.
USER 
USER     ``loop()`` raises this instead of returning a summary for a finish whose
USER     stamps are not its own readings, or whose custody record the emitter could
USER     not write cleanly. ``exit_code`` is 1, 2 or 3 and is never 0: 1 the work was
USER     accepted; 2 the work was rejected, below the floor; 3 every stop a human
USER     must see. It files neither ``summary.json`` nor ``escalation.json``. It is
USER     not a ``ValueError``: a packet refusal stays one, because a refusal is not a
USER     finish.
USER 
USER     ``halt`` carries what the record would have said — the stop, its terminal
USER     state and outcome, the stamps, the rounds, the cap, the best round, the
USER     spend, the separation gaps and the hashes.
USER     """
USER 
USER     def __init__(self, halt, exit_code):
USER         super().__init__(
USER             "%s is not done (%s / %s) after %s of cap %s rounds, best round %s, "
USER             "cost %s; no summary and no escalation are filed"
USER             % (
USER                 halt["stop"], halt["terminal_state"], halt["outcome"],
USER                 halt["rounds"], halt["cap"], halt["best_round"], halt["cost"],
USER             )
USER         )
USER         self.halt = halt
USER         self.stop = halt["stop"]
USER         self.exit_code = exit_code
USER 
USER 
USER def _exit_code(stop) -> int:
USER     """1, 2 or 3 for a finish this module does not file. Never 0.
USER 
USER     1 — the work was accepted. 2 — the work was rejected, below the floor. 3 —
USER     a human must see the finish: every other stop. The exit code names what a
USER     caller would have had to route on; it is not a state and it is not a
USER     verdict.
USER     """
USER     if stop == ACCEPTED:
USER         return 1
USER     if stop == REJECTED:
USER         return 2
USER     return 3
USER 
USER 
USER def _own_clock() -> bool:
USER     """True while ``datetime.now`` is this module's clock and not a replacement.
USER 
USER     ``datetime`` is the clock seam. A run that replaces ``now`` on it supplies
USER     every ``started_at`` and ``ended_at`` the round records and the finish
USER     carry, so those stamps are not readings this module took, and a finish
USER     resting on them cannot be filed cleanly: ``loop()`` raises
USER     ``CustodyNotDone`` for it. Nothing replaces the clock in a real run, so a
USER     real finish is always filed.
USER 
USER     An unpatched ``now`` is inherited from the base class and is bound to this
USER     class; a replacement lives in this class's own namespace (or is bound to
USER     the object that supplies it).
USER     """
USER     if "now" in datetime.__dict__:
USER         return False
USER     return getattr(datetime.now, "__self__", None) is datetime
USER 
