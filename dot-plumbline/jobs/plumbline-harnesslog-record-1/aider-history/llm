USER def build(job: Path, inputs_path: Path, ref: H.Refusals | None = None, now: datetime | None = None,
USER           expect: str | None = None, allow_hand: bool = False) -> tuple[dict, Gaps, list[str]]:
USER     gaps, notes = Gaps(), []
USER     ref = ref if ref is not None else H.Refusals()
USER     now = now or datetime.now(timezone.utc).replace(microsecond=0)
USER     packet = load(job / "packet.json")
USER     if is_loop_finish(packet, job):
USER         return build_finish(job, packet, gaps, ref, now, expect, allow_hand)
USER     have_inputs = inputs_path.is_file()
USER     ci = load(inputs_path) if have_inputs else None
USER     if ci is None:
USER         gaps.add("inputs/custody.json", f"no custody inputs at {inputs_path.relative_to(job) if inputs_path.is_relative_to(job) else inputs_path}: "
USER                  "bar, approvals, maker, evaluators, controls and retention have no source")
USER         ci = {}
USER     job_id = packet.get("job_id") or job.name
