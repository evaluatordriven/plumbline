USER     git = ["git", "-C", str(dest), "-c", "user.name=test", "-c", "user.email=test@localhost", "-c", "commit.gpgsign=false"]
USER     for args in (["init", "-q"], ["add", "-A"], ["commit", "-qm", "clean checkout for custody tests"]):
