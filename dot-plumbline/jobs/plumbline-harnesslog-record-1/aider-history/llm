USER def relay_only_buyer(ci: dict, packet: dict, lines: list[tuple[int, dict]]) -> bool:
USER     """A buyer approval is relay-only when a relay line is its only evidence: no `approve --role buyer` ledger
USER     line and no buyer entry in inputs/custody.json (F1f). A relay is a report, never an approval."""
