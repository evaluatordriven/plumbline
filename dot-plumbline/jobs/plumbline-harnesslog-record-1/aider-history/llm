USER             # the event does not carry is not compared (the ledger is not required to restate it).
USER             for k in ("by", "at"):
USER                 if a.get(k) and live.get(k) and live.get(k) != a.get(k):
USER                     ref.add("time" if k == "at" else "approval",
USER                             f"bar.approvals[{i}].{k}: the ledger says {a.get(k)!r} but {LEDGER_REL} "
USER                             f"logged {live.get(k)!r} when it happened")
USER             xa["time_source"] = "logged live (inputs/custody-events.jsonl)"
USER             if live.get("at"):
USER                 xa["at_source"] = f"{LEDGER_REL}:{live['_line']}"
USER         elif a.get("at"):
USER             n = line_in(inputs_path, a.get("at"), "at")
USER             if n:
USER                 xa["at_source"] = f"{rel_inputs}:{n}"
USER         if xa.get("at_source"):
USER             xp["sources"][f"bar.approvals[{i}].at"] = xa["at_source"]
