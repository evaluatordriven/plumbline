USER def _file_finish(record_dir, packet, halt, round_paths, best_round, by):
USER     """Write the finish: ``summary.json``, and an escalation for a stop.
USER 
USER     ``summary.json`` is what the finish says. ``escalation.json`` is written
USER     only for a stop a human must see — never for an accepted finish — and
USER     carries the route and holders the packet names, the best round's snapshot,
USER     one row per written round record with its sha256, the seat that made the
USER     stop (``by``) and the stamps. The question, diagnosis, why-unobservable,
USER     options, recommendation, proposed packet and decision are the Architect's
USER     to write; this module leaves them null.
USER     """
USER     _dump(os.path.join(record_dir, "summary.json"), halt)
USER     if halt["stop"] == ACCEPTED:
USER         return
USER     escalation = packet.get("escalation") if isinstance(packet.get("escalation"), dict) else {}
USER     best = None
USER     if best_round is not None:
USER         editable = _editable_dir(record_dir, best_round)
USER         best = {"round": best_round, "editable": editable, "sha256": _tree_sha(editable)}
USER     _dump(os.path.join(record_dir, "escalation.json"), {
