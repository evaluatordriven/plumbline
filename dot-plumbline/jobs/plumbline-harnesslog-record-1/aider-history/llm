USER def freeze_bar(record_dir, root):
USER     """Freeze the bar in the ledger, live, before the Maker is dispatched.
USER 
USER     The bar is the one the job declares: ``bar.file`` in
USER     ``record_dir/inputs/custody.json``, taken from the same relative path under
USER     ``root``; when nothing is declared, the convention file
USER     ``<root>/custody/bar.md``. The ledger tool names a bar relative to the job
USER     directory, so the bar's bytes are copied there unchanged and the tool is
USER     pointed at that copy. The tool stamps the freeze from its own clock and
USER     appends the event to ``inputs/custody-events.jsonl``; this module types no
USER     time.
USER 
USER     A declared bar that cannot be read fails closed: this raises, naming the
USER     declared path, before the Maker command runs — no Maker call and no
USER     ``emit_custody.py`` run. A job is custody-bearing when
USER     ``record_dir/inputs/custody.json`` exists or the convention bar exists. A
USER     custody-bearing job that names no ``bar.file`` and has no convention bar
USER     also fails closed: the presence of the custody inputs removes the skip
USER     path, so it cannot lose its bar silently. A caller that prepared neither
USER     signal is not refused: nothing is frozen and nothing is written.
USER     """
USER     job = os.path.abspath(str(record_dir))
USER     declared = os.path.join(job, "inputs", "custody.json")
USER     convention = os.path.join(root, "custody", "bar.md")
USER     rel = _declared_bar(job)
USER     if rel is None:
USER         if not os.path.isfile(convention):
USER             if os.path.isfile(declared):
USER                 raise RuntimeError(
USER                     "job is custody-bearing but names no bar.file in %s and no convention bar "
USER                     "exists at %s; cannot freeze before dispatch" % (declared, convention)
USER                 )
USER             return
USER         rel = "custody/bar.md"
USER     source = os.path.join(root, rel)
USER     if os.path.isabs(rel) or not os.path.isfile(source):
USER         raise RuntimeError("no bar file at %s; cannot freeze before dispatch" % source)
USER     dest = os.path.join(job, rel)
USER     if not _inside(os.path.realpath(dest), os.path.realpath(job)):
USER         raise RuntimeError("declared bar %s is outside the job directory; cannot freeze" % rel)
USER     os.makedirs(os.path.dirname(dest), exist_ok=True)
USER     shutil.copyfile(source, dest)
USER     ledger = os.path.join(os.path.dirname(os.path.abspath(__file__)), "custody_ledger.py")
USER     proc = subprocess.run(
USER         [sys.executable, ledger, "freeze", "--job-dir", job, "--bar", rel],
USER         capture_output=True,
USER         text=True,
USER     )
USER     if proc.returncode != 0:
USER         detail = (proc.stderr or proc.stdout or "").strip() or "exit %s" % proc.returncode
USER         raise RuntimeError("the bar could not be frozen in %s: %s" % (job, detail))
USER 
USER 
USER def _declared_bar(job):
USER     """``bar.file`` from ``<job>/inputs/custody.json``, or None if not declared.
USER 
USER     A missing, unreadable or malformed file declares nothing, so the caller may
USER     still fall back to the convention bar. A named bar is returned as written:
USER     a path that cannot be read is then named in the failure, which is what the
USER     fail-closed rule requires.
USER     """
USER     path = os.path.join(job, "inputs", "custody.json")
USER     if not os.path.isfile(path):
USER         return None
USER     try:
USER         with open(path, encoding="utf-8") as handle:
USER             body = json.load(handle)
USER     except (OSError, ValueError):
USER         return None
USER     bar = body.get("bar") if isinstance(body, dict) else None
USER     rel = bar.get("file") if isinstance(bar, dict) else None
USER     if not isinstance(rel, str) or not rel.strip():
USER         return None
USER     return rel
USER 
