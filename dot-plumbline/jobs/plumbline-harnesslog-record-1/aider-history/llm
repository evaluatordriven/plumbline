USER def time_sources(pred: dict, xp: dict) -> dict:
USER     """Every time field the record carries -> the `file:line` that carries it (custody N3).
USER 
USER     `x-plumbline.sources` holds only `file:line` strings; this copies it and adds the per-check, per-control
USER     and per-approval entries under their index keys, so a reader can look a field up by either name."""
USER     out = {k: v for k, v in (xp.get("sources") or {}).items() if isinstance(v, str) and v}
USER     if out.get("bar.frozenAt"):
USER         out.setdefault("frozenAt", out["bar.frozenAt"])
USER     bar = pred.get("bar") or {}
USER     for i, a in enumerate(bar.get("approvals") or []):
USER         s = (a.get("x-plumbline") or {}).get("at_source")
USER         if s:
USER             out[f"bar.approvals[{i}].at"] = s
USER             out[f"approvals[{i}].at"] = s
USER     for i, c in enumerate(pred.get("checks") or []):
USER         s = (c.get("x-plumbline") or {}).get("at_source")
USER         if s:
USER             out[f"checks[{i}].at"] = s
USER     for i, k in enumerate(pred.get("controls") or []):
USER         s = (k.get("x-plumbline") or {}).get("at_source")
USER         if s:
USER             out[f"controls[{i}].at"] = s
USER     return out
USER 
