USER def check_pin_order(pin: dict | None, calls, who: str, ref: H.Refusals) -> None:
USER     if not pin or not calls:
USER         return
USER     first = min(calls, key=lambda c: c.started)
USER     at = H.parse_ts(pin.get("declaredAt"))
USER     if at is None or at > first.started:
USER         ref.add("order", f"{who}: provider pin declared at {pin.get('declaredAt')!r}, after the seat's first call "
USER                          f"{first.label} ({H.iso(first.started)}); a pin chosen after the calls is not a pin")
USER 
