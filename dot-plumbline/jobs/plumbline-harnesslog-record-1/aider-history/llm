USER     if ev_log["_file"]:
USER         xp["events_log"] = ev_log["_file"]
USER     lines = ledger_lines(job)
USER     hand: dict[str, dict] = {}
USER 
USER     def mark(field: str, file: str, line, source: str) -> None:
