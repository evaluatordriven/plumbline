ASSISTANT def _check(value, schema, root, where):
ASSISTANT     """Errors for ``value`` against ``schema``; an empty list means it validates.
ASSISTANT 
ASSISTANT     Covers the Draft 2020-12 keywords the job-packet schema uses: local
ASSISTANT     ``$ref``, ``type``, ``const``, ``enum``, ``required``, ``properties``,
ASSISTANT     ``additionalProperties``, ``minProperties``, ``items``, ``minItems``,
ASSISTANT     ``minLength``, ``pattern``, ``minimum``, ``allOf``, ``anyOf``, ``oneOf``,
ASSISTANT     ``not`` and ``if``/``then``/``else``. A keyword it does not know is not
ASSISTANT     silently satisfied by a guess elsewhere; it simply asserts nothing.
ASSISTANT     """
ASSISTANT     if schema is True:
ASSISTANT         return []
ASSISTANT     if schema is False:
ASSISTANT         return [_at(where, "no value is allowed here")]
ASSISTANT     if not isinstance(schema, dict):
ASSISTANT         return [_at(where, "the schema is not an object")]
ASSISTANT     errors = []
ASSISTANT     reference = schema.get("$ref")
ASSISTANT     if isinstance(reference, str):
ASSISTANT         errors.extend(_check(value, _deref(root, reference), root, where))
ASSISTANT     allowed = schema.get("type")
ASSISTANT     if allowed is not None:
ASSISTANT         names = allowed if isinstance(allowed, list) else [allowed]
ASSISTANT         if not any(_of_type(value, name) for name in names):
ASSISTANT             errors.append(
ASSISTANT                 _at(where, "%s is not of type %s" % (_shown(value), ", ".join(names)))
ASSISTANT             )
ASSISTANT             return errors
ASSISTANT     if "const" in schema and value != schema["const"]:
ASSISTANT         errors.append(_at(where, "%s is not %s" % (_shown(value), _shown(schema["const"]))))
ASSISTANT     enumeration = schema.get("enum")
ASSISTANT     if isinstance(enumeration, list) and value not in enumeration:
ASSISTANT         errors.append(_at(where, "%s is not one of %s" % (_shown(value), _shown(enumeration))))
ASSISTANT     if isinstance(value, dict):
ASSISTANT         errors.extend(_check_object(value, schema, root, where))
ASSISTANT     elif isinstance(value, list):
ASSISTANT         errors.extend(_check_array(value, schema, root, where))
ASSISTANT     elif isinstance(value, str):
ASSISTANT         errors.extend(_check_string(value, schema, where))
ASSISTANT     elif _is_number(value):
ASSISTANT         errors.extend(_check_number(value, schema, where))
ASSISTANT     errors.extend(_check_combinators(value, schema, root, where))
ASSISTANT     return errors
ASSISTANT 
ASSISTANT 
ASSISTANT def _check_object(value, schema, root, where):
ASSISTANT     errors = []
ASSISTANT     required = schema.get("required")
ASSISTANT     if isinstance(required, list):
ASSISTANT         for name in required:
ASSISTANT             if name not in value:
ASSISTANT                 errors.append("'%s' is a required property" % name)
ASSISTANT     properties = schema.get("properties")
ASSISTANT     properties = properties if isinstance(properties, dict) else {}
ASSISTANT     for name, subschema in properties.items():
ASSISTANT         if name in value:
ASSISTANT             errors.extend(_check(value[name], subschema, root, name))
ASSISTANT     additional = schema.get("additionalProperties")
ASSISTANT     if additional is False:
ASSISTANT         for name in value:
ASSISTANT             if name not in properties:
ASSISTANT                 errors.append(_at(where, "'%s' is not a declared property" % name))
ASSISTANT     elif isinstance(additional, dict):
ASSISTANT         for name in value:
ASSISTANT             if name not in properties:
ASSISTANT                 errors.extend(_check(value[name], additional, root, name))
ASSISTANT     least = schema.get("minProperties")
ASSISTANT     if _is_number(least) and len(value) < least:
ASSISTANT         errors.append(_at(where, "fewer than %s properties" % least))
ASSISTANT     return errors
ASSISTANT 
ASSISTANT 
ASSISTANT def _check_array(value, schema, root, where):
ASSISTANT     errors = []
ASSISTANT     least = schema.get("minItems")
ASSISTANT     if _is_number(least) and len(value) < least:
ASSISTANT         errors.append(_at(where, "fewer than %s items" % least))
ASSISTANT     items = schema.get("items")
ASSISTANT     if isinstance(items, dict):
ASSISTANT         for index, item in enumerate(value):
ASSISTANT             errors.extend(_check(item, items, root, "%s[%d]" % (where, index)))
ASSISTANT     elif isinstance(items, list):
ASSISTANT         for index, (item, subschema) in enumerate(zip(value, items)):
ASSISTANT             errors.extend(_check(item, subschema, root, "%s[%d]" % (where, index)))
ASSISTANT     return errors
ASSISTANT 
ASSISTANT 
ASSISTANT def _check_string(value, schema, where):
ASSISTANT     errors = []
ASSISTANT     least = schema.get("minLength")
ASSISTANT     if _is_number(least) and len(value) < least:
ASSISTANT         errors.append(_at(where, "shorter than %s characters" % least))
ASSISTANT     pattern = schema.get("pattern")
ASSISTANT     if isinstance(pattern, str) and re.search(pattern, value) is None:
ASSISTANT         errors.append(_at(where, "%s does not match %r" % (_shown(value), pattern)))
ASSISTANT     return errors
ASSISTANT 
ASSISTANT 
ASSISTANT def _check_number(value, schema, where):
ASSISTANT     errors = []
ASSISTANT     least = schema.get("minimum")
ASSISTANT     if _is_number(least) and value < least:
ASSISTANT         errors.append(_at(where, "%s is below %s" % (_shown(value), least)))
ASSISTANT     return errors
ASSISTANT 
