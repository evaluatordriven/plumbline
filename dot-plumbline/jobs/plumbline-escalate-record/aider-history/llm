USER def _file_finish(record_dir, packet, halt, round_paths, best_round, by):
USER     """Write the finish: ``summary.json``, and an escalation for a stop.
USER 
USER     ``summary.json`` is what the finish says. ``escalation.json`` is written
USER     only for a stop a human must see — never for an accepted finish — and
USER     carries the route and holders the packet names, the best round's snapshot,
USER     one row per written round record with its sha256, the seat that made the
USER     stop (``by``) and the stamps. The question, diagnosis, why-unobservable,
USER     options, recommendation, proposed packet and decision are the Architect's
USER     to write; this module leaves them null.
USER     """
USER     _dump(os.path.join(record_dir, "summary.json"), halt)
USER     if halt["stop"] == ACCEPTED:
USER         return
USER     escalation = packet.get("escalation") if isinstance(packet.get("escalation"), dict) else {}
USER     best = None
USER     if best_round is not None:
USER         editable = _editable_dir(record_dir, best_round)
USER         best = {"round": best_round, "editable": editable, "sha256": _tree_sha(editable)}
USER     _dump(os.path.join(record_dir, "escalation.json"), {
USER         "terminal_state": halt["terminal_state"],
USER         "outcome": halt["outcome"],
USER         "stop": halt["stop"],
USER         "escalation_kind": _KINDS.get(halt["stop"], "other"),
USER         "route": escalation.get("route"),
USER         "human_seat": packet.get("human_seat"),
USER         "holders": escalation.get("holders"),
USER         "problems": [],
USER         "question": None,
USER         "diagnosis": None,
USER         "why_unobservable": None,
USER         "options": None,
USER         "recommendation": None,
USER         "proposed_packet": None,
USER         "decision": None,
USER         "best": best,
USER         "tried": [
USER             {"round": index + 1, "record": path, "record_sha256": _sha_file(path)}
USER             for index, path in enumerate(round_paths)
USER         ],
USER         "by": by or "loop()",
USER         "started_at": halt["started_at"],
USER         "ended_at": halt["ended_at"],
USER     })
USER 
USER 
USER def _stamp() -> str:
USER     """Now, as every record this module writes spells it."""
USER     return datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")
USER 
USER 
USER def _load(packet):
USER     if isinstance(packet, (str, os.PathLike)):
USER         raw = open(packet, "rb").read()
USER         return json.loads(raw.decode("utf-8")), hashlib.sha256(raw).hexdigest()
USER     raw = json.dumps(packet, sort_keys=True).encode("utf-8")
USER     return packet, hashlib.sha256(raw).hexdigest()
USER 
USER 
USER def _problems(packet, record_dir, root, evaluator_fn) -> list[str]:
