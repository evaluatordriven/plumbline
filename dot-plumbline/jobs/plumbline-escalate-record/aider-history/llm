ASSISTANT def _of_type(value, name):
ASSISTANT     if name == "object":
ASSISTANT         return isinstance(value, dict)
ASSISTANT     if name == "array":
ASSISTANT         return isinstance(value, list)
ASSISTANT     if name == "string":
ASSISTANT         return isinstance(value, str)
ASSISTANT     if name == "boolean":
ASSISTANT         return isinstance(value, bool)
ASSISTANT     if name == "null":
ASSISTANT         return value is None
ASSISTANT     if name == "integer":
ASSISTANT         return _is_number(value) and float(value).is_integer()
ASSISTANT     if name == "number":
ASSISTANT         return _is_number(value)
ASSISTANT     raise ValueError("unknown type name: %s" % name)
ASSISTANT 
