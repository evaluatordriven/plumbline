ASSISTANT def _deref(root, reference):
ASSISTANT     if not reference.startswith("#"):
ASSISTANT         raise ValueError("only a local reference can be resolved: %s" % reference)
ASSISTANT     node = root
ASSISTANT     pointer = reference[1:]
ASSISTANT     if pointer:
ASSISTANT         for part in pointer.split("/"):
ASSISTANT             part = part.replace("~1", "/").replace("~0", "~")
ASSISTANT             if part:
ASSISTANT                 node = node[part]
ASSISTANT     return node
ASSISTANT 
