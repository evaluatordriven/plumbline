ASSISTANT def _check_combinators(value, schema, root, where):
ASSISTANT     errors = []
ASSISTANT     for subschema in schema.get("allOf") or []:
ASSISTANT         errors.extend(_check(value, subschema, root, where))
ASSISTANT     any_of = schema.get("anyOf")
ASSISTANT     if isinstance(any_of, list) and any_of:
ASSISTANT         if all(_check(value, subschema, root, where) for subschema in any_of):
ASSISTANT             errors.append(_at(where, "matches none of the anyOf alternatives"))
ASSISTANT     one_of = schema.get("oneOf")
ASSISTANT     if isinstance(one_of, list):
ASSISTANT         hits = sum(1 for subschema in one_of if not _check(value, subschema, root, where))
ASSISTANT         if hits != 1:
ASSISTANT             errors.append(_at(where, "matches %d of the oneOf alternatives" % hits))
ASSISTANT     negated = schema.get("not")
ASSISTANT     if isinstance(negated, (dict, bool)):
ASSISTANT         if not _check(value, negated, root, where):
ASSISTANT             errors.append(_at(where, "matches a 'not' schema that forbids it"))
ASSISTANT     condition = schema.get("if")
ASSISTANT     if isinstance(condition, (dict, bool)):
ASSISTANT         if not _check(value, condition, root, where):
ASSISTANT             if "then" in schema:
ASSISTANT                 errors.extend(_check(value, schema["then"], root, where))
ASSISTANT         elif "else" in schema:
ASSISTANT             errors.extend(_check(value, schema["else"], root, where))
ASSISTANT     return errors
ASSISTANT 
