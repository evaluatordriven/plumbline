USER def loop(packet, *, record_dir, cwd=None, timeout_s=600, commit=None, evaluator_fn=None) -> dict:
USER     """Run the rounds the packet names, then file the finish and return it.
USER 
USER     ``packet`` is a path or a loaded dict. A refusal writes ``escalation.json``
USER     and raises ``ValueError`` before any command runs; a refusal is not a
USER     finish. Every other end calls ``emit_custody_for_finish`` once, after the
USER     round records and a ``packet.json`` describing the finish exist, and only if
USER     that seam returns 0 does it file its finish — ``summary.json``, and
USER     ``escalation.json`` for a stop a human must see — and return the summary.
USER     If the seam returns 1, 2 or 3, or the finish's stamps came from a replaced
USER     clock, it raises ``CustodyNotDone`` with what the record would have said and
USER     writes neither file. This function sends nothing and does not start another
USER     loop.
USER     """
USER     started_at = _stamp()
USER     try:
USER         loaded, packet_sha = _load(packet)
USER     except Exception as exc:
USER         os.makedirs(record_dir, exist_ok=True)
USER         _refuse(
USER             record_dir,
USER             packet if isinstance(packet, dict) else {},
USER             ["packet could not be loaded: %s" % exc],
USER             started_at,
USER         )
USER         raise
USER     root = os.path.realpath(cwd) if cwd is not None else os.path.realpath(os.getcwd())
USER     problems = _problems(loaded, record_dir, root, evaluator_fn)
USER     os.makedirs(record_dir, exist_ok=True)
USER     if problems:
USER         _refuse(record_dir, loaded, problems, started_at)
USER         raise ValueError("; ".join(problems))
USER 
USER     artifact = loaded["artifact"]
USER     bounds = loaded["bounds"]
USER     budget = bounds["budget"]
USER     cap = bounds["cap"]
USER     deadline = time.monotonic() + float(budget["time_hours_lt"]) * 3600
USER     spend = 0.0
USER     best_round = None
USER     best_scores = None
USER     defects: list[dict] = []
USER     solutions: list[dict] = []
USER     round_paths: list[str] = []
USER     stop = None
USER     by = None
USER     accepted_round = None
USER     last = 0
USER 
USER     for number in range(1, cap + 1):
USER         remaining = deadline - time.monotonic()
USER         if remaining <= 0:
USER             stop = CLOCK
USER             break
USER         round_started_at = _stamp()
USER         if number > 1 and best_round is not None and best_round != number - 1:
USER             _restore(root, artifact["editable"], _editable_dir(record_dir, best_round))
USER         findings = {
USER             "round": number,
USER             "cap": cap,
USER             "best": None if best_round is None else {
USER                 "round": best_round,
USER                 "editable": _editable_dir(record_dir, best_round),
USER                 "sha256": _tree_sha(_editable_dir(record_dir, best_round)),
USER             },
USER             "defects": defects,
USER             "solutions": solutions,
USER         }
USER         try:
USER             leak = _held_out(json.dumps(findings), loaded["evaluator"].get("held_out") or [])
USER         except OSError as exc:
USER             stop = HELD_OUT_UNREADABLE
USER             _write_round(
USER                 record_dir, number, None, None,
USER                 {"method": _HELD_METHOD, "result": "fail", "by": "loop()", "reason": str(exc)},
USER                 None, None, None, False, best_round, 0, stop,
USER                 round_started_at, _stamp(),
USER             )
USER             last = number
USER             round_paths.append(os.path.join(record_dir, "round-%02d.json" % number))
USER             break
USER         findings_path = os.path.join(record_dir, "findings-%02d.json" % number)
USER         if leak:
USER             stop = HELD_OUT
USER             _write_round(
USER                 record_dir, number, None, None, {"method": _HELD_METHOD, "result": "fail", "by": "loop()"},
USER                 None, None, None, False, best_round, 0, stop,
USER                 round_started_at, _stamp(),
USER             )
USER             last = number
USER             round_paths.append(os.path.join(record_dir, "round-%02d.json" % number))
USER             break
USER         _dump(findings_path, findings)
USER         bound = remaining if timeout_s is None else min(timeout_s, remaining)
USER         clock_cut = timeout_s is None or remaining <= timeout_s
USER         cost_path = os.path.join(record_dir, "cost-%02d-maker.json" % number)
USER         try:
USER             result = run(
USER                 artifact["test_cmd"],
USER                 artifact["frozen"],
USER                 artifact["editable"],
USER                 loaded["maker"]["cmd"],
USER                 commit=commit,
USER                 cwd=root,
USER                 timeout_s=bound,
USER                 ignore=artifact.get("ignore") or [],
USER                 require_red=(number == 1),
USER                 maker_env={
USER                     "PLUMBLINE_FINDINGS": findings_path,
USER                     "PLUMBLINE_COST": cost_path,
USER                 },
USER             )
USER         except ValueError as exc:
USER             if number == 1:
USER                 _refuse(record_dir, loaded, [str(exc)], started_at)
USER             raise
USER         editable_copy = _editable_dir(record_dir, number)
USER         _snapshot_editable(root, artifact["editable"], editable_copy)
USER         produced = result.get("reason") != NO_ARTIFACT
USER         stop, by = _classify(result, clock_cut)
USER         if stop is None and time.monotonic() >= deadline:
USER             stop, by = CLOCK, None
USER         maker_cost = _take_cost(cost_path)
USER         round_cost = 0.0
USER         if maker_cost is not None:
USER             round_cost += maker_cost
USER             spend += maker_cost
USER         if stop is None and budget["amount"] > 0 and maker_cost is None:
USER             stop = BUDGET_UNMEASURED
USER         elif stop is None:
USER             if budget["amount"] > 0 and spend >= budget["amount"]:
USER                 stop = BUDGET
USER             elif budget["amount"] == 0 and round_cost > 0:
USER                 stop = BUDGET
USER         reading = {}
USER         evaluator_rows = []
USER         pass_rule = None
USER         mismatch = False
USER         scores = None
USER         if stop is None and result.get("rerun", {}).get("exit") != 0:
USER             observation = "rerun exit %s sha256 %s" % (
USER                 result["rerun"]["exit"], result["rerun"]["output_sha256"],
USER             )
USER             violation = {
USER                 "id": "gate",
USER                 "class": "artifact_missed_standard",
USER                 "dimension": None,
USER                 "observation": observation,
USER             }
USER             reading = {
USER                 "from": "gate",
USER                 "verdict": "regenerate",
USER                 "dimensions": [],
USER                 "violations": [violation],
USER             }
USER             pass_rule = "regenerate"
USER             defects.append({
USER                 "round": number,
USER                 "id": "gate",
USER                 "class": "artifact_missed_standard",
USER                 "dimension": None,
USER                 "observation": observation,
USER             })
USER         elif stop is None:
USER             ev_stop, ev_by, evaluator_rows, scores, mismatch, fired, eval_costs, eval_missing = _evaluate(
USER                 loaded, result, number, editable_copy, root, deadline, timeout_s, evaluator_fn, record_dir,
USER             )
USER             for one in eval_costs:
USER                 round_cost += one
USER                 spend += one
USER             if ev_stop:
USER                 stop, by = ev_stop, ev_by
USER             elif budget["amount"] > 0 and eval_missing:
USER                 stop = BUDGET_UNMEASURED
USER             elif budget["amount"] > 0 and spend >= budget["amount"]:
USER                 stop = BUDGET
USER             elif budget["amount"] == 0 and round_cost > 0:
USER                 stop = BUDGET
USER             elif fired:
USER                 stop = ESCALATION_CLASS
USER             else:
USER                 pass_rule = _pass_rule(scores, bounds)
USER                 if pass_rule == ACCEPTED:
USER                     stop = ACCEPTED
USER                     accepted_round = number
USER                 elif pass_rule == REJECTED:
USER                     stop = REJECTED
USER                 else:
USER                     pass_rule = "regenerate"
USER             parsed_rows = _parsed(evaluator_rows)
USER             if parsed_rows:
USER                 first = parsed_rows[0]
USER                 reading = {
USER                     "from": "evaluator",
USER                     "verdict": first.get("verdict"),
USER                     "dimensions": first.get("dimensions"),
USER                     "violations": first.get("violations"),
USER                 }
USER             if scores:
USER                 for parsed in parsed_rows:
USER                     for item in parsed.get("violations") or []:
USER                         defects.append({
USER                             "round": number,
USER                             "id": item.get("id"),
USER                             "class": item.get("class"),
USER                             "dimension": item.get("dimension"),
USER                             "observation": item.get("observation"),
USER                         })
USER                         if item.get("remedy"):
USER                             solutions.append({
USER                                 "round": number, "id": item.get("id"), "remedy": item.get("remedy"),
USER                             })
USER         if produced and stop not in (NO_ARTIFACT, PACKET_REFUSED):
USER             if best_round is None:
USER                 best_round, best_scores = number, scores
USER             elif scores and (best_scores is None or _better(scores, best_scores)):
USER                 best_round, best_scores = number, scores
USER         held = {"method": _HELD_METHOD, "result": "pass" if not leak else "fail", "by": "loop()"}
USER         _write_round(
USER             record_dir, number, result, _sha_file(findings_path), held,
USER             evaluator_rows, reading, pass_rule, mismatch, best_round, round_cost, stop,
USER             round_started_at, _stamp(),
USER         )
USER         last = number
USER         round_paths.append(os.path.join(record_dir, "round-%02d.json" % number))
USER         if stop:
USER             break
USER         if number == cap:
USER             stop = CAP_REACHED
USER             break
USER 
USER     if stop is None:
USER         stop = CAP_REACHED
USER     ended_at = _stamp()
USER     state, outcome = _STATES[stop]
USER     halt = {
USER         "terminal_state": state,
USER         "outcome": outcome,
USER         "stop": stop,
USER         "rounds": last,
USER         "cap": cap,
USER         "accepted_round": accepted_round,
USER         "best_round": best_round,
USER         "cost": spend,
USER         "separation_gaps": [_GAP_GATE, _GAP_ARCH] if stop != ACCEPTED else [],
USER         "rounds_sha256": [_sha_file(path) for path in round_paths],
USER         "packet_sha256": packet_sha,
USER         "commit": conductor_software.record_field(commit),
USER         "started_at": started_at,
USER         "ended_at": ended_at,
USER     }
USER     if not _own_clock():
USER         raise CustodyNotDone(halt, _exit_code(stop))
USER     _dump(os.path.join(record_dir, "packet.json"), _custody_packet(loaded, halt))
USER     code = emit_custody_for_finish(record_dir, halt)
USER     if code != 0:
USER         raise CustodyNotDone(halt, code if code in (1, 2, 3) else 3)
USER     _file_finish(record_dir, loaded, halt, round_paths, best_round, by)
USER     return halt
