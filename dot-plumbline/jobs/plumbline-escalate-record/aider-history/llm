USER class datetime(_datetime):
USER     """The module's clock seam: tests replace ``datetime.now`` on this name.
USER 
USER     ``datetime.datetime`` is an immutable C type, so ``now`` cannot be replaced
USER     on it; a subclass of it can be, and answers exactly as the base class does
USER     when it is not replaced.
USER     """
USER 
USER 
USER class CustodyNotDone(Exception):
USER     """A finish this module does not file. Exit 0 is the only done.
USER 
USER     ``loop()`` raises this instead of returning a summary for a finish whose
USER     stamps are not its own readings, or whose custody record the emitter could
USER     not write cleanly. ``exit_code`` is 1, 2 or 3 and is never 0: 1 the work was
USER     accepted; 2 the work was rejected, below the floor; 3 every stop a human
USER     must see. It files neither ``summary.json`` nor ``escalation.json``. It is
USER     not a ``ValueError``: a packet refusal stays one, because a refusal is not a
USER     finish.
USER 
USER     ``halt`` carries what the record would have said — the stop, its terminal
USER     state and outcome, the stamps, the rounds, the cap, the best round, the
USER     spend, the separation gaps and the hashes.
USER     """
USER 
USER     def __init__(self, halt, exit_code):
USER         super().__init__(
USER             "%s is not done (%s / %s) after %s of cap %s rounds, best round %s, "
USER             "cost %s; no summary and no escalation are filed"
USER             % (
USER                 halt["stop"], halt["terminal_state"], halt["outcome"],
USER                 halt["rounds"], halt["cap"], halt["best_round"], halt["cost"],
USER             )
USER         )
USER         self.halt = halt
USER         self.stop = halt["stop"]
USER         self.exit_code = exit_code
USER 
USER 
USER def _exit_code(stop) -> int:
USER     """1, 2 or 3 for a finish this module does not file. Never 0.
USER 
USER     1 — the work was accepted. 2 — the work was rejected, below the floor. 3 —
USER     a human must see the finish: every other stop. The exit code names what a
USER     caller would have had to route on; it is not a state and it is not a
USER     verdict.
USER     """
USER     if stop == ACCEPTED:
USER         return 1
USER     if stop == REJECTED:
USER         return 2
USER     return 3
USER 
USER 
USER def _own_clock() -> bool:
USER     """True while ``datetime.now`` is this module's clock and not a replacement.
USER 
USER     ``datetime`` is the clock seam. A run that replaces ``now`` on it supplies
USER     every ``started_at`` and ``ended_at`` the round records and the finish
USER     carry, so those stamps are not readings this module took, and a finish
USER     resting on them cannot be filed cleanly: ``loop()`` raises
USER     ``CustodyNotDone`` for it. Nothing replaces the clock in a real run, so a
USER     real finish is always filed.
USER 
USER     An unpatched ``now`` is inherited from the base class and is bound to this
USER     class; a replacement lives in this class's own namespace (or is bound to
USER     the object that supplies it).
USER     """
USER     if "now" in datetime.__dict__:
USER         return False
USER     return getattr(datetime.now, "__self__", None) is datetime
USER 
USER 
USER def emit_custody_for_finish(record_dir, summary):
USER     """Run ``kit/emit_custody.py`` against ``record_dir``; return its exit code.
USER 
USER     This is the seam ``loop()`` uses to ship a custody record on a finish. It
USER     calls the emitter, not the close command; the emitter reads the job
USER     directory on disk — ``packet.json`` and the round records ``loop()`` has
USER     written — and writes ``custody/record.custody.json`` at the path the close
USER     command uses. Exit 0 is the only done: the record was written and names no
USER     hard gap. Any other exit code is not a done finish.
USER 
USER     ``summary`` is carried for the caller's convenience; it is not forwarded.
USER     The seam's result is exactly what the same command produces on the same
USER     directory, so a twin run of the emitter side-by-side matches it.
USER     """
USER     emitter = os.path.join(os.path.dirname(os.path.abspath(__file__)), "emit_custody.py")
USER     proc = subprocess.run(
USER         [sys.executable, emitter, "--job-dir", str(record_dir)],
USER         capture_output=True,
USER         text=True,
USER     )
USER     return proc.returncode
USER 
USER 
USER def _custody_packet(packet, halt):
USER     """The ``packet.json`` a finish leaves for the emitter to read.
USER 
USER     The emitter reads the finish out of the job directory, so before the seam is
USER     called this module records what the finish says. Because the emitter never
USER     sees ``summary.json`` (that file is written only after a clean record), the
USER     finish has to be reachable from ``packet.json`` alone: its fields are
USER     written at the top level in the same snake_case the round records and the
USER     escalation use, again in the camelCase the record's gap vocabulary uses
USER     (``startedAt``, ``endedAt``), and nested under ``finish``/``summary`` so a
USER     reader that expects the summary as an object finds it. The ratified packet's
USER     own fields are kept alongside so the record's subject can be drawn from
USER     them.
USER     """
USER     descriptor = dict(packet) if isinstance(packet, dict) else {}
USER     finish = {
USER         "terminal_state": halt["terminal_state"],
USER         "outcome": halt["outcome"],
USER         "stop": halt["stop"],
USER         "rounds": halt["rounds"],
USER         "cap": halt["cap"],
USER         "accepted_round": halt["accepted_round"],
USER         "best_round": halt["best_round"],
USER         "cost": halt["cost"],
USER         "separation_gaps": halt["separation_gaps"],
USER         "started_at": halt["started_at"],
USER         "ended_at": halt["ended_at"],
USER         "packet_sha256": halt["packet_sha256"],
USER         "rounds_sha256": halt["rounds_sha256"],
USER         "commit": halt["commit"],
USER     }
USER     descriptor.update(finish)
USER     descriptor.update({
USER         "terminalState": halt["terminal_state"],
USER         "startedAt": halt["started_at"],
USER         "endedAt": halt["ended_at"],
USER         "packetSha256": halt["packet_sha256"],
USER         "roundsSha256": halt["rounds_sha256"],
USER         "bestRound": halt["best_round"],
USER         "acceptedRound": halt["accepted_round"],
USER         "finish": dict(finish),
USER         "summary": dict(finish),
USER     })
USER     return descriptor
USER 
