 from __future__ import annotations                                             
                                                                                
 import argparse                                                                
 import os                                                                      
 import subprocess                                                              
 import sys                                                                     
                                                                                
 from kit.seat_move_drain import consume_turn, prepare_turn                     
                                                                                
                                                                                
 def main(argv=None) -> int:                                                    
     parser = argparse.ArgumentParser(description=__doc__)                      
     parser.add_argument("--profile-home", required=True)                       
     parser.add_argument(                                                       
         "turn",                                                                
         nargs=argparse.REMAINDER,                                              
         help="the conductor turn command; receives the staged context on       
 stdin",                                                                        
     )                                                                          
     args = parser.parse_args(argv)                                             
     if not args.turn:                                                          
         parser.error("a turn command is required")                             
                                                                                
     notices, context = prepare_turn(profile_home=args.profile_home)            
     env = dict(os.environ)                                                     
     if context:                                                                
         env["PLUMBLINE_SEAT_NOTICE_CONTEXT"] = context                         
     try:                                                                       
         completed = subprocess.run(args.turn, env=env)                         
     except BaseException:                                                      
         # Turn failed before consuming: staged notices stay for the retry.     
         raise                                                                  
     if completed.returncode != 0:                                              
         return completed.returncode                                            
     consume_turn(profile_home=args.profile_home)                               
     return 0                                                                   
                                                                                
                                                                                
 if __name__ == "__main__":                                                     
     raise SystemExit(main())                                                   
                                                                                

