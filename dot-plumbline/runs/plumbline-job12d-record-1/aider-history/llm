USER             # the time must come from the response, and the caller names it. Every other defect below still
USER             # refuses, so this is the ONLY tolerance the seam opens.
USER             continue
USER         if sent is None:
USER             raise HarnessLogError(p, "sent_at is missing or not RFC 3339 UTC (...Z)", name)
USER         if received is None:
USER             raise HarnessLogError(p, "received_at is missing or not RFC 3339 UTC (...Z)", name)
USER         if received < sent:
USER             raise HarnessLogError(
USER                 p, f"received_at {item['received_at']} is before sent_at {item['sent_at']}", name)
USER         out[name] = Entry(name, sent, received,
USER                           _line_of(lines, "sent_at", item.get("sent_at")),
USER                           _line_of(lines, "received_at", item.get("received_at")),
