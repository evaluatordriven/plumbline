USER def parse_instant(value):
USER     """A logged time as a UTC datetime, or None when it is not RFC 3339 UTC (...Z)."""
USER     if not isinstance(value, str) or not RFC3339.match(value):
USER         return None
USER     return datetime.fromisoformat(value[:-1] + "+00:00").astimezone(timezone.utc)
