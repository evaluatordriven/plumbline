USER def hexdigest(v, field: str, gaps: Gaps) -> dict | None:
USER     """A digest someone TYPED (an approval names the digest it approved): copied, never recomputed."""
USER     if isinstance(v, dict):
USER         v = v.get("sha256")
USER     if isinstance(v, str) and v.startswith("sha256:"):
USER         v = v[7:]
USER     if isinstance(v, str) and re.fullmatch(r"[0-9a-f]{64}", v):
USER         return {"sha256": v}
USER     gaps.add(field, "no sha256 recorded for what was approved (a digest is copied from the approval, never "
USER                     "computed by the emitter)")
USER     return None
