USER def rel_file(job: Path, rel: str | None, field: str, gaps: Gaps, hard: bool = True) -> Path | None:
USER     if not rel:
USER         gaps.add(field, "not named in the custody inputs", hard); return None
USER     p = (job / rel)
USER     if not p.is_file():
USER         gaps.add(field, f"named file {rel!r} does not exist in the job", hard); return None
USER     return p
USER 
USER 
USER def digest_of(job: Path, rel: str | None, field: str, gaps: Gaps, hard: bool = True) -> dict | None:
USER     p = rel_file(job, rel, field, gaps, hard)
USER     return {"sha256": file_digest(p)} if p else None
USER 
USER 
USER def hexdigest(v, field: str, gaps: Gaps) -> dict | None:
USER     """A digest someone TYPED (an approval names the digest it approved): copied, never recomputed."""
USER     if isinstance(v, dict):
USER         v = v.get("sha256")
USER     if isinstance(v, str) and v.startswith("sha256:"):
USER         v = v[7:]
USER     if isinstance(v, str) and re.fullmatch(r"[0-9a-f]{64}", v):
USER         return {"sha256": v}
USER     gaps.add(field, "no sha256 recorded for what was approved (a digest is copied from the approval, never "
USER                     "computed by the emitter)")
USER     return None
USER 
USER 
USER def ts(v, field: str, gaps: Gaps, hard: bool = True):
USER     if isinstance(v, str) and RFC.match(v):
USER         return v
USER     gaps.add(field, "no RFC 3339 UTC time recorded" if v in (None, "") else f"{v!r} is not RFC 3339 UTC (...Z)", hard)
USER     return None
USER 
USER 
USER def line_in(path: Path, value, key: str | None = None) -> int | None:
USER     """The 1-based line of `path` that carries `value` (optionally under `"key":`), if any."""
USER     if value in (None, "") or not path.is_file():
USER         return None
USER     try:
USER         lines = path.read_text(encoding="utf-8").splitlines()
USER     except OSError:
USER         return None
USER     vs = str(value)
USER     hits = [n for n, ln in enumerate(lines, 1) if vs in ln and (key is None or f'"{key}"' in ln)]
USER     if not hits:
USER         hits = [n for n, ln in enumerate(lines, 1) if vs in ln]
USER     return hits[0] if hits else None
USER 
USER 
USER def load(p: Path):
USER     return json.loads(p.read_text(encoding="utf-8"))
USER 
USER 
USER def final_record(job: Path) -> tuple[Path | None, dict | None]:
USER     recs = []
USER     for f in job.glob("iteration-*-eval-record.json"):
USER         m = re.match(r"iteration-(\d+)-eval-record\.json$", f.name)
USER         if m:
USER             recs.append((int(m.group(1)), f))
USER     if not recs:
USER         return None, None
USER     recs.sort()
USER     return recs[-1][1], load(recs[-1][1])
USER 
USER 
USER def run_for(job: Path, iteration) -> dict | None:
USER     d = job / "inputs"
USER     for f in sorted(d.glob("*.json")) if d.is_dir() else []:
USER         try:
USER             r = load(f)
USER         except Exception:
USER             continue
USER         if isinstance(r, dict) and "passes" in r and r.get("iteration") == iteration:
USER             return r
USER     return None
