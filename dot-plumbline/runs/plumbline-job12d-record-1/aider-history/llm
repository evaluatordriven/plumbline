USER 
USER class Entry:
USER     """One call of a harness log, as the record reads it."""
USER 
USER     def __init__(self, name: str, sent_at: datetime, received_at: datetime,
USER                  sent_line: int | None, received_line: int | None, log_name: str, raw: dict):
USER         self.name = name
USER         self.sent_at = sent_at
USER         self.received_at = received_at
USER         self.sent_line = sent_line
USER         self.received_line = received_line
USER         self.log_name = log_name
USER         self.raw = raw
USER 
USER     @property
USER     def source(self) -> str | None:
USER         """`<log name>:<line>` of the received time (the check's time), else of the sent time."""
USER         line = self.received_line if self.received_line is not None else self.sent_line
USER         return f"{self.log_name}:{line}" if line is not None else None
