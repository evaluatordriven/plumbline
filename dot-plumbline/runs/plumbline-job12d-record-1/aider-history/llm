USER def ts(v, field: str, gaps: Gaps, hard: bool = True):
USER     if isinstance(v, str) and RFC.match(v):
USER         return v
USER     gaps.add(field, "no RFC 3339 UTC time recorded" if v in (None, "") else f"{v!r} is not RFC 3339 UTC (...Z)", hard)
