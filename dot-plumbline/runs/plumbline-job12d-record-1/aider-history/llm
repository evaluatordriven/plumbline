USER def read(path, allow_unstamped: str = "refuse") -> dict:
USER     """Every stamped call of the harness log at `path`, by call name, in file order.
USER 
USER     Raises HarnessLogError when the file is unreadable, is not JSON, is neither a
USER     list of entries nor a single entry object, when an entry names no call, when a
USER     stamp is PRESENT but not RFC 3339 UTC, or when received_at is before sent_at.
USER 
USER     `allow_unstamped` decides what an ABSENT `sent_at` / `received_at` is:
USER 
USER       "refuse" (the default) -- an absent stamp is a malformed log, refused as it
USER           always was. A caller that wants every log sound gets that.
USER       "skip"   -- an absent stamp is NOT this reader's to refuse: the entry is left
USER           out of the returned map (its times are None), because a call the logger
USER           did not stamp carries no logger time to read, and its time must come from
USER           the response instead. Every OTHER refusal above is raised unchanged and
USER           in the same order, so a log with a present-but-unreadable, reversed, unnamed
USER           or non-JSON defect still refuses; only absences are tolerated. The caller
USER           names those calls (`Entry.raw` and the log itself are all it needs).
USER 
USER     The returned map is every entry that had both stamps. An entry that was skipped
USER     is still an entry of the file, so a caller that must name it reads the file; this
USER     module never decides that an unstamped call is acceptable, only that it is not
USER     malformed.
USER     """
USER     p = Path(path)
USER     if allow_unstamped not in ("refuse", "skip"):
USER         raise ValueError(f"allow_unstamped is {allow_unstamped!r}: it is 'refuse' or 'skip'")
USER     try:
USER         text = p.read_text(encoding="utf-8")
USER     except OSError as exc:
USER         raise HarnessLogError(p, f"cannot be read: {exc}")
USER     try:
USER         data = json.loads(text)
USER     except ValueError as exc:
USER         raise HarnessLogError(p, f"is not JSON: {exc}")
USER     if isinstance(data, list):
USER         items = data
USER     elif isinstance(data, dict):
USER         items = [data]
USER     else:
USER         raise HarnessLogError(p, "is neither a JSON list of harness entries nor one entry object")
USER     lines = text.splitlines()
USER     out: dict = {}
USER     for i, item in enumerate(items, 1):
USER         if not isinstance(item, dict):
USER             raise HarnessLogError(p, f"entry {i} is not a JSON object")
USER         raw_call = item.get("call")
USER         name = raw_call.strip() if isinstance(raw_call, str) and raw_call.strip() else None
USER         if not name:
USER             raise HarnessLogError(p, f"entry {i} names no call")
USER         sent = parse_instant(item.get("sent_at"))
USER         received = parse_instant(item.get("received_at"))
USER         absent = (sent is None and item.get("sent_at") in (None, "")) or \
USER                  (received is None and item.get("received_at") in (None, ""))
USER         if absent and allow_unstamped == "skip":
USER             # A call the logger did not stamp carries no logger time to read. It is left out, not refused:
USER             # the time must come from the response, and the caller names it. Every other defect below still
USER             # refuses, so this is the ONLY tolerance the seam opens.
USER             continue
USER         if sent is None:
USER             raise HarnessLogError(p, "sent_at is missing or not RFC 3339 UTC (...Z)", name)
USER         if received is None:
USER             raise HarnessLogError(p, "received_at is missing or not RFC 3339 UTC (...Z)", name)
USER         if received < sent:
USER             raise HarnessLogError(
USER                 p, f"received_at {item['received_at']} is before sent_at {item['sent_at']}", name)
USER         out[name] = Entry(name, sent, received,
USER                           _line_of(lines, "sent_at", item.get("sent_at")),
USER                           _line_of(lines, "received_at", item.get("received_at")),
USER                           p.name, item)
USER     return out
