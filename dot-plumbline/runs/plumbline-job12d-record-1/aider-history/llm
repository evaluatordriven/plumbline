USER def relay_only_buyer(ci: dict, packet: dict, lines: list[tuple[int, dict]]) -> bool:
USER     """A buyer approval is relay-only when a relay line is its only evidence: no `approve --role buyer` ledger
USER     line and no buyer entry in inputs/custody.json (F1f). A relay is a report, never an approval."""
USER     if not packet.get("buyer"):
USER         return False
USER     if not any(e.get("event") == "relay" for _, e in lines):
USER         return False
USER     bar_roles = {a.get("role") for a in (ci.get("bar") or {}).get("approvals") or [] if isinstance(a, dict)}
USER     ledger_roles = {e.get("role") for _, e in lines if e.get("event") == "approve"}
USER     return "buyer" not in bar_roles and "buyer" not in ledger_roles
USER 
