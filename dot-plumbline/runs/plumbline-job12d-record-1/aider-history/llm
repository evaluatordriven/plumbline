USER def rel_file(job: Path, rel: str | None, field: str, gaps: Gaps, hard: bool = True) -> Path | None:
USER     if not rel:
USER         gaps.add(field, "not named in the custody inputs", hard); return None
USER     p = (job / rel)
USER     if not p.is_file():
USER         gaps.add(field, f"named file {rel!r} does not exist in the job", hard); return None
USER     return p
