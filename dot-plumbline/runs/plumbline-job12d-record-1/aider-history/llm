USER def events_log(job: Path, ref: H.Refusals) -> dict:
USER     """inputs/custody-events.jsonl, written as things happen by kit/custody_ledger.py. Latest row per key wins."""
USER     p = job / LEDGER_REL
USER     out = {"_file": None, "approve": {}, "pin": {}}
USER     if not p.is_file():
USER         return out
USER     out["_file"] = {"name": LEDGER_REL, "sha256": file_digest(p)}
USER     for n, ln in enumerate(p.read_text(encoding="utf-8").splitlines(), 1):
USER         if not ln.strip():
USER             continue
USER         try:
USER             e = json.loads(ln)
USER         except ValueError:
USER             ref.add("time", f"{LEDGER_REL} line {n} is not JSON"); continue
USER         e["_line"] = n
USER         if e.get("event") == "approve":
USER             out["approve"][e.get("role")] = e
USER         elif e.get("event") == "pin":
USER             out["pin"][e.get("seat")] = e
USER         elif e.get("event"):
USER             out[e["event"]] = e
USER     return out
USER 
USER 
USER def round_records(job: Path) -> list[tuple[int, Path, dict]]:
USER     """The round records loop() wrote, in round order: (number, path, record)."""
USER     out = []
USER     for path in job.glob("round-*.json"):
USER         m = re.fullmatch(r"round-(\d+)\.json", path.name)
USER         if not m:
USER             continue
USER         try:
USER             body = load(path)
USER         except Exception:
USER             continue
USER         if isinstance(body, dict):
USER             out.append((int(m.group(1)), path, body))
USER     out.sort(key=lambda row: row[0])
USER     return out
USER 
USER 
USER def is_loop_finish(packet: dict, job: Path) -> bool:
USER     """True for a job loop() filed: its packet carries the finish, or it wrote round records."""
USER     return isinstance(packet.get("finish"), dict) or bool(round_records(job))
USER 
USER 
USER def _packet_blocks(packet: dict) -> list[dict]:
USER     """packet.json itself, then the finish/summary objects loop() nests the stamps under."""
USER     blocks = [packet]
USER     for key in ("finish", "summary"):
USER         if isinstance(packet.get(key), dict):
USER             blocks.append(packet[key])
USER     return blocks
USER 
USER 
USER def _first_stamp(packet: dict, names: tuple) -> str | None:
USER     for block in _packet_blocks(packet):
USER         for name in names:
USER             value = block.get(name)
USER             if isinstance(value, str) and value.strip():
USER                 return value
USER     return None
USER 
USER 
USER def _instant_text(value) -> str | None:
USER     """The instant `value` names, spelled as the custody schema's timestamp (UTC, ...Z)."""
USER     if not isinstance(value, str) or not value.strip():
USER         return None
USER     text = value.strip()
USER     if text.endswith("Z"):
USER         text = text[:-1] + "+00:00"
USER     try:
USER         parsed = datetime.fromisoformat(text)
USER     except ValueError:
USER         return None
USER     if parsed.tzinfo is None:
USER         return None
USER     return H.iso(parsed.astimezone(timezone.utc))
USER 
USER 
USER def _editable_files(job: Path, number: int | None = None) -> list[tuple[str, Path]]:
USER     """Every file under round-NN/editable/, as (job-relative path, path)."""
USER     if number is not None:
USER         bases = [job / ("round-%02d" % number) / "editable"]
USER     else:
USER         bases = sorted(path / "editable" for path in job.glob("round-*") if path.is_dir())
USER     found = []
USER     for base in bases:
USER         if not base.is_dir():
USER             continue
USER         for path in sorted(base.rglob("*")):
USER             if path.is_file():
USER                 found.append((path.relative_to(job).as_posix(), path))
USER     found.sort(key=lambda row: row[0])
USER     return found
USER 
