USER     usage = resp.get("usage") if isinstance(resp.get("usage"), dict) else {}
USER     v = usage.get("cost") if isinstance(usage, dict) else None
USER     if isinstance(v, (int, float)) and not isinstance(v, bool):
USER         return float(v)
USER     return 0.0
USER 
USER 
USER def flag_calls(calls, hand: dict | None) -> list[dict]:
USER     """Every call of a harness log the emitter reads: a `.sent_at`/`.received_at` the logger did not stamp is a
USER     hand time (T7b), named with the server time's source and the file:line that carries it. Every call counts,
USER     not only the first and the last, and both fields (a log with no logger `sent_at` on its calls would otherwise
USER     hide them). The log is never rewritten: a call the logger stamped adds nothing.
USER 
USER     Returns the entries it added: a caller that must REFUSE an unsourced check time (a model evaluator's time the
USER     logger never stamped, which --allow-hand-times does not admit) has to name every call it read, not just the
USER     first, so it needs the list and not only the side effect on `hand`."""
USER     if hand is None:
USER         return []
USER     added = []
USER     for c in calls:
USER         for e in c.hand_time_entries():
USER             hand[e["field"]] = e
USER             added.append(e)
USER     return added
USER 
USER 
USER def ledger_array(lines: list[tuple[int, dict]], event: str) -> list[dict]:
USER     """Every ledger line of `event`, verbatim, with its file:line source (F1h)."""
USER     return [{**{k: v for k, v in e.items() if k != "_line"}, "source": f"{LEDGER_REL}:{e['_line']}"}
USER             for _, e in lines if e.get("event") == event]
USER 
USER 
USER def spend_block(lines: list[tuple[int, dict]], calls) -> dict:
USER     """x-plumbline.spend: the calls sum (logs), the key delta (the spend line), total = max, tolerance 1e-4."""
USER     sp = None
USER     for _, e in lines:
USER         if e.get("event") == "spend":
USER             sp = e
USER     calls_sum = round(sum(call_cost(c) for c in calls), 6)
USER     key_delta = float(sp.get("key_delta_usd") or 0) if sp else 0.0
USER     return {"calls_sum_usd": calls_sum, "key_delta_usd": key_delta,
USER             "total_usd": max(calls_sum, key_delta), "tolerance_usd": 0.0001,
USER             "source": f"{LEDGER_REL}:{sp['_line']}" if sp else None}
USER 
