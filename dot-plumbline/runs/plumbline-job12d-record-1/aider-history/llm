USER def call_cost(c) -> float:
USER     """A harness call's billed cost, in the order the job's harness uses for its own settle lines: the
USER     generation reply's `data.total_cost` when present, else the chat reply's `usage.cost` (V5)."""
USER     raw = getattr(c, "raw", None)
USER     if not isinstance(raw, dict):
USER         return 0.0
USER     gen = raw.get("generation") if isinstance(raw.get("generation"), dict) else None
USER     if gen is not None:
USER         data = gen.get("data") if isinstance(gen.get("data"), dict) else gen
USER         v = data.get("total_cost") if isinstance(data, dict) else None
USER         if isinstance(v, (int, float)) and not isinstance(v, bool):
USER             return float(v)
USER     resp = raw.get("response") if isinstance(raw.get("response"), dict) else {}
USER     usage = resp.get("usage") if isinstance(resp.get("usage"), dict) else {}
USER     v = usage.get("cost") if isinstance(usage, dict) else None
USER     if isinstance(v, (int, float)) and not isinstance(v, bool):
USER         return float(v)
USER     return 0.0
USER 
USER 
USER def flag_calls(calls, hand: dict | None) -> None:
USER     """Every call of a harness log the emitter reads: a `.sent_at`/`.received_at` the logger did not stamp is a
USER     hand time (T7b), named with the server time's source and the file:line that carries it. Every call counts,
USER     not only the first and the last, and both fields (a log with no logger `sent_at` on its calls would otherwise
USER     hide them). The log is never rewritten: a call the logger stamped adds nothing."""
USER     if hand is None:
USER         return
USER     for c in calls:
USER         for e in c.hand_time_entries():
USER             hand[e["field"]] = e
USER 
