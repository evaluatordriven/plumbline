 def flag_calls(calls, hand: dict | None) -> None:                              
     """Every call of a harness log the emitter reads: a                        
 `.sent_at`/`.received_at` the logger did not stamp is a                        
     hand time (T7b), named with the server time's source and the file:line     
 that carries it. Every call counts,                                            
     not only the first and the last, and both fields (a log with no logger     
 `sent_at` on its calls would otherwise                                         
     hide them). The log is never rewritten: a call the logger stamped adds     
 nothing."""                                                                    
     if hand is None:                                                           
         return                                                                 
     for c in calls:                                                            
         for e in c.hand_time_entries():                                        
             hand[e["field"]] = e                                               
                                                                                

Replacement:                                                                    

                                                                                
 def flag_calls(calls, hand: dict | None) -> list[dict]:                        
     """Every call of a harness log the emitter reads: a                        
 `.sent_at`/`.received_at` the logger did not stamp is a                        
     hand time (T7b), named with the server time's source and the file:line     
 that carries it. Every call counts,                                            
     not only the first and the last, and both fields (a log with no logger     
 `sent_at` on its calls would otherwise                                         
     hide them). The log is never rewritten: a call the logger stamped adds     
 nothing.                                                                       
                                                                                
     Returns the entries it added, so a caller that must REFUSE an unsourced    
 check time (a model evaluator's                                                
     time the logger never stamped, which --allow-hand-times does not admit)    
 can name every call it read."""                                                
     if hand is None:                                                           
         return []                                                              
     added = []                                                                 
     for c in calls:                                                            
         for e in c.hand_time_entries():                                        
             hand[e["field"]] = e                                               
             added.append(e)                                                    
     return added                                                               
                                                                                

