{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smoitozo/e-di/schemas/job-packet.schema.json",
  "title": "E-DI job packet",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "entry",
    "instrument_profile",
    "job_name",
    "artifact",
    "buyer",
    "maker",
    "evaluator",
    "ratified",
    "mode"
  ],
  "properties": {
    "entry": {
      "enum": ["A", "B"]
    },
    "instrument_profile": {
      "enum": ["full", "mvi"]
    },
    "job_name": {
      "type": "string",
      "minLength": 1
    },
    "artifact": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "object"}
      ]
    },
    "buyer": {
      "type": "string",
      "minLength": 1
    },
    "specialist": {"type": "string"},
    "maker": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "object"}
      ]
    },
    "evaluator": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "object"}
      ]
    },
    "ground_truth": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "version", "hardness"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "hardness": {"enum": ["INVARIANT", "DOCUMENT", "PRIOR"]},
          "channel": {"type": "string"}
        }
      }
    },
    "mandate_ref": {
      "type": "object",
      "required": ["doc", "version"],
      "properties": {
        "doc": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "standard_ref": {
      "oneOf": [
        {"type": "string", "minLength": 1, "pattern": "\\S"},
        {"type": "object", "minProperties": 1}
      ]
    },
    "bounds": {"type": "object",
      "properties": {
        "cap_counts": {"enum": ["generations", "regenerations"]}
      }
    },
    "human_seat": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "escalation": {
      "oneOf": [
        {"type": "string"},
        {"type": "object"}
      ]
    },
    "level": {"type": "string"},
    "mode": {
      "enum": ["scored", "readings"]
    },
    "ratified": {"type": "boolean"},
    "terminal_state": {
      "enum": ["accepted", "needs_owner", "rejected"]
    },
    "outcome": {
      "enum": [
        "accepted",
        "census",
        "needs_owner",
        "rejected",
        "no_observation",
        "no_artifact"
      ]
    },
    "reads_before_freeze": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "minItems": 1}
      ]
    },
    "proposed": {"type": "object"},
    "disposition": {
      "type": ["string", "null"]
    },
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"mode": {"const": "readings"}},
        "required": ["mode"]
      },
      "then": {
        "allOf": [
          {"not": {"required": ["bounds"]}},
          {"not": {"required": ["specialist"]}},
          {
            "properties": {
              "terminal_state": {"not": {"const": "rejected"}},
              "outcome": {"not": {"const": "rejected"}}
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {"ratified": {"const": false}},
        "required": ["ratified"]
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "terminal_state": {"not": {"const": "accepted"}}
            }
          },
          {"not": {"required": ["bounds"]}},
          {"not": {"required": ["specialist"]}},
          {"not": {"required": ["standard_ref"]}}
        ]
      }
    },
    {
      "if": {
        "properties": {"mode": {"const": "scored"}},
        "required": ["mode"]
      },
      "then": {
        "required": ["specialist", "bounds", "ground_truth", "mandate_ref", "escalation"],
        "properties": {
          "bounds": {
            "type": "object",
            "required": ["T_accept", "T_dim", "T_reject", "cap", "budget"]
          },
          "ground_truth": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"ratified": {"const": true}},
        "required": ["ratified"]
      },
      "then": {"required": ["human_seat", "standard_ref"]}
    },
    {
      "if": {"required": ["terminal_state"]},
      "then": {"required": ["outcome"]}
    },
    {
      "if": {
        "properties": {"outcome": {"enum": ["no_observation", "no_artifact"]}},
        "required": ["outcome"]
      },
      "then": {
        "properties": {"terminal_state": {"const": "needs_owner"}},
        "required": ["terminal_state"]
      }
    },
    {
      "if": {
        "properties": {"outcome": {"const": "census"}},
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "terminal_state": {"const": "accepted"},
          "mode": {"const": "readings"}
        },
        "required": ["terminal_state", "mode"]
      }
    },
    {
      "if": {
        "properties": {"outcome": {"const": "rejected"}},
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "terminal_state": {"const": "rejected"},
          "mode": {"const": "scored"}
        },
        "required": ["terminal_state", "mode"]
      }
    },
    {
      "if": {
        "properties": {"entry": {"const": "B"}},
        "required": ["entry"]
      },
      "then": {"required": ["reads_before_freeze"]}
    },
    {
      "not": {
        "properties": {"evaluator": {"const": "Owner"}},
        "required": ["evaluator"]
      }
    },
    {
      "not": {
        "properties": {"evaluator": {"type": "object", "properties": {"name": {"const": "Owner"}}, "required": ["name"]}},
        "required": ["evaluator"]
      }
    },
    {
      "not": {
        "properties": {"evaluator": {"type": "object", "properties": {"who": {"const": "Owner"}}, "required": ["who"]}},
        "required": ["evaluator"]
      }
    }
  ]
}
